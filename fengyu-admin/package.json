{
  "name": "fengyu-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/gen-version.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "bun run src/db/seed.ts",
    "cron": "node dist/cron-worker.mjs",
    "cron:dev": "bun --env-file=.env run src/cron/index.ts",
    "cron:once": "bun --env-file=.env run src/cron/index.ts --once",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:manual": "playwright test --config=tests/e2e-chains/playwright.manual.config.ts --headed --project=chromium --reporter=list",
    "test:visual": "playwright test tests/e2e-pages/visual",
    "test:visual:update": "playwright test tests/e2e-pages/visual --update-snapshots",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vant/area-data": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.1",
    "lucide-react": "^0.513.0",
    "next": "^15.3.2",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.20",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.21",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "happy-dom": "^20.8.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
