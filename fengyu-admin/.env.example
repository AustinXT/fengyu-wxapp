# =============================================================================
# admin Next.js 环境变量样例
# 真实值放 .env.local（已在根 .gitignore），勿提交 secret
# =============================================================================

# PostgreSQL（业务主库）
DATABASE_URL=postgresql://fengyu:<password>@<host>:5434/fengyu

# JWT 会话签名密钥。生产环境（NODE_ENV=production）必须设置，否则启动/鉴权时
# fail-fast 报错，绝不回退到弱默认值（防 token 伪造）。开发/测试可留空走 dev-only 默认。
# 生成高强度随机值：openssl rand -base64 48
JWT_SECRET=

# 跨子域单点登录 Cookie。生产若需要 admin.fengyu.xxx 与 analyst.fengyu.xxx 共享登录态，
# 设置为顶级域，如 .fengyu.xxx；本地开发留空。
COOKIE_DOMAIN=

# 登录/改密 密码传输层 RSA 加密（前端用公钥加密，服务端用私钥解密还原明文）
# 两个变量均存 base64(PEM)，单行，规避多行 PEM 在 env/docker-compose 的换行问题。
# 公钥可暴露（NEXT_PUBLIC_）；私钥须保密。dev/prod 各自一对独立密钥。
# 未配置则登录/改密会刻意报错（fail-fast，绝不静默接收明文）。
# 生成（私钥 PKCS#8 / 公钥 SPKI，与 jsencrypt PKCS#1 v1.5 兼容）：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem
#   echo "RSA_PRIVATE_KEY=$(base64 -i priv.pem | tr -d '\n')"
#   echo "NEXT_PUBLIC_RSA_PUBLIC_KEY=$(base64 -i pub.pem | tr -d '\n')"
RSA_PRIVATE_KEY=
NEXT_PUBLIC_RSA_PUBLIC_KEY=

# 腾讯云 / 小程序（cloudbase + wxacode 生成）
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
CLOUDBASE_ENV_ID=
# CDN 桶基址：须与 CLOUDBASE_ENV_ID 同环境，否则 client 取不到 admin 上传的图
# dev=https://636c-cloud1-3gpht4b01ff88838-1406056527.tcb.qcloud.la
# prod=https://6665-fengyu-client-prod-d1cga6909c0ba-1406056527.tcb.qcloud.la
CDN_BASE=
WX_CLIENT_APPID=
WX_CLIENT_SECRET=
WXACODE_ENV_VERSION=trial

# =============================================================================
# 拉卡拉商户入网（Phase 2 / arch-007）
# =============================================================================
# API 基址；test=https://test.wsmsd.cn/xx，prod=https://s2.lakala.com/xx
LAKALA_API_BASE=https://test.wsmsd.cn/xx
# 应用编号 / 证书序列号
LAKALA_APPID=
LAKALA_SERIAL_NO=
# 商户/平台 PEM（PEM 内容本体，不是文件路径；env 多行写法见 [lakala-pem-env-format]）
LAKALA_PRIVATE_KEY_PEM=
LAKALA_PLATFORM_CERT_PEM=
# 进件回调 / 电子合同回调 URL（填到拉卡拉商户后台）
LAKALA_INCOMING_NOTIFY_URL=https://<admin-domain>/api/lakala/callback/incoming
LAKALA_CONTRACT_NOTIFY_URL=https://<admin-domain>/api/lakala/callback/contract
# 回调 IP 白名单（逗号分隔）；prod 必填，prod 启动期 fail-fast；非 prod 允许空（联调用）
LAKALA_CALLBACK_IP_WHITELIST=

# WorkFine MSSQL 只读（admin /legacy-orders manual pull 用）
# 默认连接见 reference_workfine_mssql.md（user=admin, password=Se1Qimoh）
# 设置 MOCK_WORKFINE=1 可走 fixtures（CI / 无网络环境）
#
# 两种配法二选一，优先级：MSSQL_CONNECTION_STRING > 分离变量。
# 部署（envs/*.env → docker/.env）统一用连接字符串，与 staffApi / 同步脚本一致：
# MSSQL_CONNECTION_STRING=Server=47.96.87.33,1433;Database=wkdb_20220804_86cd3292;User Id=admin;Password=Se1Qimoh;TrustServerCertificate=True
#
# 或用分离变量（本地开发）：
MSSQL_USER=admin
MSSQL_PASSWORD=
MSSQL_DATABASE=wkdb_20220804_86cd3292
MSSQL_SERVER=47.96.87.33
MSSQL_PORT=1433
# MOCK_WORKFINE=1
