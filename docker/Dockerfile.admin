# fengyu-admin Next.js 15 生产镜像
# 构建上下文：monorepo 根目录（需要访问 db/schema/）
# 用法：docker build -f docker/Dockerfile.admin -t fengyu-admin .

# base image 走 daocloud 镜像加速：本地 docker.io metadata HEAD 请求经常超时
# 远程主机不构建镜像（仅 docker load），故域名仅影响本地 build 时的 manifest 解析
FROM docker.m.daocloud.io/oven/bun:1-alpine AS base

# Alpine apk 换阿里云镜像
RUN sed -i 's#https\?://dl-cdn.alpinelinux.org/alpine#https://mirrors.aliyun.com/alpine#g' /etc/apk/repositories

# bun 换淘宝镜像
ENV BUN_INSTALL_REGISTRY=https://registry.npmmirror.com

# ---- 依赖安装 ----
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# 复制 db schema（fengyu-admin 通过 webpack alias @db 引用）
COPY db/schema/ /db/schema/

# 复制 package 文件并安装依赖
COPY fengyu-admin/package.json fengyu-admin/bun.lock ./
RUN bun install --frozen-lockfile

# ---- 构建 ----
FROM base AS builder
RUN apk add --no-cache nodejs
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /db/schema/ /db/schema/
# Shared schema lives outside /app, so Bun resolves its package imports from
# /db/node_modules while bundling the standalone workers.
COPY --from=deps /app/node_modules /db/node_modules
COPY db/utils/ /db/utils/
COPY fengyu-admin/ .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# 版本号注入：由 deploy-admin.sh 从宿主机 git 读取后传入；prebuild 脚本会读这两个 env。
ARG APP_VERSION=dev
ARG APP_COMMIT=
ENV APP_VERSION=$APP_VERSION
ENV APP_COMMIT=$APP_COMMIT

# 构建期占位：next build 的 page-data 收集会求值模块图，jwt-secret.ts 在模块加载期
# 即调 resolveSecret()，NODE_ENV=production 下无 JWT_SECRET 会 fail-fast 中断构建。
# 构建期不是运行期、本就无真 secret，这里给一个 dummy 占位让构建过；运行期由容器 env
# 注入真值覆盖（runner stage 不继承本 ENV），fail-fast 的运行期安全保障不受影响。
ENV JWT_SECRET=build-time-placeholder-not-used-at-runtime

# 登录密码 RSA 公钥：NEXT_PUBLIC_ 前缀变量由 next build 在「构建期」inline 进客户端
# bundle（运行期注入无效）。须由 deploy-admin.sh 从 envs/prod.env 读出后 --build-arg 传入，
# 否则（.dockerignore 已排除 .env.local）公钥为空 → 前端 encryptPassword 抛「缺少公钥」。
# 运行期对应的私钥 RSA_PRIVATE_KEY 由 docker-compose.remote.yml 注入，两者必须同一对。
ARG NEXT_PUBLIC_RSA_PUBLIC_KEY=
ENV NEXT_PUBLIC_RSA_PUBLIC_KEY=$NEXT_PUBLIC_RSA_PUBLIC_KEY

# Analyst 入口地址同样由部署环境在构建期注入。生产不提供时顶栏会隐藏入口，
# 防止 dev/prod 地址串用；本地 docker compose 会提供 localhost:3001 默认值。
ARG NEXT_PUBLIC_ANALYST_ORIGIN=
ENV NEXT_PUBLIC_ANALYST_ORIGIN=$NEXT_PUBLIC_ANALYST_ORIGIN

RUN bun run build

# 代码保护(L1)：兜底删除构建产物里的任何 source map。next build 生产模式默认不发
# .map（next.config.ts 也已显式 productionBrowserSourceMaps:false），此处再做一道
# belt-and-suspenders——即便未来某次配置误开，可还原成 TS 源码的 .map 也绝不进入
# 交付给客户服务器的镜像。只 runner stage 会被 COPY 的两个目录即可。
RUN find .next/standalone .next/static -name '*.map' -type f -delete 2>/dev/null || true

# 构建 cron-worker bundle 单文件（Next.js standalone 不含 src/cron/）
# postgres-js 默认尝试 require pg-native（alpine 无该原生模块），用 --external 跳过。
# cron 会复用带 server-only 标记的上传模块；保留 server-only 为外部依赖，
# 由 Node 的 react-server 条件加载空模块，避免把默认抛错分支内联进 bundle。
# 用 .mjs 后缀让 node 18 按 ESM 解析（drizzle / postgres-js 都是 ESM-only）
RUN bun build src/cron/index.ts \
      --target=node \
      --format=esm \
      --outfile=dist/cron-worker.mjs \
      --external pg-native \
      --external server-only
# 实际加载 cron bundle，提前拦截 server-only / 路径 alias 等启动期错误；--check 不连库、不跑任务。
RUN node --conditions=react-server dist/cron-worker.mjs --check

# 构建异步导出 worker。与 web / cron 独立进程运行，单任务流式写 XLSX 后再上传 CloudBase。
# with-permission 在 export session 缺失时才加载 Web auth；独立 worker 不允许该回退，
# 通过 define 在构建时裁掉整条依赖链。保留 server-only 为外部依赖，并让 Node
# 以 react-server 条件解析它，避免破坏 Web 端的 Client Component 隔离保护。
RUN bun build src/export-worker/index.ts \
      --target=node \
      --format=esm \
      --outfile=dist/export-worker.mjs \
      --external pg-native \
      --external @opentelemetry/api \
      --external server-only \
      --define process.env.FENGYU_EXPORT_WORKER='"1"'
# 实际加载 standalone bundle，提前拦截 server-only / 路径 alias 等启动期错误；--check 不连库、不领取任务。
RUN node --conditions=react-server dist/export-worker.mjs --check

# ---- 生产运行 ----
FROM docker.m.daocloud.io/library/node:22-alpine AS runner
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# 安装时区数据并锁定东八区：alpine 默认无 tzdata，仅设 TZ 会被 musl 退回 UTC。
# 影响 admin (server.js) 与 cron-worker（复用同一镜像）：postgres.js 解析无时区
# timestamp（库里存的是北京墙钟时间）、Date 本地方法、日志时间戳全部按 Asia/Shanghai。
# 缺此设置时 UTC 容器会把 11:24 误当 UTC 解析，前端再 +8 渲染成 19:24（晚 8 小时）。
RUN apk add --no-cache tzdata postgresql-client
ENV TZ=Asia/Shanghai

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# 复制 standalone 输出（admin web）
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# export-worker 将 server-only 保留为外部依赖；该包无传递依赖，Node 以 react-server
# 条件加载其空模块，Web 的 server-only 标记仍由 Next.js 正常处理。
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/server-only ./node_modules/server-only
# cron-worker bundle（含所有依赖；compose 启动时通过 command 覆盖入口）
COPY --from=builder --chown=nextjs:nodejs /app/dist/cron-worker.mjs ./cron-worker.mjs
# export-worker bundle（同镜像独立进程，compose 启动时通过 command 覆盖入口）
COPY --from=builder --chown=nextjs:nodejs /app/dist/export-worker.mjs ./export-worker.mjs

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
