# PostgreSQL
POSTGRES_USER=fengyu
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fengyu

# 腾讯云
TENCENTCLOUD_SECRETID=your_secret_id
TENCENTCLOUD_SECRETKEY=your_secret_key
CLOUDBASE_ENV_ID=your_env_id
CDN_BASE=https://your-cloudbase-cdn.tcb.qcloud.la

# 微信
WX_CLIENT_APPID=your_appid
WX_CLIENT_SECRET=your_secret
WXACODE_ENV_VERSION=release

# cron-worker 主动告警通道（企微群机器人 webhook，可选）
# 留空则 STEP 5/6 仅写 operation_logs + console.error，不外推
WECHAT_BOT_WEBHOOK_URL=

# 拉卡拉支付配置。真实值只保存在本机/服务器 .env。
LAKALA_API_FAMILY=tkbs
LAKALA_CLIENT_MODE=mock
LAKALA_API_BASE=https://test.wsmsd.cn/sit/api
LAKALA_TEST_BASE_URL=https://test.wsmsd.cn/sit/api
LAKALA_APPID=
LAKALA_SERIAL_NO=
LAKALA_CALLBACK_IP_WHITELIST=
LAKALA_ENV=test
LAKALA_PRIVATE_KEY_PEM=
LAKALA_PLATFORM_CERT_PEM=
LAKALA_SM4_KEY=
LAKALA_ORG_CODE=
LAKALA_USER_NO=
LAKALA_ACTIVITY_ID=
LAKALA_MCC=13002
LAKALA_SETTLEMENT_TYPE=AUTOMATIC
LAKALA_SOURCE=H5
# 门店入网复用上述支付凭据，只单独配置业务参数。
LAKALA_ONBOARDING_ENABLED=false
LAKALA_ONBOARDING_API_BASE=
LAKALA_ECONTRACT_CALLBACK_URL=
LAKALA_ECONTRACT_TYPE=EC015
LAKALA_ONBOARDING_FEE_DATA=
LAKALA_ONBOARDING_EMAIL=
LAKALA_ONBOARDING_BUSI_CODE=
LAKALA_ONBOARDING_MER_TYPE=
LAKALA_ONBOARDING_DEFAULT_LATITUDE=28.682892
LAKALA_ONBOARDING_DEFAULT_LONGITUDE=115.858197
LAKALA_ONBOARDING_BUSINESS_CONTENT=
PRIVATE_UPLOAD_DIR=/var/lib/fengyu/private-uploads
ALIYUN_OCR_MODE=real
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# analyst
ANALYST_ADMIN_LOGIN_URL=http://localhost:3000/login
ANALYST_ADMIN_ORIGIN=http://localhost:3000
ANALYST_PUBLIC_ORIGIN=http://localhost:3001
ANALYST_VIEW_ACTION=data_center:dashboard
ANALYST_CHAT_ACTION=data_center:dashboard
ANALYST_EXPORT_ACTION=data_center:dashboard
