/* app.wxss — 凤御员工端全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
               'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1A1A1A;
  background-color: #FAFAFA;

  /* ===== 品牌色（白红系） ===== */
  --color-primary:       #C0322A;
  --color-primary-light: #FFF0EE;
  --color-primary-dark:  #9B1E14;
  --color-accent:        #C0322A;

  /* ===== 语义色 ===== */
  --color-success:  #3D8A5A;
  --color-warning:  #D4820A;
  --color-error:    #D94040;
  --color-info:     #5E8BB3;

  /* ===== 状态徽章背景（低饱和） ===== */
  --color-badge-pending:   #FFF3E0;
  --color-badge-confirmed: #E8F5E9;
  --color-badge-progress:  #E3F0FF;
  --color-badge-done:      #F0F0F0;
  --color-badge-error:     #FFEBEE;

  /* ===== 中性色 ===== */
  --color-text-primary:   #1A1A1A;
  --color-text-secondary: #666666;
  --color-text-hint:      #999999;
  --color-border:         #E8E8E8;
  --color-bg-page:        #FAFAFA;
  --color-bg-card:        #FFFFFF;

  /* ===== 间距 ===== */
  --spacing-page:  32rpx;
  --spacing-card:  24rpx;
  --spacing-tight: 16rpx;

  /* ===== 圆角 / 阴影 / 网格 / 暖底（管理层补充） ===== */
  --radius-sm:    8rpx;
  --radius-md:   12rpx;
  --radius-lg:   16rpx;
  --radius-pill: 999rpx;
  --shadow-card:      0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-card-soft: 0 2rpx  8rpx rgba(0, 0, 0, 0.04);
  --gap-grid:       16rpx;
  --gap-grid-tight:  8rpx;
  --color-divider-soft: #F0F0F0;
  --color-bg-warm:      #F5F2EE;

  /* ===== Vant 主题覆盖 ===== */
  --button-primary-background-color: #C0322A;
  --button-primary-border-color:     #C0322A;
  --button-primary-color:            #FFFFFF;
  --button-border-radius:            44rpx;
  --tab-active-color:                #C0322A;
  --tabs-bottom-bar-color:           #C0322A;
  --tag-primary-background-color:    #C0322A;
  --checkbox-checked-icon-color:     #C0322A;
  --radio-checked-icon-color:        #C0322A;
  --search-action-color:             #C0322A;
  --cell-right-icon-color:           #999999;
  --loading-color:                   #C0322A;
  --empty-image-size:                200rpx;
  --sidebar-active-color:            #C0322A;
  --sidebar-selected-color:          #C0322A;
}

/* ===== 安全区 ===== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

/* ===== 分割线 ===== */
.divider {
  height: 1px;
  background-color: var(--color-border);
}

/* ===== 状态标签（全局通用） ===== */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.status-tag--pending  { background: var(--color-badge-pending);  color: #D4820A; }
.status-tag--success  { background: var(--color-badge-confirmed); color: #3D8A5A; }
.status-tag--progress { background: var(--color-badge-progress);  color: #5E8BB3; }
.status-tag--awaiting { background: #FCEEED;                       color: #C0322A; }
.status-tag--done     { background: var(--color-badge-done);      color: #888888; }
.status-tag--error    { background: var(--color-badge-error);     color: #D94040; }

/* ===== 旧版状态色（兼容） ===== */
.status-pending    { color: #D48806; }
.status-confirm    { color: #C0322A; }
.status-paid       { color: #389E0D; }
.status-completed  { color: #8C8C8C; }
.status-failed     { color: #CF1322; }
.status-closed     { color: #8C8C8C; }
.status-serving    { color: #096DD9; }

/* ===== 价格组合 ===== */
.price-group {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}
.price-symbol  { font-size: 22rpx; font-weight: 600; }
.price-integer { font-size: 40rpx; font-weight: 700; }

/* ===== 品牌渐变 ===== */
.brand-gradient {
  background: linear-gradient(135deg, #C0322A 0%, #9B1E14 100%);
}

.text-primary { color: var(--color-primary); }

.card-dark {
  background: #FFFFFF;
  border-top: 4rpx solid #C0322A;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  color: #1A1A1A;
}

/* ===== 角色标签 ===== */
.role-manager   { color: #C0322A; }
.role-beautician { color: #3D8A5A; }

/* ===== 三态容器（§3.3） ===== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

/* ===== 卡片布局（§3.5） ===== */
.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* ===== 底部固定栏 + safe-area（§3.4） ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-border);
  z-index: 100;
}

.bottom-placeholder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 操作按钮容器 ===== */
.action-bar {
  padding: 32rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
}

/* ===== 管理层视图：顶部筛选行（5 页统一：左 时间/period chip，右 scope tag） ===== */
.mgmt-filter-bar {
  display: flex;
  align-items: center;
  gap: var(--spacing-tight);
  padding: var(--spacing-tight) var(--spacing-page);
  background: var(--color-bg-page);
}

.mgmt-filter-bar--sticky {
  position: sticky;
  top: 0;
  z-index: 10;
}

.mgmt-scope-tag {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: auto;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 6rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--color-border);
  max-width: 280rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mgmt-scope-tag .mgmt-scope-tag-value {
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== 详情页状态条 ===== */
.status-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.status-banner--pending   { background: var(--color-badge-pending);   color: #D4820A; }
.status-banner--success   { background: var(--color-badge-confirmed); color: #3D8A5A; }
.status-banner--progress  { background: var(--color-badge-progress);  color: #5E8BB3; }
.status-banner--done      { background: var(--color-badge-done);      color: #888888; }
.status-banner--cancelled { background: var(--color-badge-error);     color: #D94040; }
.status-banner--error     { background: var(--color-badge-error);     color: #D94040; }

/* ===== van-cell-group 卡片包装 ===== */
.card-group {
  margin: 24rpx 0;
}

/* ===== FAB 浮动按钮（§4.4） ===== */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C0322A 0%, #9B1E14 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(192, 50, 42, 0.45);
}

/* ===== 列表容器 ===== */
.list-wrap {
  padding: 24rpx 32rpx;
}

/* ===== van-cell 左侧图标 ===== */
.cell-icon {
  margin-right: 12rpx;
}

/* ===== 品牌按钮（替代 custom-style 硬编码色值） ===== */
.btn-primary-brand {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
  color: #FFFFFF !important;
}

.btn-outline-brand {
  color: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
}

.btn-success {
  background: var(--color-success) !important;
  border-color: var(--color-success) !important;
  color: #FFFFFF !important;
}
