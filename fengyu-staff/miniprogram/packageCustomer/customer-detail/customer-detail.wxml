<!-- packageCustomer/customer-detail/customer-detail.wxml — 8-Tab 顾客详情 -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{!customer}}" class="empty-wrap">
    <van-empty description="顾客不存在" />
  </view>

  <block wx:else>
    <!-- 头部信息卡 -->
    <view class="profile-card">
      <view class="profile-header">
        <view class="profile-avatar">
          <van-icon name="manager" size="64rpx" color="#C0322A" />
        </view>
        <view class="profile-main">
          <view class="profile-name-row">
            <text class="profile-name">{{customer.name || '—'}}</text>
            <view wx:if="{{customer.memberLevel}}" class="vip-badge">{{customer.memberLevel}}</view>
          </view>
          <text class="profile-phone">{{isManager ? customer.phone : customer.phoneMasked}}</text>
        </view>
      </view>
      <view class="profile-stats">
        <view class="stat-item">
          <text class="stat-label">累计消费</text>
          <text class="stat-value">¥{{customer.totalConsumption}}</text>
        </view>
        <view class="stat-divider" />
        <view class="stat-item">
          <text class="stat-label">本年消费</text>
          <text class="stat-value">¥{{customer.yearConsumption}}</text>
        </view>
      </view>
      <view wx:if="{{customer.legacyOrderCount > 0}}" class="legacy-orders-badge">
        <van-icon name="warning-o" size="32rpx" color="#D4820A" />
        <text class="legacy-orders-text">
          历史订单 {{customer.legacyOrderCount}} 条待核对（请到管理后台核对）
        </text>
      </view>
    </view>

    <!-- 8-Tab 导航：7 核心（与 admin 一致）+ 日历（员工端特有） -->
    <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#C0322A" scrollable ellipsis="{{false}}" line-width="40rpx">
      <van-tab title="基本档案">
        <view class="tab-content">
          <van-cell-group class="card-group">
            <van-cell title="客户姓名" value="{{customer.name || '—'}}" />
            <van-cell wx:if="{{customer.gender}}" title="客户性别" value="{{customer.gender}}" />
            <van-cell title="手机号" value="{{isManager ? customer.phone : customer.phoneMasked}}" />
            <van-cell wx:if="{{customer.storeName}}" title="注册门店" value="{{customer.storeName}}" />
            <van-cell wx:if="{{customer.preferredStaffName}}" title="指定美容师" value="{{customer.preferredStaffName}}" />
            <van-cell wx:if="{{customer.topProductName}}" title="常购商品" value="{{customer.topProductName}}" />
            <van-cell wx:if="{{customer.lastServiceDate}}" title="上次到店" value="{{customer.lastServiceDate}}" />
            <van-cell wx:if="{{customer.visitFrequency}}" title="到店频率" value="{{customer.visitFrequency}}" />
            <van-cell title="消费金额" value="¥{{customer.totalConsumption}}" />
            <!-- Wave 3G — 储值卡余额（跨店统一） -->
            <van-cell wx:if="{{cardBalanceLoaded}}" title="储值卡余额" value="¥{{cardBalance}}" />
            <van-cell wx:if="{{customer.skinType}}" title="肤质" value="{{customer.skinType}}" />
            <van-cell wx:if="{{customer.focusAreas}}" title="改善重点" value="{{customer.focusAreas}}" />
            <van-field
              label="备注"
              type="textarea"
              placeholder="请输入备注内容"
              autosize="{{ {minHeight: 60} }}"
              value="{{notesValue}}"
              bind:change="onNotesChange"
              border="{{false}}"
            />
            <view wx:if="{{notesDirty}}" class="notes-save-wrap">
              <van-button size="small" type="primary" loading="{{notesSaving}}" bindtap="onSaveNotes">保存备注</van-button>
            </view>
          </van-cell-group>
        </view>
      </van-tab>

      <van-tab title="消费记录">
        <view class="tab-content">
          <view wx:if="{{!purchaseLoaded}}" class="loading-wrap">
            <van-loading type="spinner" color="#C0322A" />
          </view>
          <van-empty wx:elif="{{purchaseOrders.length === 0}}" description="暂无消费记录" />
          <view wx:else>
            <view class="purchase-card" wx:for="{{purchaseOrders}}" wx:key="saleOrderId">
              <view class="purchase-header">
                <text class="purchase-order-no">{{item.saleOrderId}}</text>
                <text class="status-tag status-tag--{{item.statusClass}}">{{item.status}}</text>
              </view>
              <view class="purchase-meta">
                <text class="purchase-store" wx:if="{{item.storeName}}">{{item.storeName}}</text>
                <text class="purchase-amount">{{item.amountText}}</text>
              </view>
              <view class="purchase-items">
                <view wx:for="{{item.items}}" wx:for-item="si" wx:key="saleItemId" class="purchase-item-row">
                  <text class="purchase-item-name">{{si.itemName}}</text>
                </view>
              </view>
              <view wx:if="{{item.remark}}" class="purchase-remark">
                <text class="purchase-remark-label">备注</text>
                <text class="purchase-remark-text">{{item.remark}}</text>
              </view>
              <view class="purchase-footer" bindtap="onPurchaseOrderTap" data-id="{{item.saleOrderId}}">
                <text class="purchase-time">{{item.timeText}}</text>
                <text class="purchase-link">查看详情 ›</text>
              </view>
            </view>
          </view>
        </view>
      </van-tab>

      <van-tab title="疗程卡">
        <view class="tab-content">
          <view class="tab-hint">仅显示顾客在本店购买的卡（跨店卡需在购买门店使用）</view>
          <view wx:if="{{!cardsLoaded}}" class="loading-wrap">
            <van-loading type="spinner" color="#C0322A" />
          </view>
          <van-empty wx:elif="{{treatmentCards.length === 0}}" description="顾客在本店暂无可核销疗程" />
          <view wx:else class="card-list">
            <view
              wx:for="{{treatmentCards}}" wx:key="saleItemId"
              class="treatment-card {{item.selected ? 'treatment-card--selected' : ''}} {{item.disabled ? 'treatment-card--disabled' : ''}}"
              bindtap="onToggleCard" data-index="{{index}}"
            >
              <view class="tc-row">
                <van-icon
                  wx:if="{{item.disabled}}"
                  name="close"
                  size="40rpx"
                  color="#CCCCCC"
                  custom-class="tc-checkbox"
                />
                <van-checkbox
                  wx:else
                  value="{{item.selected}}" shape="square" checked-color="#C0322A" custom-class="tc-checkbox"
                />
                <view class="tc-info">
                  <view class="tc-tags" wx:if="{{item.category || item.saleOrderTypeLabel}}">
                    <van-tag wx:if="{{item.category}}" color="{{item.categoryColor || '#C0322A'}}" text-color="#FFFFFF">{{item.category}}</van-tag>
                    <van-tag wx:if="{{item.saleOrderTypeLabel}}" plain color="#969799">{{item.saleOrderTypeLabel}}</van-tag>
                  </view>
                  <text class="tc-name">{{item.itemName}}</text>
                  <view class="tc-meta">
                    <text class="tc-order">{{item.saleOrderId}}</text>
                  </view>
                  <text class="tc-sessions">剩余 {{item.paidUnusedSessions}} / 已付 {{item.paidSessions == null ? '—' : item.paidSessions}} / 共 {{item.totalSessions}} 次{{item.unitRealPrice ? ' · 单次实付 ¥' + item.unitRealPrice : ''}}{{item.disabledReason ? ' · ' + item.disabledReason : ''}}</text>
                  <view class="session-bar">
                    <view class="session-bar__seg session-bar__seg--used" style="width:{{item.usedPct}}%"></view>
                    <view class="session-bar__seg session-bar__seg--paid-unused" style="width:{{item.paidUnusedPct}}%"></view>
                    <view class="session-bar__seg session-bar__seg--unpaid" style="width:{{item.unpaidPct}}%"></view>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.selected}}" class="tc-stepper-row" catchtap="preventBubble">
                <text class="tc-stepper-label">本次核销</text>
                <van-stepper
                  value="{{item.sessionCount}}" min="{{1}}" max="{{item.consumableSessions}}"
                  input-width="60rpx" button-size="48rpx"
                  bind:change="onStepperChange" data-index="{{index}}"
                />
                <text class="tc-stepper-unit">次</text>
              </view>
            </view>
          </view>
          <view wx:if="{{selectedCount > 0}}" class="bottom-bar-spacer" />
        </view>
      </van-tab>

      <van-tab title="预约记录">
        <view class="tab-content">
          <view wx:if="{{!appointmentsLoaded}}" class="loading-wrap">
            <van-loading type="spinner" color="#C0322A" />
          </view>
          <van-empty wx:elif="{{appointmentRecords.length === 0}}" description="暂无预约记录" />
          <view wx:else>
            <view class="appt-card" wx:for="{{appointmentRecords}}" wx:key="id">
              <view class="appt-header">
                <text class="appt-service">{{item.serviceItemName}}</text>
                <text class="status-tag status-tag--{{item.statusClass}}">{{item.statusText}}</text>
              </view>
              <view class="appt-meta">
                <text class="appt-time">{{item.appointmentTime}}</text>
                <text wx:if="{{item.staffName}}" class="appt-staff">美容师：{{item.staffName}}</text>
              </view>
              <view wx:if="{{item.remark}}" class="appt-remark">备注：{{item.remark}}</view>
            </view>
          </view>
        </view>
      </van-tab>

      <van-tab title="服务记录">
        <view class="tab-content">
          <view wx:if="{{!serviceLoaded}}" class="loading-wrap">
            <van-loading type="spinner" color="#C0322A" />
          </view>
          <van-empty wx:elif="{{serviceRecords.length === 0}}" description="暂无服务记录" />
          <view wx:else>
            <view class="refund-card" wx:for="{{serviceRecords}}" wx:key="serviceOrderId"
                  bindtap="onServiceOrderTap" data-id="{{item.serviceOrderId}}">
              <view class="refund-card-header">
                <text class="refund-order-no">{{item.serviceOrderId}}</text>
                <text class="status-tag status-tag--{{item.statusClass}}">{{item.status}}</text>
              </view>
              <view wx:if="{{item.items.length}}" class="refund-items">
                <view wx:for="{{item.items}}" wx:for-item="si" wx:for-index="sidx" wx:key="sidx" class="refund-item-row">
                  <text class="refund-item-name">{{si.itemName}}</text>
                </view>
              </view>
              <view class="appt-meta">
                <text wx:if="{{item.storeName}}" class="appt-time">{{item.storeName}}</text>
                <text wx:if="{{item.staffName}}" class="appt-staff">美容师：{{item.staffName}}</text>
              </view>
              <view class="refund-card-footer">
                <text class="refund-card-time">{{item.serviceTime}}</text>
                <text class="purchase-link">查看详情 ›</text>
              </view>
            </view>
          </view>
        </view>
      </van-tab>

      <van-tab title="顾客优惠券">
        <view class="tab-content">
          <!-- 状态筛选按钮组（客户端过滤，切状态不重新请求） -->
          <view class="filter-chips">
            <view
              wx:for="{{couponStatusOptions}}"
              wx:key="value"
              class="filter-chip {{couponStatus === item.value ? 'filter-chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="onCouponStatusTap"
            >{{item.label}}</view>
          </view>
          <view wx:if="{{!couponsLoaded}}" class="loading-wrap">
            <van-loading type="spinner" color="#C0322A" />
          </view>
          <van-empty wx:elif="{{filteredCoupons.length === 0}}" description="暂无优惠券" />
          <view wx:else class="coupon-list">
            <view
              wx:for="{{filteredCoupons}}"
              wx:key="couponId"
              class="coupon-card {{item.status !== '未使用' ? 'coupon-card--disabled' : ''}}"
            >
              <view class="coupon-card__left">
                <text class="coupon-card__amount">{{item.discountLabel}}</text>
                <text class="coupon-card__type">{{item.couponType}}</text>
              </view>
              <view class="coupon-card__right">
                <text class="coupon-card__name">{{item.name}}</text>
                <text class="coupon-card__scope" wx:if="{{item.applicableStoreNamesText}}">
                  限：{{item.applicableStoreNamesText}}
                </text>
                <text class="coupon-card__scope" wx:else>全部门店可用</text>
                <text class="coupon-card__expire">
                  <block wx:if="{{item.status === '已使用'}}">已于 {{item.usedAtFmt || '—'}} 使用</block>
                  <block wx:else>有效期至 {{item.expireAtFmt || '—'}}</block>
                </text>
                <text class="coupon-card__desc" wx:if="{{item.description}}">{{item.description}}</text>
                <text class="coupon-card__hint" wx:if="{{item.minSpendHint}}">{{item.minSpendHint}}</text>
              </view>
              <view class="coupon-card__stamp" wx:if="{{item.status === '已使用'}}">已使用</view>
              <view class="coupon-card__stamp coupon-card__stamp--expired" wx:elif="{{item.status === '已过期'}}">已过期</view>
            </view>
          </view>
        </view>
      </van-tab>

      <van-tab title="手机号变更">
        <view class="tab-content">
          <view wx:if="{{!phoneLoaded}}" class="loading-wrap">
            <van-loading type="spinner" color="#C0322A" />
          </view>
          <van-empty wx:elif="{{phoneChangeRecords.length === 0}}" description="暂无手机号变更记录" />
          <view wx:else>
            <view class="phone-log-card" wx:for="{{phoneChangeRecords}}" wx:key="id">
              <view class="phone-log-row">
                <text class="phone-log-phone">{{item.oldPhone || '—'}}</text>
                <van-icon name="arrow" size="28rpx" color="#999" />
                <text class="phone-log-phone phone-log-new">{{item.newPhone || '—'}}</text>
              </view>
              <view class="phone-log-meta">
                <text class="phone-log-source">{{item.sourceText}}</text>
                <text class="phone-log-time">{{item.createdAt}}</text>
              </view>
              <text wx:if="{{item.operatorLabel}}" class="phone-log-op">操作人：{{item.operatorLabel}}</text>
            </view>
          </view>
        </view>
      </van-tab>

      <van-tab title="日历">
        <view class="tab-content">
          <!-- 月份导航 -->
          <view class="calendar-nav">
            <van-icon name="arrow-left" size="40rpx" bindtap="onCalendarPrev" />
            <text class="calendar-month-label">{{calendarYear}}年{{calendarMonth}}月</text>
            <van-icon name="arrow" size="40rpx" bindtap="onCalendarNext" />
          </view>
          <!-- 星期头 -->
          <view class="calendar-week-header">
            <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="calendar-week-cell">{{item}}</text>
          </view>
          <!-- 日历网格 -->
          <view class="calendar-grid">
            <view
              wx:for="{{calendarDays}}" wx:key="index"
              class="calendar-cell {{item.hasData ? 'calendar-cell--has-data' : ''}} {{item.date === selectedDate ? 'calendar-cell--selected' : ''}}"
              bindtap="onCalendarDateTap"
              data-date="{{item.date}}"
            >
              <text wx:if="{{item.day > 0}}" class="calendar-day">{{item.day}}</text>
              <text wx:if="{{item.hasData}}" class="calendar-amount">{{item.amountLabel}}</text>
            </view>
          </view>
          <!-- 选中日期的订单列表 -->
          <view wx:if="{{selectedDate}}" class="calendar-orders">
            <text class="calendar-orders-title">{{selectedDate}} 消费记录</text>
            <view wx:for="{{calendarOrders}}" wx:key="saleOrderId">
              <van-cell
                wx:if="{{item.payDate === selectedDate}}"
                title="{{item.saleOrderId}}"
                value="¥{{item.totalReceived}}"
                label="{{item.orderType}}"
                is-link
                data-id="{{item.saleOrderId}}"
                bindtap="onOrderTap"
              />
            </view>
          </view>
        </view>
      </van-tab>

    </van-tabs>
  </block>

  <view class="safe-area-bottom" />
</view>

<!-- 底部操作栏（持卡汇总选中时） -->
<view wx:if="{{selectedCount > 0}}" class="bottom-action-bar">
  <van-button
    type="primary" block
    custom-class="btn-primary-brand"
    custom-style="border-radius:48rpx;"
    bind:click="onCreateService"
  >创建服务单 ({{selectedCount}})</van-button>
  <view class="safe-area-bottom" />
</view>
