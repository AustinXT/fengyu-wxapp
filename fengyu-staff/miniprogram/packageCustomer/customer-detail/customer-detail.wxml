<!-- pages/customer-detail/customer-detail.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{!customer}}" class="empty-wrap">
    <van-empty description="顾客不存在" />
  </view>

  <block wx:else>
    <!-- 基本信息卡片 -->
    <view class="profile-card">
      <view class="profile-header">
        <view class="profile-avatar">
          <van-icon name="manager" size="64rpx" color="#C0322A" />
        </view>
        <view class="profile-main">
          <view class="profile-name-row">
            <text class="profile-name">{{customer.name}}</text>
            <view wx:if="{{customer.memberLevel === 'VIP'}}" class="vip-badge">VIP</view>
          </view>
          <text class="profile-phone">{{isManager ? customer.phone : customer.phoneMasked}}</text>
        </view>
      </view>
      <view class="profile-stats">
        <view class="stat-item">
          <text class="stat-label">累计消费</text>
          <text class="stat-value">¥{{customer.totalConsumption}}</text>
        </view>
        <view class="stat-divider" />
        <view class="stat-item">
          <text class="stat-label">本年消费</text>
          <text class="stat-value">¥{{customer.yearConsumption}}</text>
        </view>
      </view>
    </view>

    <!-- 客户档案详情 -->
    <van-cell-group title="客户信息" class="card-group">
      <van-cell wx:if="{{customer.preferredStaffName}}" title="指定美容师" value="{{customer.preferredStaffName}}" />
      <van-cell wx:if="{{customer.skinType}}" title="肤质" value="{{customer.skinType}}" />
      <van-cell wx:if="{{customer.focusAreas}}" title="改善重点" value="{{customer.focusAreas}}" />
    </van-cell-group>

    <!-- 疗程卡余量 -->
    <view class="section-header">
      <text class="section-title">疗程卡余量</text>
      <text wx:if="{{selectedCount > 0}}" class="section-hint">已选 {{selectedCount}} 项</text>
    </view>

    <view wx:if="{{treatmentCards.length === 0}}" class="empty-tip">
      <text class="empty-tip-text">暂无可核销疗程</text>
    </view>

    <view wx:else class="card-list">
      <view
        wx:for="{{treatmentCards}}"
        wx:key="itemFlowNo"
        class="treatment-card {{item.selected ? 'treatment-card--selected' : ''}}"
        bindtap="onToggleCard"
        data-index="{{index}}"
      >
        <view class="tc-row">
          <van-checkbox
            value="{{item.selected}}"
            shape="square"
            checked-color="#C0322A"
            custom-class="tc-checkbox"
          />
          <view class="tc-info">
            <text class="tc-name">{{item.itemName}}</text>
            <view class="tc-meta">
              <text class="tc-spec">{{item.spec}}</text>
              <text class="tc-order">{{item.orderNo}}</text>
            </view>
            <text class="tc-sessions">剩余 {{item.remainingSessions}}/{{item.totalSessions}} 次</text>
          </view>
        </view>
        <view wx:if="{{item.selected}}" class="tc-stepper-row" catchtap="preventBubble">
          <text class="tc-stepper-label">本次核销</text>
          <van-stepper
            value="{{item.sessionCount}}"
            min="{{1}}"
            max="{{item.remainingSessions}}"
            input-width="60rpx"
            button-size="48rpx"
            bind:change="onStepperChange"
            data-index="{{index}}"
          />
          <text class="tc-stepper-unit">次</text>
        </view>
      </view>
    </view>

    <!-- 底部占位 -->
    <view wx:if="{{selectedCount > 0}}" class="bottom-bar-spacer" />
  </block>

  <view class="safe-area-bottom" />
</view>

<!-- 底部操作栏 -->
<view wx:if="{{selectedCount > 0}}" class="bottom-action-bar">
  <van-button
    type="primary"
    block
    custom-style="background:#C0322A;border-color:#C0322A;border-radius:48rpx;"
    bind:click="onCreateService"
  >创建护理单 ({{selectedCount}})</van-button>
  <view class="safe-area-bottom" />
</view>
