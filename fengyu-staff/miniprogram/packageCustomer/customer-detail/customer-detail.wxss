/* packageCustomer/customer-detail/customer-detail.wxss */

/* 头部信息卡 */
.profile-card {
  background: #FFFFFF;
  color: var(--color-text-primary);
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 3rpx solid var(--color-primary);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #FFF0EE;
  border: 2rpx solid rgba(192, 50, 42, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.profile-name { font-size: 40rpx; font-weight: 700; color: var(--color-text-primary); }
.vip-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: #FFF0EE;
  color: var(--color-primary);
  border: 1rpx solid rgba(192, 50, 42, 0.3);
}
.profile-phone { font-size: 26rpx; color: var(--color-text-secondary); }

.profile-stats {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 20rpx;
}
.stat-item { flex: 1; text-align: center; }
.stat-label { display: block; font-size: 22rpx; color: var(--color-text-hint); margin-bottom: 4rpx; }
.stat-value { font-size: 32rpx; font-weight: 700; color: var(--color-primary); }
.stat-divider { width: 1rpx; height: 48rpx; background: #E8E8E8; }

/* 历史订单待核对徽章（WorkFine 导入的 status='未审核' 订单） */
.legacy-orders-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E6;
  border: 1rpx solid #F0D89B;
  border-radius: 12rpx;
}
.legacy-orders-text {
  flex: 1;
  font-size: 24rpx;
  color: #8A5800;
  line-height: 1.4;
}

/* Tab 内容区 */
.tab-content {
  padding: 16rpx 0;
  min-height: 400rpx;
}

/* Tab 下方提示文案（例如"仅本店卡"说明） */
.tab-hint {
  padding: 8rpx 32rpx 16rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* ===== 日历样式 ===== */
.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 0 24rpx;
}
.calendar-month-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.calendar-week-header {
  display: flex;
  padding: 0 16rpx;
}
.calendar-week-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-hint);
  padding: 8rpx 0;
}
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}
.calendar-cell {
  width: 14.2857%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.calendar-day {
  font-size: 26rpx;
  color: var(--color-text-primary);
}
.calendar-amount {
  font-size: 18rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-top: 2rpx;
}
.calendar-cell--has-data .calendar-day {
  color: var(--color-primary);
  font-weight: 600;
}
.calendar-cell--selected {
  background: #FFF0EE;
  border-radius: 8rpx;
}

.calendar-orders {
  padding: 16rpx 24rpx;
}
.calendar-orders-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 12rpx;
}

/* ===== 购买记录 ===== */
.purchase-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.purchase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.purchase-order-no {
  font-size: 24rpx;
  color: var(--color-text-hint);
  font-family: monospace;
}
.purchase-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.purchase-store {
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.purchase-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.purchase-items {
  margin-bottom: 12rpx;
}
.purchase-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}
.purchase-item-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
}
.purchase-item-spec {
  font-size: 22rpx;
  color: var(--color-text-hint);
  background: #F5F2EE;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.purchase-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0EDE9;
}
.purchase-time {
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.purchase-link {
  font-size: 24rpx;
  color: var(--color-primary);
}
.purchase-remark {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 8rpx 12rpx;
  background: #F5F2EE;
  border-radius: 8rpx;
}
.purchase-remark-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
  flex-shrink: 0;
  line-height: 1.6;
}
.purchase-remark-text {
  font-size: 24rpx;
  color: var(--color-text-primary);
  word-break: break-all;
  line-height: 1.6;
}

/* ===== 持卡汇总（复用原有疗程卡样式） ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.section-hint {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.card-list { padding: 0 24rpx 24rpx; }

.treatment-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s, background-color 0.2s;
}
.treatment-card--selected {
  border-color: var(--color-primary);
  background: #FFF0EE;
}

/* NULL 历史卡：灰显不可核销（参考 appointment-create .item-disabled） */
.treatment-card--disabled {
  opacity: 0.45;
}

.treatment-card--disabled .tc-name,
.treatment-card--disabled .tc-meta,
.treatment-card--disabled .tc-sessions {
  color: var(--color-text-hint) !important;
}

.tc-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.tc-checkbox { flex-shrink: 0; margin-top: 4rpx; }
.tc-info { flex: 1; min-width: 0; }
.tc-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.tc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  display: block;
}
.tc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.tc-spec {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: #F5F5F5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.tc-order {
  font-size: 20rpx;
  color: var(--color-text-hint);
  font-family: monospace;
}
.tc-sessions {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* 疗程卡三段进度条（已用 / 已付未用 / 未付）— 与 client treatment-cards 同款三段模型 */
.session-bar {
  display: flex;
  height: 8rpx;
  width: 100%;
  margin-top: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #EFEFEF;
}
.session-bar__seg { height: 100%; }
.session-bar__seg--used { background: #DDD; }
.session-bar__seg--paid-unused { background: #C0322A; }
.session-bar__seg--unpaid { background: #F2B6B0; }

.tc-stepper-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EDE9;
}
.tc-stepper-label { font-size: 24rpx; color: var(--color-text-secondary); }
.tc-stepper-unit { font-size: 24rpx; color: var(--color-text-secondary); }

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.bottom-bar-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 退换记录 ===== */
.refund-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.refund-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.refund-order-no {
  font-size: 22rpx;
  color: var(--color-text-hint);
  font-family: monospace;
  flex: 1;
}

.refund-type-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.refund-type--refund {
  background: #FFEBEE;
  color: #D94040;
}

.refund-type--convert {
  background: #E3F0FF;
  color: #5E8BB3;
}

.refund-reason {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.refund-reason-label {
  color: var(--color-text-hint);
}

.refund-items {
  margin-bottom: 8rpx;
}

.refund-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0;
}

.refund-item-direction {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.direction--out {
  background: #FFEBEE;
  color: #D94040;
}

.direction--in {
  background: #E8F5E9;
  color: #3D8A5A;
}

.refund-item-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
  flex: 1;
}

.refund-item-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.refund-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
  border-top: 1rpx solid #F0EDE9;
}

.refund-card-time {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.refund-total {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.refund-link {
  text-align: right;
  padding-top: 8rpx;
}

/* ===== 备注编辑 ===== */
.notes-save-wrap {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 32rpx 16rpx;
}

/* ===== 预约记录 ===== */
.appt-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.appt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.appt-service {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
}

.appt-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.appt-time {
  color: var(--color-text-secondary);
}

.appt-staff {
  color: var(--color-text-hint);
}

.appt-remark {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* ===== 手机号变更 ===== */
.phone-log-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.phone-log-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.phone-log-phone {
  font-size: 28rpx;
  font-family: monospace;
  color: var(--color-text-secondary);
}

.phone-log-new {
  color: var(--color-primary);
  font-weight: 600;
}

.phone-log-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.phone-log-op {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}
