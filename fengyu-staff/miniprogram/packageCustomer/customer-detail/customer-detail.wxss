/* pages/customer-detail/customer-detail.wxss */


/* 头部信息卡 */
.profile-card {
  background: #FFFFFF;
  color: #1A1A1A;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 3rpx solid #C0322A;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #FFF0EE;
  border: 2rpx solid rgba(192, 50, 42, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.profile-name { font-size: 40rpx; font-weight: 700; color: #1A1A1A; }
.vip-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: #FFF0EE;
  color: #C0322A;
  border: 1rpx solid rgba(192, 50, 42, 0.3);
}
.profile-phone { font-size: 26rpx; color: #666666; }

.profile-stats {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 20rpx;
}
.stat-item { flex: 1; text-align: center; }
.stat-label { display: block; font-size: 22rpx; color: #999999; margin-bottom: 4rpx; }
.stat-value { font-size: 32rpx; font-weight: 700; color: #C0322A; }
.stat-divider { width: 1rpx; height: 48rpx; background: #E8E8E8; }


/* 疗程卡区块 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.section-hint {
  font-size: 24rpx;
  color: #C0322A;
  font-weight: 500;
}

.empty-tip { padding: 24rpx 32rpx; }
.empty-tip-text { font-size: 26rpx; color: #999; }

.card-list { padding: 0 24rpx 24rpx; }

/* 疗程卡片 */
.treatment-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s, background-color 0.2s;
}
.treatment-card--selected {
  border-color: #C0322A;
  background: #FFF0EE;
}

.tc-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.tc-checkbox { flex-shrink: 0; margin-top: 4rpx; }
.tc-info { flex: 1; min-width: 0; }
.tc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  display: block;
}
.tc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.tc-spec {
  font-size: 22rpx;
  color: #666;
  background: #F5F5F5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.tc-order {
  font-size: 20rpx;
  color: #999;
  font-family: monospace;
}
.tc-sessions {
  font-size: 22rpx;
  color: #C0322A;
  font-weight: 600;
}

/* stepper 行 */
.tc-stepper-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EDE9;
}
.tc-stepper-label {
  font-size: 24rpx;
  color: #666;
}
.tc-stepper-unit {
  font-size: 24rpx;
  color: #666;
}

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.bottom-bar-spacer {
  height: 140rpx;
}
