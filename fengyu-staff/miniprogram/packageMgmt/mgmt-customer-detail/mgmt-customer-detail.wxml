<!-- packageMgmt/mgmt-customer-detail — 管理层 6-Tab 顾客详情（只读） -->
<view class="container">

  <!-- 顶部筛选行：仅市场范围 tag（顾客详情无时间维度） -->
  <view class="mgmt-filter-bar">
    <view class="mgmt-scope-tag">
      <text>范围：</text>
      <text class="mgmt-scope-tag-value">{{scopeName || (scopeType === 'all' ? '全部市场' : '')}}{{scopeInactive ? '（已停用）' : ''}}</text>
    </view>
  </view>

  <!-- 顶层三态壳：loading / error / empty / content -->
  <mgmt-data-state
    state="{{ loading ? 'loading' : (customerError ? 'error' : (!customer ? 'empty' : 'content')) }}"
    empty-text="顾客不存在"
    bind:retry="onCustomerRetry"
  >
    <view wx:if="{{customer}}">
      <!-- 头部信息卡 -->
      <view class="profile-card">
        <view class="profile-header">
          <view class="profile-avatar">
            <van-icon name="manager" size="64rpx" color="#C0322A" />
          </view>
          <view class="profile-main">
            <view class="profile-name-row">
              <text class="profile-name">{{customer.name}}</text>
              <view wx:if="{{customer.memberLevel}}" class="member-level-badge {{customer.memberLevelBadgeClass}}">{{customer.memberLevel}}</view>
            </view>
            <text class="profile-phone">{{customer.phone}}</text>
          </view>
        </view>
        <view class="profile-stats">
          <view class="profile-stats-row">
            <view class="stat-item">
              <text class="stat-label">累计消费</text>
              <text class="stat-value">¥{{customer.totalConsumption}}</text>
            </view>
            <view class="stat-divider" />
            <view class="stat-item">
              <text class="stat-label">本年消费</text>
              <text class="stat-value">¥{{customer.yearConsumption}}</text>
            </view>
          </view>
          <view class="profile-stats-row">
            <view class="stat-item">
              <text class="stat-label">累计实耗</text>
              <text class="stat-value">¥{{customer.totalActualConsumption}}</text>
            </view>
            <view class="stat-divider" />
            <view class="stat-item">
              <text class="stat-label">本年实耗</text>
              <text class="stat-value">¥{{customer.yearActualConsumption}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 6-Tab 导航（sticky 吸顶） -->
      <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#C0322A" sticky scrollable line-width="40rpx">
        <van-tab title="详情">
          <view class="tab-content">
            <van-cell-group class="card-group">
              <van-cell title="客户姓名" value="{{customer.name || '—'}}" />
              <van-cell wx:if="{{customer.gender}}" title="客户性别" value="{{customer.gender}}" />
              <van-cell title="手机号" value="{{customer.phone}}" />
              <van-cell wx:if="{{customer.storeName}}" title="注册门店" value="{{customer.storeName}}" />
              <van-cell wx:if="{{customer.preferredStaffName}}" title="指定美容师" value="{{customer.preferredStaffName}}" />
              <van-cell title="员工推荐人" value="{{customer.promoterEmployeeName || '—'}}" />
              <van-cell title="顾客推荐人" value="{{customer.inviterName || customer.inviterPhone || '—'}}" />
              <van-cell title="推荐时间" value="{{customer.invitedAt || '—'}}" />
              <van-cell title="顾客来源" value="{{customer.customerSource || '—'}}" />
              <van-cell title="顾客类型" value="{{customer.customerType || '—'}}" />
              <van-cell title="会员等级" value="{{customer.memberLevel || '—'}}" />
              <van-cell title="消费档位" value="{{customer.spendingTier || '—'}}" />
              <van-cell title="月度客活" value="{{customer.monthlyActivity || '—'}}" />
              <van-cell title="到店状态" value="{{customer.customerStatus || '—'}}" />
              <van-cell title="生日" value="{{customer.birthday || '—'}}" />
              <van-cell title="职业" value="{{customer.occupation || '—'}}" />
              <van-cell title="婚姻状况" value="{{customer.isMarried === true ? '已婚' : (customer.isMarried === false ? '未婚' : '—')}}" />
              <van-cell title="微信昵称" value="{{customer.wechatName || '—'}}" />
              <van-cell wx:if="{{customer.topProductName}}" title="常购商品" value="{{customer.topProductName}}" />
              <van-cell wx:if="{{customer.lastServiceDate}}" title="上次到店" value="{{customer.lastServiceDate}}" />
              <van-cell wx:if="{{customer.visitFrequency}}" title="到店频率" value="{{customer.visitFrequency}}" />
              <van-cell title="消费金额" value="¥{{customer.totalConsumption}}" />
              <van-cell wx:if="{{customer.skinType}}" title="肤质" value="{{customer.skinType}}" />
              <van-cell wx:if="{{customer.focusAreas}}" title="改善重点" value="{{customer.focusAreas}}" />
              <van-cell title="肌肤问题" value="{{customer.skinIssue || '—'}}" />
              <van-cell title="养生偏好" value="{{customer.wellnessPreference || '—'}}" />
              <van-cell title="积分余额" value="{{customer.pointsBalance}}" />
              <van-cell wx:if="{{customer.notes}}" title="备注" value="{{customer.notes}}" />
            </van-cell-group>
          </view>
        </van-tab>

        <van-tab title="日历">
          <view class="tab-content">
            <!-- 月份导航 -->
            <view class="calendar-nav">
              <van-icon name="arrow-left" size="40rpx" bindtap="onCalendarPrev" />
              <text class="calendar-month-label">{{calendarYear}}年{{calendarMonth}}月</text>
              <van-icon name="arrow" size="40rpx" bindtap="onCalendarNext" />
            </view>
            <!-- 星期头 -->
            <view class="calendar-week-header">
              <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="calendar-week-cell">{{item}}</text>
            </view>
            <!-- 日历网格 -->
            <view class="calendar-grid">
              <view
                wx:for="{{calendarDays}}" wx:key="index"
                class="calendar-cell {{item.hasData ? 'calendar-cell--has-data' : ''}} {{item.date === selectedDate ? 'calendar-cell--selected' : ''}}"
                bindtap="onCalendarDateTap"
                data-date="{{item.date}}"
              >
                <text wx:if="{{item.day > 0}}" class="calendar-day">{{item.day}}</text>
                <text wx:if="{{item.hasData}}" class="calendar-amount">{{item.amountLabel}}</text>
              </view>
            </view>
            <!-- 选中日期的订单列表 -->
            <view wx:if="{{selectedDate}}" class="calendar-orders">
              <text class="calendar-orders-title">{{selectedDate}} 消费记录</text>
              <view wx:for="{{calendarOrders}}" wx:key="saleOrderId">
                <van-cell
                  wx:if="{{item.payDate === selectedDate}}"
                  title="{{item.saleOrderId}}"
                  value="¥{{item.totalReceived}}"
                  label="{{item.orderType}}"
                  is-link
                  data-id="{{item.saleOrderId}}"
                  bindtap="onOrderTap"
                />
              </view>
            </view>
          </view>
        </van-tab>

        <van-tab title="购买记录">
          <view class="tab-content">
            <view wx:if="{{!purchaseLoaded}}" class="loading-wrap">
              <van-loading type="spinner" color="#C0322A" />
            </view>
            <van-empty wx:elif="{{purchaseOrders.length === 0}}" description="暂无购买记录" />
            <view wx:else>
              <view class="purchase-card" wx:for="{{purchaseOrders}}" wx:key="saleOrderId">
                <view class="purchase-header">
                  <text class="purchase-order-no">{{item.saleOrderId}}</text>
                  <text class="status-tag status-tag--{{item.statusClass}}">{{item.status}}</text>
                </view>
                <view class="purchase-meta">
                  <text class="purchase-store" wx:if="{{item.storeName}}">{{item.storeName}}</text>
                  <text class="purchase-amount">{{item.amountText}}</text>
                </view>
                <view class="purchase-items">
                  <view wx:for="{{item.items}}" wx:for-item="si" wx:for-index="siIndex" wx:key="saleItemId" wx:if="{{siIndex < 3}}" class="purchase-item-row">
                    <text class="purchase-item-name">{{si.itemName}}</text>
                  </view>
                </view>
                <view class="purchase-footer" bindtap="onPurchaseOrderTap" data-id="{{item.saleOrderId}}">
                  <text class="purchase-time">{{item.timeText}}</text>
                  <text class="purchase-link">查看详情 ›</text>
                </view>
              </view>
            </view>
          </view>
        </van-tab>

        <van-tab title="持卡汇总">
          <view class="tab-content">
            <view class="tab-hint">仅显示当前数据范围内的疗程</view>
            <view wx:if="{{cardsLoaded}}" class="card-filter-bar">
              <view class="card-filter-selectors">
                <picker mode="selector" range="{{cardProductKindOptions}}" range-key="label" bindchange="onCardProductKindChange">
                  <view class="card-filter-picker">{{cardProductKindLabel}}</view>
                </picker>
                <picker mode="selector" range="{{cardCategoryOptions}}" range-key="label" disabled="{{!cardProductKind}}" bindchange="onCardCategoryChange">
                  <view class="card-filter-picker">{{cardCategoryLabel}}</view>
                </picker>
              </view>
              <van-search value="{{cardNameQuery}}" placeholder="搜索疗程卡名称" bind:change="onCardNameChange" />
            </view>
            <view wx:if="{{!cardsLoaded}}" class="loading-wrap">
              <van-loading type="spinner" color="#C0322A" />
            </view>
            <van-empty wx:elif="{{treatmentCards.length === 0 && hasTreatmentCardFilter}}" description="未找到匹配的疗程卡" />
            <van-empty wx:elif="{{treatmentCards.length === 0}}" description="暂无可核销疗程" />
            <view wx:else class="card-list">
              <view
                wx:for="{{treatmentCards}}" wx:key="saleItemId"
                class="treatment-card"
              >
                <view class="tc-row">
                  <view class="tc-info">
                    <view class="tc-tags" wx:if="{{item.category || item.saleOrderTypeLabel}}">
                      <van-tag wx:if="{{item.category}}" color="{{item.categoryColor || '#C0322A'}}" text-color="#FFFFFF">{{item.category}}</van-tag>
                      <van-tag wx:if="{{item.saleOrderTypeLabel}}" plain color="#969799">{{item.saleOrderTypeLabel}}</van-tag>
                    </view>
                    <text class="tc-name">{{item.itemName}}</text>
                    <view class="tc-meta">
                      <text class="tc-order">{{item.saleOrderId}}</text>
                    </view>
                    <text class="tc-sessions">剩余 {{item.paidUnusedSessions}} / 已付 {{item.paidSessions == null ? '—' : item.paidSessions}} / 共 {{item.totalSessions}} {{item.unit || '次'}}{{item.unitRealPrice ? ' · 单' + (item.unit || '次') + '实付 ¥' + item.unitRealPrice : ''}}</text>
                    <view class="session-bar">
                      <view class="session-bar__seg session-bar__seg--used" style="width:{{item.usedPct}}%"></view>
                      <view class="session-bar__seg session-bar__seg--paid-unused" style="width:{{item.paidUnusedPct}}%"></view>
                      <view class="session-bar__seg session-bar__seg--unpaid" style="width:{{item.unpaidPct}}%"></view>
                    </view>
                    <text wx:if="{{item.unpaidAmountFmt}}" class="tc-unpaid">待付清 ¥{{item.unpaidAmountFmt}}</text>
                    <text wx:elif="{{item.notConsumable}}" class="tc-unpaid tc-unpaid--plain">可用次数为 0，付清后可核销</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </van-tab>

        <van-tab title="赠送记录">
          <view class="tab-content">
            <view wx:if="{{!giftLoaded}}" class="loading-wrap">
              <van-loading type="spinner" color="#C0322A" />
            </view>
            <view wx:elif="{{giftData && (giftData.promoOrders.length > 0 || giftData.giftItems.length > 0)}}">
              <!-- 组合套餐订单 -->
              <view wx:if="{{giftData.promoOrders.length > 0}}">
                <text class="gift-section-title">组合套餐</text>
                <view class="gift-card" wx:for="{{giftData.promoOrders}}" wx:key="saleOrderId">
                  <view class="gift-card-header">
                    <text class="gift-order-no">{{item.saleOrderId}}</text>
                    <text class="status-tag status-tag--success">{{item.status}}</text>
                  </view>
                  <view wx:for="{{item.items}}" wx:for-item="gi" wx:key="productName" class="gift-item-row">
                    <text class="gift-item-name">{{gi.productName}}</text>
                    <text wx:if="{{gi.specName}}" class="gift-item-spec">{{gi.specName}}</text>
                    <text wx:if="{{gi.remainingSessions != null}}" class="gift-item-sessions">剩余 {{gi.paidUnusedSessions}} / 已付 {{gi.paidSessions}} / 共 {{gi.sessionCount}} {{gi.unit || '次'}}</text>
                  </view>
                  <text class="gift-card-time">{{item.paidAt}}</text>
                </view>
              </view>
              <!-- 套餐赠品 -->
              <view wx:if="{{giftData.giftItems.length > 0}}">
                <text class="gift-section-title">套餐赠品</text>
                <view class="gift-card" wx:for="{{giftData.giftItems}}" wx:key="saleItemId">
                  <view class="gift-item-row">
                    <text class="gift-item-name">{{item.productName}}</text>
                    <text wx:if="{{item.specName}}" class="gift-item-spec">{{item.specName}}</text>
                  </view>
                  <view wx:if="{{item.sessionCount}}" class="gift-item-row">
                    <text class="gift-item-sessions">剩余 {{item.paidUnusedSessions}} / 已付 {{item.paidSessions}} / 共 {{item.sessionCount}} {{item.unit || '次'}}</text>
                  </view>
                  <text class="gift-card-time">{{item.createdAt}}</text>
                </view>
              </view>
            </view>
            <van-empty wx:else description="暂无赠送记录" />
          </view>
        </van-tab>

        <van-tab title="服务记录">
          <view class="tab-content">
            <view wx:if="{{!serviceLoaded}}" class="loading-wrap">
              <van-loading type="spinner" color="#C0322A" />
            </view>
            <van-empty wx:elif="{{serviceRecords.length === 0}}" description="暂无服务记录" />
            <view wx:else>
              <view class="refund-card" wx:for="{{serviceRecords}}" wx:key="serviceOrderId"
                    bindtap="onServiceOrderTap" data-id="{{item.serviceOrderId}}">
                <view class="refund-card-header">
                  <text class="refund-order-no">{{item.serviceOrderId}}</text>
                  <text class="status-tag status-tag--{{item.statusClass}}">{{item.status}}</text>
                </view>
                <view wx:if="{{item.items.length}}" class="refund-items">
                  <view wx:for="{{item.items}}" wx:for-item="si" wx:for-index="sidx" wx:key="sidx" class="refund-item-row">
                    <text class="refund-item-name">{{si.itemName}}</text>
                  </view>
                </view>
                <view wx:if="{{item.metaText}}" class="refund-meta">
                  <text class="refund-card-time">{{item.metaText}}</text>
                </view>
                <view class="refund-card-footer">
                  <text class="refund-card-time">{{item.serviceTime}}</text>
                  <text class="purchase-link">查看详情 ›</text>
                </view>
              </view>
            </view>
          </view>
        </van-tab>

        <van-tab title="家居产品">
          <view class="tab-content">
            <view class="tab-hint">展示顾客跨门店已购家居产品，提货在员工端门店视图操作</view>
            <view wx:if="{{!homeProductsLoaded}}" class="loading-wrap">
              <van-loading type="spinner" color="#C0322A" />
            </view>
            <van-empty wx:elif="{{homeProducts.length === 0}}" description="暂无家居产品" />
            <view wx:else class="home-product-list">
              <view class="home-product-card" wx:for="{{homeProducts}}" wx:key="saleItemId">
                <view class="home-product-head">
                  <text class="home-product-name">{{item.productName}}</text>
                  <text class="status-tag status-tag--{{item.statusClass}}">{{item.status}}</text>
                </view>
                <view class="home-product-counts">
                  <text class="home-product-remaining">待提 {{item.pendingPickupQuantity}}{{item.unit}}</text>
                  <text>已提 {{item.pickedQuantity}}{{item.unit}}</text>
                  <text>已付 {{item.paidQuantity}}{{item.unit}}</text>
                  <text>购买 {{item.purchasedQuantity}}{{item.unit}}</text>
                  <text wx:if="{{item.convertedQuantity > 0}}">已转换 {{item.convertedQuantity}}{{item.unit}}</text>
                  <text wx:if="{{item.refundedQuantity > 0}}">已退款 {{item.refundedQuantity}}{{item.unit}}</text>
                </view>
                <view wx:if="{{item.unpaidAmountFmt}}" class="home-product-unpaid">待付清 ¥{{item.unpaidAmountFmt}}</view>
                <view class="home-product-meta">
                  <text>{{item.storeName || item.storeId}}</text>
                  <text wx:if="{{item.purchasedAtFmt}}">{{item.purchasedAtFmt}}</text>
                </view>
                <text class="home-product-order">{{item.saleOrderId}}</text>
              </view>
            </view>
          </view>
        </van-tab>
      </van-tabs>
    </view>
  </mgmt-data-state>

  <view class="safe-area-bottom" />
</view>
