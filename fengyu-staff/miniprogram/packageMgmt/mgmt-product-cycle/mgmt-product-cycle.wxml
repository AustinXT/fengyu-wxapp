<view class="pc-page">
  <!-- 顶部 period chip -->
  <view class="pc-filter">
    <view
      wx:for="{{periods}}"
      wx:key="key"
      class="pc-chip {{item.key === period ? 'active' : ''}}"
      data-period="{{item.key}}"
      bindtap="onPeriodTap"
    >{{item.label}}</view>
  </view>

  <!-- Section 标题 -->
  <view class="pc-section-title">品项-顾客周期</view>

  <!-- 持卡人数（截面） -->
  <view class="pc-subsection">
    <view class="pc-subsection-title">
      <text>持卡人数</text>
      <text class="pc-badge">截面</text>
    </view>
    <view class="pc-table">
      <view class="pc-table-header">
        <view class="pc-col pc-col-name">品项</view>
        <view class="pc-col pc-col-num">持卡人数</view>
        <view class="pc-col pc-col-num">占比</view>
      </view>
      <view wx:if="{{cardLoading && cardHoldersData.rows.length === 0}}" class="pc-loading">加载中...</view>
      <view wx:elif="{{cardHoldersData.rows.length === 0}}" class="pc-empty">暂无数据</view>
      <block wx:else>
        <view
          wx:for="{{cardHoldersData.rows}}"
          wx:key="productKind"
          class="pc-table-row {{index % 2 === 1 ? 'zebra' : ''}}"
        >
          <view class="pc-col pc-col-name">{{item.productKind}}</view>
          <view class="pc-col pc-col-num">{{item.count}}</view>
          <view class="pc-col pc-col-num">{{item.rate}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 体验情况 -->
  <view class="pc-subsection">
    <view class="pc-subsection-title">体验情况</view>
    <view class="pc-table">
      <view class="pc-table-header">
        <view class="pc-col pc-col-name">品项</view>
        <view class="pc-col pc-col-num">人数</view>
        <view class="pc-col pc-col-num">业绩</view>
        <view class="pc-col pc-col-num">客单价</view>
      </view>
      <view wx:if="{{loading && !display}}" class="pc-loading">加载中...</view>
      <view wx:elif="{{!display || display.trial.length === 0}}" class="pc-empty">暂无数据</view>
      <block wx:else>
        <view
          wx:for="{{display.trial}}"
          wx:key="productKind"
          class="pc-table-row {{index % 2 === 1 ? 'zebra' : ''}}"
        >
          <view class="pc-col pc-col-name">{{item.productKind}}</view>
          <view class="pc-col pc-col-num">{{item.count}}</view>
          <view class="pc-col pc-col-num">{{item.revenue}}</view>
          <view class="pc-col pc-col-num">{{item.avgTicket}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 新增情况 -->
  <view class="pc-subsection">
    <view class="pc-subsection-title">新增情况</view>
    <view class="pc-table">
      <view class="pc-table-header">
        <view class="pc-col pc-col-name">品项</view>
        <view class="pc-col pc-col-num">人数</view>
        <view class="pc-col pc-col-num">业绩</view>
        <view class="pc-col pc-col-num">客单价</view>
      </view>
      <view wx:if="{{loading && !display}}" class="pc-loading">加载中...</view>
      <view wx:elif="{{!display || display.newEntry.length === 0}}" class="pc-empty">暂无数据</view>
      <block wx:else>
        <view
          wx:for="{{display.newEntry}}"
          wx:key="productKind"
          class="pc-table-row {{index % 2 === 1 ? 'zebra' : ''}}"
        >
          <view class="pc-col pc-col-name">{{item.productKind}}</view>
          <view class="pc-col pc-col-num">{{item.count}}</view>
          <view class="pc-col pc-col-num">{{item.revenue}}</view>
          <view class="pc-col pc-col-num">{{item.avgTicket}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 复购情况 -->
  <view class="pc-subsection">
    <view class="pc-subsection-title">复购情况</view>
    <view class="pc-table">
      <view class="pc-table-header">
        <view class="pc-col pc-col-name">品项</view>
        <view class="pc-col pc-col-num">人数</view>
        <view class="pc-col pc-col-num">业绩</view>
        <view class="pc-col pc-col-num">客单价</view>
      </view>
      <view wx:if="{{loading && !display}}" class="pc-loading">加载中...</view>
      <view wx:elif="{{!display || display.repurchase.length === 0}}" class="pc-empty">暂无数据</view>
      <block wx:else>
        <view
          wx:for="{{display.repurchase}}"
          wx:key="productKind"
          class="pc-table-row {{index % 2 === 1 ? 'zebra' : ''}}"
        >
          <view class="pc-col pc-col-name">{{item.productKind}}</view>
          <view class="pc-col pc-col-num">{{item.count}}</view>
          <view class="pc-col pc-col-num">{{item.revenue}}</view>
          <view class="pc-col pc-col-num">{{item.avgTicket}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
