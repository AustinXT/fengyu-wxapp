/* packageMgmt/mgmt-product-cycle — 品项数据子页样式 */

.pc-page {
  padding: 24rpx;
  padding-bottom: 80rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部 period chip 区 */
.pc-filter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 24rpx;
}

.pc-chip {
  padding: 8rpx 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #fff;
  color: #333;
}

.pc-chip.active {
  background: #C0322A;
  border-color: #C0322A;
  color: #fff;
  font-weight: 600;
}

/* Section 标题 */
.pc-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #C0322A;
  text-align: center;
  margin: 16rpx 0 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

/* 子区块 */
.pc-subsection {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.pc-subsection-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 24rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pc-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: normal;
  color: #C0322A;
  background: #FCE9E7;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}

/* 表格 */
.pc-table {
  padding: 0 16rpx 16rpx;
}

.pc-table-header,
.pc-table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
}

.pc-table-header {
  color: #999;
  font-size: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pc-table-row {
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.pc-table-row.zebra {
  background: #fafafa;
}

.pc-table-row:last-child {
  border-bottom: none;
}

.pc-col {
  flex: 1;
  text-align: center;
}

.pc-col-name {
  text-align: left;
  flex: 1.2;
  color: #333;
  font-weight: 500;
}

.pc-col-num {
  color: #333;
  font-weight: 600;
}

.pc-table-header .pc-col-num,
.pc-table-header .pc-col-name {
  color: #999;
  font-weight: normal;
}

.pc-loading,
.pc-empty {
  padding: 48rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
