/* packageMgmt/mgmt-product-cycle — 品项数据子页样式 */

.pc-page {
  padding: 0 var(--spacing-card) 80rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
}

.pc-date-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx var(--spacing-card);
  background: var(--color-bg-page); flex-wrap: wrap;
}

.pc-date-field {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-divider-soft);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.pc-date-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.pc-date-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.pc-date-sep {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* Section 标题 */
.pc-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: left;
  margin: var(--spacing-page) 0 var(--spacing-card);
  padding-left: var(--spacing-tight);
  border-left: 4rpx solid var(--color-primary);
}

/* 子区块 */
.pc-subsection {
  margin-bottom: var(--spacing-card);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.pc-subsection-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: var(--spacing-card) var(--spacing-card) 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx; flex-wrap: wrap;
}

.pc-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: normal;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-lg);
  line-height: 1.6;
}

/* 表格 */
.pc-table {
  padding: 0 var(--spacing-tight) var(--spacing-tight);
}

.pc-table-header,
.pc-table-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-tight) 12rpx;
  font-size: 26rpx;
}

.pc-table-header {
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  border-bottom: 1rpx solid var(--color-divider-soft);
}

.pc-table-row {
  color: var(--color-text-primary);
  border-bottom: 1rpx solid var(--color-divider-soft);
}

.pc-table-row.zebra {
  background: var(--color-bg-page);
}

.pc-table-row:last-child {
  border-bottom: none;
}

.pc-col {
  flex: 1;
  min-width: 0;
  padding: 0 6rpx;
  word-break: break-all;
  line-height: 1.5;
  text-align: right;
}

.pc-col-name {
  text-align: left;
  flex: 1.2;
  color: var(--color-text-primary);
  font-weight: 500;
}

.pc-col-num {
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
  font-weight: 600;
}

.pc-table--repurchase .pc-col-name {
  flex: 1.25;
}

.pc-table--repurchase .pc-col-num {
  font-variant-numeric: tabular-nums;
  flex: 0.9; font-size: 26rpx;
}

.pc-table-header .pc-col-num,
.pc-table-header .pc-col-name {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.pc-table-scroll { width: 100%; }
.pc-table--repurchase { min-width: 900rpx; box-sizing: border-box; }
