/* packageMgmt/mgmt-customer-list/mgmt-customer-list.wxss */

.container {
  background: var(--color-bg-page);
  min-height: 100vh;
}

.hint-wrap { padding: 80rpx 32rpx; text-align: center; }
.hint-text { font-size: 26rpx; color: var(--color-text-hint); }

/* 顶部筛选行 → 全局 .mgmt-filter-bar + .mgmt-scope-tag（app.wxss）已统一 */

/* sticky 筛选容器：搜索吸顶 */
.mc-sticky-filters {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-bg-page);
}

/* 加载更多 / 没有更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: var(--spacing-card);
}

.no-more-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* 顾客卡片 */
.customer-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-card);
  margin: 0 var(--spacing-card) var(--gap-grid);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.customer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.customer-info {
  flex: 1;
  min-width: 0;
}

.customer-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.customer-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.customer-phone {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 6rpx;
}

.customer-store {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 6rpx;
}

.customer-recent {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* 头像文字 */
.customer-avatar-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.customer-list {
  padding-top: 8rpx;
}

/* VIP 徽章 */
.vip-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-lg);
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: 1rpx solid rgba(192, 50, 42, 0.3);
}

/* 分类徽章 — 三色由 pr.spec §3.14 强制规定，保留硬编码 */
.tier-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-lg);
}

.tier-badge--fan {
  background: #F0F0F0;
  color: #888888;
}

.tier-badge--iron {
  background: #FFF3E0;
  color: #D4820A;
}

.tier-badge--diamond {
  background: #1A1A1A;
  color: #FFD700;
}
