<!-- pages/appointment/appointment.wxml — 预约管理 -->
<view class="container">
  <business-list-filter
    value="{{searchInput}}"
    placeholder="搜索顾客姓名或手机号"
    status="{{status}}"
    status-options="{{statusOptions}}"
    start-date="{{startDate}}"
    end-date="{{endDate}}"
    bind:keyword-change="onSearchChange"
    bind:search="onSearch"
    bind:search-clear="onSearchClear"
    bind:status-change="onStatusChange"
    bind:start-date-change="onStartDateChange"
    bind:end-date-change="onEndDateChange"
    bind:clear-dates="clearDates"
  />

  <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{list.length === 0}}" class="empty-wrap">
    <van-empty description="暂无预约记录" />
  </view>

  <view wx:else class="list-wrap">
    <view class="appt-item" wx:for="{{list}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
      <view class="appt-header">
        <text class="appt-customer">{{item.customerName || '未知顾客'}}</text>
        <van-tag type="{{item.statusType}}" plain>{{item.statusText}}</van-tag>
      </view>
      <view class="appt-info" wx:if="{{item.customerPhone}}">
        <van-icon name="phone-o" size="28rpx" color="#999" />
        <text class="appt-phone">{{item.customerPhone}}</text>
      </view>
      <view class="appt-info">
        <van-icon name="underway-o" size="28rpx" color="#999" />
        <text class="appt-time">{{item.appointmentTime}}</text>
      </view>
      <view class="appt-info" wx:if="{{item.staffName}}">
        <van-icon name="manager-o" size="28rpx" color="#999" />
        <text class="appt-staff">{{item.staffName}}</text>
      </view>
      <view class="appt-actions" wx:if="{{!isReadOnly && item.status === 'pending'}}">
        <van-button size="small" type="primary" catchtap="onConfirmAppt" data-id="{{item.id}}">
          确认预约
        </van-button>
      </view>
      <view class="appt-actions" wx:if="{{!isReadOnly && item.status === 'confirmed'}}">
        <van-button wx:if="{{!item.checkinAt}}" size="small" type="warning" plain catchtap="onCheckin" data-id="{{item.id}}">
          顾客已到店
        </van-button>
        <van-tag wx:if="{{item.checkinAt}}" type="success" plain class="checkin-tag">已签到</van-tag>
        <van-button size="small" type="primary" catchtap="onCreateService" data-id="{{item.id}}">
          创建服务单
        </van-button>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loading-more">
      <van-loading size="24px" color="#999">加载中...</van-loading>
    </view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">没有更多了</view>
  </view>
</view>
