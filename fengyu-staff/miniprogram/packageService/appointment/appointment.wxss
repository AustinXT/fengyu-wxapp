/* pages/appointment/appointment.wxss */

.filter-panel { background: #FFFFFF; }
.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}
.status-dropdown { flex: 1; min-width: 200rpx; }
.date-chip {
  padding: 14rpx 12rpx;
  border-radius: 8rpx;
  background: #F5F2EE;
  color: #666;
  font-size: 22rpx;
  white-space: nowrap;
}
.filter-clear { color: var(--color-primary); font-size: 22rpx; white-space: nowrap; }

.list-wrap {
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.appt-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.appt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.appt-customer {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.appt-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.appt-time, .appt-staff {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.appt-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #F0F0F0;
}

.loading-more, .no-more {
  text-align: center;
  padding: 28rpx 0;
  color: #999;
  font-size: 24rpx;
}
