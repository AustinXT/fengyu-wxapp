/* pages/appointment/appointment.wxss */

.list-scroll {
  height: calc(100vh - 100rpx);
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.appt-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.appt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.appt-customer {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.appt-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.appt-time, .appt-staff {
  font-size: 26rpx;
  color: #666666;
}

.appt-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #F0F0F0;
}
