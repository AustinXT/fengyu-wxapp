
<view class="container">

  
  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <block wx:else>
    
    <view wx:if="{{requests.length === 0}}" class="empty-wrap">
      <van-empty description="暂无待审批的转店申请" />
    </view>

    
    <view wx:else class="list">
      <van-cell-group
        wx:for="{{requests}}"
        wx:key="requestId"
        class="request-card"
        inset
      >
        <van-cell title="顾客手机" value="{{item.phoneMasked}}" />
        <van-cell title="原门店" value="{{item.fromStoreName}}" />
        <van-cell title="转往门店" value="{{item.toStoreName}}" />
        <van-cell wx:if="{{item.note}}" title="备注" value="{{item.note}}" />
        <van-cell title="申请时间" value="{{item.createdAt}}" />
        <view class="action-row">
          <van-button
            type="primary"
            size="small"
            color="#3D8A5A"
            bindtap="onApprove"
            data-request-id="{{item.requestId}}"
            data-from-store="{{item.fromStoreName}}"
            data-to-store="{{item.toStoreName}}"
          >通过</van-button>
          <van-button
            type="danger"
            size="small"
            plain
            bindtap="onReject"
            data-request-id="{{item.requestId}}"
          >拒绝</van-button>
        </view>
      </van-cell-group>
    </view>
  </block>

  <view class="safe-area-bottom" />
</view>


<van-dialog
  show="{{ showRejectDialog }}"
  title="拒绝申请"
  show-cancel-button
  confirm-button-text="确认拒绝"
  bind:confirm="onRejectDialogConfirm"
  bind:cancel="onRejectDialogCancel"
>
  <view class="dialog-body">
    <van-field
      value="{{ rejectReason }}"
      placeholder="拒绝原因（选填）"
      bind:input="onRejectReasonInput"
      type="textarea"
      autosize
      border="{{ false }}"
    />
  </view>
</van-dialog>
