/* pages/unbind-requests/unbind-requests.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page, #F5F2EE);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

.list {
  padding: 24rpx 0;
}

.request-card {
  margin-bottom: 24rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx 24rpx;
}

.dialog-body {
  padding: 16rpx 0;
}

.safe-area-bottom {
  height: 40rpx;
}
