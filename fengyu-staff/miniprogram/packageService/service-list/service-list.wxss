.page-content {
  padding: 48rpx 24rpx;
}

/* ===== 服务单列表（分包入口） ===== */
.loading-wrap { padding: 120rpx 0; }

.list-wrap {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
}

.service-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.service-no {
  font-size: 26rpx;
  color: #666666;
  font-family: monospace;
}
