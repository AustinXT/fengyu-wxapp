<!-- pages/service-create/service-create.wxml -->
<view class="container">

  <!-- 关联预约（可选） -->
  <view wx:if="{{appointmentInfo}}" class="appt-banner">
    <view class="appt-info">
      <van-icon name="calendar-o" size="32rpx" color="#C0322A" />
      <view class="appt-detail">
        <text class="appt-time">{{appointmentInfo.appointmentTime}}</text>
        <text class="appt-item">{{appointmentInfo.serviceItemName}}</text>
      </view>
    </view>
    <van-icon name="cross" size="32rpx" color="#999" bindtap="onRemoveAppointment" />
  </view>

  <!-- 顾客选择 -->
  <view class="section-card">
    <text class="section-title">选择顾客</text>
    <view wx:if="{{selectedCustomer}}" class="customer-selected">
      <van-icon name="manager-o" size="36rpx" color="#C0322A" />
      <view class="customer-info">
        <text class="customer-name">{{selectedCustomer.name || '未知'}}</text>
        <text class="customer-phone">{{selectedCustomer.phone}}</text>
      </view>
      <text class="customer-change" bindtap="onClearCustomer">换一位</text>
    </view>
    <view wx:else class="customer-search">
      <van-search
        value="{{customerSearch}}"
        placeholder="搜索姓名或手机号"
        bind:search="onSearchCustomer"
        bind:change="onCustomerSearchChange"
        use-action-slot
      >
        <view slot="action" bindtap="onSearchCustomer">搜索</view>
      </van-search>

      <view wx:if="{{customerResults.length > 0}}" class="customer-results">
        <van-cell-group>
          <van-cell
            wx:for="{{customerResults}}"
            wx:key="index"
            title="{{item.name || item.phone}}"
            label="{{item.phoneMasked || item.phone}}"
            is-link
            bindtap="onCustomerTap"
            data-index="{{index}}"
          />
        </van-cell-group>
      </view>
    </view>
  </view>

  <!-- 选择核销订单行 -->
  <view class="section-card" wx:if="{{selectedCustomer}}">
    <text class="section-title">选择核销项目</text>

    <view wx:if="{{loading || !paidItemsLoaded}}" class="loading-wrap">
      <van-loading type="spinner" color="#C0322A" />
    </view>

    <block wx:else>
      <view class="card-filter-bar">
        <view class="card-filter-selectors">
          <picker mode="selector" range="{{paidItemProductKindOptions}}" range-key="label" bindchange="onPaidItemProductKindChange">
            <view class="card-filter-picker">{{paidItemProductKindLabel}}</view>
          </picker>
          <picker mode="selector" range="{{paidItemCategoryOptions}}" range-key="label" disabled="{{!paidItemProductKind}}" bindchange="onPaidItemCategoryChange">
            <view class="card-filter-picker">{{paidItemCategoryLabel}}</view>
          </picker>
        </view>
        <van-search value="{{paidItemNameQuery}}" placeholder="搜索疗程卡名称" bind:change="onPaidItemNameChange" />
      </view>

      <view wx:if="{{paidItems.length === 0}}" class="empty-tip">
        <van-empty wx:if="{{hasPaidItemFilter}}" description="未找到匹配的疗程卡" />
        <van-empty wx:else description="该顾客在本店暂无可核销的已支付订单（跨店卡需在购买门店使用）" />
      </view>

      <view wx:else class="order-list">
        <view
          class="order-item-wrap {{selectedFlowNos[si.saleItemId] ? 'order-item--selected' : ''}} {{si.disabled ? 'order-item--disabled' : ''}}"
          wx:for="{{paidItems}}"
          wx:for-item="si"
          wx:key="saleItemId"
          bindtap="onToggleItem"
          data-sale-item-id="{{si.saleItemId}}"
          data-item-name="{{si.itemName}}"
          data-spec="{{si.spec}}"
          data-sale-order-id="{{si.saleOrderId}}"
          data-disabled="{{si.disabled}}"
        >
          <view class="order-item">
            <view class="order-item-info">
              <view class="order-tags" wx:if="{{si.category || si.saleOrderTypeLabel}}">
                <van-tag wx:if="{{si.category}}" color="{{si.categoryColor || '#C0322A'}}" text-color="#FFFFFF">{{si.category}}</van-tag>
                <van-tag wx:if="{{si.saleOrderTypeLabel}}" plain color="#969799">{{si.saleOrderTypeLabel}}</van-tag>
              </view>
              <text class="order-item-name">{{si.itemName}}</text>
              <view class="order-item-meta">
              <text class="order-item-sessions">剩余 {{si.consumableSessions}} / 已付 {{si.paidSessions == null ? '—' : si.paidSessions}} / 共 {{si.totalSessions || si.sessionCount}} {{si.unit || '次'}} · 共 {{si.cardCount || 1}} 张{{si.unitRealPrice ? ' · 单' + (si.unit || '次') + '实付 ¥' + si.unitRealPrice : ''}}{{si.disabledReason ? ' · ' + si.disabledReason : ''}}</text>
              </view>
              <view class="order-item-sub" wx:if="{{si.saleOrderId}}">{{si.saleOrderId}} · {{si.paidAt}}</view>
              <view class="order-remark-list" wx:if="{{si.sourceOrderRemarks && si.sourceOrderRemarks.length}}">
                <view class="order-remark" wx:for="{{si.sourceOrderRemarks}}" wx:for-item="remarkItem" wx:key="saleOrderId">
                  <text class="order-remark__order">{{remarkItem.saleOrderId}}</text>
                  <text class="order-remark__content">订单备注：{{remarkItem.orderRemark}}</text>
                </view>
              </view>
            </view>
            <van-icon
              name="{{si.disabled ? 'close' : (selectedFlowNos[si.saleItemId] ? 'success' : 'circle')}}"
              size="40rpx"
              color="{{selectedFlowNos[si.saleItemId] ? '#C0322A' : '#CCCCCC'}}"
            />
          </view>
          <view wx:if="{{selectedFlowNos[si.saleItemId]}}" class="tc-stepper-row" catchtap="preventBubble">
            <text class="tc-stepper-label">本次核销</text>
            <van-stepper
              value="{{selectedSessionCounts[si.saleItemId]}}"
              min="{{1}}"
              max="{{si.consumableSessions}}"
              input-width="60rpx"
              button-size="48rpx"
              bind:change="onSessionStepperChange"
              data-sale-item-id="{{si.saleItemId}}"
            />
            <text class="tc-stepper-unit">{{si.unit || '次'}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 已选项目汇总 -->
  <view class="section-card" wx:if="{{selectedItems.length > 0}}">
    <text class="section-title">已选核销项目</text>
    <view class="selected-item" wx:for="{{selectedItems}}" wx:key="saleItemId">
      <van-icon name="success" size="28rpx" color="#3D8A5A" />
      <text class="selected-item-name">{{item.itemName}}{{item.spec ? ' (' + item.spec + ')' : ''}} · 本次 {{item.sessionCount}} {{item.unit || '次'}} · 共 {{item.cardCount}} 张</text>
      <view class="order-remark-list selected-item-remarks" wx:if="{{item.sourceOrderRemarks && item.sourceOrderRemarks.length}}">
        <view class="order-remark" wx:for="{{item.sourceOrderRemarks}}" wx:for-item="remarkItem" wx:key="saleOrderId">
          <text class="order-remark__order">{{remarkItem.saleOrderId}}</text>
          <text class="order-remark__content">订单备注：{{remarkItem.orderRemark}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 服务人员 + 备注 -->
  <view class="section-card">
    <van-cell-group>
      <van-cell
        title="服务人员"
        value="{{staffName}}"
        is-link="{{isManager}}"
        bindtap="{{isManager ? 'onShowStaffPicker' : ''}}"
      />
      <van-cell
        title="备注"
        value="{{remarkMode === 'preset' ? remark : '自定义输入'}}"
        is-link
        bindtap="onShowRemarkPicker"
      />
      <van-field
        wx:if="{{remarkMode === 'custom'}}"
        label="备注内容"
        placeholder="选填，最多100字"
        type="textarea"
        maxlength="100"
        autosize
        value="{{remark}}"
        bind:change="onRemarkChange"
      />
    </van-cell-group>
  </view>

  <!-- 提交 -->
  <view class="submit-bar">
    <van-button
      type="primary"
      block
      loading="{{submitting}}"
      custom-class="btn-primary-brand"
      custom-style="border-radius: 48rpx;"
      bind:click="onSubmit"
    >提交服务单</van-button>
  </view>

  <view class="safe-area-bottom" />

  <!-- 店长选择服务人员 -->
  <van-popup
    show="{{showStaffPicker}}"
    round
    position="bottom"
    bind:close="onStaffPickerClose"
  >
    <van-picker
      title="选择服务人员"
      show-toolbar
      columns="{{staffColumns}}"
      bind:confirm="onStaffConfirm"
      bind:cancel="onStaffPickerClose"
    />
  </van-popup>

  <!-- 备注预设选择 -->
  <van-popup
    show="{{showRemarkPicker}}"
    round
    position="bottom"
    bind:close="onRemarkPickerClose"
  >
    <van-picker
      title="选择备注"
      show-toolbar
      columns="{{remarkColumns}}"
      bind:confirm="onRemarkConfirm"
      bind:cancel="onRemarkPickerClose"
    />
  </van-popup>
</view>
