/* pages/service-create/service-create.wxss */

/* ===== 关联预约横幅 ===== */
.appt-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF8F0;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #E5DDD5;
}

.appt-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.appt-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.appt-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2017;
}

.appt-item {
  font-size: 24rpx;
  color: #C0322A;
}

/* ===== 通用 section ===== */
.section-card {
  background: #FFFFFF;
  margin-top: 24rpx;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2017;
  display: block;
  margin-bottom: 20rpx;
}

/* ===== 顾客信息 ===== */
.customer-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.customer-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.customer-change {
  font-size: 24rpx;
  color: #C0322A;
  flex-shrink: 0;
}

.customer-results {
  margin-top: 8rpx;
}

.customer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2017;
}

.customer-phone {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
}

/* ===== 订单列表 ===== */
.order-group {
  margin-bottom: 24rpx;
  border: 1rpx solid #E5DDD5;
  border-radius: 12rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #F5F2EE;
}

.order-no {
  font-size: 24rpx;
  color: #666666;
  font-family: monospace;
}

.order-date {
  font-size: 24rpx;
  color: #999999;
}

.order-item-wrap {
  border-top: 1rpx solid #F5F2EE;
  background: #FFFFFF;
}

.order-item-wrap.order-item--selected {
  background: #FFF8F0;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.order-item-info {
  flex: 1;
  margin-right: 16rpx;
}

.order-item-name {
  font-size: 28rpx;
  color: #2D2017;
  display: block;
  margin-bottom: 6rpx;
}

.order-item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-item-spec {
  font-size: 24rpx;
  color: #666666;
  background: #F5F2EE;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.order-item-sessions {
  font-size: 24rpx;
  color: #C0322A;
  font-weight: 500;
}

/* ===== stepper 行 ===== */
.tc-stepper-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-top: 1rpx solid #F0EDE9;
}

.tc-stepper-label {
  font-size: 24rpx;
  color: #666;
}

.tc-stepper-unit {
  font-size: 24rpx;
  color: #666;
}

/* ===== 已选汇总 ===== */
.selected-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F2EE;
}

.selected-item:last-child {
  border-bottom: none;
}

.selected-item-name {
  font-size: 26rpx;
  color: #2D2017;
}

/* ===== 提交栏 ===== */
.submit-bar {
  padding: 32rpx;
  background: #FFFFFF;
  margin-top: 24rpx;
}
