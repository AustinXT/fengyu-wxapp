/* pages/service-detail/service-detail.wxss */


.status-banner {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-banner--pending { background: #FFF3E0; }
.status-banner--progress { background: #E3F0FF; }
.status-banner--awaiting { background: #FCEEED; }
.status-banner--done { background: #F0F0F0; }
.status-banner--cancelled { background: #FDECEA; }

.status-label { font-size: 36rpx; font-weight: 700; }
.status-banner--pending .status-label { color: #D4820A; }
.status-banner--progress .status-label { color: #5E8BB3; }
.status-banner--awaiting .status-label { color: #C0322A; }
.status-banner--done .status-label { color: #888888; }
.status-banner--cancelled .status-label { color: #E53935; }

.service-no { font-size: 24rpx; color: var(--color-text-secondary); font-family: monospace; }

.section-group { margin-top: 24rpx; }

.section-title-row {
  padding: 16rpx 32rpx 8rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F5F2EE;
}
.section-title { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }

.item-row {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #F5F2EE;
}
.item-row:last-child { border-bottom: none; }

.item-name-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.item-name { font-size: 30rpx; color: #2D2017; font-weight: 500; }
.item-tag { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 6rpx; line-height: 1.4; }
.item-tag--presale { background: #FFF0EE; color: #C45C48; }
.item-tag--postsale { background: #E8F0FE; color: #3574C4; }
.item-meta { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.item-spec { font-size: 24rpx; color: var(--color-text-secondary); background: #F5F2EE; padding: 2rpx 12rpx; border-radius: 8rpx; }
.item-sessions { font-size: 24rpx; color: var(--color-primary); }
.item-flow-no { font-size: 22rpx; color: #BBBBBB; font-family: monospace; display: block; }


.action-bar {
  padding: 32rpx;
  background: #FFFFFF;
  margin-top: 24rpx;
}

/* 顾客评价 */
.review-box { background: #FFFFFF; padding: 24rpx 32rpx; }
.review-rate-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.review-score { font-size: 26rpx; color: #C0322A; font-weight: 600; }
.review-comment { font-size: 28rpx; color: #2D2017; line-height: 1.6; display: block; margin-bottom: 12rpx; word-break: break-all; }
.review-time { font-size: 22rpx; color: #BBBBBB; display: block; }
.review-empty { background: #FFFFFF; padding: 32rpx; text-align: center; font-size: 26rpx; color: #999999; }
