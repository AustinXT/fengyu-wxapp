
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{!appt}}" class="empty-wrap">
    <van-empty description="暂无数据" />
  </view>

  <block wx:else>
    
    <view class="status-banner status-banner--{{statusCls}}">
      <text class="status-banner-text">{{statusText}}</text>
    </view>

    
    <van-cell-group title="预约信息" class="card-group">
      <van-cell title="顾客姓名" value="{{appt.customerName}}" />
      <van-cell title="顾客电话" value="{{appt.customerPhone}}" />
      <van-cell title="预约时间" value="{{appt.appointmentTime}}" />
      <van-cell title="服务项目" value="{{appt.serviceItemName}}" />
      <van-cell title="指定美容师" value="{{appt.staffName}}" />
      <van-cell wx:if="{{appt.remark}}" title="备注" value="{{appt.remark}}" />
    </van-cell-group>

    
    <van-cell-group wx:if="{{appt.serviceOrderId}}" title="关联服务单" class="card-group">
      <van-cell title="服务单 ID" value="{{appt.serviceOrderId}}" is-link
        bind:click="onViewServiceOrder" />
    </van-cell-group>

    
    <view class="action-bar">
      <van-button
        wx:if="{{appt.status === 'pending'}}"
        type="primary"
        block
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:click="onConfirm"
      >确认预约</van-button>

      <view wx:if="{{appt.status === 'confirmed'}}" class="action-row">
        <van-button
          plain
          type="warning"
          custom-style="flex:1;border-radius:48rpx;"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:click="onCheckin"
        >顾客已到店</van-button>
        <van-button
          type="primary"
          custom-class="btn-primary-brand"
          custom-style="flex:1;border-radius:48rpx;"
          bind:click="onCreateService"
        >创建服务单</van-button>
      </view>
      
      <van-button
        wx:if="{{appt.status === 'completed' || appt.status === 'cancelled' || appt.status === 'closed'}}"
        type="primary" block plain
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:20rpx;"
        bind:click="onBackToWorkbench"
      >返回工作台</van-button>
    </view>
  </block>

  <view class="safe-area-bottom" />
</view>
