/* slide-to-confirm 样式 */
.stc-wrap {
  width: 100%;
  padding: 8rpx 0;
}

.stc-wrap--disabled {
  opacity: 0.5;
}

.stc-area {
  position: relative;
  width: 100%;
  height: 96rpx;
  background: #F2F2F2;
  border-radius: 48rpx;
  overflow: hidden;
}

.stc-track-label {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888888;
  pointer-events: none;
  user-select: none;
}

.stc-thumb {
  width: 96rpx;
  height: 96rpx;
}

.stc-thumb-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.stc-thumb-arrow {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}
