/* components/mgmt-scope-picker — 市场/门店二级筛选样式 */

.scope-picker {
  display: inline-block;
}

.scope-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: var(--spacing-tight) var(--spacing-card);
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.scope-trigger-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 240rpx;
}

.scope-popup {
  min-height: 60vh;
  padding: 0;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.scope-cols {
  display: flex;
  min-height: 60vh;
}

.scope-col {
  flex: 1;
  max-height: 60vh;
  overflow: auto;
}

.scope-col--left {
  border-right: 1rpx solid #EEEEEE;
}

.scope-row {
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #333333;
  border-left: 6rpx solid transparent;
}

.scope-row--active {
  border-left: 6rpx solid #C0322A;
  color: #C0322A;
  font-weight: 600;
}

.scope-actions {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

.scope-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: 1rpx solid #C0322A;
  color: #C0322A;
  background: #FFFFFF;
}

.scope-btn--primary {
  background: #C0322A;
  color: #FFFFFF;
}
