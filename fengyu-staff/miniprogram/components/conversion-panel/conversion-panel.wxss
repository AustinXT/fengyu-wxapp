/* components/conversion-panel/conversion-panel.wxss */

.conv-panel {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.conv-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.conv-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0;
  color: var(--color-text-hint);
  font-size: 26rpx;
}
.conv-loading-text { font-size: 24rpx; color: var(--color-text-hint); }

.conv-empty {
  padding: 20rpx 0;
}

.conv-card-filter {
  margin-bottom: 16rpx;
}

.conv-card-filter-selectors {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.conv-card-filter-selectors picker {
  flex: 1;
  min-width: 0;
}

.conv-card-filter-picker {
  min-height: 64rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  background: #FFFFFF;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confirm-discount-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  width: 200rpx;
}

.confirm-discount-prefix {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-right: 4rpx;
}

.confirm-discount-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-primary);
  height: 48rpx;
  min-width: 0;
}

.confirm-special-badge {
  font-size: 18rpx;
  color: var(--color-primary);
  background: rgba(192, 50, 42, 0.08);
  border-radius: 4rpx;
  padding: 0 6rpx;
  margin-right: 6rpx;
  white-space: nowrap;
}

.confirm-item-receivable {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== 卡列表 ===== */
.conv-card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.conv-card-item {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  background: #FAFAFA;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}
.conv-card-item--active {
  background: #FFF5F5;
  border-color: var(--color-primary);
}
.conv-card-checkbox {
  flex-shrink: 0;
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.conv-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.conv-card-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.conv-card-spec {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.conv-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.conv-card-remain { color: var(--color-primary); font-weight: 500; }
.conv-card-unit { color: var(--color-text-hint); }
.conv-card-amount {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.conv-card-amount-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.conv-card-amount-label {
  font-size: 20rpx;
  color: var(--color-text-hint);
}
.conv-card-quantity {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0E8E5;
}
.conv-card-quantity-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ===== 底部差额汇总 ===== */
.conv-summary {
  background: #F5F2EE;
  border-radius: 12rpx;
  padding: 16rpx;
}
.conv-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}
.conv-summary-row--diff {
  padding-top: 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-border);
}
.conv-summary-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.conv-summary-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
}
.conv-summary-value--discount {
  color: var(--color-primary);
}
.conv-summary-diff {
  font-size: 30rpx;
  font-weight: 700;
}
.conv-summary-diff--positive { color: var(--color-primary); }
.conv-summary-diff--zero { color: var(--color-text-secondary); }
.conv-summary-diff--negative { color: #27AE60; }

/* ===== 充值卡手填抵扣 ===== */
.prepaid-card-section {
  margin-top: 16rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid #F5E0C8;
  border-radius: 12rpx;
  background: #FFFAF3;
}
.prepaid-card-section-title { display: block; margin-bottom: 12rpx; font-size: 22rpx; color: var(--color-text-hint); }
.prepaid-card-row, .prepaid-card-deduct-row { display: flex; align-items: center; justify-content: space-between; }
.prepaid-card-info { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.prepaid-card-label { font-size: 26rpx; font-weight: 600; color: var(--color-text-primary); }
.prepaid-card-balance { font-size: 22rpx; color: var(--color-text-secondary); }
.prepaid-card-deduct-row { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #F5E0C8; }
.prepaid-card-deduct-label { font-size: 24rpx; color: var(--color-text-secondary); }
.prepaid-card-amount-input-wrap { display: flex; align-items: center; width: 200rpx; padding: 4rpx 12rpx; border: 1rpx solid #F5E0C8; border-radius: 8rpx; background: #FFFFFF; }
.prepaid-card-amount-prefix { margin-right: 4rpx; font-size: 24rpx; color: var(--color-text-hint); }
.prepaid-card-amount-input { flex: 1; min-width: 0; height: 44rpx; font-size: 24rpx; color: var(--color-text-primary); text-align: right; }
.prepaid-card-max-hint { margin-top: 8rpx; font-size: 22rpx; color: var(--color-text-hint); text-align: right; }
.prepaid-card-empty-hint { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #F5E0C8; font-size: 22rpx; color: var(--color-text-hint); }
.prepaid-paid-summary { display: flex; align-items: baseline; justify-content: space-between; padding: 14rpx 4rpx; }
.prepaid-paid-label { font-size: 28rpx; color: var(--color-text-secondary); }
.prepaid-paid-amount { font-size: 36rpx; font-weight: 700; color: var(--color-primary); }
.prepaid-paid-fullcover-hint { font-size: 22rpx; color: #3D8A5A; }
