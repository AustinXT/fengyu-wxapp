/* packageMy/pickup/pickup-by-customer.wxss */
.container {
  background-color: #F5F5F5;
  min-height: 100vh;
}

.header {
  background: #FFFFFF;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #EEE;
}

.header-title {
  font-size: 32rpx;
  font-weight: 500;
}

.header-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

.search-area {
  padding: 24rpx;
}

.search-row {
  display: flex;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.search-btn {
  background: var(--color-primary);
  color: #FFFFFF;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.customer-list {
  margin-top: 24rpx;
}

.customer-row {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.customer-name {
  font-size: 30rpx;
  font-weight: 500;
}

.customer-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  gap: 16rpx;
}

.empty,
.empty-card {
  text-align: center;
  padding: 60rpx 24rpx;
  color: #999;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.result-area {
  padding: 24rpx;
}

.selected-bar {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.selected-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.selected-phone {
  font-size: 24rpx;
  color: #999;
}

.back-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

.item-list .item-card {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
}

.store-tag {
  background: #F5F5F5;
  color: #666;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.item-spec {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.item-progress {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.remaining {
  color: var(--color-primary);
  font-weight: 500;
}

.item-action {
  text-align: right;
}

.pickup-btn {
  display: inline-block;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  line-height: 1.6;
}

/* dialog */
.dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  background: #FFFFFF;
  width: 80%;
  border-radius: 16rpx;
  padding: 24rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 24rpx;
}

.dialog-body {
  padding: 0 8rpx;
}

.dialog-product {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.dialog-remaining {
  font-size: 24rpx;
  color: var(--color-primary);
  margin-bottom: 24rpx;
}

.dialog-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.dialog-label {
  font-size: 24rpx;
  color: #666;
}

.dialog-input {
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dialog-btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.dialog-btn.cancel {
  background: #F5F5F5;
  color: #666;
}

.dialog-btn.confirm {
  background: var(--color-primary);
  color: #FFFFFF;
}

.dialog-btn[disabled] {
  opacity: 0.6;
}
