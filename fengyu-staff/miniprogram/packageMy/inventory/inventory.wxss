/* packageMy/inventory/inventory.wxss */
.container {
  padding: 24rpx;
  background-color: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-tip {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 16rpx;
}

.section-title {
  color: #222;
  font-size: 28rpx;
  font-weight: 600;
}

.section-link {
  color: var(--color-primary);
  font-size: 24rpx;
}

.operation-list {
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.operation {
  min-height: 112rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #F0F0F0;
  box-sizing: border-box;
}

.operation:last-child {
  border-bottom: 0;
}

.operation-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.operation-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.operation-title {
  color: #222;
  font-size: 28rpx;
  font-weight: 500;
}

.operation-desc {
  color: #888;
  font-size: 22rpx;
}

.records-head {
  margin-top: 0;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
}
