<!-- packageMy/inventory/detail.wxml -->
<view class="container" wx:if="{{detail}}">
  <view class="head">
    <view class="head-line">
      <text class="doc-id">{{detail.id}}</text>
      <text class="status status-{{detail.statusKey}}">{{detail.status}}</text>
    </view>
    <view class="meta-row">
      <text class="meta-tag">{{detail.docType}}</text>
      <text class="meta-date">{{detail.docDate}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">基础信息</view>
    <view class="field" wx:if="{{detail.sourceOrgNodeName || detail.sourceOrgNodeId}}"><text class="label">出库/发起主体</text><text class="value">{{detail.sourceOrgNodeName || detail.sourceOrgNodeId}}</text></view>
    <view class="field" wx:if="{{detail.targetOrgNodeName || detail.targetOrgNodeId}}"><text class="label">入库/接收主体</text><text class="value">{{detail.targetOrgNodeName || detail.targetOrgNodeId}}</text></view>
    <view class="field" wx:if="{{detail.customerName}}"><text class="label">顾客</text><text class="value">{{detail.customerName}}</text></view>
    <view class="field" wx:if="{{isStocktake}}"><text class="label">盘点结论</text><text class="value">{{stocktakeSummary}}</text></view>
    <view class="field"><text class="label">{{isStocktake ? '实盘合计' : '总数量'}}</text><text class="value">{{detail.totalQuantity === undefined ? '—' : detail.totalQuantity}}</text></view>
    <view class="field" wx:if="{{detail.relatedSaleOrderId}}"><text class="label">销售单号</text><text class="value">{{detail.relatedSaleOrderId}}</text></view>
    <view class="field" wx:if="{{detail.employeeName}}"><text class="label">相关员工</text><text class="value">{{detail.employeeName}}</text></view>
    <view class="field" wx:if="{{detail.supplierName}}"><text class="label">供货方</text><text class="value">{{detail.supplierName}}</text></view>
    <view class="field" wx:if="{{detail.trackingNo}}"><text class="label">物流单号</text><text class="value">{{detail.trackingNo}}</text></view>
    <view class="field" wx:if="{{detail.confirmedAt}}"><text class="label">确认时间</text><text class="value">{{detail.confirmedAt}}</text></view>
    <view class="field" wx:if="{{detail.auditRemark}}"><text class="label">审批备注</text><text class="value">{{detail.auditRemark}}</text></view>
    <view class="field" wx:if="{{detail.remark}}"><text class="label">备注</text><text class="value">{{detail.remark}}</text></view>
  </view>

  <view class="section" wx:if="{{detail.lineage.length}}">
    <view class="section-title">单据血缘</view>
    <view class="field" wx:for="{{detail.lineage}}" wx:key="docId">
      <text class="label">{{item.direction}} · {{item.relationType}}</text>
      <text class="value">{{item.docType}} {{item.docId}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">明细行（{{detail.items.length}} 条）</view>
    <view class="item-card" wx:for="{{detail.items}}" wx:key="id">
      <view class="item-head">
        <text class="item-name">{{item.skuName}}</text>
        <text wx:if="{{!isStocktake}}" class="item-qty">×{{item.quantity}}</text>
      </view>
      <!-- 盘点单（#352）：账面 / 实盘 / 差异三列，差异前端派生；历史单无账面显示「—」 -->
      <view wx:if="{{isStocktake}}" class="stocktake-row">
        <view class="stocktake-cell"><text class="stocktake-label">账面</text><text class="stocktake-value">{{item.stockSnapshot === null ? '—' : item.stockSnapshot}}</text></view>
        <view class="stocktake-cell"><text class="stocktake-label">实盘</text><text class="stocktake-value">{{item.quantity}}</text></view>
        <view class="stocktake-cell"><text class="stocktake-label">差异</text><text class="stocktake-value diff-{{item.diffKey}}">{{item.diffText}}</text></view>
      </view>
      <view class="item-meta">
        <text class="item-code">{{item.skuId}}</text>
        <text wx:if="{{item.specName}}" class="item-spec">{{item.specName}}</text>
        <text wx:if="{{item.batchNo}}" class="item-batch">批号：{{item.batchNo}}</text>
      </view>
      <view class="item-extra">
        <text wx:if="{{item.reason}}" class="item-reason">{{item.reason}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{canReceive}}" class="receive-section">
    <button class="receive-button" bindtap="onConfirmReceiveTap" loading="{{submitting}}" disabled="{{submitting}}">确认收货</button>
  </view>
</view>

<view wx:if="{{loading}}" class="loading">加载中...</view>
