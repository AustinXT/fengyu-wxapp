<!-- packageMy/inventory/form.wxml -->
<view class="container">
  <view class="source-card">
    <text class="source-label">发起门店</text>
    <text class="source-value">{{sourceStoreName || sourceStoreId || '当前门店'}}</text>
  </view>

  <view class="section">
    <view class="section-title">添加明细</view>

    <view wx:if="{{itemMode === 'reportableSku'}}" class="field">
      <text class="field-label">可报货产品</text>
      <view class="selector {{selectedSku ? '' : 'placeholder'}}" bindtap="onOpenSkuPicker">{{selectedSku ? selectedSku.displayName : '请选择可报货产品'}}</view>
      <view wx:if="{{selectedSku}}" class="stock-reference">本店库存参考：{{selectedSku.stockReference}}</view>
    </view>

    <!-- 门店盘点（#352）：盲盘，不展示账面数；账面数由服务端在提交时记入 -->
    <view wx:if="{{isStocktake}}" class="field">
      <text class="field-label">盘点产品</text>
      <view class="selector {{selectedSku ? '' : 'placeholder'}}" bindtap="onOpenSkuPicker">{{selectedSku ? selectedSku.displayName : '请选择盘点产品'}}</view>
    </view>

    <view wx:if="{{itemMode === 'stockLot'}}" class="field">
      <text class="field-label">库存批次</text>
      <picker range="{{stockOptions}}" range-key="displayName" value="{{selectedLotIndex < 0 ? 0 : selectedLotIndex}}" bindchange="onLotChange">
        <view class="selector {{selectedLot ? '' : 'placeholder'}}">{{selectedLot ? selectedLot.displayName : '请选择库存批次'}}</view>
      </picker>
      <view wx:if="{{selectedLot}}" class="stock-reference">当前库存：{{selectedLot.quantityOnHand}}</view>
    </view>

    <view wx:if="{{needsTargetStore}}" class="field">
      <text class="field-label">接收门店</text>
      <picker range="{{storeOptions}}" range-key="storeName" value="{{selectedStoreIndex < 0 ? 0 : selectedStoreIndex}}" bindchange="onStoreChange">
        <view class="selector {{selectedStore ? '' : 'placeholder'}}">{{selectedStore ? selectedStore.storeName : '请选择同市场接收门店'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">{{isStocktake ? '实盘数量' : '数量'}}</text>
      <input class="input" type="digit" placeholder="{{isStocktake ? '请输入货架上的实际数量，没有请填 0' : '请输入数量'}}" value="{{quantityInput}}" bindinput="onQuantityInput" />
    </view>

    <view wx:if="{{needsReason}}" class="field">
      <text class="field-label">报损原因</text>
      <input class="input" placeholder="请填写报损原因" value="{{reasonInput}}" bindinput="onReasonInput" maxlength="100" />
    </view>

    <button class="add-button" bindtap="onAddItem" disabled="{{loadingOptions}}">添加明细</button>
  </view>

  <view class="section">
    <view class="section-title">单据明细（{{items.length}}）</view>
    <view wx:if="{{items.length === 0}}" class="empty">{{isStocktake ? '请逐个选择产品并录入实盘数' : '请先添加产品或库存批次'}}</view>
    <view wx:for="{{items}}" wx:key="key" class="item-row">
      <view class="item-main">
        <text class="item-name">{{item.skuName}}</text>
        <text wx:if="{{item.specName}}" class="item-meta">{{item.specName}}</text>
        <text wx:if="{{item.batchNo}}" class="item-meta">批号：{{item.batchNo}}</text>
        <text wx:if="{{item.reason}}" class="item-reason">{{item.reason}}</text>
      </view>
      <view class="item-right">
        <text class="item-quantity">{{isStocktake ? '实盘 ' + item.quantity : '×' + item.quantity}}</text>
        <text class="remove" data-index="{{index}}" bindtap="onRemoveItem">删除</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">备注</view>
    <textarea class="remark" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" auto-height />
  </view>

  <!-- 选品弹层（#339 门店报货 / #352 门店盘点共用）：关键词防抖检索 + 上拉分页，替换只拉前 100 条的原生 picker -->
  <van-popup
    show="{{showSkuPicker}}"
    position="bottom"
    round
    custom-style="height: 75%;"
    bind:close="onCloseSkuPicker"
  >
    <view class="sku-picker">
      <view class="sku-picker-title">{{isStocktake ? '选择盘点产品' : '选择可报货产品'}}</view>
      <van-search
        value="{{skuKeyword}}"
        placeholder="输入编号 / 名称 / 规格搜索"
        bind:change="onSkuKeywordChange"
        bind:clear="onSkuKeywordClear"
      />
      <scroll-view scroll-y class="sku-picker-list" lower-threshold="80" bindscrolltolower="onSkuListReachBottom">
        <view
          wx:for="{{skuOptions}}"
          wx:key="skuId"
          class="sku-option {{selectedSku && selectedSku.skuId === item.skuId ? 'sku-option-active' : ''}}"
          data-index="{{index}}"
          bindtap="onSelectSku"
        >
          <text class="sku-option-name">{{item.displayName}}</text>
          <text wx:if="{{!isStocktake}}" class="sku-option-stock">本店库存 {{item.stockReference}}</text>
          <text wx:elif="{{addedSkuIds[item.skuId]}}" class="sku-option-stock sku-option-added">已添加</text>
          <text wx:elif="{{item.inStock}}" class="sku-option-stock">本店有货</text>
        </view>
        <view wx:if="{{skuLoading}}" class="sku-picker-tip">加载中…</view>
        <view wx:elif="{{skuError}}" class="sku-picker-tip sku-picker-error" bindtap="onRetrySkuPage">{{skuError}}，点击重试</view>
        <view wx:elif="{{skuOptions.length === 0}}" class="sku-picker-tip">{{isStocktake ? (skuKeyword ? '没有匹配的产品' : '暂无可盘点产品') : (skuKeyword ? '没有匹配的可报货产品' : '暂无可报货产品')}}</view>
        <view wx:elif="{{skuHasMore}}" class="sku-picker-tip sku-picker-more" bindtap="onLoadMoreSku">上拉或点击加载更多</view>
        <view wx:else class="sku-picker-tip">已显示全部 {{skuOptions.length}} 个产品</view>
      </scroll-view>
    </view>
  </van-popup>

  <view class="submit-bar">
    <button class="submit-button" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting || loadingOptions}}">提交单据</button>
  </view>
</view>
