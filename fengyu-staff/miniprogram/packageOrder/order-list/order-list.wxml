<!-- pages/order-list/order-list.wxml -->
<view class="container">
  <van-tabs active="{{tabActive}}" bind:change="onTabChange" color="#C0322A" sticky swipeable>
    <van-tab name="全部" title="全部" />
    <van-tab name="待支付" title="待支付" />
    <van-tab name="已支付" title="已支付" />
    <van-tab name="已完成" title="已完成" />
    <van-tab name="支付失败" title="支付失败" />
    <van-tab name="已关闭" title="已关闭" />
  </van-tabs>

  <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{!loading && list.length === 0}}" class="empty-wrap">
    <van-empty description="暂无订单" />
  </view>

  <scroll-view wx:else scroll-y class="list-scroll" bindscrolltolower="onLoadMore">
    <view class="order-card" wx:for="{{list}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">{{item.saleOrderId}}</text>
        <view class="status-wrap">
          <view wx:if="{{item.hasPendingRefund}}" class="refund-tag refund-tag--pending">退款审批中</view>
          <view wx:elif="{{item.hasRefund}}" class="refund-tag refund-tag--done">含退款</view>
          <view class="status-tag status-tag--{{item.statusClass}}">{{item.status}}</view>
        </view>
      </view>
      <view class="order-customer">
        <text class="customer-name">{{item.customerName}}</text>
        <text class="customer-phone">{{item.customerPhoneMasked}}</text>
      </view>
      <view class="order-meta">
        <text class="order-type-label">{{item.orderType}}</text>
        <text class="order-pay-type" wx:if="{{item.payType}}">{{item.payType === 'wechat' ? '微信支付' : '线下付款'}}</text>
        <text class="order-time">{{item.paidAt || item.createdAt}}</text>
      </view>
      <view class="order-footer">
        <text class="order-amount">¥ {{item.totalAmount}}</text>
        <view class="order-actions" catchtap="noop">
          <van-button
            wx:if="{{item.status === '待支付'}}"
            size="small" plain
            catchtap="onViewQrcode"
            data-id="{{item.id}}"
          >查看二维码</van-button>
          <van-button
            wx:if="{{item.status === '待支付' && item.payType === 'offline' && isManager}}"
            type="primary" size="small"
            custom-class="btn-primary-brand"
            catchtap="onConfirmOffline"
            data-id="{{item.id}}"
          >确认收款</van-button>
          <van-button
            wx:if="{{item.status === '待支付' && isManager}}"
            size="small" plain type="danger"
            catchtap="onCloseOrder"
            data-id="{{item.id}}"
          >关闭订单</van-button>
          <van-button
            wx:if="{{item.status === '待支付' && !isManager && item.openedBy && item.openedBy === currentStaffId}}"
            size="small" plain type="danger"
            catchtap="onCloseOrder"
            data-id="{{item.id}}"
          >取消订单</van-button>
          <van-button
            wx:if="{{item.status === '支付失败' && isManager}}"
            size="small" plain
            catchtap="onResetFailed"
            data-id="{{item.id}}"
          >重置支付</van-button>
          <van-button
            wx:if="{{item.allocatable && (item.status === '已支付' || item.status === '已完成') && isManager}}"
            size="small" plain type="primary"
            catchtap="onAllocate"
            data-id="{{item.id}}"
          >营业额分配</van-button>
          <van-button size="small" plain catchtap="onItemTap" data-id="{{item.id}}">详情</van-button>
        </view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loading-more">
      <van-loading type="spinner" size="24rpx" color="#C0322A">加载中...</van-loading>
    </view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </scroll-view>

  <view class="safe-area-bottom" />
</view>
