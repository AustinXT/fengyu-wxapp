/* pages/order-list/order-list.wxss */

.list-scroll {
  height: calc(100vh - 88rpx);
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no { font-size: 24rpx; color: #666; font-family: monospace; }

.status-wrap { display: flex; align-items: center; gap: 8rpx; }

.refund-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.3;
}
.refund-tag--pending { color: #D4820A; background: #FFF4E0; }
.refund-tag--done    { color: #C62828; background: #FBECEC; }


.order-customer {
  display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx;
}
.customer-name { font-size: 30rpx; font-weight: 600; color: #2D2017; }
.customer-phone { font-size: 26rpx; color: #999; }

.order-meta {
  display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx;
}
.order-type-label, .order-pay-type {
  font-size: 22rpx; color: #666;
  background: #F5F2EE; padding: 2rpx 10rpx; border-radius: 6rpx;
}
.order-time { font-size: 22rpx; color: #999; margin-left: auto; }

.order-footer {
  display: flex; align-items: center; justify-content: space-between;
}
.order-amount { font-size: 36rpx; font-weight: 700; color: var(--color-primary); }
.order-actions { display: flex; gap: 16rpx; }

.loading-more {
  display: flex; justify-content: center; padding: 24rpx 0;
}
.no-more {
  text-align: center; padding: 24rpx 0;
}
.no-more-text {
  font-size: 24rpx; color: #999;
}
