<!-- packageOrder/dashboard/dashboard.wxml — 数据看板 -->
<view class="container dashboard-page">

  <!-- 时间范围选择 -->
  <view class="dash-header">
    <text class="dash-date">{{displayDate}}</text>
    <view class="dash-range-btns">
      <view class="range-btn {{rangeType === 'today' ? 'range-btn--active' : ''}}" bindtap="onRangeTap" data-type="today">今日</view>
      <view class="range-btn {{rangeType === 'month' ? 'range-btn--active' : ''}}" bindtap="onRangeTap" data-type="month">本月</view>
      <view class="range-btn {{rangeType === 'lastMonth' ? 'range-btn--active' : ''}}" bindtap="onRangeTap" data-type="lastMonth">上月</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:else class="dash-metrics">
    <!-- 业绩（最大卡片） -->
    <view class="metric-card metric-card--large">
      <view class="metric-icon-wrap metric-icon--primary">
        <van-icon name="gold-coin-o" size="48rpx" color="#FFFFFF" />
      </view>
      <view class="metric-body">
        <text class="metric-label">业绩</text>
        <text class="metric-desc">收款金额汇总</text>
      </view>
      <view class="metric-value-wrap">
        <text class="metric-unit">¥</text>
        <text class="metric-value">{{revenue}}</text>
      </view>
    </view>

    <!-- 消耗 -->
    <view class="metric-card">
      <view class="metric-icon-wrap metric-icon--blue">
        <van-icon name="fire-o" size="40rpx" color="#FFFFFF" />
      </view>
      <view class="metric-body">
        <text class="metric-label">消耗</text>
        <text class="metric-desc">划卡单价汇总</text>
      </view>
      <view class="metric-value-wrap">
        <text class="metric-unit">¥</text>
        <text class="metric-value">{{consume}}</text>
      </view>
    </view>

    <!-- 客流 -->
    <view class="metric-card">
      <view class="metric-icon-wrap metric-icon--green">
        <van-icon name="friends-o" size="40rpx" color="#FFFFFF" />
      </view>
      <view class="metric-body">
        <text class="metric-label">客流</text>
        <text class="metric-desc">一人一天算一次</text>
      </view>
      <text class="metric-count">{{footfall}}</text>
    </view>

    <!-- 客量 -->
    <view class="metric-card">
      <view class="metric-icon-wrap metric-icon--orange">
        <van-icon name="user-o" size="40rpx" color="#FFFFFF" />
      </view>
      <view class="metric-body">
        <text class="metric-label">客量</text>
        <text class="metric-desc">顾客去重</text>
      </view>
      <text class="metric-count">{{headcount}}</text>
    </view>

    <!-- 新会员 -->
    <view class="metric-card">
      <view class="metric-icon-wrap metric-icon--purple">
        <van-icon name="medal-o" size="40rpx" color="#FFFFFF" />
      </view>
      <view class="metric-body">
        <text class="metric-label">新会员</text>
        <text class="metric-desc">首次消费≥1980</text>
      </view>
      <text class="metric-count">{{newMembers}}</text>
    </view>
  </view>

  <view class="dash-note">
    <text class="dash-note-text">{{isManager ? '展示本店全部数据' : '展示您的个人数据'}}</text>
  </view>

  <view class="safe-area-bottom" />
</view>
