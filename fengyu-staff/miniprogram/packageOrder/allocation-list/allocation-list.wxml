<!-- packageOrder/allocation-list/allocation-list.wxml — 营业额分配（销售提成 / 服务提成） -->
<view class="container">

  <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#C0322A" line-width="40rpx">
    <van-tab title="销售提成" name="sale" />
    <van-tab title="服务提成" name="service" />
  </van-tabs>

  <view class="filter-panel">
    <van-search
      value="{{searchInput}}"
      placeholder="搜索顾客姓名或手机号"
      bind:change="onSearchChange"
      bind:search="onSearch"
      bind:clear="onSearchClear"
      use-action-slot
    >
      <view slot="action" bindtap="onSearch">搜索</view>
    </van-search>
    <view class="filter-row">
      <van-dropdown-menu active-color="#C0322A" custom-class="status-dropdown">
        <van-dropdown-item value="{{status}}" options="{{statusOptions}}" bind:change="onStatusChange" />
      </van-dropdown-menu>
      <picker mode="date" value="{{startDate}}" end="{{endDate}}" bindchange="onStartDateChange">
        <view class="date-chip">{{startDate || '开始日期'}}</view>
      </picker>
      <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndDateChange">
        <view class="date-chip">{{endDate || '结束日期'}}</view>
      </picker>
      <view wx:if="{{startDate || endDate}}" class="filter-clear" bindtap="clearDates">清除</view>
    </view>
  </view>

  <view wx:if="{{loading && orders.length === 0}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <van-empty wx:elif="{{!loading && orders.length === 0}}" description="暂无数据" />

  <block wx:else>
    <!-- 销售提成卡片（按回款逐笔分配：每张卡 = 一笔回款事件） -->
    <block wx:if="{{activeTab === 'sale'}}">
      <view
        class="order-card"
        wx:for="{{orders}}"
        wx:key="sale_payment_id"
        data-id="{{item.sale_payment_id}}"
        bindtap="onTapOrder"
      >
        <view class="card-header">
          <text class="order-no">{{item.change_type}} · ¥{{item.amount}}</text>
          <view class="tag-group">
            <van-tag wx:if="{{item.preferred_employee_id}}" color="#7B1FA2" plain>已指定美容师</van-tag>
            <van-tag color="{{item.allocation_status === '已分配' ? '#3D8A5A' : '#D4820A'}}" plain>{{item.allocation_status}}</van-tag>
          </view>
        </view>
        <view class="card-body">
          <view class="info-row">
            <text class="info-label">顾客</text>
            <text class="info-value">{{item.customer_name || '未知'}} {{item.client_phone || ''}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">订单</text>
            <text class="info-value">{{item.sale_order_id}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">到账</text>
            <text class="info-value">{{item.time_display || item.paid_at}} · {{item.payment_method}}</text>
          </view>
        </view>
        <view class="card-footer">
          <text class="action-hint">{{item.allocation_status === '已分配' ? '点击查看 / 调整' : '点击分配提成'}}</text>
          <van-icon name="arrow" size="28rpx" color="#999" />
        </view>
      </view>
    </block>

    <!-- 服务提成卡片 -->
    <block wx:else>
      <view
        class="order-card"
        wx:for="{{orders}}"
        wx:key="service_order_id"
        data-id="{{item.service_order_id}}"
        bindtap="onTapOrder"
      >
        <view class="card-header">
          <text class="order-no">{{item.service_order_id}}</text>
          <view class="tag-group">
            <van-tag color="{{item.commission_status === '已分配' ? '#3D8A5A' : '#D4820A'}}" plain>{{item.commission_status}}</van-tag>
          </view>
        </view>
        <view class="card-body">
          <view class="info-row">
            <text class="info-label">顾客</text>
            <text class="info-value">{{item.customer_name || '未知'}} {{item.client_phone || ''}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">美容师</text>
            <text class="info-value">{{item.employee_name || '—'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">服务日期</text>
            <text class="info-value">{{item.time_display || item.service_date}}</text>
          </view>
        </view>
        <view class="card-footer">
          <text class="action-hint">{{item.commission_status === '已分配' ? '点击查看 / 调整' : '点击分配提成'}}</text>
          <van-icon name="arrow" size="28rpx" color="#999" />
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{loading && orders.length > 0}}" class="loading-more">
    <van-loading size="24px" color="#999">加载中...</van-loading>
  </view>
  <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">没有更多了</view>

  <view class="safe-area-bottom" />
</view>
