

.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }
.loading-more { display: flex; justify-content: center; padding: 32rpx 0; }

.status-switch {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 4rpx;
}
.status-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 999rpx;
  padding: 12rpx 0;
}
.status-btn.active {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: rgba(192, 50, 42, 0.06);
  font-weight: 600;
}

.order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.order-no { font-size: 22rpx; color: #999; font-family: monospace; }
.tag-group { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }

.card-body { margin-bottom: 16rpx; }

.info-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.info-label { font-size: 24rpx; color: #999; width: 120rpx; }
.info-value { font-size: 26rpx; color: #2D2017; flex: 1; }
.info-value.amount { font-weight: 700; color: var(--color-primary); font-size: 30rpx; }

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 16rpx;
}
.action-hint { font-size: 24rpx; color: #D4820A; }
