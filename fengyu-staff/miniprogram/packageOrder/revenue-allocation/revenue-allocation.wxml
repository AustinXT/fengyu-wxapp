<!-- packageOrder/revenue-allocation/revenue-allocation.wxml — 提成分配 -->
<wxs module="fmt">
module.exports.pct = function(rate) {
  return (rate * 100).toFixed(1);
}
</wxs>
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <block wx:else>
    <!-- 订单摘要 -->
    <view class="order-header">
      <text class="order-no">{{orderNo}}</text>
      <view class="header-info">
        <text class="customer-name">{{order.customer_name || '未知顾客'}}</text>
        <text class="paid-at" wx:if="{{order.paid_at}}">支付于 {{order.paid_at}}</text>
      </view>
      <view class="amount-row">
        <text class="amount-label">实收金额</text>
        <text class="amount-value">¥{{order.totalAmount}}</text>
      </view>
    </view>

    <!-- 已分配提示 -->
    <view wx:if="{{isAllocated}}" class="status-notice status-notice--allocated">
      <van-icon name="passed" size="28rpx" color="#3D8A5A" />
      <text class="status-text">该订单已分配，可修改后重新保存</text>
    </view>

    <!-- 按订单项分组的分配行 -->
    <view class="alloc-section" wx:for="{{items}}" wx:for-item="item" wx:key="item_flow_no">
      <view class="item-header">
        <view class="item-name-row">
          <text class="item-name">{{item.spu_name || item.sku_display_name}}</text>
          <van-tag wx:if="{{item.sales_category}}" plain color="#666" size="medium">{{item.sales_category}}</van-tag>
        </view>
        <text class="item-amount">¥{{item.receivable}}</text>
      </view>

      <!-- 该 item 的各部门分配行 -->
      <block wx:for="{{allocLines}}" wx:for-item="line" wx:for-index="lineIdx" wx:key="lineIdx">
        <view class="dept-row" wx:if="{{line.itemFlowNo === item.item_flow_no}}">
          <view class="dept-label-row">
            <text class="dept-name">{{line.department}}</text>
            <text class="rate-badge">{{fmt.pct(line.commissionRate)}}%</text>
          </view>
          <view class="dept-input-row">
            <!-- 员工选择 -->
            <view class="staff-selector" data-index="{{lineIdx}}" bindtap="onTapStaff">
              <text wx:if="{{line.staffName}}" class="staff-name-text">{{line.staffName}}</text>
              <text wx:else class="staff-placeholder">选员工</text>
              <van-icon name="arrow-down" size="24rpx" color="#999" />
            </view>
            <!-- 金额 -->
            <view class="amount-input-wrap">
              <text class="currency-symbol">¥</text>
              <input
                class="amount-input"
                type="digit"
                value="{{line.amount}}"
                data-index="{{lineIdx}}"
                bindinput="onAmountChange"
              />
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 汇总 -->
    <view class="summary-section" wx:if="{{summary.length > 0}}">
      <view class="summary-title">分配汇总</view>
      <view class="summary-row" wx:for="{{summary}}" wx:key="index">
        <text class="summary-name">{{item.staffName}} ({{item.department}})</text>
        <text class="summary-amount">¥{{item.total}}</text>
      </view>
      <view class="summary-grand">
        <text class="summary-grand-label">合计</text>
        <text class="summary-grand-value">¥{{grandTotal}}</text>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="action-bar">
      <van-button
        type="primary"
        block
        loading="{{submitting}}"
        custom-style="background:#C0322A;border-color:#C0322A;border-radius:48rpx;"
        bind:click="onSave"
      >保存分配方案</van-button>
    </view>
  </block>

  <!-- 员工选择弹出层 -->
  <van-popup show="{{showPicker}}" position="bottom" bind:close="onPickerCancel">
    <van-picker
      title="选择员工"
      show-toolbar
      columns="{{pickerColumns}}"
      bind:confirm="onPickerConfirm"
      bind:cancel="onPickerCancel"
    />
  </van-popup>

  <view class="safe-area-bottom" />
</view>
