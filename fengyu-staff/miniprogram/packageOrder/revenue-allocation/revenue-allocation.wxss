/* packageOrder/revenue-allocation/revenue-allocation.wxss */

.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }

/* 订单头部 */
.order-header {
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.order-no { display: block; font-size: 22rpx; color: #999; font-family: monospace; margin-bottom: 8rpx; }
.header-info { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.customer-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.paid-at { font-size: 22rpx; color: #999; }
.amount-row { display: flex; align-items: baseline; gap: 16rpx; }
.amount-label { font-size: 26rpx; color: #666; }
.amount-value { font-size: 48rpx; font-weight: 700; color: #C0322A; }

/* 状态提示 */
.status-notice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
}
.status-notice--allocated { background: #E8F5E9; }
.status-text { font-size: 24rpx; color: #3D8A5A; }

/* 分配区域 — 按订单项分组 */
.alloc-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.item-name-row { display: flex; align-items: center; gap: 12rpx; flex: 1; }
.item-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.item-amount { font-size: 28rpx; font-weight: 700; color: #C0322A; white-space: nowrap; margin-left: 16rpx; }

/* 部门分配行 */
.dept-row {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
}
.dept-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.dept-name { font-size: 26rpx; font-weight: 600; color: #2D2017; }
.rate-badge {
  font-size: 22rpx;
  color: #D4820A;
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.dept-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.staff-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  flex: 1;
}
.staff-name-text { font-size: 26rpx; color: #2D2017; flex: 1; }
.staff-placeholder { font-size: 26rpx; color: #BBB; flex: 1; }

.amount-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 72rpx;
  width: 240rpx;
}
.currency-symbol { font-size: 26rpx; color: #C0322A; font-weight: 600; margin-right: 4rpx; }
.amount-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2017;
}

/* 汇总 */
.summary-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
}
.summary-title { font-size: 26rpx; font-weight: 600; color: #2D2017; margin-bottom: 16rpx; }
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.summary-name { font-size: 26rpx; color: #666; }
.summary-amount { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.summary-grand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 12rpx;
  padding-top: 12rpx;
}
.summary-grand-label { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.summary-grand-value { font-size: 32rpx; font-weight: 700; color: #C0322A; }

/* 操作区 */
.action-bar { padding: 0 32rpx 32rpx; }
