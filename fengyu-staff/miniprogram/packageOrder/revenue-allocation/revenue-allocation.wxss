/* packageOrder/revenue-allocation/revenue-allocation.wxss */


/* 订单头部 */
.order-header {
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.order-no { display: block; font-size: 22rpx; color: #999; font-family: monospace; margin-bottom: 8rpx; }
.header-info { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.customer-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.paid-at { font-size: 22rpx; color: #999; }
.amount-row { display: flex; align-items: baseline; gap: 16rpx; }
.amount-label { font-size: 26rpx; color: #666; }
.amount-value { font-size: 48rpx; font-weight: 700; color: var(--color-primary); }

/* 上下文提示区 */
.context-hints {
  margin: 0 32rpx 24rpx;
}
.hint-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.hint-item:last-child { margin-bottom: 0; }
.hint-item--success { background: #E8F5E9; }
.hint-item--warn { background: #FFF3E0; }
.hint-item--new { background: #F3E5F5; }
.hint-text { font-size: 24rpx; color: #333; line-height: 1.5; flex: 1; }

/* 状态提示 */
.status-notice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
}
.status-notice--allocated { background: #E8F5E9; }
.status-notice--warn { background: #FFF3E0; }
.status-notice--frozen { background: #FDECEC; }
.status-text { font-size: 24rpx; color: #3D8A5A; }
.status-notice--warn .status-text { color: #E65100; }
.status-notice--frozen .status-text { color: #D94040; }

/* 分配区域 — 按订单项分组 */
.alloc-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.item-name-row { display: flex; align-items: center; gap: 12rpx; flex: 1; }
.item-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.item-amount { font-size: 28rpx; font-weight: 700; color: var(--color-primary); white-space: nowrap; margin-left: 16rpx; }

/* 分配行 */
.alloc-line {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.line-fields {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.field--ratio { flex: 0 0 150rpx; }
.field-label { font-size: 20rpx; color: #999; }
.field-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 10rpx;
  padding: 0 12rpx;
  height: 60rpx;
  font-size: 26rpx;
  color: #2D2017;
}
.field-value.placeholder { color: #BBB; }
.remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 60rpx;
  flex-shrink: 0;
}

/* 只读派生：提成% / 分配额 / 提成额 */
.line-derived {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #ECECEC;
}
.derived-item { font-size: 24rpx; color: #666; }
.derived-strong { color: #2D2017; font-weight: 600; }
.derived-warn { color: #D4820A; font-weight: 600; }
.derived-primary { color: var(--color-primary); font-weight: 600; margin-left: auto; }

/* 添加人员按钮 */
.add-person-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  margin-top: 4rpx;
}
.add-person-text {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 选人弹窗 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2017;
}
.picker-scroll {
  height: 720rpx;
  padding: 0 32rpx;
  /* scroll-view 默认 content-box，不加 box-sizing 左右 padding 会把行内容整体挤出屏幕右侧 */
  box-sizing: border-box;
}
.picker-group {
  margin-bottom: 16rpx;
}
.picker-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  padding: 20rpx 0 12rpx;
  position: sticky;
  top: 0;
  background: #FFFFFF;
}
.picker-member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.picker-member:active {
  background: #F5F5F5;
}
/* text 默认 inline，显式块化才保证 ellipsis 生效（与全仓其它截断场景写法一致） */
.picker-member-name {
  display: block;
  /* 不收缩：姓名必须完整，长门店名不得挤压它 */
  flex: 0 0 auto;
  /* 极端长姓名的兜底，避免反过来把门店名挤没 */
  max-width: 60%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: #2D2017;
}
.picker-member-store {
  display: block;
  /* basis 0 + grow：吃满姓名以外的剩余宽度，ellipsis 的可用宽度才确定 */
  flex: 1 1 0;
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: right;
  font-size: 22rpx;
  color: #999;
}
.picker-empty {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 80rpx 0;
}

/* 汇总 */
.summary-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
}
.summary-title { font-size: 26rpx; font-weight: 600; color: #2D2017; margin-bottom: 16rpx; }
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.summary-name { font-size: 26rpx; color: #666; }
.summary-amount { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.summary-grand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 12rpx;
  padding-top: 12rpx;
}
.summary-grand-label { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.summary-grand-value { font-size: 32rpx; font-weight: 700; color: var(--color-primary); }

/* 操作区 */
.action-bar { padding: 0 32rpx 32rpx; }
