/* packageOrder/revenue-allocation/revenue-allocation.wxss */

.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }

/* 订单头部 */
.order-header {
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.order-no { display: block; font-size: 22rpx; color: #999; font-family: monospace; margin-bottom: 8rpx; }
.header-info { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.customer-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.paid-at { font-size: 22rpx; color: #999; }
.amount-row { display: flex; align-items: baseline; gap: 16rpx; }
.amount-label { font-size: 26rpx; color: #666; }
.amount-value { font-size: 48rpx; font-weight: 700; color: #C0322A; }

/* 上下文提示区 */
.context-hints {
  margin: 0 32rpx 24rpx;
}
.hint-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.hint-item:last-child { margin-bottom: 0; }
.hint-item--success { background: #E8F5E9; }
.hint-item--warn { background: #FFF3E0; }
.hint-item--new { background: #F3E5F5; }
.hint-text { font-size: 24rpx; color: #333; line-height: 1.5; flex: 1; }

/* 状态提示 */
.status-notice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
}
.status-notice--allocated { background: #E8F5E9; }
.status-text { font-size: 24rpx; color: #3D8A5A; }

/* 分配区域 — 按订单项分组 */
.alloc-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.item-name-row { display: flex; align-items: center; gap: 12rpx; flex: 1; }
.item-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.item-amount { font-size: 28rpx; font-weight: 700; color: #C0322A; white-space: nowrap; margin-left: 16rpx; }

/* 人员行 */
.person-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
}
.person-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.person-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2017;
  flex-shrink: 0;
}
.rate-badge {
  font-size: 22rpx;
  color: #D4820A;
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.person-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #F5F5F5;
}

/* 金额输入 */
.amount-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 64rpx;
  width: 200rpx;
}
.currency-symbol { font-size: 26rpx; color: #C0322A; font-weight: 600; margin-right: 4rpx; }
.amount-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2017;
}

/* 添加人员按钮 */
.add-person-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  margin-top: 4rpx;
}
.add-person-text {
  font-size: 26rpx;
  color: #C0322A;
}

/* 选人弹窗 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2017;
}
.picker-scroll {
  height: 720rpx;
  padding: 0 32rpx;
}
.picker-group {
  margin-bottom: 16rpx;
}
.picker-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  padding: 20rpx 0 12rpx;
  position: sticky;
  top: 0;
  background: #FFFFFF;
}
.picker-member {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.picker-member:active {
  background: #F5F5F5;
}
.picker-member-name {
  font-size: 28rpx;
  color: #2D2017;
}

/* 汇总 */
.summary-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
}
.summary-title { font-size: 26rpx; font-weight: 600; color: #2D2017; margin-bottom: 16rpx; }
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.summary-name { font-size: 26rpx; color: #666; }
.summary-amount { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.summary-grand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 12rpx;
  padding-top: 12rpx;
}
.summary-grand-label { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.summary-grand-value { font-size: 32rpx; font-weight: 700; color: #C0322A; }

/* 操作区 */
.action-bar { padding: 0 32rpx 32rpx; }
