<!-- pages/order-detail/order-detail.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{!order}}" class="empty-wrap">
    <van-empty description="订单不存在" />
  </view>

  <block wx:else>
    <!-- 状态条 -->
    <view class="status-banner status-banner--{{statusClass}}">
      <text class="status-text">{{order.status}}</text>
      <text wx:if="{{refundBadge}}" class="refund-badge">{{refundBadge}}</text>
      <text class="order-no-top">{{order.saleOrderId}}</text>
    </view>

    <!-- 订单信息 -->
    <van-cell-group title="订单信息" class="card-group">
      <van-cell title="下单人" value="{{order.customerName || '—'}}" />
      <van-cell title="手机号" value="{{isManager ? order.customerPhone : order.customerPhoneMasked}}" />
      <van-cell title="所属门店" value="{{order.storeName || '—'}}" />
      <van-cell wx:if="{{order.marketName}}" title="所属市场" value="{{order.marketName}}" />
      <van-cell title="订单来源" value="{{order.orderSourceLabel}}" />
      <van-cell title="下单方式" value="{{order.orderTypeLabel}}" />
      <van-cell wx:if="{{order.documentType}}" title="单据类型" value="{{order.documentType}}" />
      <van-cell wx:if="{{order.refOrderId}}" title="关联原单" value="{{order.refOrderId}}" />
      <van-cell wx:if="{{order.preferredStaffName}}" title="指定美容师" value="{{order.preferredStaffName}}" />
      <van-cell title="支付方式" value="{{order.payTypeLabel}}" />
      <van-cell wx:if="{{order.couponName || order.couponDiscount}}" title="优惠券" value="{{order.couponName}}{{order.couponDiscount ? ' -¥' + order.couponDiscount : ''}}" />
      <van-cell wx:if="{{order.confirmedBy}}" title="确认人" value="{{order.confirmedBy}}" />
      <van-cell wx:if="{{order.confirmedAt}}" title="确认时间" value="{{order.confirmedAt}}" />
      <van-cell wx:if="{{order.allocationStatus}}" title="分配状态" value="{{order.allocationStatus}}" />
      <van-cell title="创建时间" value="{{order.createdAt}}" />
      <van-cell wx:if="{{order.paidAt}}" title="支付时间" value="{{order.paidAt}}" />
      <van-cell wx:if="{{order.isLegacy}}" title="数据来源" value="历史导入订单" />
      <van-cell wx:if="{{order.remark}}" title="备注" value="{{order.remark}}" />
    </van-cell-group>

    <!-- 订单明细 -->
    <view class="card-group items-card">
      <text class="items-title">订单明细</text>
      <view class="order-item" wx:for="{{order.items}}" wx:key="saleItemId">
        <view class="item-name-row">
          <text class="item-name">{{item.itemName || '—'}}</text>
          <text class="item-spec">{{item.spec || '—'}}</text>
        </view>
        <view class="item-price-row">
          <text class="item-price">实收 ¥{{item.totalPrice}}</text>
          <text wx:if="{{item.sessionCount > 1}}" class="item-sessions">
            已用 {{item.usedSessions}} / 已付 {{item.paidSessions}} / 共 {{item.sessionCount}} 次
          </text>
        </view>
        <!-- 三段进度条：已用（灰）/ 剩余可用（主色）/ 已付未用（浅色）/ 未付（灰条余下） -->
        <view wx:if="{{item.sessionCount > 1}}" class="session-bar">
          <view class="session-bar__seg session-bar__seg--remain" style="width:{{item.remainPct}}%"></view>
          <view class="session-bar__seg session-bar__seg--paid-unused" style="width:{{item.paidUnusedPct}}%"></view>
          <view class="session-bar__seg session-bar__seg--unpaid" style="width:{{item.unpaidPct}}%"></view>
        </view>
        <!-- 明细扩展：原价划线 / 销售分类 / 过期日期 / 已提货数量 -->
        <view wx:if="{{item.hasDiscount || item.salesCategory || item.expireDate || item.pickedUpQuantity > 0}}" class="item-extra">
          <text wx:if="{{item.hasDiscount}}" class="item-extra-tag">单价 <text class="item-origin-price">¥{{item.unitPrice}}</text> ¥{{item.unitRealPrice}}</text>
          <text wx:if="{{item.salesCategory}}" class="item-extra-tag">{{item.salesCategory}}</text>
          <text wx:if="{{item.expireDate}}" class="item-extra-tag">有效期至 {{item.expireDate}}</text>
          <text wx:if="{{item.pickedUpQuantity > 0}}" class="item-extra-tag">已提 {{item.pickedUpQuantity}}</text>
        </view>
        <text class="item-flow-no">{{item.saleItemId}}</text>
      </view>
      <view class="total-row">
        <text class="total-label">合计</text>
        <text class="total-amount">¥{{order.totalAmount}}</text>
      </view>
    </view>

    <!-- Ticket 2 PR-A：欠款 + 款项流水 -->
    <view wx:if="{{order.hasDebt || order.payments.length > 0}}" class="card-group items-card">
      <text class="items-title">款项情况</text>
      <view wx:if="{{order.hasDebt}}" class="debt-row">
        <view class="debt-col">
          <text class="debt-label">应付</text>
          <text class="debt-value">¥{{order.payableAmount}}</text>
        </view>
        <view class="debt-col">
          <text class="debt-label">已付</text>
          <text class="debt-value">¥{{order.paidAmount}}</text>
        </view>
        <view class="debt-col">
          <text class="debt-label debt-label--hot">欠款</text>
          <text class="debt-value debt-value--hot">¥{{order.remainingPayable}}</text>
        </view>
      </view>
      <!-- 款项流水（payments 非空时展示） -->
      <view wx:if="{{order.payments.length > 0}}" class="pay-list">
        <view
          wx:for="{{order.payments}}"
          wx:key="timeFmt"
          wx:for-item="p"
          class="pay-row"
        >
          <view class="pay-row-left">
            <text class="pay-type">{{p.changeType}}</text>
            <text class="pay-meta">{{p.timeFmt}} · {{p.paymentMethod}}</text>
            <text wx:if="{{p.note}}" class="pay-note">{{p.note}}</text>
          </view>
          <view class="pay-row-right">
            <text class="pay-amount {{p.isRefund ? 'pay-amount--refund' : ''}}">
              {{p.isRefund ? '-¥' : '¥'}}{{p.amountAbs}}
            </text>
            <text class="pay-status" wx:if="{{p.status !== '已支付'}}">{{p.status}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 营业额分配（仅店长 + 已支付/已完成可见） -->
    <view wx:if="{{isManager && order.allocatable && (order.status === '已支付' || order.status === '已完成') && order.allocation.length > 0}}" class="card-group items-card">
      <text class="items-title">营业额分配</text>
      <view class="alloc-row" wx:for="{{order.allocation}}" wx:key="id">
        <view class="alloc-row-left">
          <text class="alloc-staff">{{item.staffName}}<text wx:if="{{item.roleType}}">（{{item.roleType}}）</text></text>
          <text class="alloc-meta">{{item.saleItemName}} · 比例{{item.ratio}} · 提成率{{item.commissionRate}} · 分配额¥{{item.totalAmount}}</text>
        </view>
        <view class="alloc-row-right">
          <text class="alloc-amount">¥{{item.commissionAmount}}</text>
        </view>
      </view>
      <view class="re-alloc-btn">
        <van-button size="small" plain type="primary" bind:click="onReAllocation"
          custom-class="btn-outline-brand">重新分配</van-button>
      </view>
    </view>

    <!-- 无分配时入口（仅店长 + 已支付/已完成） -->
    <view wx:if="{{isManager && order.allocatable && (order.status === '已支付' || order.status === '已完成') && order.allocation.length === 0}}" class="card-group items-card">
      <van-button block plain type="primary"
        custom-class="btn-outline-brand"
        bind:click="onReAllocation"
      >营业额分配</van-button>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <van-button
        wx:if="{{isManager && order.status === '待支付' && order.payType === 'offline'}}"
        block type="primary"
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:click="onConfirmOffline"
      >确认线下收款</van-button>
      <van-button
        wx:if="{{isManager && order.status === '支付失败'}}"
        block type="warning"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:click="onResetFailed"
      >重置支付失败</van-button>
      <van-button
        wx:if="{{(isManager || isCreator) && order.status === '待支付'}}"
        block plain type="primary"
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onShowQrcode"
      >查看收款码</van-button>
      <van-button
        wx:if="{{(isManager || isCreator) && order.status === '待支付'}}"
        block plain type="danger"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCloseOrder"
      >取消订单</van-button>
      <!-- Ticket 2 PR-A：发起回款（店长 + 有欠款） -->
      <van-button
        wx:if="{{isManager && order.hasDebt}}"
        block type="primary"
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;"
        bind:click="onRepayTap"
      >发起回款（欠 ¥{{order.remainingPayable}}）</van-button>

      <!-- 创建服务单（已支付 + 非家居产品订单） -->
      <van-button
        wx:if="{{order.status === '已支付'}}"
        block plain type="primary"
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCreateService"
      >创建服务单</van-button>
      <!-- P2: 退款按钮（已支付/已完成 + 仅销售单；员工可发起→店长审批，对齐后端 requireStaffBound + 充值卡退款按钮；充值单走下方专用按钮） -->
      <van-button
        wx:if="{{(order.status === '已支付' || order.status === '已完成') && order.orderType === '销售单'}}"
        block plain type="danger"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCreateRefund"
      >申请退款</van-button>

      <!-- 充值卡退款（充值单专用，走 card.createRefund 退卡内余额，员工可发起→店长审批） -->
      <van-button
        wx:if="{{order.status === '已支付' && order.orderType === '充值单'}}"
        block plain type="danger"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCreateCardRefund"
      >充值卡退款</van-button>

      <!-- 退款审批已收口到 refund-list/refund-detail 页（后端 sale_order_type 枚举已无「退款单」，此处按钮恒不命中，已删除死代码 Bug D） -->

      <!-- 终态：返回工作台 -->
      <van-button
        wx:if="{{order.status === '已关闭' || (!isManager && (order.status === '已完成' || order.status === '已支付'))}}"
        block plain round
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onBackToWorkbench"
      >返回工作台</van-button>
    </view>
  </block>

  <!-- P2: 退款原因对话框 -->
  <van-dialog
    use-slot
    title="申请退款"
    show="{{showRefundDialog}}"
    show-cancel-button
    confirm-button-color="#C0322A"
    bind:confirm="onConfirmRefund"
    bind:cancel="onCancelRefund"
    confirm-button-text="提交"
  >
    <view style="padding: 16rpx 24rpx;">
      <van-field
        label="退款原因"
        placeholder="请填写退款原因"
        type="textarea"
        maxlength="200"
        autosize
        value="{{refundReason}}"
        bind:change="onRefundReasonChange"
      />
    </view>
  </van-dialog>

  <!-- Ticket 2 PR-A：发起回款弹层 -->
  <van-popup
    show="{{showRepayPopup}}"
    position="bottom"
    round
    custom-style="padding: 32rpx 0; max-height: 85vh;"
    bind:close="onCloseRepayPopup"
    closeable
  >
    <view class="repay-popup">
      <view class="repay-title">按子项回款</view>
      <view class="repay-debt">
        欠款金额：<text class="repay-debt-hot">¥{{order.remainingPayable}}</text>
        <text class="repay-debt-tip">（可只对部分子项回款，不要求一次性付清）</text>
      </view>

      <van-field
        label="支付方式"
        readonly
        clickable="{{false}}"
      >
        <view slot="input" class="repay-method-row">
          <van-radio-group value="{{repayMethod}}" bind:change="onRepayMethodChange" direction="horizontal">
            <van-radio name="线下" checked-color="#C0322A">现金/扫码回执</van-radio>
            <van-radio name="储值卡" checked-color="#C0322A">储值卡</van-radio>
            <van-radio name="微信" checked-color="#C0322A" disabled>微信（开发中）</van-radio>
          </van-radio-group>
        </view>
      </van-field>

      <!-- 按子项金额表 -->
      <view class="repay-lines">
        <view wx:for="{{repayLines}}" wx:key="saleItemId" class="repay-line">
          <view class="repay-line-info">
            <text class="repay-line-name">{{item.itemName}}</text>
            <text class="repay-line-sub">可回款 ¥{{item.repayable}}</text>
          </view>
          <van-field
            wx:if="{{repayMethod !== '储值卡'}}"
            type="digit"
            placeholder="现金"
            value="{{item.cash}}"
            data-index="{{index}}"
            data-col="cash"
            bind:change="onRepayLineChange"
            custom-class="repay-line-input"
          />
          <van-field
            type="digit"
            placeholder="储值卡"
            value="{{item.card}}"
            data-index="{{index}}"
            data-col="card"
            bind:change="onRepayLineChange"
            custom-class="repay-line-input"
          />
        </view>
      </view>

      <view class="repay-debt">
        本次合计：<text class="repay-debt-hot">¥{{repayGrandTotal}}</text>
        <text class="repay-line-sub">现金 ¥{{repayCashTotal}} · 储值卡 ¥{{repayCardTotal}}</text>
      </view>

      <van-field
        label="备注"
        type="textarea"
        placeholder="可选备注"
        maxlength="100"
        autosize
        value="{{repayNote}}"
        bind:change="onRepayNoteChange"
      />

      <view class="repay-actions">
        <van-button block plain type="default" bind:click="onCloseRepayPopup">取消</van-button>
        <van-button
          block type="primary"
          custom-class="btn-primary-brand"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:click="onConfirmRepay"
        >确认回款</van-button>
      </view>
    </view>
  </van-popup>

  <view class="safe-area-bottom" />
</view>
