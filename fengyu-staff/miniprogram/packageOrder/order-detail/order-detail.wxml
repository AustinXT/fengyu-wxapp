<!-- pages/order-detail/order-detail.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{!order}}" class="empty-wrap">
    <van-empty description="订单不存在" />
  </view>

  <block wx:else>
    <!-- 状态条 -->
    <view class="status-banner status-banner--{{statusClass}}">
      <text class="status-text">{{order.status}}</text>
      <text class="order-no-top">{{order.saleOrderId}}</text>
    </view>

    <!-- 订单信息 -->
    <van-cell-group title="订单信息" class="card-group">
      <van-cell title="下单人" value="{{order.customerName || '—'}}" />
      <van-cell title="手机号" value="{{isManager ? order.customerPhone : order.customerPhoneMasked}}" />
      <van-cell title="所属门店" value="{{order.storeName || '—'}}" />
      <van-cell title="订单来源" value="{{order.orderSourceLabel}}" />
      <van-cell title="下单方式" value="{{order.orderTypeLabel}}" />
      <van-cell wx:if="{{order.preferredStaffName}}" title="指定美容师" value="{{order.preferredStaffName}}" />
      <van-cell title="支付方式" value="{{order.payTypeLabel}}" />
      <van-cell wx:if="{{order.confirmedBy}}" title="确认人" value="{{order.confirmedBy}}" />
      <van-cell wx:if="{{order.confirmedAt}}" title="确认时间" value="{{order.confirmedAt}}" />
      <van-cell title="创建时间" value="{{order.createdAt}}" />
      <van-cell wx:if="{{order.paidAt}}" title="支付时间" value="{{order.paidAt}}" />
      <van-cell wx:if="{{order.remark}}" title="备注" value="{{order.remark}}" />
    </van-cell-group>

    <!-- 订单明细 -->
    <view class="card-group items-card">
      <text class="items-title">订单明细</text>
      <view class="order-item" wx:for="{{order.items}}" wx:key="saleItemId">
        <view class="item-name-row">
          <text class="item-name">{{item.itemName}}</text>
          <text class="item-spec">{{item.spec}}</text>
        </view>
        <view class="item-price-row">
          <text class="item-price">实收 ¥{{item.totalPrice}}</text>
          <text wx:if="{{item.sessionCount > 1}}" class="item-sessions">
            剩余 {{item.remainingSessions}} / {{item.sessionCount}} 次
          </text>
        </view>
        <text class="item-flow-no">{{item.saleItemId}}</text>
      </view>
      <view class="total-row">
        <text class="total-label">合计</text>
        <text class="total-amount">¥{{order.totalAmount}}</text>
      </view>
    </view>

    <!-- Ticket 2 PR-A：欠款 + 款项流水 -->
    <view wx:if="{{order.hasDebt || order.payments.length > 0}}" class="card-group items-card">
      <text class="items-title">款项情况</text>
      <view wx:if="{{order.hasDebt}}" class="debt-row">
        <view class="debt-col">
          <text class="debt-label">应付</text>
          <text class="debt-value">¥{{order.payableAmount}}</text>
        </view>
        <view class="debt-col">
          <text class="debt-label">已付</text>
          <text class="debt-value">¥{{order.paidAmount}}</text>
        </view>
        <view class="debt-col">
          <text class="debt-label debt-label--hot">欠款</text>
          <text class="debt-value debt-value--hot">¥{{order.remainingPayable}}</text>
        </view>
      </view>
      <!-- 款项流水（payments 非空时展示） -->
      <view wx:if="{{order.payments.length > 0}}" class="pay-list">
        <view
          wx:for="{{order.payments}}"
          wx:key="timeFmt"
          wx:for-item="p"
          class="pay-row"
        >
          <view class="pay-row-left">
            <text class="pay-type">{{p.changeType}}</text>
            <text class="pay-meta">{{p.timeFmt}} · {{p.paymentMethod}}</text>
            <text wx:if="{{p.note}}" class="pay-note">{{p.note}}</text>
          </view>
          <view class="pay-row-right">
            <text class="pay-amount {{p.isRefund ? 'pay-amount--refund' : ''}}">
              {{p.isRefund ? '-¥' : '¥'}}{{p.amountAbs}}
            </text>
            <text class="pay-status" wx:if="{{p.status !== '已支付'}}">{{p.status}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 营业额分配（仅店长 + 已支付/已完成可见） -->
    <view wx:if="{{isManager && (order.status === '已支付' || order.status === '已完成') && order.allocation.length > 0}}" class="card-group items-card">
      <text class="items-title">营业额分配</text>
      <view class="alloc-row" wx:for="{{order.allocation}}" wx:key="staffName">
        <text class="alloc-staff">{{item.staffName}}（{{item.department}}）</text>
        <view class="alloc-right">
          <text class="alloc-amount">¥{{item.amount}}</text>
          <text class="alloc-ratio"> · {{item.ratio}}</text>
        </view>
      </view>
      <view class="re-alloc-btn">
        <van-button size="small" plain type="primary" bind:click="onReAllocation"
          custom-class="btn-outline-brand">重新分配</van-button>
      </view>
    </view>

    <!-- 无分配时入口（仅店长 + 已支付/已完成） -->
    <view wx:if="{{isManager && (order.status === '已支付' || order.status === '已完成') && order.allocation.length === 0}}" class="card-group items-card">
      <van-button block plain type="primary"
        custom-class="btn-outline-brand"
        bind:click="onReAllocation"
      >营业额分配</van-button>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <van-button
        wx:if="{{isManager && (order.status === '待确认收款' || (order.status === '待支付' && order.payType === 'offline'))}}"
        block type="primary"
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:click="onConfirmOffline"
      >确认线下收款</van-button>
      <van-button
        wx:if="{{isManager && order.status === '支付失败'}}"
        block type="warning"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:click="onResetFailed"
      >重置支付失败</van-button>
      <van-button
        wx:if="{{(isManager || isCreator) && order.status === '待支付'}}"
        block plain type="primary"
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onShowQrcode"
      >查看收款码</van-button>
      <van-button
        wx:if="{{(isManager || isCreator) && order.status === '待支付'}}"
        block plain type="danger"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCloseOrder"
      >取消订单</van-button>
      <!-- Ticket 2 PR-A：发起回款（店长 + 有欠款） -->
      <van-button
        wx:if="{{isManager && order.hasDebt}}"
        block type="primary"
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;"
        bind:click="onRepayTap"
      >发起回款（欠 ¥{{order.remainingPayable}}）</van-button>

      <!-- 创建服务单（已支付 + 非家居产品订单） -->
      <van-button
        wx:if="{{order.status === '已支付'}}"
        block plain type="primary"
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCreateService"
      >创建服务单</van-button>
      <!-- P2: 退款按钮（已支付/已完成 + 店长 + 非退款/转换/回款单） -->
      <van-button
        wx:if="{{isManager && (order.status === '已支付' || order.status === '已完成') && order.orderType !== '退款单' && order.orderType !== '转换单' && order.orderType !== '回款单'}}"
        block plain type="danger"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onCreateRefund"
      >申请退款</van-button>

      <!-- P2: 退款审批按钮（待审批 + 退款单 + 店长） -->
      <van-button
        wx:if="{{isManager && order.status === '待审批' && order.orderType === '退款单'}}"
        block type="primary"
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onApproveRefund"
      >通过退款</van-button>
      <van-button
        wx:if="{{isManager && order.status === '待审批' && order.orderType === '退款单'}}"
        block plain type="danger"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onRejectRefund"
      >驳回退款</van-button>

      <!-- 终态：返回工作台 -->
      <van-button
        wx:if="{{order.status === '已关闭' || (!isManager && (order.status === '已完成' || order.status === '已支付'))}}"
        block plain round
        custom-class="btn-outline-brand"
        custom-style="border-radius:48rpx;margin-top:24rpx;"
        bind:click="onBackToWorkbench"
      >返回工作台</van-button>
    </view>
  </block>

  <!-- P2: 退款原因对话框 -->
  <van-dialog
    use-slot
    title="申请退款"
    show="{{showRefundDialog}}"
    show-cancel-button
    confirm-button-color="#C0322A"
    bind:confirm="onConfirmRefund"
    bind:cancel="onCancelRefund"
    confirm-button-text="提交"
  >
    <view style="padding: 16rpx 24rpx;">
      <van-field
        label="退款原因"
        placeholder="请填写退款原因"
        type="textarea"
        maxlength="200"
        autosize
        value="{{refundReason}}"
        bind:change="onRefundReasonChange"
      />
    </view>
  </van-dialog>

  <!-- Ticket 2 PR-A：发起回款弹层 -->
  <van-popup
    show="{{showRepayPopup}}"
    position="bottom"
    round
    custom-style="padding: 32rpx 0; max-height: 85vh;"
    bind:close="onCloseRepayPopup"
    closeable
  >
    <view class="repay-popup">
      <view class="repay-title">发起回款</view>
      <view class="repay-debt">
        欠款金额：<text class="repay-debt-hot">¥{{order.remainingPayable}}</text>
      </view>

      <van-field
        label="支付方式"
        readonly
        clickable="{{false}}"
      >
        <view slot="input" class="repay-method-row">
          <van-radio-group value="{{repayMethod}}" bind:change="onRepayMethodChange" direction="horizontal">
            <van-radio name="线下" checked-color="#C0322A">现金/扫码回执</van-radio>
            <van-radio name="储值卡" checked-color="#C0322A">储值卡付清</van-radio>
            <van-radio name="微信" checked-color="#C0322A" disabled>微信（开发中）</van-radio>
          </van-radio-group>
        </view>
      </van-field>

      <van-field
        wx:if="{{repayMethod !== '储值卡'}}"
        label="回款金额"
        type="digit"
        placeholder="0.00"
        value="{{repayAmountInput}}"
        bind:change="onRepayAmountChange"
      />

      <van-field
        label="储值卡抵扣"
        type="digit"
        placeholder="0.00（可选）"
        value="{{repayPrepaidCardInput}}"
        bind:change="onRepayPrepaidCardChange"
      />

      <van-field
        label="备注"
        type="textarea"
        placeholder="可选备注"
        maxlength="100"
        autosize
        value="{{repayNote}}"
        bind:change="onRepayNoteChange"
      />

      <view class="repay-actions">
        <van-button block plain type="default" bind:click="onCloseRepayPopup">取消</van-button>
        <van-button
          block type="primary"
          custom-class="btn-primary-brand"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:click="onConfirmRepay"
        >确认回款</van-button>
      </view>
    </view>
  </van-popup>

  <view class="safe-area-bottom" />
</view>
