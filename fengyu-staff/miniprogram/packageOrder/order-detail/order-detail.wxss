/* pages/order-detail/order-detail.wxss */


.status-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}
.status-text { font-size: 28rpx; font-weight: 600; }
.activity-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  color: #C0322A;
  background: #FFFFFF;
}
.order-no-top { font-size: 22rpx; opacity: 0.75; font-family: monospace; }


.items-card {
  background: #FFFFFF;
  padding: 28rpx 32rpx;
}
.items-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
}

.order-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EDE9;
}
.order-item:last-child { border-bottom: none; }

.item-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.item-name { font-size: 28rpx; font-weight: 600; color: #2D2017; }
.item-spec {
  font-size: 22rpx; color: var(--color-text-secondary);
  background: #F5F2EE; padding: 2rpx 10rpx; border-radius: 6rpx;
}

.item-price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.item-price { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }
.item-sessions { font-size: 22rpx; color: var(--color-text-hint); }
.item-flow-no { font-size: 20rpx; color: #BBB; font-family: monospace; display: block; margin-top: 4rpx; }

/* 明细扩展信息（单价/原价划线、销售分类、过期日期、已提货数量） */
.item-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  margin-top: 8rpx;
}
.item-extra-tag { font-size: 22rpx; color: var(--color-text-hint); }
.item-origin-price { text-decoration: line-through; color: #BBB; }

/* 疗程卡三段进度条（剩余可用 / 已付未用 / 未付） */
.session-bar {
  display: flex;
  height: 8rpx;
  width: 100%;
  margin-top: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #EFEFEF;
}
.session-bar__seg { height: 100%; }
.session-bar__seg--remain { background: #C0322A; }
.session-bar__seg--paid-unused { background: #F2B6B0; }
.session-bar__seg--unpaid { background: #DDD; }

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #E5DDD5;
}
.total-label { font-size: 26rpx; color: var(--color-text-secondary); }
.total-amount { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }

.alloc-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EDE9;
}
.alloc-row:last-of-type { border-bottom: none; }
.alloc-row-left { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.alloc-staff { font-size: 26rpx; font-weight: 600; color: #2D2017; }
.alloc-meta { font-size: 22rpx; color: var(--color-text-hint); }
.alloc-row-right { display: flex; flex-direction: column; align-items: flex-end; margin-left: 16rpx; }
.alloc-amount { font-size: 28rpx; font-weight: 600; color: var(--color-primary); }

.re-alloc-btn { margin-top: 20rpx; text-align: right; }

/* Ticket 2 PR-A：欠款 + 款项流水 + 回款弹层 */
.debt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EDE9;
}
.debt-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.debt-label { font-size: 22rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.debt-label--hot { color: var(--color-primary); }
.debt-value { font-size: 30rpx; font-weight: 600; color: #2D2017; }
.debt-value--hot { color: var(--color-primary); font-size: 34rpx; }

.pay-list { margin-top: 8rpx; }
.pay-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EDE9;
}
.pay-row:last-child { border-bottom: none; }
.pay-row-left { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.pay-type { font-size: 26rpx; font-weight: 600; color: #2D2017; }
.pay-meta { font-size: 22rpx; color: var(--color-text-hint); }
.pay-note { font-size: 22rpx; color: var(--color-text-secondary); }
.pay-row-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; margin-left: 16rpx; }
.pay-amount { font-size: 28rpx; font-weight: 600; color: var(--color-primary); }
.pay-amount--refund { color: #8C8C8C; }
.pay-status { font-size: 22rpx; color: #FAAD14; }

.repay-popup { padding: 0 32rpx 16rpx; }
.repay-title { font-size: 32rpx; font-weight: 600; color: #2D2017; text-align: center; margin-bottom: 16rpx; }
.repay-debt { font-size: 26rpx; color: var(--color-text-secondary); text-align: center; margin-bottom: 20rpx; }
.repay-debt-hot { color: var(--color-primary); font-size: 32rpx; font-weight: 600; }
.repay-section-label { font-size: 26rpx; color: var(--color-text-secondary); margin: 4rpx 0 14rpx; }
.repay-method-cards { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 16rpx; }
.repay-method-card {
  flex: 1 1 calc(50% - 8rpx);
  box-sizing: border-box;
  min-width: 0;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #2D2017;
  background: #F7F4F0;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}
.repay-method-card--active {
  color: var(--color-primary);
  background: #FFF0EE;
  border-color: var(--color-primary);
  font-weight: 600;
}
.repay-online-hint {
  font-size: 22rpx;
  color: #8A6D3B;
  background: #FFF7E6;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 18rpx;
  line-height: 1.5;
}
.repay-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.repay-actions > van-button { flex: 1; }

/* 按回款逐笔分配入口（款项流水行内） */
.pay-alloc-btn {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C0322A;
  border: 1rpx solid #C0322A;
  border-radius: 24rpx;
  padding: 2rpx 18rpx;
  line-height: 1.9;
}
.pay-alloc-btn--done {
  color: #3D8A5A;
  border-color: #3D8A5A;
}
.alloc-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}
