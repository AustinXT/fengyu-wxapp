
<view class="container qrcode-page">

  
  <view wx:if="{{loading && !saleOrderId}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <block wx:else>
    
    <view class="order-summary">
      <text class="summary-customer">{{customerName}}</text>
      <text class="summary-amount">¥{{actualPayable}}</text>
    </view>

    
    <view class="status-area">
      
      <block wx:if="{{status === '待扫码'}}">
        <view class="status-badge status-badge--pending">待扫码</view>
        <view class="qrcode-wrap">
          <image
            wx:if="{{qrcodeUrl}}"
            class="qrcode-img"
            src="{{qrcodeUrl}}"
            mode="aspectFit"
          />
          <view wx:elif="{{qrcodeError}}" class="qrcode-placeholder qrcode-error">
            <van-icon name="warning-o" size="80rpx" color="#D94040" />
            <text class="error-text">{{qrcodeError}}</text>
            <van-button
              size="small" plain
              custom-class="btn-outline-brand"
              custom-style="margin-top:24rpx;"
              bind:click="onRetryQrcode"
            >重新生成</van-button>
          </view>
          <view wx:else class="qrcode-placeholder">
            <van-loading type="spinner" color="#C0322A" />
            <text class="placeholder-text">生成二维码中...</text>
          </view>
        </view>
        <text class="hint-text">请顾客用微信扫码完成支付</text>
      </block>

      
      <block wx:elif="{{status === '支付中'}}">
        <view class="status-badge status-badge--progress">支付中</view>
        <view class="qrcode-wrap qrcode-wrap--dimmed">
          <image class="qrcode-img" src="{{qrcodeUrl}}" mode="aspectFit" />
          <view class="qrcode-overlay">
            <van-loading type="spinner" color="#FFFFFF" />
          </view>
        </view>
        <text class="hint-text">顾客正在选择支付方式...</text>
      </block>

      
      <block wx:elif="{{status === '待确认收款'}}">
        <view class="status-badge status-badge--warning">待确认收款</view>
        <view class="success-icon-area">
          <van-icon name="cash-on-deliver" size="120rpx" color="#D4820A" />
        </view>
        <text class="hint-text">顾客已选择线下付款，请确认收款</text>
      </block>

      
      <block wx:elif="{{status === '已支付'}}">
        <view class="status-badge status-badge--success">已支付</view>
        <view class="success-icon-area">
          <van-icon name="success" size="120rpx" color="#3D8A5A" />
        </view>
        <text class="success-amount">¥{{actualPayable}} 已支付</text>
      </block>

      
      <block wx:elif="{{status === '部分支付'}}">
        <view class="status-badge status-badge--warning">部分支付</view>
        <view class="success-icon-area">
          <van-icon name="pending-payment" size="120rpx" color="#D4820A" />
        </view>
        <text class="hint-text">本订单已部分付款，可继续收款或关闭订单</text>
      </block>

      
      <block wx:else>
        <view class="status-badge status-badge--done">{{status}}</view>
        <view class="success-icon-area">
          <van-icon name="close" size="120rpx" color="#888888" />
        </view>
      </block>
    </view>

    
    <text class="order-no">{{saleOrderId}}</text>

    
    <view class="action-bar">
      <van-button
        wx:if="{{isManager && status === '待确认收款'}}"
        block type="primary"
        custom-class="btn-primary-brand"
        custom-style="border-radius:48rpx;"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:click="onConfirmOffline"
      >确认线下收款</van-button>
      <view
        wx:if="{{(isManager || isCreator) && status !== '已支付' && status !== '已关闭'}}"
        class="close-slider-wrap"
      >
        <slide-to-confirm
          id="closeSlider"
          label="向右滑动作废订单"
          confirmed-label="作废中…"
          accent-color="#D94040"
          disabled="{{submitting}}"
          bind:confirm="onCloseOrder"
        />
      </view>
    </view>
  </block>

  <view class="safe-area-bottom" />
</view>
