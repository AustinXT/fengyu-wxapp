

.perf-page {
  background: var(--color-bg-page);
}


.perf-header {
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid var(--color-border);
}

.perf-staff-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.perf-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #FFF0EE;
  display: flex;
  align-items: center;
  justify-content: center;
}

.perf-staff-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
}

.perf-staff-switch {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
}

.perf-switch-text {
  font-size: 22rpx;
  color: var(--color-primary);
}

.perf-date-display {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.perf-range-btns {
  display: flex;
  gap: 12rpx;
}

.range-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx 0;
  border-radius: 32rpx;
  background: #F5F5F5;
  color: var(--color-text-secondary);
}

.range-btn--active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}


.perf-summary-card {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.summary-row {
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-item--total .price-integer {
  color: var(--color-primary);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-bottom: 8rpx;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--color-border);
}


.perf-list {
  padding: 16rpx 24rpx;
}

.perf-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.perf-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.perf-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.perf-item-type-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.type-tag--sale {
  background: #FFF3E0;
  color: #D4820A;
}

.type-tag--service {
  background: #E3F0FF;
  color: #5E8BB3;
}

.perf-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
}

.perf-item-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.perf-item-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.perf-item-value {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.perf-item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F0EDE9;
}

.perf-item-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.perf-item-category {
  font-size: 20rpx;
  color: var(--color-text-hint);
  background: #F5F5F5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 24rpx;
}

.no-more {
  text-align: center;
  padding: 24rpx;
}

.no-more-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}
