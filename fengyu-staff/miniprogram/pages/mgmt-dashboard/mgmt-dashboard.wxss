/* pages/mgmt-dashboard — hub 页，占位内容沿用 placeholder-page；我的 tab 内置样式 */
.mgmt-hub {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 140rpx;
}

/* 数据中心 dashboard tab */
.mgmt-dash {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.mgmt-dash-filters {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 24rpx;
}

.filter-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.mgmt-dash-grid-large {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mgmt-dash-grid-small {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}

.dash-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.dash-card--small {
  padding: 16rpx 12rpx;
}

.dash-card-title {
  font-size: 28rpx;
  color: #C0322A;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.dash-card--small .dash-card-title {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.dash-card-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 1.8;
}

.dash-card--small .dash-card-row {
  font-size: 22rpx;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.6;
}

.dash-card-row .lbl {
  color: #999;
}

.dash-card-row .val {
  color: #333;
  font-weight: 600;
}

.dash-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

@media (max-width: 360px) {
  .mgmt-dash-grid-small {
    grid-template-columns: 1fr 1fr;
  }
}

/* 区块标题（门店状况 / 人效数据） */
.dash-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #C0322A;
  text-align: center;
  margin: 32rpx 0 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

/* 门店状况 - 第一行：会员数量 / 保有会员 / 占比 */
.dash-status-row1 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 16rpx;
  gap: 8rpx;
}

.status-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.status-cell .lbl {
  font-size: 24rpx;
  color: #999;
}

.status-cell .val {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 门店状况 - 第二行：左右两个 block */
.dash-status-row2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.status-block {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 1.6;
}

.status-line .lbl {
  color: #999;
}

.status-line .val {
  color: #333;
  font-weight: 600;
}

/* 入口区：van-grid 宫格卡片 */
.dash-entries {
  margin-top: 32rpx;
  /* 通过 CSS 变量穿透 Vant 样式隔离：让 grid-item content 去掉默认 padding */
  --grid-item-content-padding: 0;
  --grid-item-content-background-color: #fff;
}

/* 单卡内容：图标 + 文字 居中垂直排列 */
.dash-entry-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 8rpx;
  border-radius: 16rpx;
  width: 100%;
}

.dash-entry-card:active {
  opacity: 0.7;
}

.dash-entry-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.mgmt-profile-wrap {
  min-height: 100vh;
}

.mgmt-profile-header {
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #C0322A 0%, #9C261E 100%);
  color: #FFFFFF;
}

.mgmt-profile-name {
  font-size: 40rpx;
  font-weight: 600;
}

.mgmt-profile-meta {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgmt-profile-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

.mgmt-profile-meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgmt-profile-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.mgmt-profile-tip {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #666;
}

.mgmt-profile-action {
  margin-top: 48rpx;
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #C0322A;
  color: #FFFFFF;
  font-size: 28rpx;
  border: none;
}

.mgmt-profile-action--outline {
  background: #FFFFFF;
  color: #C0322A;
  border: 2rpx solid #C0322A;
}

/* 排行榜 tab */
.mgmt-ranking {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* sub-toggle：门店 / 员工 */
.ranking-dimensions {
  display: flex;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.ranking-dimension {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
  border-radius: 6rpx;
}

.ranking-dimension.active {
  background: #fff;
  font-weight: 600;
  color: #C0322A;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

/* 时间 chip */
.ranking-periods {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ranking-period {
  padding: 8rpx 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  background: #fff;
}

.ranking-period.active {
  background: #FFC85F;
  border-color: #FFC85F;
  color: #fff;
  font-weight: 600;
}

/* 6 指标按钮 */
.ranking-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.ranking-metric {
  padding: 24rpx 0;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
}

.ranking-metric.active {
  background: #FFC85F;
  color: #fff;
  font-weight: 600;
}

/* 表格 */
.ranking-table {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.ranking-table-title {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 24rpx;
}

.ranking-table-header,
.ranking-row {
  display: grid;
  grid-template-columns: 80rpx 1fr 1fr 200rpx;
  align-items: center;
  padding: 24rpx 16rpx;
  font-size: 28rpx;
}

.ranking-table-header {
  color: #999;
  font-size: 24rpx;
}

.ranking-row {
  border-top: 1rpx solid #f0f0f0;
}

.col-name {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 8rpx;
}

.col-market {
  color: #999;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 8rpx;
}

.col-value {
  text-align: right;
}

.val-num {
  font-weight: 600;
}

.val-unit {
  display: block;
  color: #999;
  font-size: 22rpx;
}

.ranking-loading,
.ranking-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
