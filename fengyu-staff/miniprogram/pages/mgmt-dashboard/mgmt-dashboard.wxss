/* pages/mgmt-dashboard — hub 页，占位内容沿用 placeholder-page；我的 tab 内置样式 */
.mgmt-hub {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 140rpx;
}

/* 数据中心 dashboard tab */
.mgmt-dash {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.mgmt-dash-filters {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 24rpx;
}

.filter-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.mgmt-dash-grid-large {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mgmt-dash-grid-small {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}

.dash-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.dash-card--small {
  padding: 16rpx 12rpx;
}

.dash-card-title {
  font-size: 28rpx;
  color: #C0322A;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.dash-card--small .dash-card-title {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.dash-card-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 1.8;
}

.dash-card--small .dash-card-row {
  font-size: 22rpx;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.6;
}

.dash-card-row .lbl {
  color: #999;
}

.dash-card-row .val {
  color: #333;
  font-weight: 600;
}

.dash-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

@media (max-width: 360px) {
  .mgmt-dash-grid-small {
    grid-template-columns: 1fr 1fr;
  }
}

/* 区块标题（门店状况 / 人效数据） */
.dash-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #C0322A;
  text-align: center;
  margin: 32rpx 0 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

/* 门店状况 - 第一行：会员数量 / 保有会员 / 占比 */
.dash-status-row1 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 16rpx;
  gap: 8rpx;
}

.status-cell {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.status-cell .lbl {
  font-size: 24rpx;
  color: #999;
}

.status-cell .val {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 门店状况 - 第二行：左右两个 block */
.dash-status-row2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.status-block {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 1.6;
}

.status-line .lbl {
  color: #999;
}

.status-line .val {
  color: #333;
  font-weight: 600;
}

/* 入口区 */
.dash-entries {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dash-entry-row {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.dash-entry-row:active {
  opacity: 0.7;
}

.mgmt-profile-wrap {
  min-height: 100vh;
}

.mgmt-profile-header {
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #C0322A 0%, #9C261E 100%);
  color: #FFFFFF;
}

.mgmt-profile-name {
  font-size: 40rpx;
  font-weight: 600;
}

.mgmt-profile-meta {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgmt-profile-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

.mgmt-profile-meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgmt-profile-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.mgmt-profile-tip {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #666;
}

.mgmt-profile-action {
  margin-top: 48rpx;
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #C0322A;
  color: #FFFFFF;
  font-size: 28rpx;
  border: none;
}

.mgmt-profile-action--outline {
  background: #FFFFFF;
  color: #C0322A;
  border: 2rpx solid #C0322A;
}
