/* pages/workbench/workbench.wxss */

/* ===== 分成卡片：员工信息行 ===== */
.commission-staff-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.commission-staff-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.commission-store-wrap {
  display: inline-flex;
  align-items: center;
}

.commission-store-wrap--clickable {
  padding: 4rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.15);
}

.commission-store-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.role-badge--manager {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.role-badge--beautician {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* ===== 通用 section ===== */
.section-wrap {
  padding: 24rpx 32rpx 0;
}

.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 12rpx;
}

/* ===== 分成卡片 ===== */
.commission-card {
  background: var(--color-primary);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(192, 50, 42, 0.35);
  color: #FFFFFF;
}

.commission-columns {
  display: flex;
  align-items: stretch;
}

.commission-col {
  flex: 1;
}

.commission-col--right {
  padding-left: 32rpx;
}

.commission-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}

.commission-col-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-bottom: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.price-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.commission-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.commission-stat {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.commission-stat-sep {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

.store-revenue {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.store-revenue-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 月度业绩日历 ===== */
.section-header-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.cal-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.cal-total-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.cal-total-detail {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.month-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.month-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  min-width: 120rpx;
  text-align: center;
}

.cal-weekdays {
  display: flex;
  margin-bottom: 8rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-hint);
  padding: 8rpx 0;
}

.cal-days {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 8rpx;
}

.cal-day {
  width: 14.2857%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cal-day-num {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1;
}

.cal-day-today .cal-day-num {
  color: #FFFFFF;
  background: var(--color-primary);
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.cal-day-amount {
  font-size: 20rpx;
  color: var(--color-primary);
  margin-top: 4rpx;
  line-height: 1;
}


/* ===== 门店营收（补充动画） ===== */
.store-revenue-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

/* ===== 日历空日 ===== */
.cal-day--empty {
  visibility: hidden;
}

.cal-day--future .cal-day-num {
  color: #CCCCCC;
}
