/* pages/workbench/workbench.wxss */

/* ===== 分成卡片：员工信息行 ===== */
.commission-staff-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.commission-staff-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.commission-store-wrap {
  display: inline-flex;
  align-items: center;
}

.commission-store-wrap--clickable {
  padding: 4rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.15);
}

.commission-store-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.role-badge--manager {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.role-badge--beautician {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* ===== 通用 section ===== */
.section-wrap {
  padding: 24rpx 32rpx 0;
}

.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 12rpx;
}

/* ===== 分成卡片 ===== */
.commission-card {
  background: var(--color-primary);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(192, 50, 42, 0.35);
  color: #FFFFFF;
}

/* ===== 常用功能：大色块磁贴 ===== */
.func-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 24rpx 32rpx 0;
}

.func-item {
  position: relative;
  width: calc(50% - 8rpx);      /* 2 列，列间距 16rpx */
  margin-bottom: 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.func-badge {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
}

.func-label {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* ===== 待处理事项：图标宫格 ===== */
.todo-grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 12rpx;
}

.todo-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.todo-icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.todo-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
}

.todo-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}
