/* pages/workbench/workbench.wxss */

/* ===== 页面头部 ===== */
.page-header {
  padding: 48rpx 32rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #FFFFFF;
}

.store-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.role-badge--manager {
  background: rgba(196, 151, 90, 0.3);
  color: #C4975A;
  border: 1rpx solid rgba(196, 151, 90, 0.5);
}

.role-badge--beautician {
  background: rgba(61, 138, 90, 0.3);
  color: #7ECBA1;
  border: 1rpx solid rgba(61, 138, 90, 0.4);
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 通用 section ===== */
.section-wrap {
  padding: 24rpx 32rpx 0;
}

.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2017;
}

.section-more {
  font-size: 24rpx;
  color: #8B6A3E;
}

.section-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

/* ===== 分成卡片 ===== */
.commission-card {
  background: linear-gradient(135deg, #8B6A3E 0%, #C4975A 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #FFFFFF;
}

.commission-columns {
  display: flex;
  align-items: stretch;
}

.commission-col {
  flex: 1;
}

.commission-col--right {
  padding-left: 32rpx;
}

.commission-divider {
  width: 1rpx;
  background: rgba(255,255,255,0.25);
  margin: 0 24rpx;
}

.commission-col-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-bottom: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.price-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.commission-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.commission-stat {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.commission-stat-sep {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.store-revenue {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.store-revenue-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
}

/* ===== 月度业绩日历 ===== */
.month-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.month-label {
  font-size: 26rpx;
  color: #666666;
  min-width: 120rpx;
  text-align: center;
}

.cal-weekdays {
  display: flex;
  margin-bottom: 8rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 0;
}

.cal-days {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 8rpx;
}

.cal-day {
  width: 14.2857%;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cal-day-num {
  font-size: 26rpx;
  color: #2D2017;
  line-height: 1;
}

.cal-day-today .cal-day-num {
  color: #FFFFFF;
  background: #8B6A3E;
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.cal-day-amount {
  font-size: 18rpx;
  color: #C4975A;
  margin-top: 2rpx;
  line-height: 1;
}

/* ===== 代办图标 ===== */
.cell-icon {
  margin-right: 12rpx;
}

/* ===== 搜索结果 ===== */
.customer-results {
  margin-top: 8rpx;
}

.empty-hint {
  padding: 24rpx 0;
  text-align: center;
}

.empty-hint-text {
  font-size: 26rpx;
  color: #999999;
}
