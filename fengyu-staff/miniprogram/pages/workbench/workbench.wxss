/* pages/workbench/workbench.wxss */

/* ===== 分成卡片：员工信息行 ===== */
.commission-staff-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.commission-staff-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.commission-store-wrap {
  display: inline-flex;
  align-items: center;
}

.commission-store-wrap--clickable {
  padding: 4rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.15);
}

.commission-store-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.role-badge--manager {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.role-badge--beautician {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* ===== 通用 section ===== */
.section-wrap {
  padding: 24rpx 32rpx 0;
}

.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 12rpx;
}

/* ===== 分成卡片 ===== */
.commission-card {
  background: var(--color-primary);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(192, 50, 42, 0.35);
  color: #FFFFFF;
}

.commission-columns {
  display: flex;
  align-items: stretch;
}

.commission-col {
  flex: 1;
}

.commission-col--right {
  padding-left: 32rpx;
}

.commission-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}

.commission-col-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-bottom: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.price-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.commission-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.commission-stat {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.commission-stat-sep {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

.store-revenue {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.store-revenue-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 常用功能：大图标宫格 ===== */
.func-grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 12rpx;
}

.func-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 28rpx;
}

.func-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.func-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

/* ===== 待处理事项：图标宫格 ===== */
.todo-grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 12rpx;
}

.todo-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.todo-icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.todo-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
}

.todo-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}
