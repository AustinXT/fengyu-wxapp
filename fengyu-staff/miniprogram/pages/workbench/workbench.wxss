


.commission-staff-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.commission-staff-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.commission-store-wrap {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
}

.commission-store-wrap--clickable:active {
  opacity: 0.7;
}

.commission-store-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.role-badge--manager {
  background: #FFFFFF;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

.role-badge--beautician {
  background: #FFFFFF;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}


.section-wrap {
  padding: 24rpx 32rpx 0;
}

.section-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
  margin-bottom: 12rpx;
}


.commission-card {
  background: #F2F3F5;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: none;
  color: var(--color-text-primary);
}


.func-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
}

.func-item {
  position: relative;
  box-sizing: border-box;
  border-radius: 16rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}


.func-item--hero {
  width: 100%;
  flex-direction: row;
  gap: 16rpx;
  padding: 56rpx 0;
}


.func-item--third {
  width: calc((100% - 40rpx) / 3);
  padding: 40rpx 0;
}


.func-item--half {
  width: calc((100% - 20rpx) / 2);
  padding: 40rpx 0;
}


.func-item--bar {
  width: 100%;
  flex-direction: row;
  gap: 16rpx;
  padding: 20rpx 0;
}

.func-badge {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
}

.func-label {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}


.func-item--hero .func-label,
.func-item--bar .func-label {
  margin-top: 0;
}
.func-item--hero .func-label {
  font-size: 36rpx;
}


.todo-grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 12rpx;
}

.todo-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.todo-icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.todo-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
}

.todo-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}


.wb-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: #FFFFFF;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}

.wb-navbar__content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wb-navbar__logo {
  height: 52rpx;
  width: 168rpx;
}
