<!-- pages/workbench/workbench.wxml — 工作台 -->
<view class="container">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <block wx:else>

    <!-- 1. 分成卡片（两列） -->
    <view class="section-wrap">
      <view class="commission-card">
        <!-- 员工信息行 -->
        <view class="commission-staff-row">
          <text class="commission-staff-name">{{staffName}}</text>
          <text class="commission-store-name">{{storeName || '未绑定门店'}}</text>
          <view class="role-badge role-badge--{{isManager ? 'manager' : 'beautician'}}">
            <text class="role-text">{{position || '未绑定'}}</text>
          </view>
        </view>
        <view class="commission-columns">
          <!-- 左列：今日分成 -->
          <view class="commission-col" bindtap="goPerformance">
            <text class="commission-col-label">今日分成</text>
            <view class="price-row">
              <text class="price-unit">¥ </text>
              <text class="price-value">{{todayCommission}}</text>
            </view>
            <view class="commission-stats">
              <text class="commission-stat">订单 {{todayOrderCount}}</text>
              <text class="commission-stat-sep">·</text>
              <text class="commission-stat">服务 {{todayServiceCount}}</text>
            </view>
          </view>
          <!-- 分隔线 -->
          <view class="commission-divider" />
          <!-- 中列：本月累计 -->
          <view class="commission-col" bindtap="goPerformance">
            <text class="commission-col-label">本月累计</text>
            <view class="price-row">
              <text class="price-unit">¥ </text>
              <text class="price-value">{{monthlyCommission}}</text>
            </view>
            <view class="commission-stats">
              <text class="commission-stat">订单 {{monthlyOrderCount}}</text>
              <text class="commission-stat-sep">·</text>
              <text class="commission-stat">服务 {{monthlyServiceCount}}</text>
            </view>
          </view>
          <!-- 分隔线 -->
          <view class="commission-divider" />
          <!-- 右列：上月累计 -->
          <view class="commission-col" bindtap="goPerformance">
            <text class="commission-col-label">上月累计</text>
            <view class="price-row">
              <text class="price-unit">¥ </text>
              <text class="price-value">{{lastMonthCommission}}</text>
            </view>
            <view class="commission-stats">
              <text class="commission-stat">订单 {{lastMonthOrderCount}}</text>
              <text class="commission-stat-sep">·</text>
              <text class="commission-stat">服务 {{lastMonthServiceCount}}</text>
            </view>
          </view>
        </view>
        <!-- 仅店长：门店今日营收 -->
        <view class="store-revenue" wx:if="{{isManager}}">
          <text class="store-revenue-text">门店今日营收  ¥ {{storeTodayRevenue}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 本月业绩日历 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-header-left">
          <text class="section-title">本月</text>
          <view class="cal-total">
            <text class="cal-total-amount">¥ {{monthlyCommission}}</text>
            <text class="cal-total-detail">订单{{monthlyOrderCount}} · 服务{{monthlyServiceCount}}</text>
          </view>
        </view>
        <view class="month-nav">
          <van-icon name="arrow-left" size="32rpx" color="#1A1A1A" bindtap="onPrevMonth" />
          <text class="month-label">{{monthLabel}}</text>
          <van-icon name="arrow" size="32rpx" color="#1A1A1A" bindtap="onNextMonth" />
        </view>
      </view>
      <!-- 星期标题 -->
      <view class="cal-weekdays">
        <text class="cal-wd" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
      </view>
      <!-- 日历格子 -->
      <view class="cal-days">
        <view
          class="cal-day {{item.isEmpty ? 'cal-day-empty' : ''}} {{item.isToday ? 'cal-day-today' : ''}} {{item.hasData ? 'cal-day-has-data' : ''}}"
          wx:for="{{calendarDays}}"
          wx:key="index"
        >
          <text class="cal-day-num" wx:if="{{!item.isEmpty}}">{{item.day}}</text>
          <text class="cal-day-amount" wx:if="{{item.hasData}}">{{item.amountLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 3. 顾客快速搜索 -->
    <view class="search-section" bindtap="goCustomerList">
      <van-search
        disabled
        placeholder="搜索顾客姓名/手机号"
        shape="round"
      />
    </view>

    <!-- 4. 代办事项 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">待处理事项</text>
      </view>
      <van-cell-group>
        <van-cell
          title="预约待确认"
          value="{{pendingAppointmentCount}}条"
          is-link
          bind:click="goAppointments"
        >
          <van-icon slot="icon" name="clock-o" size="40rpx" color="#D4820A" class="cell-icon" />
        </van-cell>
        <van-cell
          title="服务单待推进"
          value="{{pendingServiceCount}}条"
          is-link
          bind:click="goServiceList"
        >
          <van-icon slot="icon" name="flower-o" size="40rpx" color="#3D8A5A" class="cell-icon" />
        </van-cell>
        <van-cell
          wx:if="{{isManager}}"
          title="待确认收款"
          value="{{pendingOfflineOrderCount}}条"
          is-link
          bind:click="goOrderListOffline"
        >
          <van-icon slot="icon" name="gold-coin-o" size="40rpx" color="#C0322A" class="cell-icon" />
        </van-cell>
        <van-cell
          wx:if="{{isManager}}"
          title="待确认订单"
          value="{{pendingCreateOrderCount}}条"
          is-link
          bind:click="goOrderListCreate"
        >
          <van-icon slot="icon" name="records" size="40rpx" color="#C0322A" class="cell-icon" />
        </van-cell>
        <van-cell
          wx:if="{{isManager}}"
          title="待提成分配"
          value="{{pendingAllocationCount}}条"
          is-link
          bind:click="goAllocationList"
        >
          <van-icon slot="icon" name="balance-o" size="40rpx" color="#D4820A" class="cell-icon" />
        </van-cell>
        <van-cell
          wx:if="{{isManager}}"
          title="待审批解绑申请"
          value="{{pendingUnbindCount}}条"
          is-link
          bind:click="goUnbindRequests"
        >
          <van-icon slot="icon" name="exchange" size="40rpx" color="#C0322A" class="cell-icon" />
        </van-cell>
      </van-cell-group>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom" />

  </block>

</view>
