<!-- pages/workbench/workbench.wxml — 工作台 -->
<view class="container">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <block wx:else>

    <!-- 1. 分成卡片（两列） -->
    <view class="section-wrap">
      <view class="commission-card">
        <!-- 员工信息行 -->
        <view class="commission-staff-row">
          <text class="commission-staff-name">{{staffName}}</text>
          <view class="commission-store-wrap {{hasMultiStore ? 'commission-store-wrap--clickable' : ''}}" bindtap="openStorePicker">
            <text class="commission-store-name">{{storeName || '未绑定门店'}}</text>
            <van-icon wx:if="{{hasMultiStore}}" name="arrow-down" size="20rpx" color="#666" custom-style="margin-left: 4rpx;" />
          </view>
          <view class="role-badge role-badge--{{isManager ? 'manager' : 'beautician'}}">
            <text class="role-text">{{position || '职位待设置'}}</text>
          </view>
        </view>
        <view class="commission-columns">
          <!-- 左列：今日分成 -->
          <view class="commission-col" bindtap="goPerformance" data-range="today">
            <text class="commission-col-label">今日分成</text>
            <view class="price-row">
              <text class="price-unit">¥ </text>
              <text class="price-value">{{todayCommission}}</text>
            </view>
            <view class="commission-stats">
              <text class="commission-stat">订单 {{todayOrderCount}}</text>
              <text class="commission-stat-sep">·</text>
              <text class="commission-stat">服务 {{todayServiceCount}}</text>
            </view>
          </view>
          <!-- 分隔线 -->
          <view class="commission-divider" />
          <!-- 中列：本月累计 -->
          <view class="commission-col" bindtap="goPerformance" data-range="month">
            <text class="commission-col-label">本月累计</text>
            <view class="price-row">
              <text class="price-unit">¥ </text>
              <text class="price-value">{{monthlyCommission}}</text>
            </view>
            <view class="commission-stats">
              <text class="commission-stat">订单 {{monthlyOrderCount}}</text>
              <text class="commission-stat-sep">·</text>
              <text class="commission-stat">服务 {{monthlyServiceCount}}</text>
            </view>
          </view>
          <!-- 分隔线 -->
          <view class="commission-divider" />
          <!-- 右列：上月累计 -->
          <view class="commission-col" bindtap="goPerformance" data-range="lastMonth">
            <text class="commission-col-label">上月累计</text>
            <view class="price-row">
              <text class="price-unit">¥ </text>
              <text class="price-value">{{lastMonthCommission}}</text>
            </view>
            <view class="commission-stats">
              <text class="commission-stat">订单 {{lastMonthOrderCount}}</text>
              <text class="commission-stat-sep">·</text>
              <text class="commission-stat">服务 {{lastMonthServiceCount}}</text>
            </view>
          </view>
        </view>
        <!-- 仅店长：门店今日营收 -->
        <view class="store-revenue" wx:if="{{isManager}}">
          <text class="store-revenue-text">门店今日营收  ¥ {{storeTodayRevenue}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 本月业绩日历 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-header-left">
          <text class="section-title">门店业绩</text>
          <view class="cal-total">
            <text class="cal-total-amount">¥ {{storeMonthAmount}}</text>
            <text class="cal-total-detail">订单{{storeMonthOrderCount}} · 服务{{storeMonthServiceCount}}</text>
          </view>
        </view>
        <view class="month-nav">
          <van-icon name="arrow-left" size="32rpx" color="#1A1A1A" bindtap="onPrevMonth" />
          <text class="month-label">{{monthLabel}}</text>
          <van-icon name="arrow" size="32rpx" color="#1A1A1A" bindtap="onNextMonth" />
        </view>
      </view>
      <!-- 星期标题 -->
      <view class="cal-weekdays">
        <text class="cal-wd" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
      </view>
      <!-- 日历格子 -->
      <view class="cal-days">
        <view
          class="cal-day {{item.isEmpty ? 'cal-day-empty' : ''}} {{item.isToday ? 'cal-day-today' : ''}} {{item.hasData ? 'cal-day-has-data' : ''}}"
          wx:for="{{calendarDays}}"
          wx:key="index"
        >
          <text class="cal-day-num" wx:if="{{!item.isEmpty}}">{{item.day}}</text>
          <text class="cal-day-amount" wx:if="{{item.hasData}}">{{item.amountLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 3. 代办事项 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">待处理事项</text>
      </view>
      <view class="todo-grid">
        <!-- 预约待确认 -->
        <view class="todo-item" bindtap="goAppointments">
          <view class="todo-icon-wrap" style="background: rgba(212, 130, 10, 0.12);">
            <van-icon name="clock-o" size="44rpx" color="#D4820A" />
            <view wx:if="{{pendingAppointmentCount > 0}}" class="todo-badge">{{pendingAppointmentCount > 99 ? '99+' : pendingAppointmentCount}}</view>
          </view>
          <text class="todo-label">预约确认</text>
        </view>
        <!-- 服务单待推进 -->
        <view class="todo-item" bindtap="goServiceList">
          <view class="todo-icon-wrap" style="background: rgba(61, 138, 90, 0.12);">
            <van-icon name="flower-o" size="44rpx" color="#3D8A5A" />
            <view wx:if="{{pendingServiceCount > 0}}" class="todo-badge">{{pendingServiceCount > 99 ? '99+' : pendingServiceCount}}</view>
          </view>
          <text class="todo-label">服务推进</text>
        </view>
        <!-- 待确认线下收款 -->
        <view wx:if="{{isManager}}" class="todo-item" bindtap="goOrderListOffline">
          <view class="todo-icon-wrap" style="background: rgba(192, 50, 42, 0.12);">
            <van-icon name="gold-coin-o" size="44rpx" color="#C0322A" />
            <view wx:if="{{pendingOfflineOrderCount > 0}}" class="todo-badge">{{pendingOfflineOrderCount > 99 ? '99+' : pendingOfflineOrderCount}}</view>
          </view>
          <text class="todo-label">线下收款</text>
        </view>
        <!-- 待确认订单 -->
        <view wx:if="{{isManager}}" class="todo-item" bindtap="goOrderListCreate">
          <view class="todo-icon-wrap" style="background: rgba(192, 50, 42, 0.12);">
            <van-icon name="records" size="44rpx" color="#C0322A" />
            <view wx:if="{{pendingCreateOrderCount > 0}}" class="todo-badge">{{pendingCreateOrderCount > 99 ? '99+' : pendingCreateOrderCount}}</view>
          </view>
          <text class="todo-label">确认订单</text>
        </view>
        <!-- 待提成分配 -->
        <view wx:if="{{isManager}}" class="todo-item" bindtap="goAllocationList">
          <view class="todo-icon-wrap" style="background: rgba(212, 130, 10, 0.12);">
            <van-icon name="balance-o" size="44rpx" color="#D4820A" />
            <view wx:if="{{pendingAllocationCount > 0}}" class="todo-badge">{{pendingAllocationCount > 99 ? '99+' : pendingAllocationCount}}</view>
          </view>
          <text class="todo-label">提成分配</text>
        </view>
        <!-- 待审批退款 -->
        <view wx:if="{{isManager}}" class="todo-item" bindtap="goRefundList">
          <view class="todo-icon-wrap" style="background: rgba(198, 40, 40, 0.12);">
            <van-icon name="revoke" size="44rpx" color="#C62828" />
            <view wx:if="{{pendingRefundCount > 0}}" class="todo-badge">{{pendingRefundCount > 99 ? '99+' : pendingRefundCount}}</view>
          </view>
          <text class="todo-label">退款审批</text>
        </view>
        <!-- 待审批解绑申请 -->
        <view wx:if="{{isManager}}" class="todo-item" bindtap="goUnbindRequests">
          <view class="todo-icon-wrap" style="background: rgba(192, 50, 42, 0.12);">
            <van-icon name="exchange" size="44rpx" color="#C0322A" />
            <view wx:if="{{pendingUnbindCount > 0}}" class="todo-badge">{{pendingUnbindCount > 99 ? '99+' : pendingUnbindCount}}</view>
          </view>
          <text class="todo-label">解绑审批</text>
        </view>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom" />

  </block>

  <!-- 门店切换 action sheet（多店时可用） -->
  <van-action-sheet
    show="{{storePickerVisible}}"
    actions="{{storePickerActions}}"
    cancel-text="取消"
    bind:select="onStorePickerSelect"
    bind:close="onStorePickerClose"
    bind:cancel="onStorePickerClose"
  />
</view>
