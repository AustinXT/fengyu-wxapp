/* pages/profile/profile.wxss */
.profile-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 3rpx solid #C0322A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  color: #1A1A1A;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #FFF0EE;
  border: 2rpx solid rgba(192, 50, 42, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  color: #1A1A1A;
}

.profile-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-store {
  font-size: 24rpx;
  color: #666666;
}

.section-card {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 20rpx;
}

.bind-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 24rpx;
}

.bind-tip-text {
  font-size: 26rpx;
  color: #D48806;
}

.profile-bind-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  background: #C0322A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}
