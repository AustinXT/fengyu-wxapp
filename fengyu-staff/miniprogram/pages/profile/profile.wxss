/* pages/profile/profile.wxss */
.profile-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 3rpx solid var(--color-primary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  color: var(--color-text-primary);
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #FFF0EE;
  border: 2rpx solid rgba(192, 50, 42, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

/* 头像右下角"换图"小角标 */
.avatar-edit-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FFFFFF;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  color: var(--color-text-primary);
}

.profile-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-store {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.section-card {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 20rpx;
}

.bind-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 24rpx;
}

.bind-tip-text {
  font-size: 26rpx;
  color: #D48806;
}

.profile-bind-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

/* ===== 重新绑定按钮 ===== */
.rebind-btn {
  font-size: 22rpx;
  color: var(--color-primary);
  border-color: var(--color-primary);
  padding: 0 16rpx;
  line-height: 48rpx;
  height: 48rpx;
  background: transparent;
}

/* ===== 角色标签 ===== */
.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: 1rpx solid rgba(192, 50, 42, 0.3);
}

/* ===== 退出按钮 ===== */
.logout-btn-wrap {
  padding: 48rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  border: 1rpx solid var(--color-border);
}
