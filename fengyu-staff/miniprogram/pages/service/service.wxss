/* pages/service/service.wxss — 护理 Tab */


/* ===== 列表 ===== */
.list-wrap {
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
}

/* ===== 服务单卡片 ===== */
.service-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.service-no {
  font-size: 26rpx;
  color: #666666;
  font-family: monospace;
}


/* ===== 顾客信息 ===== */
.card-customer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.customer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2017;
}

.customer-phone {
  font-size: 26rpx;
  color: #999999;
  margin-left: 8rpx;
}

/* ===== 服务项目行 ===== */
.card-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #F5F2EE;
}

.card-item:last-of-type {
  border-bottom: none;
}

.item-name {
  font-size: 28rpx;
  color: #2D2017;
  flex: 1;
}

.item-spec {
  font-size: 24rpx;
  color: #666666;
  background: #F5F2EE;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.item-sessions {
  font-size: 22rpx;
  color: #C0322A;
  font-weight: 500;
}

/* ===== 时间 ===== */
.card-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.time-text {
  font-size: 24rpx;
  color: #999999;
}

/* ===== 操作按钮 ===== */
.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 4rpx;
}

