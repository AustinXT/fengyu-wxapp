<!-- pages/service/service.wxml — 服务 Tab -->
<view class="container">

  <!-- Tab 筛选 -->
  <van-tabs
    active="{{tabActive}}"
    bind:change="onTabChange"
    color="#C0322A"
    title-active-color="#C0322A"
    title-inactive-color="#666666"
    sticky
  >
    <van-tab name="pending" title="待服务{{tabs[0].badge > 0 ? '(' + tabs[0].badge + ')' : ''}}" />
    <van-tab name="processing" title="服务中{{tabs[1].badge > 0 ? '(' + tabs[1].badge + ')' : ''}}" />
    <van-tab name="awaiting" title="待确认{{tabs[2].badge > 0 ? '(' + tabs[2].badge + ')' : ''}}" />
    <van-tab name="completed" title="已完成" />
  </van-tabs>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{list.length === 0}}" class="empty-wrap">
    <van-empty description="暂无{{tabActive === 'pending' ? '待服务' : tabActive === 'processing' ? '服务中' : tabActive === 'awaiting' ? '待确认' : '已完成'}}的服务单" />
  </view>

  <!-- 服务单列表 -->
  <view wx:else class="list-wrap">
    <view
      class="service-card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <!-- 卡片头：编号 + 状态 -->
      <view class="card-header">
        <text class="service-no">{{item.serviceOrderId}}</text>
        <view class="status-tag status-tag--{{item.status === '待服务' ? 'pending' : item.status === '服务中' ? 'progress' : item.status === '待客户确认' ? 'awaiting' : 'done'}}">
          {{item.status}}
        </view>
      </view>

      <!-- 顾客信息 -->
      <view class="card-customer">
        <van-icon name="manager-o" size="28rpx" color="#C0322A" />
        <text class="customer-name">{{item.customerName}}</text>
        <text class="customer-phone">{{item.customerPhone}}</text>
      </view>

      <!-- 服务项目 -->
      <view
        class="card-item"
        wx:for="{{item.items}}"
        wx:for-item="si"
        wx:key="saleItemId"
      >
        <text class="item-name">{{si.itemName}}</text>
        <text class="item-spec">{{si.spec}}</text>
        <text class="item-sessions" wx:if="{{si.totalSessions > 1}}">剩余 {{si.remainingSessions}} / 已付 {{si.paidSessions}} / 共 {{si.totalSessions}} {{si.unit || '次'}}</text>
      </view>

      <!-- 时间信息 -->
      <view class="card-time">
        <van-icon name="clock-o" size="26rpx" color="#999" />
        <text class="time-text" wx:if="{{item.status === '待服务'}}">预计 {{item.serviceTime}}</text>
        <text class="time-text" wx:elif="{{item.status === '服务中'}}">开始 {{item.startTime}}（进行中）</text>
        <text class="time-text" wx:elif="{{item.status === '待客户确认'}}">待顾客确认</text>
        <text class="time-text" wx:else>完成 {{item.completedTime}}</text>
      </view>

      <!-- 操作按钮（阻止事件冒泡到卡片tap） -->
      <view class="card-actions" catchtap="noop">
        <van-button
          wx:if="{{!isReadOnly && item.status === '待服务'}}"
          type="primary"
          size="small"
          custom-class="btn-primary-brand"
          catchtap="onStartService"
          data-id="{{item.id}}"
        >开始服务</van-button>
        <van-button
          wx:elif="{{!isReadOnly && item.status === '服务中'}}"
          type="primary"
          size="small"
          custom-class="btn-success"
          catchtap="onCompleteService"
          data-id="{{item.id}}"
        >标记完成</van-button>
        <van-button
          wx:elif="{{!isReadOnly && item.status === '待客户确认' && isManager}}"
          type="primary"
          size="small"
          custom-class="btn-success"
          catchtap="onConfirmService"
          data-id="{{item.id}}"
        >代客户确认</van-button>
        <van-button
          wx:else
          size="small"
          plain
          catchtap="onItemTap"
          data-id="{{item.id}}"
        >查看详情</van-button>
      </view>
    </view>
  </view>

  <!-- FAB: 新建服务单 -->
  <view wx:if="{{!isReadOnly}}" class="fab" bindtap="onNewService">
    <van-icon name="plus" size="44rpx" color="#FFFFFF" />
  </view>

  <view class="safe-area-bottom" />
</view>
