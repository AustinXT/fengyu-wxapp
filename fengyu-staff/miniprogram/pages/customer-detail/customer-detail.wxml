<!-- pages/customer-detail/customer-detail.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#8B6A3E" />
  </view>

  <view wx:elif="{{!customer}}" class="empty-wrap">
    <van-empty description="顾客不存在" />
  </view>

  <block wx:else>
    <!-- 基本信息卡片 -->
    <view class="profile-card">
      <view class="profile-header">
        <view class="profile-avatar">
          <van-icon name="manager" size="64rpx" color="#8B6A3E" />
        </view>
        <view class="profile-main">
          <view class="profile-name-row">
            <text class="profile-name">{{customer.name}}</text>
            <view wx:if="{{customer.memberLevel === 'VIP'}}" class="vip-badge">VIP</view>
          </view>
          <text class="profile-phone">{{isManager ? customer.phone : customer.phoneMasked}}</text>
        </view>
      </view>
      <view class="profile-stats">
        <view class="stat-item">
          <text class="stat-label">累计消费</text>
          <text class="stat-value">¥{{customer.totalConsumption}}</text>
        </view>
        <view class="stat-divider" />
        <view class="stat-item">
          <text class="stat-label">本年消费</text>
          <text class="stat-value">¥{{customer.yearConsumption}}</text>
        </view>
      </view>
    </view>

    <!-- 客户档案详情 -->
    <van-cell-group title="客户信息" class="card-group">
      <van-cell wx:if="{{customer.preferredStaffName}}" title="指定美容师" value="{{customer.preferredStaffName}}" />
      <van-cell wx:if="{{customer.skinType}}" title="肤质" value="{{customer.skinType}}" />
      <van-cell wx:if="{{customer.focusAreas}}" title="改善重点" value="{{customer.focusAreas}}" />
    </van-cell-group>

    <!-- 已支付订单（疗程卡余量）-->
    <view class="card-group items-card">
      <view class="items-header">
        <text class="items-title">疗程卡余量</text>
        <van-button
          size="mini"
          type="primary"
          custom-style="background:#8B6A3E;border-color:#8B6A3E;border-radius:32rpx;"
          bind:click="onNewService"
        >新建护理单</van-button>
      </view>

      <view wx:if="{{orders.length === 0}}" class="empty-tip">
        <text class="empty-tip-text">暂无可核销疗程</text>
      </view>

      <view wx:else>
        <view wx:for="{{orders}}" wx:key="orderId" class="order-group">
          <view class="order-header" bindtap="onOrderTap" data-id="{{item.orderId}}">
            <text class="order-no">{{item.orderNo}}</text>
            <text class="order-date">{{item.paidAt}}</text>
            <van-icon name="arrow" size="28rpx" color="#999" />
          </view>
          <view class="order-item" wx:for="{{item.items}}" wx:for-item="si" wx:key="itemFlowNo">
            <text class="item-name">{{si.itemName}}</text>
            <text class="item-spec">{{si.spec}}</text>
            <text class="item-sessions">剩余 {{si.remainingSessions}} 次</text>
          </view>
        </view>
      </view>
    </view>

  </block>

  <view class="safe-area-bottom" />
</view>
