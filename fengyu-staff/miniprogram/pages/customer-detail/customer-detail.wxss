/* pages/customer-detail/customer-detail.wxss */

.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.empty-wrap { padding: 80rpx 0; }

/* 头部信息卡 */
.profile-card {
  background: linear-gradient(135deg, #8B6A3E 0%, #C4975A 100%);
  color: #FFFFFF;
  padding: 40rpx 32rpx 32rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.profile-name { font-size: 40rpx; font-weight: 700; }
.vip-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.3);
  color: #FFFFFF;
}
.profile-phone { font-size: 26rpx; opacity: 0.85; }

.profile-stats {
  display: flex;
  align-items: center;
  background: rgba(0,0,0,0.15);
  border-radius: 16rpx;
  padding: 20rpx;
}
.stat-item { flex: 1; text-align: center; }
.stat-label { display: block; font-size: 22rpx; opacity: 0.75; margin-bottom: 4rpx; }
.stat-value { font-size: 32rpx; font-weight: 700; }
.stat-divider { width: 1rpx; height: 48rpx; background: rgba(255,255,255,0.3); }

.card-group { margin: 24rpx 0; }

.items-card {
  background: #FFFFFF;
  padding: 28rpx 32rpx;
  margin: 24rpx 0;
}
.items-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.items-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2017;
}

.empty-tip { padding: 24rpx 0; }
.empty-tip-text { font-size: 26rpx; color: #999; }

.order-group { margin-bottom: 24rpx; }
.order-group:last-child { margin-bottom: 0; }

.order-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 12rpx;
  border-bottom: 1rpx solid #F0EDE9;
  margin-bottom: 8rpx;
}
.order-no { font-size: 22rpx; color: #666; font-family: monospace; flex: 1; }
.order-date { font-size: 22rpx; color: #999; }

.order-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}
.item-name { font-size: 26rpx; color: #2D2017; flex: 1; }
.item-spec {
  font-size: 22rpx; color: #666;
  background: #F5F2EE; padding: 2rpx 10rpx; border-radius: 6rpx;
}
.item-sessions { font-size: 22rpx; color: #8B6A3E; font-weight: 600; white-space: nowrap; }
