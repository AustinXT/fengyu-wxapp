.mgmt-profile-wrap {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 140rpx;
}

.mgmt-profile-header {
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #C0322A 0%, #9C261E 100%);
  color: #FFFFFF;
}

.mgmt-profile-name {
  font-size: 40rpx;
  font-weight: 600;
}

.mgmt-profile-meta {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgmt-profile-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

.mgmt-profile-meta-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mgmt-profile-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.mgmt-profile-tip {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #666;
}

.mgmt-profile-action {
  margin-top: 48rpx;
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #C0322A;
  color: #FFFFFF;
  font-size: 28rpx;
  border: none;
}

.mgmt-profile-action--outline {
  background: #FFFFFF;
  color: #C0322A;
  border: 2rpx solid #C0322A;
}
