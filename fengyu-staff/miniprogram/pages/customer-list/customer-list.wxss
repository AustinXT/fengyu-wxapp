/* pages/customer-list/customer-list.wxss */
.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }
.empty-wrap { padding: 80rpx 0; }
.hint-wrap { padding: 80rpx 32rpx; text-align: center; }
.hint-text { font-size: 26rpx; color: #999; }

/* 统计卡片 */
.stats-section {
  padding: 24rpx 24rpx 8rpx;
  background: #f5f5f5;
}
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.stat-card {
  flex: 1;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  background: #fff;
}
.stat-count {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 22rpx;
  color: #666;
  line-height: 1.3;
}
.stat-active .stat-count { color: #07c160; }
.stat-warning .stat-count { color: #ff8f1f; }
.stat-lost .stat-count { color: #ee0a24; }
.stat-sleep .stat-count { color: #9b9b9b; }
.stat-birthday .stat-count { color: #C0322A; }
.stat-birthday-next .stat-count { color: #a06abf; }
