<!-- pages/customer-list/customer-list.wxml -->
<view class="container">

  <!-- 客户分类统计卡片 -->
  <view class="stats-section">
    <view class="stats-row">
      <view class="stat-card stat-active">
        <view class="stat-count">2</view>
        <view class="stat-label">活跃客户</view>
      </view>
      <view class="stat-card stat-warning">
        <view class="stat-count">3</view>
        <view class="stat-label">即将流失客户</view>
      </view>
      <view class="stat-card stat-lost">
        <view class="stat-count">0</view>
        <view class="stat-label">流失客户</view>
      </view>
    </view>
    <view class="stats-row">
      <view class="stat-card stat-sleep">
        <view class="stat-count">2</view>
        <view class="stat-label">沉睡客户</view>
      </view>
      <view class="stat-card stat-birthday">
        <view class="stat-count">0</view>
        <view class="stat-label">本月生日客户</view>
      </view>
      <view class="stat-card stat-birthday-next">
        <view class="stat-count">0</view>
        <view class="stat-label">下月生日客户</view>
      </view>
    </view>
  </view>

  <van-search
    value="{{searchKeyword}}"
    placeholder="搜索姓名或手机号"
    bind:search="onSearch"
    bind:change="onSearchChange"
    use-action-slot
  >
    <view slot="action" bindtap="onSearch">搜索</view>
  </van-search>

  <view wx:if="{{loading}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{searched && results.length === 0}}" class="empty-wrap">
    <van-empty description="未找到该顾客" />
  </view>

  <view wx:elif="{{results.length > 0}}">
    <van-cell-group>
      <van-cell
        wx:for="{{results}}"
        wx:key="index"
        title="{{item.name}}"
        label="{{item.phoneMasked || item.phone}}"
        is-link
        data-id="{{item.id}}"
        data-client-user-id="{{item.clientUserId}}"
        bindtap="onItemTap"
      />
    </van-cell-group>
  </view>

  <view wx:else />

  <view class="safe-area-bottom" />
</view>
