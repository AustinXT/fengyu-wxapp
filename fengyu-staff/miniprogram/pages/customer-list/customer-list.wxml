<!-- pages/customer-list/customer-list.wxml -->
<view class="container">

  <!-- 客户分类统计卡片 -->
  <view class="stats-section">
    <view class="stats-row">
      <view class="stat-card stat-active {{activeTag === 'active' ? 'stat-card--selected' : ''}}" bindtap="onStatTap" data-tag="active">
        <view class="stat-count">{{stats.active}}</view>
        <view class="stat-label">活跃客户</view>
      </view>
      <view class="stat-card stat-warning {{activeTag === 'atRisk' ? 'stat-card--selected' : ''}}" bindtap="onStatTap" data-tag="atRisk">
        <view class="stat-count">{{stats.atRisk}}</view>
        <view class="stat-label">即将流失</view>
      </view>
      <view class="stat-card stat-lost {{activeTag === 'lost' ? 'stat-card--selected' : ''}}" bindtap="onStatTap" data-tag="lost">
        <view class="stat-count">{{stats.lost}}</view>
        <view class="stat-label">流失客户</view>
      </view>
    </view>
    <view class="stats-row">
      <view class="stat-card stat-sleep {{activeTag === 'sleeping' ? 'stat-card--selected' : ''}}" bindtap="onStatTap" data-tag="sleeping">
        <view class="stat-count">{{stats.sleeping}}</view>
        <view class="stat-label">沉睡客户</view>
      </view>
      <view class="stat-card stat-birthday {{activeTag === 'birthday' ? 'stat-card--selected' : ''}}" bindtap="onStatTap" data-tag="birthday">
        <view class="stat-count">{{stats.birthday}}</view>
        <view class="stat-label">本月生日</view>
      </view>
      <view class="stat-card stat-birthday-next {{activeTag === 'birthdayNext' ? 'stat-card--selected' : ''}}" bindtap="onStatTap" data-tag="birthdayNext">
        <view class="stat-count">{{stats.birthdayNext}}</view>
        <view class="stat-label">下月生日</view>
      </view>
    </view>
  </view>

  <!-- 拓展筛选（可折叠，置于搜索框之前） -->
  <view class="advanced-filter">
    <view class="advanced-header" bindtap="toggleAdvanced">
      <view class="advanced-title">
        拓展筛选<text wx:if="{{hasAdvancedFilter}}" class="advanced-dot"></text>
      </view>
      <text class="advanced-arrow {{advancedExpanded ? 'advanced-arrow--up' : ''}}">⌄</text>
    </view>

    <view wx:if="{{advancedExpanded}}" class="advanced-body">
      <view class="filter-dim">
        <text class="filter-dim-label">顾客类型</text>
        <view class="filter-chips">
          <view
            wx:for="{{customerTypeOptions}}"
            wx:key="value"
            class="filter-chip {{customerType === item.value ? 'filter-chip--active' : ''}}"
            data-dim="customerType"
            data-value="{{item.value}}"
            bindtap="onAdvancedFilterTap"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="filter-dim">
        <text class="filter-dim-label">消费档位</text>
        <view class="filter-chips">
          <view
            wx:for="{{spendingTierOptions}}"
            wx:key="value"
            class="filter-chip {{spendingTier === item.value ? 'filter-chip--active' : ''}}"
            data-dim="spendingTier"
            data-value="{{item.value}}"
            bindtap="onAdvancedFilterTap"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="filter-dim">
        <text class="filter-dim-label">月度客活</text>
        <view class="filter-chips">
          <view
            wx:for="{{monthlyActivityOptions}}"
            wx:key="value"
            class="filter-chip {{monthlyActivity === item.value ? 'filter-chip--active' : ''}}"
            data-dim="monthlyActivity"
            data-value="{{item.value}}"
            bindtap="onAdvancedFilterTap"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="filter-dim">
        <text class="filter-dim-label">到店状态</text>
        <view class="filter-chips">
          <view
            wx:for="{{customerStatusOptions}}"
            wx:key="value"
            class="filter-chip {{customerStatus === item.value ? 'filter-chip--active' : ''}}"
            data-dim="customerStatus"
            data-value="{{item.value}}"
            bindtap="onAdvancedFilterTap"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="advanced-actions">
        <view class="reset-btn" bindtap="onResetFilters">重置筛选</view>
      </view>
    </view>
  </view>

  <van-search
    value="{{searchKeyword}}"
    placeholder="搜索姓名或手机号"
    bind:search="onSearch"
    bind:change="onSearchChange"
    use-action-slot
  >
    <view slot="action" bindtap="onSearch">搜索</view>
  </van-search>

  <view wx:if="{{loading && results.length === 0}}" class="loading-wrap">
    <van-loading type="spinner" color="#C0322A" />
  </view>

  <view wx:elif="{{(searched || activeTag || hasAdvancedFilter) && results.length === 0}}" class="empty-wrap">
    <van-empty description="{{activeTag ? '该分类暂无顾客' : (hasAdvancedFilter && !searched ? '该筛选条件下暂无顾客' : '未找到该顾客')}}" />
  </view>

  <view wx:elif="{{results.length > 0}}" class="customer-list">
    <view
      wx:for="{{results}}"
      wx:key="index"
      class="customer-card"
      data-id="{{item.id}}"
      data-client-user-id="{{item.clientUserId}}"
      data-name="{{item.name}}"
      bindtap="onItemTap"
      bindlongpress="{{isManager ? 'onLongPressAssign' : ''}}"
    >
      <view class="customer-avatar">
        <text class="customer-avatar-text">{{item.name ? item.name[0] : '?'}}</text>
      </view>
      <view class="customer-info">
        <view class="customer-name-row">
          <text class="customer-name">{{item.name || '未知'}}</text>
          <text wx:if="{{item.memberLevel}}" class="member-level-badge {{item.memberLevelBadgeClass}}">{{item.memberLevel}}</text>
        </view>
        <text class="customer-phone">{{item.phone}}</text>
        <text wx:if="{{item.storeName}}" class="customer-store">{{item.storeName}}</text>
        <text wx:if="{{item.lastPurchaseName}}" class="customer-recent">最近购买：{{item.lastPurchaseName}}</text>
        <text wx:if="{{item.lastServiceDate}}" class="customer-recent">最近到店：{{item.lastServiceDate}}</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loading-more">
      <van-loading size="24rpx" />
    </view>
    <view wx:if="{{!loading && !hasMore}}" class="loading-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>

  <view wx:else />

  <view class="safe-area-bottom" />

  <!-- 客户分配 Action Sheet（仅店长） -->
  <van-action-sheet
    wx:if="{{isManager}}"
    show="{{showAssignSheet}}"
    actions="{{staffActions}}"
    cancel-text="取消"
    bind:close="onAssignClose"
    bind:cancel="onAssignClose"
    bind:select="onAssignSelect"
    description="将 {{assignTarget.name}} 分配给"
  />
</view>
