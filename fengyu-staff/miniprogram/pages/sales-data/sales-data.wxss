

.sd-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 0 var(--spacing-card) 80rpx;
  box-sizing: border-box;
}


.sd-period-tabs {
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
}

.sd-period-tab {
  position: relative;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 4rpx;
}

.sd-period-tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.sd-period-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -6rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}


.sd-section {
  margin-bottom: 32rpx;
}

.sd-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
  margin: var(--spacing-tight) 0 var(--spacing-tight);
  padding-top: 8rpx;
}


.sd-matrix-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap-grid-tight);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-card) var(--spacing-tight);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--gap-grid);
}

.sd-matrix-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 4rpx;
  min-width: 0;
}

.sd-cell-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
  text-align: center;
  white-space: normal;
  word-break: break-all;
  line-height: 1.3;
}

.sd-cell-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  text-align: center;
  white-space: normal;
  word-break: break-all;
  line-height: 1.3;
}


.sd-consume-card {
  display: flex;
  align-items: stretch;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-card) var(--spacing-tight);
  box-shadow: var(--shadow-card);
  gap: 12rpx;
}

.sd-consume-total {
  flex: 0 0 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--color-divider-soft);
  padding: 12rpx 4rpx;
  gap: 12rpx;
  min-width: 0;
}

.sd-cell-value--lg {
  font-size: 32rpx;
  color: var(--color-primary);
}

.sd-consume-breakdown {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.sd-consume-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--gap-grid-tight);
}

.sd-consume-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 4rpx;
  min-width: 0;
}


.sd-breakdown-group {
  margin-bottom: var(--gap-grid);
}

.sd-breakdown-group:last-child {
  margin-bottom: 0;
}

.sd-breakdown-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-tight) 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  border-bottom: 1rpx solid var(--color-divider-soft);
}

.sd-breakdown-label {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.sd-breakdown-list {
  background: var(--color-bg-card);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  padding: 8rpx 0;
  box-shadow: var(--shadow-card);
}

.sd-breakdown-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-tight) 28rpx;
  font-size: 26rpx;
  border-top: 1rpx solid var(--color-divider-soft);
}

.sd-breakdown-row:first-child {
  border-top: none;
}

.sd-breakdown-name {
  color: var(--color-text-secondary);
  flex: 1;
  padding-right: var(--spacing-tight);
  word-break: break-all;
}

.sd-breakdown-value {
  color: var(--color-text-primary);
  font-weight: 600;
  flex-shrink: 0;
  padding-right: 16rpx;
}

.sd-breakdown-ratio {
  width: 110rpx;
  text-align: right;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
}


.sd-kind-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx 14rpx;
  border-top: 1rpx solid var(--color-divider-soft);
}
.sd-kind-row:first-child {
  border-top: none;
}
.sd-kind-bar {
  width: 4rpx;
  height: 28rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}
.sd-kind-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
  word-break: break-all;
}
.sd-kind-value {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
  padding-right: 16rpx;
}
.sd-kind-ratio {
  width: 110rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
}


.sd-leaf-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 28rpx 10rpx 56rpx;
  font-size: 26rpx;
}
.sd-leaf-row:last-child {
  padding-bottom: 16rpx;
}
.sd-leaf-name {
  flex: 1;
  color: var(--color-text-secondary);
  padding-right: var(--spacing-tight);
  word-break: break-all;
}
.sd-leaf-value {
  color: var(--color-text-primary);
  font-weight: 500;
  flex-shrink: 0;
  padding-right: 16rpx;
}
.sd-leaf-ratio {
  width: 110rpx;
  text-align: right;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
}


@media (max-width: 360px) {
  .sd-cell-label {
    font-size: 20rpx;
  }
  .sd-cell-value {
    font-size: 24rpx;
  }
  .sd-cell-value--lg {
    font-size: 28rpx;
  }
}
