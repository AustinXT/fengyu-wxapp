/* pages/sales-data — 销售数据页样式 */

.sd-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 0 var(--spacing-card) 80rpx;
  box-sizing: border-box;
}

/* 顶部 chip：保留下划线 chip 风格（嵌入 mgmt-filter-bar 内，inline 紧凑无 sticky/卡片） */
.sd-period-tabs {
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
}

.sd-period-tab {
  position: relative;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 4rpx;
}

.sd-period-tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.sd-period-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -6rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

/* 区段 */
.sd-section {
  margin-bottom: 32rpx;
}

.sd-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: left;
  margin: var(--spacing-page) 0 var(--spacing-tight);
  padding-left: var(--spacing-tight);
  border-left: 4rpx solid var(--color-primary);
}

/* 4 列业绩矩阵 */
.sd-matrix-card {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--gap-grid-tight);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-card) var(--spacing-tight);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--gap-grid);
}

.sd-matrix-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0; border-radius: var(--radius-md); padding: var(--spacing-tight) 8rpx;
}

.sd-cell-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  white-space: normal;
  word-break: break-all;
  line-height: 1.3;
}

.sd-cell-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: center;
  white-space: normal;
  word-break: break-all;
  line-height: 1.3;
}

/* 实耗卡：左 25% + 右 75% (3x2) */
.sd-consume-card {
  display: flex;
  align-items: stretch;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-card) var(--spacing-tight);
  box-shadow: var(--shadow-card);
  gap: 12rpx;
}

.sd-consume-total {
  flex: 0 0 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--color-divider-soft);
  padding: 12rpx 4rpx;
  gap: 12rpx;
  min-width: 0;
}

.sd-cell-value--lg {
  font-size: 32rpx;
  color: var(--color-primary);
}

.sd-consume-breakdown {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.sd-consume-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--gap-grid-tight);
}

.sd-consume-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 4rpx;
  min-width: 0;
}

/* 品项汇总分组（标题条 + 列表/空态合体卡片） */
.sd-breakdown-group {
  margin-bottom: var(--gap-grid);
}

.sd-breakdown-group:last-child {
  margin-bottom: 0;
}

.sd-breakdown-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-tight) 28rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  border-bottom: 1rpx solid var(--color-divider-soft);
}

.sd-breakdown-label {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.sd-breakdown-list {
  background: var(--color-bg-card);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  padding: 8rpx 0;
  box-shadow: var(--shadow-card);
}

.sd-breakdown-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-tight) 28rpx;
  font-size: 26rpx;
  border-top: 1rpx solid var(--color-divider-soft);
}

.sd-breakdown-row:first-child {
  border-top: none;
}

.sd-breakdown-name {
  color: var(--color-text-secondary);
  flex: 1;
  padding-right: var(--spacing-tight);
  word-break: break-all;
}

.sd-breakdown-value {
  color: var(--color-text-primary);
  font-weight: 600;
  flex-shrink: 0;
  padding-right: 16rpx;
}

.sd-breakdown-ratio {
  width: 110rpx;
  text-align: right;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 一级品项汇总行 */
.sd-kind-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx 14rpx;
  border-top: 1rpx solid var(--color-divider-soft); background: var(--color-bg-page);
}
.sd-kind-row:first-child {
  border-top: none;
}
.sd-kind-name {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
  word-break: break-all;
}
.sd-kind-value {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
  padding-right: 16rpx;
}
.sd-kind-ratio {
  width: 110rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
}

/* 二级品项行：缩进 + 灰色 · 项目符号 */
.sd-leaf-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 28rpx 10rpx 56rpx;
  font-size: 26rpx;
}
.sd-leaf-row:last-child {
  padding-bottom: 16rpx;
}
.sd-leaf-name {
  flex: 1;
  color: var(--color-text-secondary);
  padding-right: var(--spacing-tight);
  word-break: break-all;
}
.sd-leaf-value {
  color: var(--color-text-primary);
  font-weight: 500;
  flex-shrink: 0;
  padding-right: 16rpx;
}
.sd-leaf-ratio {
  width: 110rpx;
  text-align: right;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 手机减少列数，保留数值字号。 */
@media (max-width: 480px) {
  .sd-matrix-card { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sd-consume-card { flex-direction: column; }
  .sd-consume-total { border-right: none; border-bottom: 1rpx solid var(--color-border); }
  .sd-consume-row { grid-template-columns: minmax(0, 1fr); }
  .sd-consume-cell { flex-direction: row; justify-content: space-between; gap: var(--spacing-tight); }
  .sd-consume-cell .sd-cell-label { flex: 1; min-width: 0; text-align: left; }
  .sd-consume-cell .sd-cell-value { flex: 1; min-width: 0; text-align: right; }
}
.sd-matrix-cell:nth-child(1), .sd-matrix-cell:nth-child(4) { background: var(--color-primary-light); }
.sd-breakdown-row, .sd-kind-row, .sd-leaf-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 0.8fr);
  gap: 8rpx;
}
.sd-breakdown-value, .sd-kind-value, .sd-leaf-value,
.sd-breakdown-ratio, .sd-kind-ratio, .sd-leaf-ratio {
  display: block; min-width: 0; width: auto; padding-right: 0;
  text-align: right; word-break: break-all; font-variant-numeric: tabular-nums;
}
.sd-breakdown-row:nth-child(even), .sd-leaf-row:nth-child(even) { background: var(--color-bg-page); }
.sd-kind-name, .sd-kind-value, .sd-kind-ratio { color: var(--color-text-primary); }
