<!-- pages/order-create/order-create.wxml — 开单 -->
<view class="container order-create-page">

  <!-- 顶部大类分类横向导航 -->
  <van-tabs
    active="{{activeBigCategoryIndex}}"
    bind:change="onBigCategoryChange"
    color="#C0322A"
    title-active-color="#C0322A"
    line-width="40rpx"
  >
    <van-tab wx:for="{{bigCategories}}" wx:key="*this" title="{{item}}" />
  </van-tabs>

  <!-- 分类 + 商品主区域 -->
  <view class="catalog-layout">
    <!-- 左侧：分类侧边栏 -->
    <scroll-view class="sidebar-scroll" scroll-y>
      <van-sidebar active-key="{{activeCategoryIndex}}" bind:change="onCategoryChange">
        <van-sidebar-item
          wx:for="{{categories}}"
          wx:key="id"
          title="{{item.name}}"
        />
      </van-sidebar>
    </scroll-view>

    <!-- 右侧：商品列表 -->
    <scroll-view class="product-scroll" scroll-y>
      <!-- 骨架屏 -->
      <view wx:if="{{catalogLoading && spuList.length === 0}}" class="skeleton-wrap">
        <van-skeleton title avatar row="3" />
        <van-skeleton title avatar row="3" style="margin-top:24rpx" />
      </view>

      <!-- 空态 -->
      <view wx:elif="{{spuList.length === 0 && categories.length === 0}}">
        <van-empty description="暂无商品" />
      </view>
      <view wx:elif="{{spuList.length === 0 && categories.length > 0}}">
        <van-empty description="该分类暂无商品" />
      </view>

      <!-- SPU 卡片列表 -->
      <view wx:else>
        <view class="spu-list-inner">
          <view
            class="spu-card"
            wx:for="{{spuList}}"
            wx:key="spuId"
            bindtap="onSpuTap"
            data-spu="{{item}}"
          >
            <!-- 商品封面 -->
            <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
              <van-icon name="photo-o" size="64rpx" color="#C0322A" />
            </view>
            <image
              wx:else
              class="spu-cover"
              src="{{item.cover_image}}"
              mode="aspectFill"
              lazy-load
            />

            <!-- 商品信息 -->
            <view class="spu-body">
              <!-- 标签行 -->
              <view class="spu-tags" wx:if="{{item.is_recommend}}">
                <van-tag color="#C0322A">推荐</van-tag>
              </view>

              <!-- 商品名 -->
              <text class="spu-name">{{item.spuName}}</text>

              <!-- 底部：价格 + 按钮 -->
              <view class="spu-footer">
                <view class="price-group">
                  <text class="price-symbol">¥</text>
                  <text class="price-integer">{{item.priceFrom}}</text>
                  <text class="price-start">起</text>
                </view>
                <view class="spu-add-btn">
                  <van-icon name="plus" size="36rpx" color="#FFFFFF" />
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 购物车已选项目（内联） -->
        <view wx:if="{{cart.length > 0}}" class="cart-items-inline">
          <text class="cart-inline-title">已添加项目</text>
          <view class="cart-item" wx:for="{{cart}}" wx:key="skuId">
            <view class="cart-item-info">
              <text class="cart-item-name">{{item.spuName}}</text>
              <text class="cart-item-spec">{{item.specName}}</text>
            </view>
            <view class="cart-item-right">
              <text class="cart-item-price">¥{{item.price * item.quantity - item.discount}}</text>
              <van-stepper
                value="{{item.quantity}}"
                min="1"
                max="10"
                data-sku-id="{{item.skuId}}"
                bind:change="onCartQtyChange"
              />
              <van-icon
                name="delete-o" size="36rpx" color="#D94040"
                data-sku-id="{{item.skuId}}" catchtap="onCartItemRemove"
              />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{categories.length > 0}}">
    <view class="bottom-bar-mid">
      <text class="bottom-bar-count" wx:if="{{cartCount > 0}}">已选 {{cartCount}} 项</text>
      <text class="bottom-bar-total">¥{{cartTotal}}</text>
    </view>
    <van-button
      type="primary"
      size="small"
      disabled="{{cartCount === 0}}"
      custom-class="btn-primary-brand"
      custom-style="border-radius:40rpx;padding:0 40rpx;"
      bind:click="onOpenCheckout"
    >下单</van-button>
  </view>

  <!-- 结算面板弹层 -->
  <van-popup
    show="{{showCheckout}}"
    position="bottom"
    round
    safe-area-inset-bottom
    bind:close="onCloseCheckout"
  >
    <view class="checkout-panel">
      <!-- 步骤条 -->
      <view class="checkout-steps">
        <view class="checkout-step {{checkoutStep >= 0 ? 'checkout-step--active' : ''}}">选顾客</view>
        <view class="checkout-step-line" />
        <view class="checkout-step {{checkoutStep >= 1 ? 'checkout-step--active' : ''}}">开单类型</view>
        <view class="checkout-step-line" />
        <view class="checkout-step {{checkoutStep >= 2 ? 'checkout-step--active' : ''}}">确认</view>
      </view>

      <!-- Step 0: 选择顾客 -->
      <view wx:if="{{checkoutStep === 0}}" class="checkout-body">
        <view wx:if="{{recentCustomers.length > 0}}" class="recent-section">
          <text class="section-label">最近选择</text>
          <van-cell-group>
            <van-cell
              wx:for="{{recentCustomers}}"
              wx:key="phone"
              title="{{item.name || '未命名'}}"
              label="{{item.phoneMasked || item.phone}}"
              is-link
              data-customer="{{item}}"
              bind:click="onSelectRecentCustomer"
            />
          </van-cell-group>
        </view>
        <van-search
          value="{{customerPhone}}"
          placeholder="输入手机号搜索顾客"
          bind:search="onSearchCustomer"
          bind:change="onCustomerPhoneChange"
          use-action-slot
        >
          <view slot="action" bindtap="onSearchCustomer">搜索</view>
        </van-search>
        <view wx:if="{{customerInfo}}" class="customer-found">
          <van-cell-group>
            <van-cell
              title="{{customerInfo.name || customerInfo.phone}}"
              label="{{customerInfo.phoneMasked || customerInfo.phone}}"
              value="已选"
              icon="manager-o"
            />
          </van-cell-group>
        </view>
        <view class="checkout-footer">
          <van-button
            type="primary"
            block
            loading="{{customerSearching}}"
            custom-class="btn-primary-brand"
            custom-style="border-radius:48rpx;"
            bind:click="onStep0Next"
          >下一步</van-button>
        </view>
      </view>

      <!-- Step 1: 开单类型 -->
      <view wx:if="{{checkoutStep === 1}}" class="checkout-body">
        <text class="checkout-customer-label">顾客：{{customerInfo.name || customerInfo.phone}}</text>
        <text class="section-label">选择开单模式</text>
        <view class="order-type-cards">
          <view
            class="order-type-card {{orderType === 'normal' ? 'order-type-card--active' : ''}}"
            bindtap="onSelectOrderType"
            data-type="normal"
          >
            <van-icon name="orders-o" size="48rpx" color="{{orderType === 'normal' ? '#C0322A' : '#999'}}" />
            <text class="order-type-card-name">正常单</text>
            <text class="order-type-card-desc">标准价格</text>
          </view>
          <view
            class="order-type-card {{isManager ? '' : 'order-type-card--disabled'}} {{orderType === 'experience' ? 'order-type-card--active' : ''}}"
            bindtap="onSelectOrderType"
            data-type="experience"
          >
            <van-icon name="smile-o" size="48rpx" color="{{orderType === 'experience' ? '#C0322A' : (isManager ? '#999' : '#CCC')}}" />
            <text class="order-type-card-name {{isManager ? '' : 'order-type-card-name--gray'}}">体验单</text>
            <text class="order-type-card-desc">仅店长</text>
          </view>
          <view
            class="order-type-card {{isManager ? '' : 'order-type-card--disabled'}} {{orderType === 'internal' ? 'order-type-card--active' : ''}}"
            bindtap="onSelectOrderType"
            data-type="internal"
          >
            <van-icon name="friends-o" size="48rpx" color="{{orderType === 'internal' ? '#C0322A' : (isManager ? '#999' : '#CCC')}}" />
            <text class="order-type-card-name {{isManager ? '' : 'order-type-card-name--gray'}}">内部单</text>
            <text class="order-type-card-desc">员工半价</text>
          </view>
        </view>
        <view class="checkout-footer checkout-footer--row">
          <van-button size="small" plain bind:click="onStep1Back">返回</van-button>
          <van-button
            size="small" type="primary"
            custom-class="btn-primary-brand"
            custom-style="border-radius:40rpx;"
            bind:click="onStep1Next"
          >下一步</van-button>
        </view>
      </view>

      <!-- Step 2: 确认订单 -->
      <view wx:if="{{checkoutStep === 2}}" class="checkout-body">
        <text class="checkout-customer-label">
          顾客：{{customerInfo.name || customerInfo.phone}} ·
          {{orderType === 'normal' ? '正常单' : orderType === 'experience' ? '体验单' : '内部单'}}
        </text>
        <view class="confirm-items">
          <view class="confirm-item-block" wx:for="{{cart}}" wx:key="skuId">
            <view class="confirm-item-header">
              <text class="confirm-item-name">{{item.spuName}}</text>
              <text class="confirm-item-spec">{{item.specName}}</text>
            </view>
            <view class="confirm-item-row">
              <text class="confirm-item-label">售价</text>
              <text class="confirm-item-value">¥{{item.price}} × {{item.quantity}} = ¥{{item.price * item.quantity}}</text>
            </view>
            <view class="confirm-item-row">
              <text class="confirm-item-label">优惠</text>
              <view class="confirm-discount-input-wrap">
                <text class="confirm-discount-prefix">¥</text>
                <input
                  class="confirm-discount-input"
                  type="digit"
                  value="{{item.discount || ''}}"
                  placeholder="0"
                  data-sku-id="{{item.skuId}}"
                  bindblur="onDiscountChange"
                />
              </view>
            </view>
            <view class="confirm-item-row">
              <text class="confirm-item-label">实付</text>
              <text class="confirm-item-receivable">¥{{item.price * item.quantity - item.discount}}</text>
            </view>
          </view>
          <view class="confirm-total-row">
            <text class="confirm-total-label">合计</text>
            <text class="confirm-total-amount">¥{{cartTotal}}</text>
          </view>
        </view>
        <!-- 优惠券选择 -->
        <view class="confirm-coupon-row" bindtap="onSelectCoupon">
          <text class="confirm-item-label">顾客优惠券</text>
          <view class="confirm-coupon-value">
            <text wx:if="{{selectedCoupon}}" class="confirm-coupon-discount">-¥{{couponDiscount}}</text>
            <text wx:else class="confirm-coupon-hint">去选择</text>
            <van-icon name="arrow" size="28rpx" color="#999" />
          </view>
        </view>
        <view wx:if="{{selectedCoupon}}" class="confirm-coupon-info">
          <text>{{selectedCoupon.name}}</text>
        </view>
        <!-- 券后合计 -->
        <view wx:if="{{couponDiscount > 0}}" class="confirm-total-row">
          <text class="confirm-total-label">券后合计</text>
          <text class="confirm-total-amount confirm-total-amount--coupon">¥{{couponTotal}}</text>
        </view>
        <van-field
          label="备注"
          placeholder="选填，最多100字"
          type="textarea"
          maxlength="100"
          autosize
          bind:change="onRemarkChange"
        />
        <view class="checkout-footer checkout-footer--row">
          <van-button size="small" plain bind:click="onStep2Back">返回修改</van-button>
          <van-button
            size="small" type="primary"
            loading="{{submitting}}"
            custom-class="btn-primary-brand"
            custom-style="border-radius:40rpx;"
            bind:click="onSubmitOrder"
          >确认开单</van-button>
        </view>
      </view>
    </view>
  </van-popup>

  <!-- 优惠券选择 Popup -->
  <van-popup
    show="{{showCouponPopup}}"
    position="bottom"
    round
    closeable
    bind:close="onCloseCouponPopup"
  >
    <view class="coupon-popup">
      <view class="coupon-popup__title">选择顾客优惠券</view>
      <view wx:if="{{couponsLoading}}" class="coupon-popup__loading">
        <van-loading size="48rpx" />
      </view>
      <view wx:elif="{{availableCoupons.length === 0}}" class="coupon-popup__empty">
        <text>该顾客暂无可用优惠券</text>
      </view>
      <scroll-view wx:else scroll-y class="coupon-popup__list">
        <view
          wx:for="{{availableCoupons}}"
          wx:key="couponId"
          class="coupon-popup__item {{selectedCoupon.couponId === item.couponId ? 'coupon-popup__item--active' : ''}}"
          bindtap="onCouponPick"
          data-coupon-id="{{item.couponId}}"
          data-name="{{item.name}}"
          data-discount="{{item.discount}}"
        >
          <view class="coupon-popup__item-left">
            <text class="coupon-popup__item-discount">¥{{item.discount}}</text>
            <text class="coupon-popup__item-type">{{item.couponType}}</text>
          </view>
          <view class="coupon-popup__item-right">
            <text class="coupon-popup__item-name">{{item.name}}</text>
            <text class="coupon-popup__item-expire">有效期至 {{item.expireAt}}</text>
          </view>
          <van-icon wx:if="{{selectedCoupon.couponId === item.couponId}}" name="success" color="#C0322A" size="40rpx" />
        </view>
      </scroll-view>
      <view class="coupon-popup__footer">
        <van-button wx:if="{{selectedCoupon}}" plain size="small" bindtap="onClearCoupon">不使用优惠券</van-button>
      </view>
    </view>
  </van-popup>

</view>
