<!-- pages/order-create/order-create.wxml — 开单 -->
<view class="container order-create-page">

  <!-- 顶部商品类型 4 选 1（PR-B §2.1）-->
  <van-tabs
    active="{{productKindChoiceIndex}}"
    bind:change="onBigCategoryChange"
    color="#C0322A"
    title-active-color="#C0322A"
    line-width="40rpx"
  >
    <van-tab wx:for="{{productKindChoices}}" wx:key="*this" title="{{item}}" />
  </van-tabs>

  <!-- 分类 + 商品主区域 -->
  <view class="catalog-layout">

    <!-- 组合套餐：独立 BundlePicker 子视图（隐藏侧边栏）-->
    <block wx:if="{{productKindChoice === '组合套餐'}}">
      <view class="bundle-picker-wrap">
        <bundle-picker
          bundles="{{bundleSpus}}"
          skuMap="{{skuMap}}"
          bind:select="onBundlePickerSelect"
        />
      </view>
    </block>

    <!-- 其他类型：侧边栏 + SKU 列表 -->
    <block wx:else>
      <!-- 左侧：分类侧边栏 -->
      <scroll-view class="sidebar-scroll" scroll-y>
        <van-sidebar active-key="{{activeCategoryIndex}}" bind:change="onCategoryChange">
          <van-sidebar-item
            wx:for="{{categories}}"
            wx:key="id"
            title="{{item.name}}"
          />
        </van-sidebar>
      </scroll-view>

      <!-- 右侧：商品列表 -->
      <scroll-view class="product-scroll" scroll-y>
        <!-- 骨架屏 -->
        <view wx:if="{{catalogLoading && spuList.length === 0}}" class="skeleton-wrap">
          <van-skeleton title avatar row="3" />
          <van-skeleton title avatar row="3" style="margin-top:24rpx" />
        </view>

        <!-- 空态 -->
        <view wx:elif="{{spuList.length === 0 && categories.length === 0}}">
          <van-empty description="暂无商品" />
        </view>
        <view wx:elif="{{spuList.length === 0 && categories.length > 0}}">
          <van-empty description="该分类暂无商品" />
        </view>

        <!-- SPU 列表（isCardType=true 时 grid 简化布局；否则平铺卡片）-->
        <view wx:else>
          <view class="spu-list-inner {{isCardType ? 'spu-list-inner--grid' : ''}}">
            <view
              class="{{isCardType ? 'sku-grid-item' : 'spu-card'}}"
              wx:for="{{spuList}}"
              wx:key="spuId"
              bindtap="onSpuTap"
              data-spu="{{item}}"
            >
              <!-- 卡类型 grid：简化为"名称 + 金额"按钮块 -->
              <block wx:if="{{isCardType}}">
                <text class="sku-grid-name">{{item.spuName}}</text>
                <view class="sku-grid-price">
                  <text class="price-symbol">¥</text>
                  <text class="price-integer">{{item.price}}</text>
                </view>
              </block>

              <!-- 普通商品：保留原图文卡片 -->
              <block wx:else>
                <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
                  <van-icon name="photo-o" size="64rpx" color="#C0322A" />
                </view>
                <image
                  wx:else
                  class="spu-cover"
                  src="{{item.cover_image}}"
                  mode="aspectFill"
                  lazy-load
                />
                <view class="spu-body">
                  <view class="spu-tags" wx:if="{{item.is_recommend}}">
                    <van-tag color="#C0322A">推荐</van-tag>
                  </view>
                  <text class="spu-name">{{item.spuName}}</text>
                  <view class="spu-footer">
                    <view class="price-group">
                      <text class="price-symbol">¥</text>
                      <text class="price-integer">{{item.price}}</text>
                    </view>
                    <view class="spu-add-btn">
                      <van-icon name="plus" size="36rpx" color="#FFFFFF" />
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </view>

          <!-- 购物车已选项目（内联） -->
          <view wx:if="{{cart.length > 0}}" class="cart-items-inline">
            <text class="cart-inline-title">已添加项目</text>
            <view class="cart-item" wx:for="{{cart}}" wx:key="skuId">
              <view class="cart-item-info">
                <text class="cart-item-name">{{item.spuName}}</text>
                <text class="cart-item-spec">{{item.specName}}</text>
              </view>
              <view class="cart-item-right">
                <text class="cart-item-price">¥{{item.itemTotal}}</text>
                <van-stepper
                  wx:if="{{!item.refBundleId}}"
                  value="{{item.quantity}}"
                  min="1"
                  max="10"
                  data-sku-id="{{item.skuId}}"
                  bind:change="onCartQtyChange"
                />
                <van-icon
                  name="delete-o" size="36rpx" color="#D94040"
                  data-sku-id="{{item.skuId}}" catchtap="onCartItemRemove"
                />
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>
  </view>

  <!-- 底部操作栏（组合套餐视图或普通分类有数据时显示）-->
  <view class="bottom-bar" wx:if="{{categories.length > 0 || productKindChoice === '组合套餐'}}">
    <view class="bottom-bar-mid">
      <text class="bottom-bar-count" wx:if="{{cartCount > 0}}">已选 {{cartCount}} 项</text>
      <text class="bottom-bar-total">¥{{cartTotal}}</text>
    </view>
    <van-button
      type="primary"
      size="small"
      disabled="{{cartCount === 0}}"
      custom-class="btn-primary-brand"
      custom-style="border-radius:40rpx;padding:0 40rpx;"
      bind:click="onOpenCheckout"
    >下单</van-button>
  </view>

  <!-- 结算面板弹层 -->
  <van-popup
    show="{{showCheckout}}"
    position="bottom"
    round
    safe-area-inset-bottom
    bind:close="onCloseCheckout"
  >
    <view class="checkout-panel">
      <!-- 步骤条 -->
      <view class="checkout-steps">
        <view class="checkout-step {{checkoutStep >= 0 ? 'checkout-step--active' : ''}}">选顾客</view>
        <view class="checkout-step-line" />
        <view class="checkout-step {{checkoutStep >= 1 ? 'checkout-step--active' : ''}}">开单类型</view>
        <view class="checkout-step-line" />
        <view class="checkout-step {{checkoutStep >= 2 ? 'checkout-step--active' : ''}}">确认</view>
      </view>

      <!-- Step 0: 选择顾客 -->
      <view wx:if="{{checkoutStep === 0}}" class="checkout-body">
        <view wx:if="{{recentCustomers.length > 0}}" class="recent-section">
          <text class="section-label">最近选择</text>
          <van-cell-group>
            <van-cell
              wx:for="{{recentCustomers}}"
              wx:key="phone"
              title="{{item.name || '未命名'}}"
              label="{{item.phoneMasked || item.phone}}"
              is-link
              data-customer="{{item}}"
              bind:click="onSelectRecentCustomer"
            />
          </van-cell-group>
        </view>
        <van-search
          value="{{customerPhone}}"
          placeholder="输入手机号搜索顾客"
          bind:search="onSearchCustomer"
          bind:change="onCustomerPhoneChange"
          use-action-slot
        >
          <view slot="action" bindtap="onSearchCustomer">搜索</view>
        </van-search>
        <view wx:if="{{customerInfo}}" class="customer-found">
          <van-cell-group>
            <van-cell
              title="{{customerInfo.name || customerInfo.phone}}"
              label="{{customerInfo.phoneMasked || customerInfo.phone}}"
              value="已选"
              icon="manager-o"
            />
          </van-cell-group>
        </view>
        <view class="checkout-footer">
          <van-button
            type="primary"
            block
            loading="{{customerSearching}}"
            custom-class="btn-primary-brand"
            custom-style="border-radius:48rpx;"
            bind:click="onStep0Next"
          >下一步</van-button>
        </view>
      </view>

      <!-- Step 1（死码）—— PR-B 废除"选开单模式"；PR-C 将订单类型挪到 Step 2 顶部 -->
      <view wx:if="{{checkoutStep === 1}}" class="checkout-body">
        <!-- intentionally empty -->
      </view>

      <!-- Step 2: 确认订单 -->
      <view wx:if="{{checkoutStep === 2}}" class="checkout-body">
        <text class="checkout-customer-label">
          顾客：{{customerInfo.name || customerInfo.phone}} · {{saleOrderType}}
        </text>

        <!-- PR-C §C1 — 订单类型 3 选 1 -->
        <view class="order-type-cards">
          <view
            class="order-type-card {{saleOrderType === '销售单' ? 'order-type-card--active' : ''}}"
            data-type="销售单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name">销售单</text>
            <text class="order-type-card-desc">正常计价</text>
          </view>
          <view
            class="order-type-card {{saleOrderType === '内部单' ? 'order-type-card--active' : ''}} {{!isManager ? 'order-type-card--disabled' : ''}}"
            data-type="内部单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name {{!isManager ? 'order-type-card-name--gray' : ''}}">内部单</text>
            <text class="order-type-card-desc">员工半价</text>
          </view>
          <view
            class="order-type-card {{saleOrderType === '转换单' ? 'order-type-card--active' : ''}} {{(!isManager || !customerInfo.id) ? 'order-type-card--disabled' : ''}}"
            data-type="转换单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name {{(!isManager || !customerInfo.id) ? 'order-type-card-name--gray' : ''}}">转换单</text>
            <text class="order-type-card-desc">{{!customerInfo.id ? '需已注册顾客' : '卡折抵换购'}}</text>
          </view>
        </view>

        <!-- PR-C §C3 — 转换单 Panel（saleOrderType='转换单' 时渲染） -->
        <block wx:if="{{saleOrderType === '转换单'}}">
          <conversion-panel
            clientUserId="{{customerInfo.id}}"
            convertInAmount="{{cartTotal}}"
            bind:change="onConversionPanelChange"
          />
        </block>

        <!-- 销售单 / 内部单：行级明细 -->
        <block wx:else>
          <view class="confirm-items">
            <view class="confirm-item-block" wx:for="{{cart}}" wx:key="skuId">
              <view class="confirm-item-header">
                <text class="confirm-item-name">{{item.spuName}}</text>
                <text class="confirm-item-spec">{{item.specName}}</text>
              </view>
              <view class="confirm-item-row">
                <text class="confirm-item-label">售价</text>
                <text class="confirm-item-value">¥{{item.price}} × {{item.quantity}} = ¥{{item.subtotal}}</text>
              </view>

              <!-- PR-C §C6：行级自定义单价（仅销售单） -->
              <view wx:if="{{saleOrderType === '销售单'}}" class="confirm-item-row">
                <text class="confirm-item-label">自定义单价</text>
                <view class="confirm-discount-input-wrap">
                  <text class="confirm-discount-prefix">¥</text>
                  <input
                    class="confirm-discount-input"
                    type="digit"
                    value="{{item.customPrice}}"
                    placeholder="留空使用原价"
                    data-sku-id="{{item.skuId}}"
                    bindblur="onCustomPriceChange"
                  />
                </view>
              </view>

              <!-- PR-C §C2：内部单禁 discount（仅展示），销售单正常可编辑 -->
              <view class="confirm-item-row">
                <text class="confirm-item-label">优惠</text>
                <view class="confirm-discount-input-wrap {{saleOrderType === '内部单' ? 'confirm-discount-input-wrap--disabled' : ''}}">
                  <text class="confirm-discount-prefix">¥</text>
                  <input
                    class="confirm-discount-input"
                    type="digit"
                    value="{{item.discount || ''}}"
                    placeholder="0"
                    disabled="{{saleOrderType === '内部单'}}"
                    data-sku-id="{{item.skuId}}"
                    bindblur="onDiscountChange"
                  />
                </view>
              </view>

              <!-- 实付：内部单展示半价；销售单展示 itemTotal -->
              <view class="confirm-item-row">
                <text class="confirm-item-label">实付</text>
                <block wx:if="{{saleOrderType === '内部单'}}">
                  <view class="confirm-internal-price">
                    <text class="confirm-item-origprice">¥{{item.itemTotal}}</text>
                    <text class="confirm-item-receivable">¥{{item.halfPriceItemTotal}}</text>
                  </view>
                </block>
                <text wx:else class="confirm-item-receivable">¥{{item.itemTotal}}</text>
              </view>
            </view>

            <!-- PR-C §C2：内部单合计区加"5 折"标签 + 划线原价 + 半价总计 -->
            <view class="confirm-total-row">
              <view class="confirm-total-label-group">
                <text class="confirm-total-label">合计</text>
                <view wx:if="{{saleOrderType === '内部单'}}" class="confirm-internal-badge">内部单 5 折</view>
              </view>
              <block wx:if="{{saleOrderType === '内部单'}}">
                <view class="confirm-total-price-group">
                  <text class="confirm-total-strikethrough">¥{{cartTotal}}</text>
                  <text class="confirm-total-amount">¥{{halfPriceTotal}}</text>
                </view>
              </block>
              <text wx:else class="confirm-total-amount">¥{{cartTotal}}</text>
            </view>
          </view>

          <!-- PR-C §C2：优惠券控件仅销售单可见（内部单已在云函数侧守卫拒券） -->
          <block wx:if="{{saleOrderType === '销售单'}}">
            <view class="confirm-coupon-row" bindtap="onSelectCoupon">
              <text class="confirm-item-label">顾客优惠券</text>
              <view class="confirm-coupon-value">
                <text wx:if="{{selectedCoupon}}" class="confirm-coupon-discount">-¥{{couponDiscount}}</text>
                <text wx:else class="confirm-coupon-hint">去选择</text>
                <van-icon name="arrow" size="28rpx" color="#999" />
              </view>
            </view>
            <view wx:if="{{selectedCoupon}}" class="confirm-coupon-info">
              <text>{{selectedCoupon.name}}</text>
            </view>
            <view wx:if="{{couponDiscount > 0}}" class="confirm-total-row">
              <text class="confirm-total-label">券后合计</text>
              <text class="confirm-total-amount confirm-total-amount--coupon">¥{{couponTotal}}</text>
            </view>
          </block>

          <!-- PR-D1：支付方式（销售单 / 内部单二选一；转换单由 ConversionPanel 内部 picker 管理） -->
          <view class="order-type-cards">
            <view
              class="order-type-card {{paymentMethod === '微信' ? 'order-type-card--active' : ''}}"
              data-method="微信"
              bindtap="onPaymentMethodTap"
            >
              <text class="order-type-card-name">微信支付</text>
              <text class="order-type-card-desc">扫码付款</text>
            </view>
            <view
              class="order-type-card {{paymentMethod === '线下' ? 'order-type-card--active' : ''}}"
              data-method="线下"
              bindtap="onPaymentMethodTap"
            >
              <text class="order-type-card-name">线下收款</text>
              <text class="order-type-card-desc">待店长确认</text>
            </view>
          </view>
        </block>

        <!-- 指定美容师（可选，用于默认分配） -->
        <van-cell
          title="指定美容师"
          value="{{preferredStaffName || '不指定'}}"
          is-link
          bindtap="onSelectPreferredStaff"
        />
        <van-field
          label="备注"
          placeholder="选填，最多100字"
          type="textarea"
          maxlength="100"
          autosize
          bind:change="onRemarkChange"
        />
        <view class="checkout-footer checkout-footer--row">
          <van-button size="small" plain bind:click="onStep2Back">返回修改</van-button>
          <van-button
            size="small" type="primary"
            loading="{{submitting}}"
            custom-class="btn-primary-brand"
            custom-style="border-radius:40rpx;"
            bind:click="onSubmitOrder"
          >确认开单</van-button>
        </view>
      </view>
    </view>
  </van-popup>

  <!-- 美容师选择 Popup -->
  <van-popup
    show="{{showStaffPicker}}"
    round
    position="bottom"
    bind:close="onStaffPickerClose"
  >
    <van-picker
      title="指定美容师"
      show-toolbar
      columns="{{staffPickerColumns}}"
      bind:confirm="onPreferredStaffConfirm"
      bind:cancel="onStaffPickerClose"
    />
  </van-popup>

  <!-- 优惠券选择 Popup -->
  <van-popup
    show="{{showCouponPopup}}"
    position="bottom"
    round
    closeable
    bind:close="onCloseCouponPopup"
  >
    <view class="coupon-popup">
      <view class="coupon-popup__title">选择顾客优惠券</view>
      <view wx:if="{{couponsLoading}}" class="coupon-popup__loading">
        <van-loading size="48rpx" />
      </view>
      <view wx:elif="{{availableCoupons.length === 0}}" class="coupon-popup__empty">
        <text>该顾客暂无可用优惠券</text>
      </view>
      <scroll-view wx:else scroll-y class="coupon-popup__list">
        <view
          wx:for="{{availableCoupons}}"
          wx:key="couponId"
          class="coupon-popup__item {{selectedCoupon && selectedCoupon.couponId === item.couponId ? 'coupon-popup__item--active' : ''}}"
          bindtap="onCouponPick"
          data-coupon-id="{{item.couponId}}"
          data-name="{{item.name}}"
          data-discount="{{item.discount}}"
        >
          <view class="coupon-popup__item-left">
            <text class="coupon-popup__item-discount">¥{{item.discount}}</text>
            <text class="coupon-popup__item-type">{{item.couponType}}</text>
          </view>
          <view class="coupon-popup__item-right">
            <text class="coupon-popup__item-name">{{item.name}}</text>
            <text class="coupon-popup__item-expire">有效期至 {{item.expireAt}}</text>
          </view>
          <van-icon wx:if="{{selectedCoupon && selectedCoupon.couponId === item.couponId}}" name="success" color="#C0322A" size="40rpx" />
        </view>
      </scroll-view>
      <view class="coupon-popup__footer">
        <van-button wx:if="{{selectedCoupon}}" plain size="small" bindtap="onClearCoupon">不使用优惠券</van-button>
      </view>
    </view>
  </van-popup>

</view>
