
<view class="container order-create-page">

  
  <van-tabs
    active="{{productKindChoiceIndex}}"
    bind:change="onBigCategoryChange"
    color="#C0322A"
    title-active-color="#C0322A"
    line-width="40rpx"
  >
    <van-tab wx:for="{{productKindChoices}}" wx:key="*this" title="{{item}}" />
  </van-tabs>

  
  <van-search
    wx:if="{{productKindChoice === '普通商品'}}"
    value="{{productKeyword}}"
    placeholder="搜索商品名称"
    bind:change="onProductKeywordChange"
    bind:clear="onProductKeywordClear"
  />

  
  <view class="catalog-layout">

    
    <block wx:if="{{productKindChoice === '组合套餐'}}">
      <view class="bundle-picker-wrap">
        <bundle-picker
          bundles="{{bundleSpus}}"
          bind:select="onBundlePickerSelect"
        />
      </view>
    </block>

    
    <block wx:elif="{{productKindChoice === '体验卡'}}">
      <scroll-view class="trial-card-scroll" scroll-y>
        <view wx:if="{{spuList.length === 0}}" class="trial-card-empty">
          <van-empty description="暂无可选体验卡" />
        </view>
        <view wx:else class="trial-card-list">
          <view
            wx:for="{{spuList}}"
            wx:key="spuId"
            class="trial-card-item"
            bindtap="onSpuTap"
            data-spu="{{item}}"
          >
            <text class="trial-card-name">{{item.spuName}}</text>
            <view class="trial-card-sub">
              <text class="trial-card-meta">{{item.sessionCount ? item.sessionCount + '次卡' : '单次'}}</text>
              <view class="trial-card-right">
                <view class="price-dual">
                  <block wx:if="{{item.specialPrice != null}}">
                    <text class="price-original">¥{{item.listPrice}}</text>
                    <text class="price-special">¥{{item.specialPrice}}</text>
                  </block>
                  <text wx:else class="price-special">¥{{item.listPrice}}</text>
                </view>
                <view class="trial-card-add-btn">加入</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

    
    <block wx:else>
      
      <scroll-view class="sidebar-scroll" scroll-y>
        
        <block wx:if="{{productKindChoice === '普通商品'}}">
          <view
            class="grouped-sidebar"
            wx:for="{{groupedCategories}}"
            wx:for-item="group"
            wx:key="productKind"
          >
            <view class="group-header">{{group.productKind}}</view>
            <view
              wx:for="{{group.items}}"
              wx:for-item="sub"
              wx:key="id"
              class="cat-item {{activeCategoryId === sub.id ? 'cat-item--active' : ''}}"
              hover-class="cat-item-hover"
              hover-stay-time="50"
              data-id="{{sub.id}}"
              bindtap="onGroupedCategoryTap"
            >{{sub.name}}</view>
          </view>
        </block>
        
        <van-sidebar wx:else active-key="{{activeCategoryIndex}}" bind:change="onCategoryChange">
          <van-sidebar-item
            wx:for="{{categories}}"
            wx:key="id"
            title="{{item.name}}"
          />
        </van-sidebar>
      </scroll-view>

      
      <scroll-view class="product-scroll" scroll-y>
        
        <view wx:if="{{catalogLoading && spuList.length === 0}}" class="skeleton-wrap">
          <van-skeleton title avatar row="3" />
          <van-skeleton title avatar row="3" style="margin-top:24rpx" />
        </view>

        
        <view wx:elif="{{searching && spuList.length === 0}}">
          <van-empty description="未找到相关商品" />
        </view>

        
        <view wx:elif="{{spuList.length === 0 && categories.length === 0}}">
          <van-empty description="暂无商品" />
        </view>
        <view wx:elif="{{spuList.length === 0 && categories.length > 0}}">
          <van-empty description="该分类暂无商品" />
        </view>

        
        <view wx:else>
          
          <view wx:if="{{isCardType}}" class="spu-list-inner spu-list-inner--grid">
            <view
              class="sku-grid-item"
              wx:for="{{spuList}}"
              wx:key="spuId"
              bindtap="onSpuTap"
              data-spu="{{item}}"
            >
              <text class="sku-grid-name">{{item.spuName}}</text>
              <view class="sku-grid-price">
                <text class="price-symbol">¥</text>
                <text class="price-integer">{{item.price}}</text>
              </view>
            </view>
          </view>

          
          <view wx:else class="trial-card-list">
            <view
              class="trial-card-item"
              wx:for="{{spuList}}"
              wx:key="spuId"
              bindtap="onSpuTap"
              data-spu="{{item}}"
            >
              <text class="trial-card-name">{{item.spuName}}</text>
              <view class="trial-card-sub">
                <text class="trial-card-meta">{{item.productType === '疗程卡' ? (item.productType + ' · ' + (item.sessionCount ? item.sessionCount + '次' : '单次')) : item.productType}}</text>
                <view class="trial-card-right">
                  <view class="price-dual">
                    <block wx:if="{{item.specialPrice != null}}">
                      <text class="price-original">¥{{item.listPrice}}</text>
                      <text class="price-special">¥{{item.specialPrice}}</text>
                    </block>
                    <text wx:else class="price-special">¥{{item.listPrice}}</text>
                  </view>
                  <view class="trial-card-add-btn">加入</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>
  </view>

  
  <view class="bottom-bar" wx:if="{{productKindChoice !== '组合套餐' && (categories.length > 0 || (productKindChoice === '体验卡' && spuList.length > 0))}}">
    <view class="bottom-bar-cart {{cartCount === 0 ? 'bottom-bar-cart--disabled' : ''}}" bindtap="onOpenCartPopup">
      <text class="bottom-bar-cart-text">已选 {{cartCount}} 项</text>
    </view>
    <view class="bottom-bar-mid" bindtap="onOpenCartPopup">
      <text class="bottom-bar-total">¥{{cartTotal}}</text>
    </view>
    <van-button
      type="primary"
      size="small"
      disabled="{{cartCount === 0}}"
      custom-class="btn-primary-brand"
      custom-style="border-radius:40rpx;padding:0 40rpx;"
      bind:click="onOpenCheckout"
    >下单</van-button>
  </view>

  
  <van-popup
    show="{{cartPopupVisible}}"
    position="bottom"
    round
    safe-area-inset-bottom
    bind:close="onCloseCartPopup"
  >
    <view class="cart-popup">
      <view class="cart-popup-header">
        <text class="cart-popup-title">已选项目</text>
        <text class="cart-popup-clear" bindtap="onClearCart">清空</text>
      </view>
      <scroll-view scroll-y class="cart-popup-list">
        <view class="cart-item" wx:for="{{cart}}" wx:key="skuId">
          <view class="cart-item-info">
            <text class="cart-item-name">{{item.specName}}</text>
            <text class="cart-item-spec" wx:if="{{item.productType}}">{{item.productType === '疗程卡' ? (item.productType + ' · ' + (item.sessionCount ? item.sessionCount + '次' : '单次')) : item.productType}}</text>
            <view class="cart-item-unitprice">
              <block wx:if="{{item.specialPrice != null}}">
                <text class="price-original">¥{{item.listPrice}}</text>
                <text class="price-special">¥{{item.specialPrice}}</text>
              </block>
              <text wx:else class="price-special">¥{{item.listPrice}}</text>
            </view>
          </view>
          <view class="cart-item-right">
            <text class="cart-item-price">¥{{item.priceLine}}</text>
            <van-stepper
              wx:if="{{!item.refBundleId}}"
              value="{{item.quantity}}"
              min="1"
              max="99"
              data-sku-id="{{item.skuId}}"
              bind:change="onCartQtyChange"
            />
            <van-icon
              name="delete-o" size="36rpx" color="#D94040"
              data-sku-id="{{item.skuId}}" catchtap="onCartItemRemove"
            />
          </view>
        </view>
      </scroll-view>
    </view>
  </van-popup>

  
  <van-popup
    show="{{showCheckout}}"
    position="bottom"
    safe-area-inset-bottom
    bind:close="onCloseCheckout"
  >
    <view class="checkout-panel">
      
      <view class="checkout-steps">
        <view class="checkout-step {{checkoutStep >= 0 ? 'checkout-step--active' : ''}}">选顾客</view>
        <view class="checkout-step-line" />
        <view class="checkout-step {{checkoutStep === 2 ? 'checkout-step--active' : ''}}">确认订单</view>
      </view>

      
      <view wx:if="{{checkoutStep === 0}}" class="checkout-body">
        <view wx:if="{{recentCustomers.length > 0}}" class="recent-section">
          <text class="section-label">最近选择</text>
          <van-cell-group>
            <van-cell
              wx:for="{{recentCustomers}}"
              wx:key="phone"
              title="{{item.name || '未命名'}}"
              label="{{item.phoneMasked || item.phone}}"
              is-link
              data-customer="{{item}}"
              bind:click="onSelectRecentCustomer"
            />
          </van-cell-group>
        </view>
        <van-search
          value="{{customerKeyword}}"
          placeholder="搜索姓名或手机号"
          bind:search="onSearchCustomer"
          bind:change="onCustomerKeywordChange"
          use-action-slot
        >
          <view slot="action" bindtap="onSearchCustomer">搜索</view>
        </van-search>
        <view wx:if="{{customerResults.length > 0 && !customerInfo}}" class="customer-results">
          <van-cell-group>
            <van-cell
              wx:for="{{customerResults}}"
              wx:key="clientUserId"
              title="{{item.name || '未命名'}}"
              label="{{item.phoneMasked || item.phone}}"
              value="{{item.crossStore ? '非本店·' + item.storeName : item.storeName}}"
              value-class="{{item.crossStore ? 'customer-cross-store' : ''}}"
              is-link
              data-customer="{{item}}"
              bind:click="onSelectCustomer"
            />
          </van-cell-group>
        </view>
        <view wx:if="{{customerInfo}}" class="customer-found">
          <van-cell-group>
            <van-cell
              title="{{customerInfo.name || customerInfo.phone}}"
              label="{{customerInfo.phoneMasked || customerInfo.phone}}"
              value="{{customerInfo.crossStore ? '非本店·' + customerInfo.storeName : '已选'}}"
              value-class="{{customerInfo.crossStore ? 'customer-cross-store' : ''}}"
              icon="manager-o"
            />
          </van-cell-group>
        </view>
        <view class="checkout-footer">
          <van-button
            type="primary"
            block
            loading="{{customerSearching}}"
            custom-class="btn-primary-brand"
            custom-style="border-radius:48rpx;"
            bind:click="onStep0Next"
          >下一步</van-button>
        </view>
      </view>

      
      <view wx:if="{{checkoutStep === 2}}" class="checkout-body">
        <text class="checkout-customer-label">
          顾客：{{customerInfo.name || customerInfo.phone}} · {{saleOrderType}}
        </text>

        
        <view class="order-type-cards">
          <view
            class="order-type-card {{saleOrderType === '销售单' ? 'order-type-card--active' : ''}}"
            data-type="销售单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name">销售单</text>
            <text class="order-type-card-desc">正常计价</text>
          </view>
          <view
            class="order-type-card {{saleOrderType === '内部单' ? 'order-type-card--active' : ''}}"
            data-type="内部单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name">内部单</text>
            <text class="order-type-card-desc">员工半价</text>
          </view>
          <view
            class="order-type-card {{saleOrderType === '转换单' ? 'order-type-card--active' : ''}} {{!customerInfo ? 'order-type-card--disabled' : ''}}"
            data-type="转换单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name {{!customerInfo ? 'order-type-card-name--gray' : ''}}">转换单</text>
            <text class="order-type-card-desc">{{!customerInfo ? '需已注册顾客' : '卡折抵换购'}}</text>
          </view>
          <view
            class="order-type-card {{saleOrderType === '寄存单' ? 'order-type-card--active' : ''}} {{!customerInfo ? 'order-type-card--disabled' : ''}}"
            data-type="寄存单"
            bindtap="onSelectSaleOrderType"
          >
            <text class="order-type-card-name {{!customerInfo ? 'order-type-card-name--gray' : ''}}">寄存单</text>
            <text class="order-type-card-desc">{{!customerInfo ? '需已注册顾客' : '剩余次数寄存'}}</text>
          </view>
        </view>

        
        <block wx:if="{{saleOrderType === '转换单'}}">
          <conversion-panel
            clientUserId="{{customerInfo.clientUserId}}"
            convertInAmount="{{cartTotal}}"
            cardBalance="{{customerCardBalance}}"
            cartItems="{{cart}}"
            bind:change="onConversionPanelChange"
          />
        </block>

        
        <block wx:elif="{{saleOrderType === '寄存单'}}">
          <view class="deposit-banner">
            <text>寄存单：不收款，仅初始化剩余次数到小程序，可生成服务单核销。历史实收金额仅作账目记录，不计营业额。</text>
          </view>
          <view class="confirm-items">
            <view class="confirm-item-block" wx:for="{{cart}}" wx:key="skuId">
              <view class="confirm-item-header">
                <text class="confirm-item-name">{{item.spuName}}</text>
                <text class="confirm-item-spec">{{item.specName}}</text>
              </view>
              
              <view wx:if="{{item.productType === '疗程卡' && item.sessionCount > 0}}" class="confirm-item-row">
                <text class="confirm-item-label">规定次数</text>
                <text class="confirm-item-value">{{item.sessionCount}} 次</text>
              </view>
              <view class="confirm-item-row">
                <text class="confirm-item-label">数量</text>
                <text class="confirm-item-value">× {{item.quantity}}</text>
              </view>
              
              <view class="confirm-item-row">
                <text class="confirm-item-label">历史实收</text>
                <view class="confirm-discount-input-wrap">
                  <text class="confirm-discount-prefix">¥</text>
                  <input
                    class="confirm-discount-input"
                    type="digit"
                    value="{{depositReceivedMap[item.skuId]}}"
                    placeholder="0"
                    data-sku-id="{{item.skuId}}"
                    bindblur="onDepositReceivedChange"
                  />
                </view>
              </view>
            </view>
          </view>
        </block>

        
        <block wx:else>
          
          <block wx:if="{{saleOrderType === '销售单'}}">
            <view class="confirm-coupon-row" bindtap="onSelectCoupon">
              <text class="confirm-item-label">顾客优惠券</text>
              <view class="confirm-coupon-value">
                <text wx:if="{{selectedCoupon}}" class="confirm-coupon-discount">-¥{{couponDiscount}}</text>
                <text wx:else class="confirm-coupon-hint">去选择</text>
                <van-icon name="arrow" size="28rpx" color="#999" />
              </view>
            </view>
            <view wx:if="{{selectedCoupon}}" class="confirm-coupon-info">
              <text>{{selectedCoupon.name}}</text>
            </view>
          </block>

          <view class="confirm-items">
            <view class="confirm-item-block" wx:for="{{cart}}" wx:key="skuId">
              <view class="confirm-item-header">
                <text class="confirm-item-name">{{item.spuName}}</text>
                <text class="confirm-item-spec">{{item.specName}}</text>
              </view>
              
              <view wx:if="{{item.productType === '疗程卡' && item.sessionCount > 0}}" class="confirm-item-row">
                <text class="confirm-item-label">规定次数</text>
                <text class="confirm-item-value">{{item.sessionCount}} 次</text>
              </view>
              <view class="confirm-item-row">
                <text class="confirm-item-label">价格</text>
                <text class="confirm-item-value">¥{{item.price}} × {{item.quantity}} = ¥{{item.priceLine}}</text>
              </view>

              
              <view class="confirm-item-row">
                <text class="confirm-item-label">应付金额</text>
                <view
                  wx:if="{{item.isManagerSpecial && saleOrderType === '销售单' && !item.refBundleId && item.productType !== '组合套餐'}}"
                  class="confirm-discount-input-wrap"
                >
                  <text class="confirm-special-badge">店长特价</text>
                  <text class="confirm-discount-prefix">¥</text>
                  <input
                    class="confirm-discount-input"
                    type="digit"
                    value="{{item.saleAmount}}"
                    placeholder="0"
                    data-sku-id="{{item.skuId}}"
                    bindblur="onSaleAmountChange"
                  />
                </view>
                <block wx:elif="{{saleOrderType === '内部单'}}">
                  <view class="confirm-internal-price">
                    <text class="confirm-item-origprice">¥{{item.saleAmount}}</text>
                    <text class="confirm-item-receivable">¥{{item.halfPriceSaleAmount}}</text>
                  </view>
                </block>
                <text wx:else class="confirm-item-receivable">¥{{item.saleAmount}}</text>
              </view>

              
              <view class="confirm-item-row">
                <text class="confirm-item-label">实付金额</text>
                <view class="confirm-discount-input-wrap">
                  <text class="confirm-discount-prefix">¥</text>
                  <input
                    class="confirm-discount-input"
                    type="digit"
                    value="{{item.received}}"
                    placeholder="0"
                    data-sku-id="{{item.skuId}}"
                    bindblur="onReceivedChange"
                  />
                </view>
              </view>
            </view>

            
            <view class="confirm-total-row">
              <view class="confirm-total-label-group">
                <text class="confirm-total-label">应付合计</text>
                <view wx:if="{{saleOrderType === '内部单'}}" class="confirm-internal-badge">内部单 5 折</view>
              </view>
              <block wx:if="{{saleOrderType === '内部单'}}">
                <view class="confirm-total-price-group">
                  <text class="confirm-total-strikethrough">¥{{cartTotal}}</text>
                  <text class="confirm-total-amount">¥{{payableTotal}}</text>
                </view>
              </block>
              <text wx:else class="confirm-total-amount">¥{{payableTotal}}</text>
            </view>
          </view>

          
          <view class="activity-section">
            <view class="activity-row">
              <text class="activity-label">活动</text>
              <van-switch
                checked="{{isActivity}}"
                size="40rpx"
                active-color="#C0322A"
                bind:change="onToggleActivity"
              />
            </view>
          </view>

          
          <view class="prepaid-card-section">
            <text class="prepaid-card-section-title">抵扣（预选）</text>
            <view class="prepaid-card-row">
              <view class="prepaid-card-info">
                <text class="prepaid-card-label">充值卡</text>
                <text class="prepaid-card-balance">余额 ¥{{customerCardBalance}}</text>
              </view>
              <view class="prepaid-card-switch-wrap">
                <van-switch
                  checked="{{useCard}}"
                  size="40rpx"
                  active-color="#C0322A"
                  disabled="{{customerCardBalance <= 0 || customerBalanceLoading}}"
                  bind:change="onTogglePrepaidCard"
                />
              </view>
            </view>
            <view wx:if="{{useCard && prepaidCardAmount > 0}}" class="prepaid-card-deduct-row">
              <text class="prepaid-card-deduct-label">预选抵扣</text>
              <text class="prepaid-card-deduct-amount">-¥{{prepaidCardAmount}}<text class="prepaid-card-deduct-hint">（不计入实付）</text></text>
            </view>
            <view wx:elif="{{customerCardBalance <= 0}}" class="prepaid-card-empty-hint">
              <text>顾客暂无充值卡余额</text>
            </view>
          </view>

          
          <view class="prepaid-paid-summary">
            <text class="prepaid-paid-label">现金应收</text>
            <text class="prepaid-paid-amount">¥{{paidAmount}}</text>
          </view>
          <view wx:if="{{!showPayMethodGroup}}" class="prepaid-paid-fullcover-hint">
            <text>全额抵扣，支付方式：无</text>
          </view>

          
          
          <view wx:if="{{showPayMethodGroup}}" class="order-type-cards">
            <view
              class="order-type-card {{paymentMethod === '微信' ? 'order-type-card--active' : ''}}"
              data-method="微信"
              bindtap="onPaymentMethodTap"
            >
              <text class="order-type-card-name">微信支付</text>
              <text class="order-type-card-desc">扫码付款</text>
            </view>
            <view
              class="order-type-card {{paymentMethod === '支付宝' ? 'order-type-card--active' : ''}}"
              data-method="支付宝"
              bindtap="onPaymentMethodTap"
            >
              <text class="order-type-card-name">支付宝</text>
              <text class="order-type-card-desc">扫码付款</text>
            </view>
            <view
              class="order-type-card {{paymentMethod === '线下' ? 'order-type-card--active' : ''}}"
              data-method="线下"
              bindtap="onPaymentMethodTap"
            >
              <text class="order-type-card-name">线下收款</text>
              <text class="order-type-card-desc">待店长确认</text>
            </view>
          </view>

          
          <view class="prepaid-warning-tip">
            <van-icon name="warning-o" size="28rpx" color="#FA8C16" />
            <text class="prepaid-warning-text">顾客扫码确认后才真正扣卡</text>
          </view>
        </block>

        
        <van-cell
          title="指定美容师"
          value="{{preferredStaffName || '不指定'}}"
          is-link
          bindtap="onSelectPreferredStaff"
        />
        <van-field
          label="备注"
          placeholder="选填，最多100字"
          type="textarea"
          maxlength="100"
          autosize
          bind:change="onRemarkChange"
        />
        <view class="checkout-footer checkout-footer--row">
          <van-button size="small" plain bind:click="onStep2Back">返回修改</van-button>
          <van-button
            size="small" type="primary"
            loading="{{submitting}}"
            custom-class="btn-primary-brand"
            custom-style="border-radius:40rpx;"
            bind:click="onSubmitOrder"
          >{{saleOrderType === '寄存单' ? '确认寄存' : '生成付款码'}}</van-button>
        </view>
      </view>
    </view>
  </van-popup>

  
  <van-popup
    show="{{showStaffPicker}}"
    round
    position="bottom"
    bind:close="onStaffPickerClose"
  >
    <van-picker
      title="指定美容师"
      show-toolbar
      columns="{{staffPickerColumns}}"
      bind:confirm="onPreferredStaffConfirm"
      bind:cancel="onStaffPickerClose"
    />
  </van-popup>

  
  <van-popup
    show="{{showCouponPopup}}"
    position="bottom"
    round
    closeable
    bind:close="onCloseCouponPopup"
  >
    <view class="coupon-popup">
      <view class="coupon-popup__title">选择顾客优惠券</view>
      <view wx:if="{{couponsLoading}}" class="coupon-popup__loading">
        <van-loading size="48rpx" />
      </view>
      <view wx:elif="{{availableCoupons.length === 0}}" class="coupon-popup__empty">
        <text>该顾客暂无可用优惠券</text>
      </view>
      <scroll-view wx:else scroll-y class="coupon-popup__list">
        <view
          wx:for="{{availableCoupons}}"
          wx:key="couponId"
          class="coupon-popup__item {{selectedCoupon && selectedCoupon.couponId === item.couponId ? 'coupon-popup__item--active' : ''}}"
          bindtap="onCouponPick"
          data-coupon-id="{{item.couponId}}"
          data-name="{{item.name}}"
          data-discount="{{item.discount}}"
        >
          <view class="coupon-popup__item-left">
            <text class="coupon-popup__item-discount">¥{{item.discount}}</text>
            <text class="coupon-popup__item-type">{{item.couponType}}</text>
          </view>
          <view class="coupon-popup__item-right">
            <text class="coupon-popup__item-name">{{item.name}}</text>
            <text class="coupon-popup__item-expire">有效期至 {{item.expireAt}}</text>
          </view>
          <van-icon wx:if="{{selectedCoupon && selectedCoupon.couponId === item.couponId}}" name="success" color="#C0322A" size="40rpx" />
        </view>
      </scroll-view>
      <view class="coupon-popup__footer">
        <van-button wx:if="{{selectedCoupon}}" plain size="small" bindtap="onClearCoupon">不使用优惠券</van-button>
      </view>
    </view>
  </van-popup>

</view>
