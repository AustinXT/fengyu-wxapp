<!-- pages/order-create/order-create.wxml — 开单（全员可操作，店长审批） -->
<view class="container">

  <!-- 非店长提示：需店长审批 -->
  <view wx:if="{{!isManager}}" class="approval-notice">
    <van-icon name="info-o" size="28rpx" color="#D4820A" />
    <text class="approval-notice-text">您提交的订单将由店长审批后生效</text>
  </view>

  <view class="steps-bar">
    <view class="step {{step >= 1 ? 'step-active' : ''}}">
      <view class="step-dot">1</view>
      <text class="step-label">选顾客</text>
    </view>
    <view class="step-line"></view>
    <view class="step {{step >= 2 ? 'step-active' : ''}}">
      <view class="step-dot">2</view>
      <text class="step-label">选商品</text>
    </view>
    <view class="step-line"></view>
    <view class="step {{step >= 3 ? 'step-active' : ''}}">
      <view class="step-dot">3</view>
      <text class="step-label">分配</text>
    </view>
    <view class="step-line"></view>
    <view class="step {{step >= 4 ? 'step-active' : ''}}">
      <view class="step-dot">4</view>
      <text class="step-label">收款</text>
    </view>
  </view>

  <!-- Step 1: 选择顾客 -->
  <view wx:if="{{step === 1}}" class="step-panel">
    <view class="panel-title">选择顾客</view>
    <view class="panel-desc">顾客手机号为必填项，用于关联顾客端账号</view>

    <view class="input-group">
      <van-field
        value="{{customerPhone}}"
        label="手机号"
        placeholder="请输入顾客手机号"
        type="number"
        maxlength="11"
        bind:change="onPhoneChange"
      />
    </view>

    <view wx:if="{{customerInfo}}" class="customer-found">
      <van-cell-group>
        <van-cell title="{{customerInfo.name || '未命名'}}" label="{{customerInfo.phone}}" />
      </van-cell-group>
    </view>

    <view class="order-type-section">
      <view class="panel-title">开单类型</view>
      <van-cell-group>
        <van-cell
          title="正式订单"
          label="从商品目录选择疗程/产品"
          is-link
          bindtap="onSelectOrderType"
          data-type="normal"
          value="{{orderType === 'normal' ? '已选' : ''}}"
        />
        <!-- 体验单：仅店长可用 -->
        <van-cell
          wx:if="{{isManager}}"
          title="体验单"
          label="首次体验，店长自定义金额"
          is-link
          bindtap="onSelectOrderType"
          data-type="experience"
          value="{{orderType === 'experience' ? '已选' : ''}}"
        />
        <van-cell
          title="促销方案"
          label="套餐销售，从方案库选择"
          is-link
          bindtap="onSelectOrderType"
          data-type="promotion"
          value="{{orderType === 'promotion' ? '已选' : ''}}"
        />
      </van-cell-group>
    </view>

    <view class="step-actions">
      <van-button type="primary" block bindtap="onStep1Next" loading="{{searching}}">
        下一步：选择商品
      </van-button>
    </view>
  </view>

  <!-- Step 2: 选择商品 -->
  <view wx:if="{{step === 2}}" class="step-panel">
    <view class="panel-title">添加项目</view>
    <view class="panel-desc">当前顾客：{{customerInfo.phone}}</view>
    <view class="step-actions-row">
      <van-button size="small" bindtap="onStep2Back">返回</van-button>
      <van-button type="primary" size="small" bindtap="onStep2Next">下一步：营业额分配</van-button>
    </view>
    <van-empty description="商品选择（待实现）" />
  </view>

  <!-- Step 3: 营业额分配 -->
  <view wx:if="{{step === 3}}" class="step-panel">
    <view class="panel-title">营业额分配</view>
    <view class="step-actions-row">
      <van-button size="small" bindtap="onStep3Back">返回</van-button>
      <van-button type="primary" size="small" bindtap="onStep3Next">下一步：生成收款码</van-button>
    </view>
    <van-empty description="分配界面（待实现）" />
  </view>

  <!-- Step 4: 生成二维码收款 -->
  <view wx:if="{{step === 4}}" class="step-panel">
    <view class="panel-title">收款</view>
    <van-empty description="二维码收款（待实现）" />
  </view>

</view>
