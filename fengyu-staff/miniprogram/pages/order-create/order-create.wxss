/* pages/order-create/order-create.wxss */

.order-create-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 三级导航：大类tabs + 侧边栏 + 商品列表 ===== */
.catalog-layout {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类滚动区 */
.sidebar-scroll {
  width: 180rpx;
  flex-shrink: 0;
  background: #F5F2EE;
  border-right: 1rpx solid var(--color-border);
  overflow: hidden;
}
.sidebar-scroll .van-sidebar {
  width: 100%;
  background: transparent;
}

/* 右侧商品滚动区 */
.product-scroll {
  flex: 1;
  padding: 16rpx;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 16rpx;
}


/* ===== BundlePicker 子视图 ===== */
.bundle-picker-wrap {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ===== SPU 卡片列表（图文卡片） ===== */
.spu-list-inner {
  padding-bottom: 16rpx;
}

/* ===== SKU 网格（体验卡 / 充值卡 简化布局）===== */
.spu-list-inner--grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.sku-grid-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid transparent;
}
.sku-grid-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
  text-align: center;
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.sku-grid-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--color-primary);
  font-weight: 700;
}
.sku-grid-price .price-symbol { font-size: 24rpx; }
.sku-grid-price .price-integer { font-size: 40rpx; }

.spu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.spu-cover {
  width: 100%;
  height: 220rpx;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F5F2EE 0%, #EDE8E0 100%);
}

.spu-body {
  padding: 18rpx 20rpx 16rpx;
}

.spu-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.spu-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-start {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-left: 4rpx;
}

.spu-add-btn {
  width: 56rpx;
  height: 56rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== 购物车内联展示 ===== */
.cart-items-inline {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}
.cart-inline-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #F0EDE9;
}
.cart-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F2EE;
}
.cart-item:last-child { border-bottom: none; }
.cart-item-info { flex: 1; }
.cart-item-name { font-size: 26rpx; color: var(--color-text-primary); display: block; }
.cart-item-spec { font-size: 22rpx; color: var(--color-text-secondary); }
.cart-item-right { display: flex; align-items: center; gap: 12rpx; }
.cart-item-price { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }

/* ===== 底部操作栏（flex 布局内，非固定定位） ===== */
.bottom-bar {
  position: static;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--color-border);
  gap: 12rpx;
}
.bottom-bar-mid { flex: 1; display: flex; flex-direction: column; align-items: flex-end; padding-right: 8rpx; }
.bottom-bar-count { font-size: 22rpx; color: var(--color-text-hint); }
.bottom-bar-total { font-size: 34rpx; font-weight: 700; color: var(--color-primary); }

/* ===== 结算弹层 ===== */
.checkout-panel { padding: 24rpx 32rpx; }
.checkout-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-bottom: 32rpx;
}
.checkout-step {
  font-size: 24rpx;
  color: #BBB;
  padding: 0 8rpx;
}
.checkout-step--active { color: var(--color-primary); font-weight: 600; }
.checkout-step-line { width: 40rpx; height: 1rpx; background: var(--color-border); }

.checkout-customer-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.recent-section { margin-bottom: 16rpx; }
.section-label { display: block; font-size: 24rpx; color: var(--color-text-hint); margin-bottom: 8rpx; }
.customer-found { margin-top: 8rpx; }

.confirm-items {
  background: #F5F2EE;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.confirm-item-block {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.confirm-item-block:last-child { border-bottom: none; }
.confirm-item-header {
  margin-bottom: 8rpx;
}
.confirm-item-name { font-size: 26rpx; color: var(--color-text-primary); font-weight: 600; }
.confirm-item-spec { font-size: 22rpx; color: var(--color-text-secondary); display: block; margin-top: 2rpx; }
.confirm-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
}
.confirm-item-label { font-size: 24rpx; color: var(--color-text-hint); }
.confirm-item-value { font-size: 24rpx; color: var(--color-text-secondary); }
.confirm-discount-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  width: 200rpx;
}
.confirm-discount-prefix { font-size: 24rpx; color: var(--color-text-hint); margin-right: 4rpx; }
.confirm-discount-input { flex: 1; font-size: 24rpx; color: var(--color-text-primary); height: 48rpx; }
.confirm-item-receivable { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }
.confirm-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-border);
}
.confirm-total-label { font-size: 26rpx; color: var(--color-text-secondary); }
.confirm-total-amount { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }
.confirm-total-amount--coupon { font-size: 32rpx; }

/* 优惠券选择行 */
.confirm-coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-border);
}
.confirm-coupon-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.confirm-coupon-discount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.confirm-coupon-hint {
  font-size: 26rpx;
  color: var(--color-text-hint);
}
.confirm-coupon-info {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding-bottom: 8rpx;
}

/* 优惠券选择弹窗 */
.coupon-popup { padding-bottom: env(safe-area-inset-bottom); }
.coupon-popup__title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 32rpx 0 20rpx;
}
.coupon-popup__loading,
.coupon-popup__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  color: var(--color-text-hint);
  font-size: 28rpx;
}
.coupon-popup__list {
  max-height: 600rpx;
  padding: 0 24rpx;
}
.coupon-popup__item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.coupon-popup__item--active {
  border-color: var(--color-primary);
  background: #FFF5F5;
}
.coupon-popup__item-left {
  width: 140rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.coupon-popup__item-discount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.coupon-popup__item-type {
  font-size: 20rpx;
  color: var(--color-primary);
}
.coupon-popup__item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 16rpx;
}
.coupon-popup__item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}
.coupon-popup__item-expire {
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.coupon-popup__footer {
  display: flex;
  justify-content: center;
  padding: 20rpx 24rpx;
}

.checkout-footer {
  padding-top: 24rpx;
}
.checkout-footer--row {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

/* ===== 订单类型卡片（Step 2 顶部；PR-C §C1）===== */
.order-type-cards {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.order-type-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: #F5F2EE;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
}
.order-type-card--active {
  background: #FFF8F0;
  border-color: var(--color-primary);
}
.order-type-card--disabled { opacity: 0.5; }
.order-type-card-name { font-size: 28rpx; font-weight: 600; color: var(--color-text-primary); }
.order-type-card-name--gray { color: #CCC; }
.order-type-card-desc { font-size: 22rpx; color: var(--color-text-hint); text-align: center; }

/* ===== PR-C §C2 内部单视觉 ===== */
/* 合计行"内部单 5 折"红底徽章 + 划线原价 */
.confirm-total-label-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.confirm-internal-badge {
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}
.confirm-total-price-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.confirm-total-strikethrough {
  font-size: 24rpx;
  color: var(--color-text-hint);
  text-decoration: line-through;
}
/* 行级实付：内部单双价 */
.confirm-internal-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.confirm-item-origprice {
  font-size: 22rpx;
  color: var(--color-text-hint);
  text-decoration: line-through;
}
/* 内部单 discount 输入禁用态 */
.confirm-discount-input-wrap--disabled {
  background: #F5F2EE;
  opacity: 0.6;
}
