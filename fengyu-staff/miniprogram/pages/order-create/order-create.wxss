/* pages/order-create/order-create.wxss */

.order-create-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 三级导航：大类tabs + 侧边栏 + 商品列表 ===== */
.catalog-layout {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类滚动区 */
.sidebar-scroll {
  width: 180rpx;
  flex-shrink: 0;
  background: #F5F2EE;
  border-right: 1rpx solid var(--color-border);
  overflow: hidden;
}
.sidebar-scroll .van-sidebar {
  width: 100%;
  background: transparent;
}

/* 右侧商品滚动区 */
.product-scroll {
  flex: 1;
  padding: 16rpx;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 16rpx;
}

.loading-wrap { display: flex; justify-content: center; padding: 80rpx 0; }
.empty-wrap { padding: 60rpx 0; }

/* ===== SPU 卡片列表（图文卡片） ===== */
.spu-list-inner {
  padding-bottom: 16rpx;
}

.spu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.spu-cover {
  width: 100%;
  height: 220rpx;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F5F2EE 0%, #EDE8E0 100%);
}

.spu-body {
  padding: 18rpx 20rpx 16rpx;
}

.spu-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.spu-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-start {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-left: 4rpx;
}

.spu-add-btn {
  width: 56rpx;
  height: 56rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== 购物车内联展示 ===== */
.cart-items-inline {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}
.cart-inline-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #F0EDE9;
}
.cart-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F2EE;
}
.cart-item:last-child { border-bottom: none; }
.cart-item-info { flex: 1; }
.cart-item-name { font-size: 26rpx; color: var(--color-text-primary); display: block; }
.cart-item-spec { font-size: 22rpx; color: var(--color-text-secondary); }
.cart-item-right { display: flex; align-items: center; gap: 12rpx; }
.cart-item-price { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }

/* 促销方案锁定项 */
.cart-item-qty-lock { font-size: 24rpx; color: var(--color-text-hint); min-width: 48rpx; text-align: center; }

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--color-border);
  gap: 12rpx;
}
.bottom-bar-left { flex-shrink: 0; }
.bottom-bar-mid { flex: 1; display: flex; flex-direction: column; align-items: flex-end; padding-right: 8rpx; }
.bottom-bar-count { font-size: 22rpx; color: var(--color-text-hint); }
.bottom-bar-total { font-size: 34rpx; font-weight: 700; color: var(--color-primary); }

/* 促销方案快捷入口 */
.promo-shortcut {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  background: #FFF8F0;
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
}
.promo-shortcut-text { font-size: 24rpx; color: var(--color-primary); }

/* ===== SKU 弹层 ===== */
.sku-popup { padding: 32rpx; }
.sku-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sku-popup-name { font-size: 32rpx; font-weight: 600; color: var(--color-text-primary); }
.sku-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EDE9;
}
.sku-item:last-child { border-bottom: none; }
.sku-item-info { flex: 1; }
.sku-spec { font-size: 28rpx; font-weight: 600; color: var(--color-text-primary); display: block; }
.sku-sessions { font-size: 22rpx; color: var(--color-text-secondary); }
.sku-item-right { display: flex; align-items: center; gap: 16rpx; }
.sku-price { font-size: 32rpx; font-weight: 700; color: var(--color-primary); }

/* ===== 结算弹层 ===== */
.checkout-panel { padding: 24rpx 32rpx; }
.checkout-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-bottom: 32rpx;
}
.checkout-step {
  font-size: 24rpx;
  color: #BBB;
  padding: 0 8rpx;
}
.checkout-step--active { color: var(--color-primary); font-weight: 600; }
.checkout-step-line { width: 40rpx; height: 1rpx; background: var(--color-border); }

.checkout-customer-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.recent-section { margin-bottom: 16rpx; }
.section-label { display: block; font-size: 24rpx; color: var(--color-text-hint); margin-bottom: 8rpx; }
.customer-found { margin-top: 8rpx; }

.confirm-items {
  background: #F5F2EE;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.confirm-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.confirm-item-left { flex: 1; }
.confirm-item-name { font-size: 26rpx; color: var(--color-text-primary); }
.confirm-item-spec { font-size: 22rpx; color: var(--color-text-secondary); display: block; }
.confirm-item-right { text-align: right; }
.confirm-item-qty { font-size: 22rpx; color: var(--color-text-hint); display: block; }
.confirm-item-price { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }
.confirm-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-border);
}
.confirm-total-label { font-size: 26rpx; color: var(--color-text-secondary); }
.confirm-total-amount { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }

.checkout-footer {
  padding-top: 24rpx;
}
.checkout-footer--row {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

/* ===== 开单类型卡片（Step 1）===== */
.order-type-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.order-type-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 12rpx;
  background: #F5F2EE;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
}
.order-type-card--active {
  background: #FFF8F0;
  border-color: var(--color-primary);
}
.order-type-card--disabled { opacity: 0.5; }
.order-type-card-name { font-size: 28rpx; font-weight: 600; color: var(--color-text-primary); }
.order-type-card-name--gray { color: #CCC; }
.order-type-card-desc { font-size: 22rpx; color: var(--color-text-hint); }
.order-type-card-plan {
  font-size: 20rpx;
  color: var(--color-primary);
  text-align: center;
  background: #F5F2EE;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  margin-top: 4rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 促销方案已选提示 */
.promo-selected-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--color-badge-confirmed);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}
.promo-selected-hint-text { flex: 1; font-size: 24rpx; color: var(--color-success); }
.promo-reselect { font-size: 24rpx; color: var(--color-primary); text-decoration: underline; }

/* 促销方案确认banner */
.promo-order-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.promo-order-banner-name { font-size: 28rpx; font-weight: 600; color: var(--color-primary); }

/* 赠品价格 */
.confirm-item-price--gift { color: var(--color-success); font-size: 22rpx; font-weight: 400; }

/* ===== 促销方案列表弹层 ===== */
.promo-list-panel { padding: 32rpx 32rpx 16rpx; }
.promo-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.promo-list-title { font-size: 34rpx; font-weight: 700; color: var(--color-text-primary); }

.promo-plan-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #F5F2EE;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.promo-plan-info { flex: 1; min-width: 0; }
.promo-plan-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.promo-plan-name { font-size: 30rpx; font-weight: 700; color: var(--color-text-primary); }
.promo-plan-valid { font-size: 22rpx; color: var(--color-text-hint); flex-shrink: 0; }
.promo-plan-price-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.promo-plan-orig { font-size: 24rpx; color: var(--color-text-hint); text-decoration: line-through; }
.promo-plan-promo { font-size: 28rpx; font-weight: 700; color: var(--color-primary); }
.promo-plan-items { display: flex; flex-wrap: wrap; gap: 8rpx; }
.promo-plan-item-tag {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.promo-plan-item-tag--gift {
  color: var(--color-success);
  background: var(--color-badge-confirmed);
}
