/* pages/revenue-allocation/revenue-allocation.wxss */

.loading-wrap { display: flex; justify-content: center; padding: 120rpx 0; }

.order-header {
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.order-no { display: block; font-size: 22rpx; color: #999; font-family: monospace; margin-bottom: 8rpx; }
.amount-row { display: flex; align-items: baseline; gap: 16rpx; }
.amount-label { font-size: 26rpx; color: #666; }
.amount-value { font-size: 48rpx; font-weight: 700; color: #8B6A3E; }

.lock-notice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F5F2EE;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
}
.lock-text { font-size: 24rpx; color: #999; }

/* 分配行 */
.alloc-list { padding: 0 32rpx; }

.alloc-row {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.row-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.row-label { font-size: 26rpx; font-weight: 600; color: #2D2017; }

.staff-selector {
  display: flex;
  align-items: center;
  background: #F5F2EE;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.staff-selector--disabled { opacity: 0.6; }
.staff-selected { flex: 1; }
.staff-name { font-size: 28rpx; font-weight: 600; color: #2D2017; display: block; }
.staff-dept { font-size: 22rpx; color: #666; }
.staff-placeholder { flex: 1; font-size: 26rpx; color: #BBB; }

.amount-input-wrap {
  display: flex;
  align-items: center;
  background: #F5F2EE;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}
.currency-symbol { font-size: 28rpx; color: #8B6A3E; font-weight: 600; margin-right: 8rpx; }
.amount-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2017;
}

/* 添加员工 */
.add-row-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #C4975A;
  background: #FFFBF5;
}
.add-row-text { font-size: 26rpx; color: #8B6A3E; }

/* 预设比例 */
.preset-section {
  padding: 0 32rpx 24rpx;
}
.preset-label { font-size: 24rpx; color: #666; display: block; margin-bottom: 16rpx; }
.preset-btns {
  display: flex;
  gap: 16rpx;
}
.preset-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #F5F2EE;
  font-size: 26rpx;
  color: #8B6A3E;
  font-weight: 600;
}

/* 合计 */
.total-summary {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #E8F5E9;
  padding: 20rpx 32rpx;
  margin: 0 0 32rpx;
}
.total-summary--error { background: #FFEBEE; }
.total-summary-label { font-size: 24rpx; color: #666; }
.total-summary-value { font-size: 32rpx; font-weight: 700; color: #3D8A5A; }
.total-summary--error .total-summary-value { color: #D94040; }
.total-summary-limit { font-size: 22rpx; color: #999; flex: 1; }
.over-budget-text { font-size: 22rpx; color: #D94040; font-weight: 600; }

.action-bar { padding: 0 32rpx 32rpx; }
