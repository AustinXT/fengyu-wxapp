<!-- pages/service-create/service-create.wxml -->
<view class="container">

  <!-- 关联预约（可选） -->
  <view wx:if="{{appointmentInfo}}" class="appt-banner">
    <view class="appt-info">
      <van-icon name="calendar-o" size="32rpx" color="#8B6A3E" />
      <view class="appt-detail">
        <text class="appt-time">{{appointmentInfo.appointmentTime}}</text>
        <text class="appt-item">{{appointmentInfo.serviceItemName}}</text>
      </view>
    </view>
    <van-icon name="cross" size="32rpx" color="#999" bindtap="onRemoveAppointment" />
  </view>

  <!-- 顾客选择 -->
  <view class="section-card">
    <text class="section-title">选择顾客</text>
    <view wx:if="{{selectedCustomer}}" class="customer-selected">
      <van-icon name="manager-o" size="36rpx" color="#8B6A3E" />
      <view class="customer-info">
        <text class="customer-name">{{selectedCustomer.name || '未知'}}</text>
        <text class="customer-phone">{{selectedCustomer.phone}}</text>
      </view>
    </view>
    <view wx:else class="customer-search">
      <van-search
        value="{{customerSearch}}"
        placeholder="输入手机号搜索顾客"
        bind:search="onSearchCustomer"
        bind:change="onCustomerSearchChange"
        use-action-slot
      >
        <view slot="action" bindtap="onSearchCustomer">搜索</view>
      </van-search>
    </view>
  </view>

  <!-- 选择核销订单行 -->
  <view class="section-card" wx:if="{{selectedCustomer}}">
    <text class="section-title">选择核销项目</text>

    <view wx:if="{{loading}}" class="loading-wrap">
      <van-loading type="spinner" color="#8B6A3E" />
    </view>

    <view wx:elif="{{paidOrders.length === 0}}" class="empty-tip">
      <van-empty description="该顾客暂无可核销的已支付订单" />
    </view>

    <view wx:else class="order-list">
      <view class="order-group" wx:for="{{paidOrders}}" wx:key="orderId">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-date">{{item.paidAt}}</text>
        </view>
        <view
          class="order-item {{selectedFlowNos[si.itemFlowNo] ? 'order-item--selected' : ''}}"
          wx:for="{{item.items}}"
          wx:for-item="si"
          wx:key="itemFlowNo"
          bindtap="onToggleItem"
          data-flow-no="{{si.itemFlowNo}}"
          data-item-name="{{si.itemName}}"
          data-spec="{{si.spec}}"
          data-order-no="{{item.orderNo}}"
        >
          <view class="order-item-info">
            <text class="order-item-name">{{si.itemName}}</text>
            <view class="order-item-meta">
              <text class="order-item-spec">{{si.spec}}</text>
              <text class="order-item-sessions">剩余 {{si.remainingSessions}} 次</text>
            </view>
          </view>
          <van-icon
            name="{{selectedFlowNos[si.itemFlowNo] ? 'success' : 'circle'}}"
            size="40rpx"
            color="{{selectedFlowNos[si.itemFlowNo] ? '#8B6A3E' : '#CCCCCC'}}"
          />
        </view>
      </view>
    </view>
  </view>

  <!-- 已选项目汇总 -->
  <view class="section-card" wx:if="{{selectedItems.length > 0}}">
    <text class="section-title">已选核销项目</text>
    <view class="selected-item" wx:for="{{selectedItems}}" wx:key="itemFlowNo">
      <van-icon name="success" size="28rpx" color="#3D8A5A" />
      <text class="selected-item-name">{{item.itemName}} ({{item.spec}}) · 本次 1 次</text>
    </view>
  </view>

  <!-- 服务人员 + 备注 -->
  <view class="section-card">
    <van-cell-group>
      <van-cell title="服务人员" value="{{staffName}}" />
      <van-field
        label="备注"
        placeholder="选填，最多100字"
        type="textarea"
        maxlength="100"
        autosize
        bind:change="onRemarkChange"
      />
    </van-cell-group>
  </view>

  <!-- 提交 -->
  <view class="submit-bar">
    <van-button
      type="primary"
      block
      loading="{{submitting}}"
      custom-style="background: #8B6A3E; border-color: #8B6A3E; border-radius: 48rpx;"
      bind:click="onSubmit"
    >提交服务单</van-button>
  </view>

  <view class="safe-area-bottom" />
</view>
