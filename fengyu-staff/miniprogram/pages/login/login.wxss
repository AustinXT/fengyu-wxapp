/* pages/login/login.wxss */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 64rpx;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 32rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 16rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #C4975A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 40rpx;
}

.login-btn[disabled] {
  opacity: 0.6;
}

.login-error {
  display: block;
  text-align: center;
  color: #FF4D4F;
  font-size: 26rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}
