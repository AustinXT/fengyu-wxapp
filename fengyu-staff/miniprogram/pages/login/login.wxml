
<view class="login-container brand-gradient">
  
  <view class="login-brand">
    <van-icon name="manager-o" size="120rpx" color="#C0322A" />
    <text class="login-title">凤御·员工端</text>
    <text class="login-subtitle">
      {{ phase === 'authed' ? '请选择登录身份' : '请绑定手机号以验证员工身份' }}
    </text>
  </view>

  
  <van-loading wx:if="{{checking}}" color="#C0322A" />

  <block wx:elif="{{!checking}}">
    
    <block wx:if="{{phase === 'initial'}}">
      <button open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber"
              class="login-btn" disabled="{{binding}}">
        {{binding ? '验证中...' : '授权手机号登录'}}
      </button>
    </block>

    
    <block wx:elif="{{phase === 'authed'}}">
      <view class="login-level-group">
        <van-radio-group
          value="{{ loginLevel }}"
          bind:change="onLoginLevelChange"
          direction="horizontal"
          custom-class="login-level-radio"
        >
          <van-radio name="store" checked-color="#C0322A" custom-class="login-level-radio-item">门店</van-radio>
          <van-radio name="management" checked-color="#C0322A" custom-class="login-level-radio-item">管理层</van-radio>
        </van-radio-group>
      </view>
      <button bindtap="onEnterByLevel" class="login-btn">登录</button>
    </block>

    <text wx:if="{{errorMsg}}" class="login-error">{{errorMsg}}</text>
  </block>
</view>
