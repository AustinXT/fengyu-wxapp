exports[`applyRechargeOnOrderPaid SQL 一致性守护（三端独立副本） > Snapshot 守护：三端 UPSERT 文本任一漂移立即可见 1`] = `
{
  "adminTs": "INSERT INTO prepaid_cards (card_id, user_id, balance) VALUES (?, ?, ?) ON CONFLICT (user_id) DO UPDATE SET balance = prepaid_cards.balance + EXCLUDED.balance, updated_at = NOW() RETURNING card_id",
  "payNotify": "INSERT INTO prepaid_cards (card_id, user_id, balance, created_at, updated_at) VALUES (?, ?, ?, NOW(), NOW()) ON CONFLICT (user_id) DO UPDATE SET balance = prepaid_cards.balance + EXCLUDED.balance, updated_at = NOW() RETURNING card_id",
  "staff": "INSERT INTO prepaid_cards (card_id, user_id, balance, created_at, updated_at) VALUES (?, ?, ?, NOW(), NOW()) ON CONFLICT (user_id) DO UPDATE SET balance = prepaid_cards.balance + EXCLUDED.balance, updated_at = NOW() RETURNING card_id",
}
`;

