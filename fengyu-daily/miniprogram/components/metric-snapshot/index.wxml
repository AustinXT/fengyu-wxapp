<view wx:if="{{snapshot}}" class="metric-card"><view class="heading">{{frozen?'提交时经营快照':'当日实际完成'}} · {{scopeLabel}}</view><view class="muted">{{periodLabel}}</view><view class="metrics"><view><text>本日销售完成（元）</text><view>{{daySales}}</view></view><view><text>本日消耗完成（元）</text><view>{{dayConsumption}}</view></view><block wx:if="{{snapshot.period && !compact}}"><view><text>本周销售完成率</text><view>{{weekSales}}</view></view><view><text>本周消耗完成率</text><view>{{weekConsumption}}</view></view></block></view><block wx:if="{{snapshot.month && !compact}}"><view class="muted">本月销售 {{monthSales}}</view><view class="muted">本月消耗 {{monthConsumption}}</view></block><view wx:if="{{frozen && savedAt}}" class="muted">快照时间：{{savedAt}}</view></view><view wx:elif="{{frozen}}" class="metric-card muted">此记录未保存经营快照，不用当前数据替代。</view>
