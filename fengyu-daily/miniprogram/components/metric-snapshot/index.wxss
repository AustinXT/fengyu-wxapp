.metric-card{background:#fff;padding:28rpx;border:1rpx solid #e4e6eb;border-radius:20rpx;margin-bottom:24rpx}.heading{font-size:30rpx;font-weight:700;margin-bottom:14rpx}.muted{font-size:24rpx;color:#7c8593;line-height:1.8}.metrics{display:flex;flex-wrap:wrap;margin:24rpx 0;gap:24rpx}.metrics>view{width:calc(50% - 12rpx)}.metrics text{color:#7c8593;font-size:22rpx}.metrics view>view{font-size:34rpx;font-weight:700;margin-top:12rpx}
