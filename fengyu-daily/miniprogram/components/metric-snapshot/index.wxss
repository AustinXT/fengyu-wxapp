.metric-card{background:#fff;padding:28rpx;border:1rpx solid #e4e6eb;border-radius:20rpx;margin-bottom:24rpx}.heading{font-size:30rpx;font-weight:700;margin-bottom:10rpx}.muted{font-size:23rpx;color:#7c8593;line-height:1.7}.actual-grid{margin-top:22rpx}.actual-row{display:grid;grid-template-columns:minmax(112rpx,1.1fr) repeat(3,minmax(0,1fr));align-items:center;min-height:76rpx;border-top:1rpx solid #eceef1;column-gap:4rpx;text-align:right;font-size:21rpx;white-space:nowrap}.actual-row text{overflow:hidden;text-overflow:ellipsis}.actual-head{min-height:56rpx;color:#7c8593;font-size:19rpx}.actual-row .metric-label{text-align:left;color:#454d58;font-weight:600}.actual-row .actual-today{font-size:22rpx;font-weight:700;color:#242a32}.actual-grid.compact{display:grid;grid-template-columns:1fr 1fr;gap:0 20rpx}.actual-grid.compact .actual-row{grid-template-columns:minmax(118rpx,1fr) auto;min-height:66rpx}.metric-note{margin:14rpx 0 8rpx;font-size:21rpx}
