.header{background:white;border-bottom:1rpx solid #e9eaed}.bar{height:64px;display:flex;align-items:center;justify-content:center}.brand-logo{display:flex;align-items:center;gap:18rpx;color:#c0322a}.brand-mark{width:58rpx;height:58rpx;border:5rpx solid #c0322a;border-radius:50% 50% 44% 44%;transform:rotate(45deg);position:relative}.brand-mark:after{content:'';width:22rpx;height:22rpx;border-radius:50%;background:#c0322a;position:absolute;left:17rpx;top:17rpx}.brand-text{font-size:34rpx;font-weight:800;letter-spacing:1rpx;line-height:1.1}.brand-text text{display:block;font-size:22rpx;font-weight:500;color:#a94b4b;margin-top:8rpx}.nav-title{font-size:34rpx;font-weight:600}
