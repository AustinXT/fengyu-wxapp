<view class="page">
  <picker mode="date" value="{{date}}" end="{{maxDate}}" bindchange="changeDate" disabled="{{loading || submitting}}"><view class="date row"><view>日报日期 · {{date}}</view><view class="link">切换 ›</view></view></picker>
  <view wx:if="{{readOnly}}" class="notice">这份历史日报已提交，仅可查看。</view><view wx:elif="{{status === 'submitted'}}" class="notice">今日日报已提交，修改后请再次提交。</view>
  <view wx:if="{{loading}}" class="skeleton">正在整理本人当天业务…</view>
  <view wx:elif="{{!ready}}" class="card"><view class="muted">日报读取失败，请重试。</view><button class="secondary" bindtap="retry">重新加载</button></view>
  <block wx:else><view class="section">当天业务 <text class="muted">{{entries.length}} 条</text></view><view wx:if="{{!entries.length}}" class="card empty">当天暂无已开始服务或有效销售分配记录。<view class="muted">仍可填写今日行动、成长和明日计划。</view></view>
    <view wx:for="{{entries}}" wx:key="businessId" class="card"><view class="row"><view class="tag">{{item.businessType === 'service' ? '服务' : '销售'}}</view><view class="muted">{{item.status}}</view></view><view class="title" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.businessId}}</view><view wx:if="{{item.businessType === 'service'}}" class="muted"><view wx:for="{{item.items}}" wx:for-item="project" wx:key="sourceOrderId">{{project.name}} · {{project.sessions}} 次 · 来源 {{project.sourceOrderId}}</view></view>
      <view class="label">{{item.businessType === 'service' ? '服务反馈' : '销售反馈'}}</view><textarea value="{{item.feedback}}" maxlength="300" auto-height disabled="{{readOnly || submitting}}" data-field="feedback" data-index="{{index}}" bindinput="input" placeholder="记录顾客感受、沟通结果或你的体会（选填）" />
      <view class="label">后续跟进</view><textarea value="{{item.followUp}}" maxlength="300" auto-height disabled="{{readOnly || submitting}}" data-field="followUp" data-index="{{index}}" bindinput="input" placeholder="有哪些问题需要跟进？（选填）" />
    </view>
    <view class="section">复盘与计划</view><view class="card"><view class="label">今日行动</view><textarea value="{{action}}" maxlength="500" auto-height disabled="{{readOnly || submitting}}" data-field="action" bindinput="input" placeholder="今天做了哪些主动行动？（选填）"/><view class="label">今日成长</view><textarea value="{{growth}}" maxlength="500" auto-height disabled="{{readOnly || submitting}}" data-field="growth" bindinput="input" placeholder="今天有哪些收获与改进？（选填）"/><view class="label">明日计划</view><textarea value="{{plan}}" maxlength="500" auto-height disabled="{{readOnly || submitting}}" data-field="plan" bindinput="input" placeholder="明天重点做什么？（选填）"/></view>
  </block>
</view><view wx:if="{{ready && !readOnly}}" class="footer"><button wx:if="{{status !== 'submitted'}}" class="secondary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="save">保存草稿</button><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{status === 'submitted' ? '再次提交' : '提交日报'}}</button></view>