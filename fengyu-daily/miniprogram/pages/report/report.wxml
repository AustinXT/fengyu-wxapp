<view class="page">
  <picker mode="date" value="{{date}}" end="{{maxDate}}" bindchange="changeDate" disabled="{{loading || submitting || copying || candidateLoading || selectingBusiness}}"><view class="date row"><view>日报日期 · {{date}}</view><view class="link">切换 ›</view></view></picker>
  <button wx:if="{{ready && !readOnly}}" class="copy-last" bindtap="copyLast" loading="{{copying}}" disabled="{{loading || submitting || copying || candidateLoading || selectingBusiness}}">复制上次补充</button>
  <view wx:if="{{readOnly}}" class="notice">这份历史日报已提交，仅可查看。</view><view wx:elif="{{status === 'submitted'}}" class="notice">今日日报已提交，修改后请再次提交。</view>
  <view wx:if="{{loading}}" class="skeleton">正在整理本人当天业务…</view>
  <view wx:elif="{{!ready}}" class="card"><view class="muted">日报读取失败，请重试。</view><button class="secondary" bindtap="retry">重新加载</button></view>
  <block wx:else><metric-snapshot compact="{{true}}" snapshot="{{metrics}}" frozen="{{status==='submitted'}}" /><view class="section">一 关联业务 <text class="muted">{{entries.length}} 条</text></view><view wx:if="{{!entries.length}}" class="card empty">当天暂无已开始服务或有效销售分配记录。<view class="muted">仍可填写今日行动、成长和明日计划。</view></view>
    <view wx:for="{{entries}}" wx:key="businessId" class="card"><view class="row"><view class="tag">{{item.businessType === 'service' ? '服务' : '销售'}}</view><view class="muted">{{item.status}}</view></view><view class="title" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.businessId}} · 业务日期 {{item.businessDate || date}}{{item.auto===false?' · 手动补充':''}}</view><view wx:if="{{item.unavailable}}" class="notice">业务已失效或归属已变化，请移除后再保存。</view><button wx:if="{{item.auto===false && !readOnly}}" class="remove-business" data-index="{{index}}" bindtap="removeBusiness" disabled="{{submitting || copying}}">移除</button><view wx:if="{{item.businessType === 'service'}}" class="muted"><view wx:for="{{item.items}}" wx:for-item="project" wx:key="sourceOrderId">{{project.name}} · {{project.sessions}} 次 · 来源 {{project.sourceOrderId}}</view></view>
      <view class="label">{{item.businessType === 'service' ? '服务反馈' : '销售反馈'}}</view><textarea value="{{item.feedback}}" maxlength="300" auto-height disabled="{{readOnly || submitting || copying}}" data-field="feedback" data-index="{{index}}" bindinput="input" placeholder="记录顾客感受、沟通结果或你的体会（选填）" />
      <view class="label">后续跟进</view><textarea value="{{item.followUp}}" maxlength="300" auto-height disabled="{{readOnly || submitting || copying}}" data-field="followUp" data-index="{{index}}" bindinput="input" placeholder="有哪些问题需要跟进？（选填）" />
    </view>
    <button wx:if="{{!readOnly}}" class="secondary" bindtap="supplement" disabled="{{submitting || copying}}">＋ 补充遗漏业务条目</button><view class="section">二 整日补充 <text class="muted">选填</text></view><view class="card"><view class="label">今日行动</view><textarea value="{{action}}" maxlength="500" auto-height disabled="{{readOnly || submitting || copying}}" data-field="action" bindinput="input" placeholder="今天做了哪些主动行动？（选填）"/></view><view class="card"><view class="label">今日成长</view><textarea value="{{growth}}" maxlength="500" auto-height disabled="{{readOnly || submitting || copying}}" data-field="growth" bindinput="input" placeholder="今天有哪些收获与改进？（选填）"/></view><view class="card"><view class="label">明日计划</view><textarea value="{{plan}}" maxlength="500" auto-height disabled="{{readOnly || submitting || copying}}" data-field="plan" bindinput="input" placeholder="明天重点做什么？（选填）"/></view>
    <view class="card"><view class="title">指导关系 <text class="muted">选填</text></view><picker range="{{contacts}}" range-key="name" value="{{mentorIndex}}" data-kind="mentor" bindchange="chooseContact" disabled="{{readOnly || submitting || copying}}"><view class="list-row"><text>指导员</text><text>{{mentorName}} ⌄</text></view></picker><picker range="{{contacts}}" range-key="name" value="{{peerIndex}}" data-kind="peer" bindchange="chooseContact" disabled="{{readOnly || submitting || copying}}"><view class="list-row"><text>同事</text><text>{{peerName}} ⌄</text></view></picker></view>
  </block>
</view><view wx:if="{{ready && !readOnly}}" class="footer"><button wx:if="{{status !== 'submitted'}}" class="secondary" loading="{{submitting}}" disabled="{{submitting || copying}}" bindtap="save">保存草稿</button><button wx:else class="secondary" disabled="{{submitting || copying}}" bindtap="cancelEdit">取消修改</button><button class="primary" loading="{{submitting}}" disabled="{{submitting || copying}}" bindtap="submit">{{status === 'submitted' ? '再次提交' : '提交日报'}}</button></view>
<view wx:if="{{selectingBusiness}}" class="business-overlay"><view class="business-sheet"><view class="row"><view class="title">补充遗漏业务条目</view><text class="link" bindtap="closeCandidates">关闭</text></view><view class="muted">仅显示本人参与、同日报日期且尚未添加的有效业务。</view><input class="search-input" placeholder="搜索顾客或单号" value="{{candidateSearch}}" bindinput="candidateSearch" maxlength="100" /><scroll-view scroll-y class="candidate-list"><view wx:if="{{candidateLoading}}" class="skeleton">正在查找业务…</view><view wx:elif="{{!visibleCandidates.length}}" class="empty">该日暂无可补充业务。</view><view wx:for="{{visibleCandidates}}" wx:if="{{!candidateLoading}}" wx:key="businessId" class="list-row" data-index="{{item.sourceIndex}}" bindtap="addBusiness"><view>{{item.title}}<view class="muted">{{item.businessType==='service'?'服务单':'销售订单'}} · {{item.businessId}}</view></view><text class="link">添加</text></view></scroll-view></view></view>
