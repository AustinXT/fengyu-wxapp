
.copy-last{margin:0 0 24rpx auto;padding:0 20rpx;width:auto;display:table;font-size:24rpx;line-height:64rpx;color:#6d7179;background:#fff;border:1rpx solid #e8e9ed;border-radius:12rpx}.copy-last::after{border:0}

.remove-business{margin:16rpx 0 0 auto;padding:0 20rpx;display:table;font-size:24rpx;color:#c0322a;line-height:52rpx;background:#fff1ef}.remove-business::after{border:0}.business-overlay{position:fixed;inset:0;background:#0006;z-index:200;display:flex;align-items:flex-end}.business-sheet{background:#fff;width:100%;padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;box-sizing:border-box}.candidate-list{height:50vh;margin-top:24rpx}
