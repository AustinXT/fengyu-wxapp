<view class="page"><view class="section">我的历史日报</view><view class="muted">最近 60 份日报</view><view wx:if="{{loading}}" class="skeleton">加载中…</view><view wx:elif="{{!reports.length}}" class="card empty">还没有日报，先记录今天吧。</view><view wx:for="{{reports}}" wx:key="id" class="card row" data-date="{{item.report_date}}" bindtap="open"><view>{{item.report_date}}</view><view class="tag">{{item.status === 'submitted' ? '已提交' : '草稿'}} ›</view></view></view>