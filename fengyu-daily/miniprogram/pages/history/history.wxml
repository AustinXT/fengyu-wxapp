<page-header back="{{true}}" title="{{employee.name || '我的'}}个人日报" />
<view class="page">
<view wx:if="{{employee}}" class="card row"><view><view class="title">{{employee.name}}</view><view class="muted">{{employee.position_name || '员工'}} · {{employee.store_name || '尚未分配门店'}}</view></view><view class="avatar">{{employee.name[0]}}</view></view>
<picker wx:if="{{periods.length}}" range="{{periods}}" range-key="name" value="{{periodIndex}}" bindchange="periodChange" disabled="{{loading}}"><view class="date row"><view>{{periods[periodIndex].name}}<view class="muted">{{periods[periodIndex].start}} 至 {{periods[periodIndex].end}}</view></view><text class="link">⌄</text></view></picker>
<view class="card" wx:if="{{summary}}"><view class="row"><view class="title">本经营月提交概况</view><view class="tag {{summary.rate>=90?'ok':summary.rate>=70?'warn':'danger'}}">{{summary.rate}}%</view></view><view class="stats"><view><text>应提交</text>{{summary.due}}</view><view><text>已提交</text>{{summary.submitted}}</view><view><text>未提交</text>{{summary.missing}}</view></view></view>
<view class="section">本经营月日报记录</view><view class="muted">{{own ? '草稿仅本人可见' : '仅展示授权门店的已提交日报'}}</view>
<view wx:if="{{loading}}" class="skeleton">加载中…</view><view wx:elif="{{!ready}}" class="card"><button bindtap="retry">重新加载</button></view>
<block wx:else><view wx:if="{{!reports.length}}" class="card empty">当前经营月暂无日报记录。</view><view wx:for="{{reports}}" wx:key="id" class="card row" data-date="{{item.report_date}}" data-id="{{item.id}}" bindtap="open"><view>{{item.report_date}} 日报</view><view class="tag {{item.status==='submitted'?'ok':'warn'}}">{{item.status === 'submitted' ? '已提交' : '草稿'}} ›</view></view></block></view>
