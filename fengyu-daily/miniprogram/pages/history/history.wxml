<view class="page"><view class="section">{{employee.name || '我的'}}日报记录</view>
<picker wx:if="{{periods.length}}" range="{{periods}}" range-key="name" value="{{periodIndex}}" bindchange="periodChange" disabled="{{loading}}"><view class="date row">{{periods[periodIndex].name}}<text class="link">切换经营月 ›</text></view></picker>
<view class="card" wx:if="{{summary}}"><view class="stats"><view>应交<view>{{summary.due}}</view></view><view>已交<view>{{summary.submitted}}</view></view><view>未交<view>{{summary.missing}}</view></view></view></view>
<view class="muted">{{own ? '草稿仅本人可见' : '仅展示授权门店的已提交日报'}}</view>
<view wx:if="{{loading}}" class="skeleton">加载中…</view><view wx:elif="{{!ready}}" class="card"><button bindtap="retry">重新加载</button></view>
<block wx:else><view wx:if="{{!reports.length}}" class="card empty">暂无日报记录。</view><view wx:for="{{reports}}" wx:key="id" class="card row" data-date="{{item.report_date}}" data-id="{{item.id}}" bindtap="open"><view>{{item.report_date}}</view><view class="tag">{{item.status === 'submitted' ? '已提交' : '草稿'}} ›</view></view></block></view>