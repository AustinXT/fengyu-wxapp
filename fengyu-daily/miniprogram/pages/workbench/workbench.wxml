<page-header title="{{workspace==='management'?'组织':workspace==='manager'?'本店管理':'我的日报记录'}}" />
<view class="page">
 <view wx:if="{{loading}}" class="skeleton">正在读取…</view><view wx:elif="{{!ready}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view>
 <block wx:elif="{{workspace==='employee'}}"><view class="section">我的日报记录</view><view class="muted">最近60份，草稿仅本人可见</view><view wx:if="{{!reports.length}}" class="card empty">还没有日报记录。</view><view wx:for="{{reports}}" wx:key="id" class="card row" bindtap="open" data-date="{{item.report_date}}"><view>{{item.report_date}} 日报</view><view class="tag {{item.status==='submitted'?'ok':'warn'}}">{{item.status==='submitted'?'已提交':'草稿'}} ›</view></view></block>
 <block wx:elif="{{workspace==='manager'}}"><picker range="{{user.managerStores}}" range-key="store_name" value="{{storeIndex}}" bindchange="storeChange"><view class="date row">{{user.managerStores[storeIndex].store_name}}<text class="link">⌄</text></view></picker><view class="card"><view class="title">本店提交概况</view><view class="muted">{{date}} · 当前在职员工</view><view class="stats"><view><text>已提交</text><view>{{storeReports.length}}</view></view><view><text>未提交</text><view>{{unsubmitted.length}}</view></view></view></view><view class="card"><view class="title">待关注员工</view><view wx:for="{{unsubmitted}}" wx:key="employee_id" class="list-row"><view>{{item.name}}</view><view class="tag danger">未提交</view></view><view wx:if="{{!unsubmitted.length}}" class="empty">暂无未提交员工。</view></view><view class="section">已提交日报</view><view wx:for="{{storeReports}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="open"><view>{{item.employee_name}}</view><text class="link">查看 ›</text></view></block>
 <block wx:else><view class="segmented"><view class="{{orgView==='tree'?'selected':''}}" data-view="tree" bindtap="orgChange">组织架构</view><view class="{{orgView==='people'?'selected':''}}" data-view="people" bindtap="orgChange">人员查找</view></view>
  <block wx:if="{{orgView==='tree'}}"><view class="card"><view class="row"><view class="title">授权组织范围</view><view wx:if="{{selectedNodeId}}" class="link" bindtap="root">返回组织顶层</view></view><view wx:for="{{visibleNodes}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="node"><view>{{item.name}}<view class="muted">{{item.type}}</view></view><text class="link">›</text></view><view wx:if="{{!visibleNodes.length}}" class="muted">已到组织末级，下方可查看授权门店。</view></view><view class="section">授权门店</view><view wx:for="{{visibleStores}}" wx:key="store_id" class="card row" data-id="{{item.store_id}}" bindtap="store"><view>{{item.store_name}}<view class="muted">已交 {{item.submitted}} / {{item.due}}</view></view><text class="link">›</text></view></block>
  <block wx:else><input class="search-input" placeholder="搜索员工姓名" value="{{search}}" bindinput="search" maxlength="100" /><view class="card"><view class="title">员工列表 · {{visibleEmployees.length}} 人</view><view wx:for="{{visibleEmployees}}" wx:key="employee_id" class="list-row" data-id="{{item.report_id}}" bindtap="open"><view class="avatar">{{item.name[0]}}</view><view class="person-main">{{item.name}}<view class="muted">{{item.store_name}}</view></view><view class="tag {{item.report_id?'ok':'danger'}}">{{item.report_id?'已提交 ›':'未提交'}}</view></view></view></block>
 </block>
</view>