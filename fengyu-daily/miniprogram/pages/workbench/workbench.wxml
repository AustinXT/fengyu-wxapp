<page-header title="{{workspace==='management'?'组织':workspace==='manager'?'本店管理':'我的日报记录'}}" />
<view class="page"><view wx:if="{{workspace==='manager'}}" class="segmented"><view class="{{period==='today'?'selected':''}}" data-period="today" bindtap="periodChange">今日</view><view class="{{period==='week'?'selected':''}}" data-period="week" bindtap="periodChange">经营周</view><view class="{{period==='month'?'selected':''}}" data-period="month" bindtap="periodChange">经营月</view></view>
 <view wx:if="{{loading&&ready}}" class="muted">正在更新…</view><view wx:if="{{loading&&!ready}}" class="skeleton">正在读取…</view><view wx:elif="{{!ready}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view>
 <block wx:elif="{{workspace==='employee'}}"><view class="card row"><view><view class="title">{{user.name}}</view><view class="muted">{{user.positionName || '员工'}} · {{user.storeName || '尚未分配门店'}}</view></view><view class="avatar">{{user.name[0]}}</view></view>
<picker wx:if="{{periods.length}}" range="{{periods}}" range-key="name" value="{{periodIndex}}" bindchange="monthChange"><view class="date row">{{periods[periodIndex].name}}<text class="link">切换经营月 ⌄</text></view></picker>
<view wx:if="{{personalSummary}}" class="card"><view class="row"><view class="title">本经营月提交概况</view><view class="tag">{{personalSummary.rate}}%</view></view><view class="stats"><view><text>应提交</text>{{personalSummary.due}}</view><view><text>已提交</text>{{personalSummary.submitted}}</view><view><text>未提交</text>{{personalSummary.missing}}</view></view></view><view class="section">本经营月日报记录</view><view class="muted">草稿仅本人可见</view><view wx:if="{{!reports.length}}" class="card empty">还没有日报记录。</view><view wx:for="{{reports}}" wx:key="id" class="card row" bindtap="open" data-id="{{item.id}}" data-date="{{item.report_date}}" data-status="{{item.status}}"><view>{{item.report_date}} 日报</view><view class="tag {{item.status==='submitted'?'ok':'warn'}}">{{item.status==='submitted'?'已提交':'草稿'}} ›</view></view></block>
 <block wx:elif="{{workspace==='manager'}}"><picker range="{{managerStores}}" range-key="store_name" value="{{storeIndex}}" bindchange="storeChange"><view class="date row">{{managerStores[storeIndex].store_name}}<text class="link">⌄</text></view></picker><view class="card"><view class="row"><view class="title">本店提交概况</view><view class="tag {{summary.rate>=90?'ok':summary.rate>=70?'warn':'danger'}}">{{summary.rate}}%</view></view><view class="muted">{{range.label}} · 员工档案入离职日期</view><view class="stats"><view><text>应提交</text>{{summary.due}}</view><view><text>已提交</text><view>{{summary.submitted}}</view></view><view><text>未提交</text><view>{{summary.missing}}</view></view></view></view><view class="card"><view class="title">待关注员工</view><view class="muted">草稿对店长显示为未提交</view><view wx:for="{{storePeople}}" wx:key="employee_id" class="list-row" data-id="{{item.employee_id}}" bindtap="person"><view>{{item.name}}<view class="muted">{{item.position_name || (item.is_store_manager?'店长':'员工')}}</view></view><view class="tag {{item.submitted>=item.due?'ok':'danger'}}">已交 {{item.submitted}} / {{item.due}} ›</view></view><view wx:if="{{!storePeople.length}}" class="empty">暂无员工。</view></view><view class="section">已提交日报</view><view wx:for="{{storeReports}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="open"><view>{{item.employee_name}}</view><text class="link">查看 ›</text></view></block>
 <block wx:else><view class="segmented"><view class="{{orgView==='tree'?'selected':''}}" data-view="tree" bindtap="orgChange">组织架构</view><view class="{{orgView==='people'?'selected':''}}" data-view="people" bindtap="orgChange">人员查找</view></view>
  <block wx:if="{{orgView==='tree'}}">
    <picker wx:if="{{organizationMarkets.length>1}}" range="{{organizationMarkets}}" range-key="name" value="{{organizationMarketIndex}}" bindchange="organizationMarketChange" disabled="{{loading}}"><view class="organization-scope row"><text>查看市场：{{organizationMarkets[organizationMarketIndex].name}}</text><text>⌄</text></view></picker>
    <view wx:elif="{{organizationMarkets.length===1}}" class="organization-scope">{{organizationCompatibility?'查看范围':'查看市场'}}：{{organizationMarkets[0].name}}<view wx:if="{{organizationCompatibility}}" class="muted">市场切换需服务更新，当前显示全部授权门店。</view></view>
    <view class="card"><view class="title">门店列表</view><view wx:for="{{visibleStores}}" wx:key="store_id" class="list-row" data-id="{{item.store_id}}" bindtap="store"><view class="organization-store-main"><view class="organization-store-name">{{item.store_name}}</view><view class="muted">{{organizationMarkets[organizationMarketIndex].name}} · 已交 {{item.submitted}} / {{item.due}}</view></view><text class="link">›</text></view><view wx:if="{{!visibleStores.length}}" class="empty">{{organizationMarkets.length?'当前市场暂无授权门店。':'当前账号暂无授权市场或门店。'}}</view></view>
  </block>
  <block wx:else><input class="search-input" placeholder="搜索员工姓名" value="{{search}}" bindinput="search" maxlength="100" /><view class="row"><picker wx:if="{{peopleMarkets.length>1}}" range="{{peopleMarkets}}" range-key="name" value="{{peopleMarketIndex}}" data-kind="market" bindchange="peopleFilter"><view class="scope-label">{{peopleMarkets[peopleMarketIndex].name}} ⌄</view></picker><view wx:else class="scope-label">{{peopleMarkets[0].name}}</view><picker range="{{peopleStores}}" range-key="store_name" value="{{peopleStoreIndex}}" data-kind="store" bindchange="peopleFilter"><view class="scope-label">{{peopleStores[peopleStoreIndex].store_name}} ⌄</view></picker></view><view class="segmented"><view wx:for="{{positions}}" wx:key="*this" class="{{position===item?'selected':''}}" data-value="{{item}}" bindtap="position">{{item}}</view></view><view class="card"><view class="title">员工列表 · {{visibleEmployees.length}} 人</view><view wx:for="{{visibleEmployees}}" wx:key="employee_id" class="list-row" data-id="{{item.employee_id}}" bindtap="person"><view class="avatar">{{item.name[0]}}</view><view class="person-main">{{item.name}}<view class="muted">{{item.store_name}} · {{item.position_name || (item.is_store_manager?'店长':'员工')}}</view></view><view class="tag {{item.submitted>=item.due?'ok':'danger'}}">{{item.submitted>=item.due?'已交齐 ›':'未交齐 ›'}}</view></view></view></block>
 </block>
</view>
