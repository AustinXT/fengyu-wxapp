.goal-input{border:1rpx solid #e4e6eb;border-radius:12rpx;padding:22rpx;font-size:32rpx;background:#fff}.amount{font-size:40rpx;font-weight:700;margin:12rpx 0}.reference{margin:24rpx 0}
.goal-error{color:#c0322a;font-size:24rpx;margin-top:20rpx;line-height:1.6}
.month-summary{display:flex;flex-wrap:wrap;margin:16rpx -8rpx 0}.goal-metric{box-sizing:border-box;width:calc(33.333% - 16rpx);min-width:0;min-height:132rpx;margin:8rpx;background:#faf9f8;border-radius:14rpx;padding:22rpx}.goal-metric .amount{font-size:36rpx;overflow-wrap:anywhere}.metric-input{box-sizing:border-box;width:100%;height:64rpx;margin-top:10rpx;padding:0 12rpx;font-size:32rpx;font-weight:700;line-height:64rpx}.incentive-row{display:flex;align-items:flex-start;margin-top:28rpx;padding:20rpx 22rpx;background:#faf9f8;border-radius:14rpx}.incentive-label{flex:none;font-size:28rpx;font-weight:600;line-height:1.6}.incentive-input,.incentive-value{box-sizing:border-box;flex:1;min-width:0;margin:0;padding:0 0 0 16rpx;font-size:28rpx;line-height:1.6}.incentive-value{overflow-wrap:anywhere}
.week-target-list{margin-top:20rpx}.week-target-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #f0f0f0}.week-target-label{flex:1;min-width:0;font-size:26rpx;line-height:1.5}.week-target-input{box-sizing:border-box;flex:none;width:42%;height:76rpx;padding:0 16rpx;text-align:right;line-height:76rpx}.week-target-reference{padding-top:20rpx}
.week-plan-row{padding:22rpx 0;border-bottom:1rpx solid #f0f0f0}.week-plan-row:nth-last-child(2){border-bottom:0}.week-plan-head{margin-bottom:14rpx}.week-plan-title{display:flex;align-items:center;gap:10rpx;font-size:28rpx;font-weight:600}.week-plan-head>.muted{margin-top:6rpx}.week-plan-badge{padding:4rpx 10rpx;border-radius:999rpx;background:#f5f6f7;color:#737b87;font-size:20rpx;font-weight:400}.week-plan-metrics{display:flex;flex-wrap:nowrap;gap:8rpx}.week-plan-metric{box-sizing:border-box;flex:1 1 20%;width:20%;min-width:0;padding:14rpx 8rpx;border-radius:10rpx;background:#faf9f8}.week-plan-metric .muted{font-size:22rpx;white-space:nowrap}.week-plan-value{margin-top:8rpx;overflow:hidden;font-size:20rpx;font-weight:600;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.week-plan-note{padding-top:14rpx}
