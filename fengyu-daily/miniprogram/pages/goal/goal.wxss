.goal-input{border:1rpx solid #e4e6eb;border-radius:12rpx;padding:22rpx;font-size:32rpx;background:#fff}.amount{font-size:40rpx;font-weight:700;margin:12rpx 0}.reference{margin:24rpx 0}.week-values{font-size:24rpx;text-align:right;max-width:42%}
.goal-error{color:#c0322a;font-size:24rpx;margin-top:20rpx;line-height:1.6}
.month-summary{display:flex;flex-wrap:wrap;margin:16rpx -8rpx 0}.goal-metric{box-sizing:border-box;width:calc(50% - 16rpx);min-width:0;min-height:132rpx;margin:8rpx;background:#faf9f8;border-radius:14rpx;padding:22rpx}.goal-metric:nth-child(5):last-child{margin-left:calc(25% + 8rpx)}.goal-metric .amount{font-size:36rpx;overflow-wrap:anywhere}.metric-input{box-sizing:border-box;width:100%;height:64rpx;margin-top:10rpx;padding:8rpx 12rpx;font-size:32rpx;font-weight:700}.incentive-row{display:flex;align-items:flex-start;margin-top:28rpx;padding:20rpx 22rpx;background:#faf9f8;border-radius:14rpx}.incentive-label{flex:none;font-size:28rpx;font-weight:600;line-height:1.6}.incentive-input,.incentive-value{box-sizing:border-box;flex:1;min-width:0;margin:0;padding:0 0 0 16rpx;font-size:28rpx;line-height:1.6}.incentive-value{overflow-wrap:anywhere}
