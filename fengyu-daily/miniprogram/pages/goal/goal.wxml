<page-header back="{{true}}" title="{{title}}" />
<view class="page">
  <picker wx:if="{{periods.length}}" range="{{periods}}" range-key="name" value="{{periodIndex}}" data-kind="period" bindchange="selection" disabled="{{loading || saving}}"><view class="card row">{{periods[periodIndex].name}}<text class="link">选择经营月 ⌄</text></view></picker>
  <picker wx:if="{{scopes.length>1}}" range="{{scopes}}" range-key="name" value="{{scopeIndex}}" data-kind="scope" bindchange="selection" disabled="{{loading || saving}}"><view class="card row">{{scopes[scopeIndex].name}}<text class="link">切换范围 ⌄</text></view></picker>
  <view wx:if="{{loading}}" class="skeleton">正在读取经营目标…</view>
  <view wx:elif="{{!period}}" class="card empty">尚未配置经营周期，请联系管理员。</view>
  <block wx:elif="{{ready}}">
    <view wx:if="{{!editable}}" class="notice">历史或未来经营月仅可查看。</view>
    <view class="card"><view class="row"><view class="title">本经营月目标</view><view class="tag {{confirmed?'ok':'warn'}}">{{confirmed && countsConfirmed ? '已确认 · 不可修改' : confirmed ? '补充三项目标' : '待确认'}}</view></view>
      <view class="muted">{{period.start}} 至 {{period.end}}</view>
      <view class="month-summary">
        <view class="goal-metric"><view class="muted">业绩目标（元）</view><view wx:if="{{confirmed}}" class="amount">{{monthSales}}</view><input wx:else class="goal-input metric-input" type="digit" data-field="sales" value="{{sales}}" bindinput="input" disabled="{{saving || !editable}}" /></view>
        <view class="goal-metric"><view class="muted">消耗目标（元）</view><view wx:if="{{confirmed}}" class="amount">{{monthConsumption}}</view><input wx:else class="goal-input metric-input" type="digit" data-field="consumption" value="{{consumption}}" bindinput="input" disabled="{{saving || !editable}}" /></view>
        <view wx:for="{{countFields}}" wx:key="key" class="goal-metric"><view class="muted">月{{item.label}}目标（{{item.unit}}）</view><view wx:if="{{countsConfirmed}}" class="amount">{{item.month}}</view><input wx:else class="goal-input metric-input" type="number" data-field="{{item.key}}" value="{{item.month}}" bindinput="input" disabled="{{saving || !editable}}" /></view>
      </view>
      <view class="muted reference">去年对应经营月实际：{{monthReference}}</view>
      <view wx:if="{{scope==='personal'}}" class="incentive-row"><view class="incentive-label">本月负激励</view><view wx:if="{{confirmed}}" class="incentive-value">{{penalty}}</view><textarea wx:else class="incentive-input" data-field="penalty" value="{{penalty}}" bindinput="input" maxlength="500" auto-height disabled="{{saving || !editable}}" placeholder="例如：未完成目标吃鲱鱼罐头" /></view>
      <view wx:if="{{(!confirmed || !countsConfirmed) && editable && monthError}}" class="goal-error">{{monthError}}</view>
    </view>
    <view wx:if="{{confirmed && editable && !automatic && weekError}}" class="goal-error">{{weekError}}</view>
    <view wx:if="{{confirmed && week}}" class="card"><view class="title">{{week.name}}目标</view><view class="muted">{{week.start}} 至 {{week.end}} · 只填写当前经营周</view>
      <view wx:if="{{automatic}}" class="notice">最后一周目标自动取月目标扣除前面各周后的余额，无需填写。</view>
      <block wx:else>
        <view class="week-target-list">
          <view class="week-target-row"><view class="week-target-label">本周业绩目标（元）<view class="muted">占月目标 {{weekSalesPercent}}</view></view><input class="goal-input week-target-input" type="digit" data-field="weekSales" value="{{weekSales}}" bindinput="input" disabled="{{saving || !editable}}" /></view>
          <view class="week-target-row"><view class="week-target-label">本周消耗目标（元）<view class="muted">占月目标 {{weekConsumptionPercent}}</view></view><input class="goal-input week-target-input" type="digit" data-field="weekConsumption" value="{{weekConsumption}}" bindinput="input" disabled="{{saving || !editable}}" /></view>
          <view wx:for="{{countFields}}" wx:key="key" class="week-target-row"><view class="week-target-label">本周{{item.label}}目标（{{item.unit}}）<view class="muted">占月目标 {{item.weekPercent}}</view></view><input class="goal-input week-target-input" type="number" data-field="{{item.weekKey}}" value="{{item.week}}" bindinput="input" disabled="{{saving || !editable || !countsConfirmed}}" /></view>
          <view class="muted week-target-reference">去年对应经营周实际：{{weekReference}}</view>
        </view>
      </block>
    </view>
    <view wx:if="{{confirmed}}" class="card"><view class="title">经营周安排</view><view wx:for="{{weeks}}" wx:key="id" class="week-plan-row"><view class="week-plan-head"><view class="week-plan-title">{{item.name}}<text wx:if="{{item.current}}" class="week-plan-badge">当前</text><text wx:if="{{item.automatic}}" class="week-plan-badge">自动余额</text></view><view class="muted">{{item.dates}}</view></view><view class="week-plan-metrics"><view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="label" class="week-plan-metric"><view class="muted">{{metric.label}}</view><view class="week-plan-value">{{metric.value}}</view></view></view></view><view class="muted week-plan-note">五项目标同级展示；未设置的经营周不按零计算。</view></view>
  </block>
</view>
<view wx:if="{{ready && editable}}" class="footer"><button wx:if="{{!confirmed || !countsConfirmed}}" class="primary" data-kind="month" bindtap="save" loading="{{saving}}" disabled="{{saving || !!monthError}}">{{confirmed ? '补充确认三项月目标' : '确认本月五项目标'}}</button><button wx:elif="{{week && !automatic}}" class="primary" data-kind="week" bindtap="save" loading="{{saving}}" disabled="{{saving || !!weekError}}">{{target.weeks[week.id].sales!==null && target.weeks[week.id].consumption!==null ? '更新本周目标' : '保存本周目标'}}</button></view>
