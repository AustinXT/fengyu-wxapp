.board{background:#fff;border:1rpx solid #e5e7eb;border-radius:20rpx;margin:24rpx 0}.table{width:2600rpx}.tr{display:flex;border-bottom:1rpx solid #eee;min-height:90rpx;align-items:center}.tr text{flex:none;width:200rpx;padding:16rpx;box-sizing:border-box;font-size:24rpx}.tr text:first-child{width:80rpx}.tr text:nth-child(3){width:300rpx}.header{background:#f9fafb;color:#6b7280;font-weight:600}.rate{color:#c0322a;font-weight:700}

.pk-metrics{margin:16rpx 0}.pk-metrics>view{padding:10rpx 0;min-height:36rpx;line-height:36rpx;font-size:26rpx}.pk-filters{display:flex;align-items:center;gap:20rpx;margin:16rpx 0;font-size:26rpx}.filter-sort,.filter-item{display:flex;align-items:center;gap:8rpx}.filter-sort switch{zoom:.65}.filter-value{border:1rpx solid #e5e7eb;border-radius:12rpx;padding:10rpx 14rpx;background:#fff;max-width:160rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tr text:nth-child(5){width:300rpx}.tr text:nth-child(-n+2){position:sticky;background:#fff;z-index:1}.tr text:first-child{left:0}.tr text:nth-child(2){left:80rpx}.header text:nth-child(-n+2){background:#f9fafb;z-index:2}

.tr text:nth-child(2){width:330rpx}.table{width:2730rpx}
