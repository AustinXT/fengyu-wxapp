<page-header back="{{true}}" title="经营指标 PK" /><view class="page">
<picker wx:if="{{periods.length}}" range="{{periods}}" range-key="name" value="{{periodIndex}}" bindchange="periodChange" disabled="{{loading}}"><view class="date row">{{periods[periodIndex].name}}<text class="link">切换经营月 ›</text></view></picker>
<view wx:if="{{loading}}" class="skeleton">读取班级排名…</view><view wx:elif="{{!ready}}" class="card"><button bindtap="retry">重新加载</button></view>
<block wx:else><view wx:if="{{!classes.length}}" class="card empty">本经营月暂无可查看的 PK 班级。</view>
<block wx:else>
<block wx:if="{{!selectedClass}}"><view class="hero"><view class="title">{{periods[periodIndex].name}} · PK 班级</view><view class="subtitle">选择班级，查看完整业绩榜和消耗榜</view></view>
<view class="card"><view class="stats"><view><text>全部班级</text>{{classes.length}}</view><view><text>进行中</text>{{status==='进行中'?classes.length:0}}</view><view><text>未开始</text>{{status==='未开始'?classes.length:0}}</view><view><text>已结束</text>{{status==='已结束'?classes.length:0}}</view></view></view>
<view class="section">{{status}} · {{classes.length}} 个班级</view><view wx:for="{{classes}}" wx:key="id" class="card row" data-index="{{index}}" bindtap="openClass"><view><view class="title">{{item.name}}</view><view class="muted">{{status}} · {{item.stores}} 家门店 · {{item.members}} 位参与人员</view></view><text class="link">查看榜单 ›</text></view><view class="muted">{{scopeLabel}}</view></block>
<block wx:else><view class="row section"><view>{{classes[classIndex].name}}</view><text class="link" bindtap="classList">返回班级列表</text></view>
<view class="segmented"><view class="{{metric==='sales'?'selected':''}}" data-metric="sales" bindtap="metricChange">销售 PK</view><view class="{{metric==='consumption'?'selected':''}}" data-metric="consumption" bindtap="metricChange">消耗 PK</view></view>
<view class="section">{{weekName}} · 周完成率排名</view><view class="muted">{{scopeLabel}} · 金额单位：元 · 左右滑动查看</view>
<scroll-view scroll-x class="board"><view class="table"><view class="tr header"><text>排名</text><text>姓名</text><text>区域 / 门店</text><text>军团</text><text>小组</text><text>指导员</text><text>周目标</text><text>周完成</text><text>周完成率</text><text>月累计目标</text><text>月累计完成</text><text>月完成率</text></view>
<view wx:for="{{rows}}" wx:key="employeeId" class="tr"><text>{{item.rank}}</text><text>{{item.name}}</text><text>{{item.area}}</text><text>{{item.legion || '—'}}</text><text>{{item.group || '—'}}</text><text>{{item.mentor || '—'}}</text><text>{{item.weekTargetText}}</text><text>{{item.weekDoneText}}</text><text class="rate">{{item.weekRate}}</text><text>{{item.monthTargetText}}</text><text>{{item.monthDoneText}}</text><text>{{item.monthRate}}</text></view></view></scroll-view>
<view class="muted">月累计目标为已开始经营周的目标合计。未设置或零目标不计算完成率。</view></block></block></block></view>
