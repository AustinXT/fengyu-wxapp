<page-header brand="{{workspace !== 'management'}}" title="{{user.staffLevel==='market'?'市场总览':'管理总览'}}" />
<view class="page home-content">
  <view wx:if="{{testBinding}}" class="card test-binding"><view class="row"><view class="title">开发测试身份</view><button wx:if="{{!!testCode || !!user}}" class="test-exit" bindtap="exitTestIdentity">退出测试身份</button></view><view class="muted">绑定码长期有效，仅在日报开发版切换测试身份；退出后恢复当前微信绑定身份。</view><input placeholder="输入24位测试绑定码" value="{{testCode}}" bindinput="inputTestCode" maxlength="24" disabled="{{binding}}" /><button class="secondary" bindtap="bindTestCode" loading="{{binding}}" disabled="{{binding}}">使用绑定码登录 / 切换账号</button></view>
  <view wx:if="{{loading}}" class="skeleton">正在读取日报…</view>
  <view wx:elif="{{error}}" class="card"><view class="title">暂未连接日报服务</view><button class="secondary" bindtap="retry">重新加载</button></view>
<view wx:elif="{{!user}}" class="card"><view class="title">绑定员工身份</view><view class="muted">授权微信手机号，与已有员工档案关联。日报与员工端使用同一个员工编号。</view><button class="primary" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" loading="{{binding}}" disabled="{{binding}}">授权手机号并绑定</button></view>

  <block wx:elif="{{workspace === 'management'}}">
    <view wx:if="{{user.staffLevel==='headquarters'}}" class="card row" bindtap="pk"><view>经营指标 PK</view><text class="link">查看班级 ›</text></view><view wx:else class="card goal-entry"><view class="row" bindtap="goal"><view>市场经营目标</view><text class="link">查看 / 设置 ›</text></view><view class="goal-pk" bindtap="pk">经营指标 PK ›<view class="muted">查看班级、业绩榜和消耗榜</view></view></view>
<view class="segmented"><view class="{{period==='today'?'selected':''}}" data-period="today" bindtap="periodChange">今日</view><view class="{{period==='week'?'selected':''}}" data-period="week" bindtap="periodChange">经营周</view><view class="{{period==='month'?'selected':''}}" data-period="month" bindtap="periodChange">经营月</view></view>
<picker range="{{scopes}}" range-key="name" value="{{scopeIndex}}" bindchange="scopeChange" disabled="{{loading}}"><view class="scope-label">查看范围：{{scopes[scopeIndex].name}} ⌄</view></picker>
    <view class="card"><view class="row"><view class="title">提交概况</view><view class="tag">{{overview.summary.rate}}%</view></view><view class="muted">{{overview.range.label}} · 授权门店员工</view><view class="stats"><view><text>应提交</text><view>{{overview.summary.due}}</view></view><view><text>已提交</text><view>{{overview.summary.submitted}}</view></view><view><text>未提交</text><view>{{overview.summary.missing}}</view></view></view></view>
    <view wx:if="{{overview.markets.length && !scopeIndex && user.staffLevel==='headquarters'}}" class="card"><view class="title">待关注市场</view><block wx:for="{{overview.markets}}" wx:key="id"><view wx:if="{{item.missing>0}}" class="list-row" data-id="{{item.id}}" bindtap="openMarket"><view>{{item.name}}<view class="muted">已交 {{item.submitted}} / {{item.due}} · {{item.rate}}%</view></view><text class="link">›</text></view></block><view wx:if="{{!overview.summary.missing}}" class="empty">暂无待关注市场。</view></view>
    <view class="card"><view class="title">待关注门店</view><block wx:for="{{overview.stores}}" wx:key="store_id"><view wx:if="{{item.missing>0}}" class="list-row" data-id="{{item.store_id}}" bindtap="openStore"><view>{{item.store_name}}<view class="muted">已交 {{item.submitted}} / {{item.due}}</view></view><text class="link">›</text></view></block><view wx:if="{{!overview.summary.missing}}" class="empty">当前范围暂无未提交员工。</view></view>
    <view class="card"><view class="title">待关注员工</view><block wx:for="{{overview.employees}}" wx:key="employee_id"><view wx:if="{{item.submitted<item.due}}" class="list-row" data-id="{{item.employee_id}}" bindtap="person"><view class="avatar">{{item.name[0]}}</view><view class="person-main">{{item.name}}<view class="muted">{{item.store_name}}</view></view><view class="tag danger">未提交</view></view></block></view>
  </block>
  <block wx:else>
    <view class="card today-card"><view class="today-summary"><view class="today-title">我的日报</view><view class="muted">{{date}} · {{user.name}} · {{user.storeName || '尚未分配门店'}}</view></view><view wx:if="{{statusError}}" class="muted" bindtap="retry">状态读取失败，点击重试</view><view class="row"><view class="title">今日状态</view><view class="tag {{status==='已提交'?'ok':status==='草稿'?'warn':'danger'}}">{{statusLoading ? '读取中…' : statusError ? '读取失败' : status}}</view></view><button class="primary" bindtap="report">{{button}}</button></view>
    <view wx:if="{{showGoalEntry}}" class="card goal-entry"><view class="row"><view><view class="title">{{goalTitle}}</view><view class="muted">{{goalLoading ? '读取目标中…' : goalError ? '目标读取失败，点击重试' : goalPeriod}}</view></view><button class="goal-entry-action" bindtap="goal">{{goalLoading ? '读取中…' : goalError ? '重试' : goalLabel}} ›</button></view><view class="goal-pk" bindtap="pk">经营指标 PK ›<view class="muted">查看班级、业绩榜和消耗榜</view></view></view>
    <view wx:if="{{!showGoalEntry}}" class="card row" bindtap="pk"><view><view class="title">经营指标 PK</view><view class="muted">查看班级、业绩榜和消耗榜</view></view><text class="link">查看榜单 ›</text></view>
    <view class="section-head row"><view class="section">我的最近日报</view><view class="link" bindtap="history">历史记录 ›</view></view>
    <view wx:if="{{historyLoading && !recent.length}}" class="card empty">读取最近日报…</view>
    <view wx:elif="{{historyError}}" class="card empty" bindtap="retry">历史记录读取失败，点击重试</view>
    <view wx:elif="{{!recent.length}}" class="card empty">暂无日报记录，开始记录今天吧。</view>
    <view wx:for="{{recent}}" wx:key="id" class="card row" data-date="{{item.report_date}}" bindtap="openRecent"><view><view class="title">{{item.report_date}} 日报</view><view class="muted">{{item.status==='submitted'?'已提交日总结':'继续填写日总结'}}</view></view><view class="tag {{item.status==='submitted'?'ok':'warn'}}">{{item.status==='submitted'?'已提交':'草稿'}} ›</view></view>
  </block>
</view>
