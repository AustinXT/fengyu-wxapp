<page-header brand="{{workspace !== 'management'}}" title="管理总览" />
<view class="page home-content">
  <view wx:if="{{loading}}" class="skeleton">正在读取日报…</view>
  <view wx:elif="{{error}}" class="card"><view class="title">暂未连接日报服务</view><button class="secondary" bindtap="retry">重新加载</button></view>
<view wx:elif="{{!user}}" class="card"><view class="title">绑定员工身份</view><view class="muted">授权微信手机号，与已有员工档案关联。日报与员工端使用同一个员工编号。</view><button class="primary" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" loading="{{binding}}" disabled="{{binding}}">授权手机号并绑定</button><view wx:if="{{testBinding}}" class="test-binding"><view class="title">开发测试绑定</view><view class="muted">输入管理员提供的绑定码，关联测试员工后体验日报。</view><input placeholder="输入24位测试绑定码" value="{{testCode}}" bindinput="inputTestCode" maxlength="24" disabled="{{binding}}" /><button class="secondary" bindtap="bindTestCode" loading="{{binding}}" disabled="{{binding}}">使用绑定码开始测试</button></view></view>

  <block wx:elif="{{workspace === 'management'}}">
    <view class="scope-label">查看范围：{{user.staffLevel==='headquarters'?'全部授权门店':'当前授权范围'}}</view>
    <view class="card"><view class="row"><view class="title">提交概况</view><view class="tag">{{overview.summary.rate}}%</view></view><view class="muted">{{date}} · 授权门店的当前在职员工</view><view class="stats"><view><text>应提交</text><view>{{overview.summary.due}}</view></view><view><text>已提交</text><view>{{overview.summary.submitted}}</view></view><view><text>未提交</text><view>{{overview.summary.missing}}</view></view></view></view>
    <view class="card"><view class="title">待关注门店</view><block wx:for="{{overview.stores}}" wx:key="store_id"><view wx:if="{{item.missing>0}}" class="list-row" data-id="{{item.store_id}}" bindtap="openStore"><view>{{item.store_name}}<view class="muted">已交 {{item.submitted}} / {{item.due}}</view></view><text class="link">›</text></view></block><view wx:if="{{!overview.summary.missing}}" class="empty">当前范围暂无未提交员工。</view></view>
    <view class="card"><view class="title">待关注员工</view><block wx:for="{{overview.employees}}" wx:key="employee_id"><view wx:if="{{!item.report_id}}" class="list-row"><view class="avatar">{{item.name[0]}}</view><view class="person-main">{{item.name}}<view class="muted">{{item.store_name}}</view></view><view class="tag danger">未提交</view></view></block></view>
  </block>
  <block wx:else>
    <view class="card today-card"><view class="today-summary"><view class="today-title">我的日报</view><view class="muted">{{date}} · {{user.name}} · {{user.storeName || '尚未分配门店'}}</view></view><view class="row"><view class="title">今日状态</view><view class="tag {{status==='已提交'?'ok':status==='草稿'?'warn':'danger'}}">{{status}}</view></view><button class="primary" bindtap="report">{{button}}</button></view>
    <view class="section-head row"><view class="section">我的最近日报</view><view class="link" bindtap="history">历史记录 ›</view></view>
    <view wx:if="{{!recent.length}}" class="card empty">暂无日报记录，开始记录今天吧。</view>
    <view wx:for="{{recent}}" wx:key="id" class="card row" data-date="{{item.report_date}}" bindtap="openRecent"><view><view class="title">{{item.report_date}} 日报</view><view class="muted">{{item.status==='submitted'?'已提交日总结':'继续填写日总结'}}</view></view><view class="tag {{item.status==='submitted'?'ok':'warn'}}">{{item.status==='submitted'?'已提交':'草稿'}} ›</view></view>
  </block>
</view>
