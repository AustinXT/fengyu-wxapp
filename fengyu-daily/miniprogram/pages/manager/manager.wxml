<page-header title="{{title}}" back="{{true}}" />
<view class="page store-report-page">
  <view class="segmented">
    <view class="{{period==='today'?'selected':''}}" data-period="today" bindtap="periodChange">今日</view>
    <view class="{{period==='week'?'selected':''}}" data-period="week" bindtap="periodChange">经营周</view>
    <view class="{{period==='month'?'selected':''}}" data-period="month" bindtap="periodChange">经营月</view>
  </view>
  <view wx:if="{{loading}}" class="skeleton">读取门店日报…</view>
  <view wx:elif="{{!ready}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view>
  <block wx:else>
    <view class="card">
      <view class="row"><view class="title">提交概况</view><view class="tag {{summary.rate>=90?'ok':summary.rate>=70?'warn':'danger'}}">{{summary.rate}}%</view></view>
      <view class="muted">{{stores[storeIndex].store_name}} · {{range.label}}</view>
      <view class="stats">
        <view><text>应提交</text><view>{{summary.due}}</view></view>
        <view><text>已提交</text><view>{{summary.submitted}}</view></view>
        <view><text>未提交</text><view>{{summary.missing}}</view></view>
      </view>
    </view>
    <view class="card">
      <view class="title">人员提交列表</view>
      <view wx:for="{{employeeRows}}" wx:key="employee_id" class="list-row" data-id="{{item.employee_id}}" bindtap="person">
        <view class="avatar">{{item.name[0]}}</view>
        <view class="store-person-main"><view class="store-person-name">{{item.name}}</view><view class="muted">{{item.position_name || (item.is_store_manager?'店长':'员工')}} · {{period==='today'?(item.submitted>0?'今日已提交':'今日未提交'):'已交 '+item.submitted+' / '+item.due}}</view></view>
        <button wx:if="{{item.directReportId}}" class="report-action" data-id="{{item.directReportId}}" catchtap="open">查看日报</button>
        <view wx:else class="tag {{item.submitted>=item.due?'ok':'danger'}}">{{period==='today'?(item.submitted>=item.due?'已交齐':'未提交'):'已交 '+item.submitted+' / '+item.due}} ›</view>
      </view>
      <view wx:if="{{!employeeRows.length}}" class="empty">当前范围暂无员工。</view>
    </view>
  </block>
</view>
