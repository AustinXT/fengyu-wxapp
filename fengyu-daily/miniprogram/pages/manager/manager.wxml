<view class="page"><view class="section">门店日报</view>
<picker wx:if="{{stores.length}}" range="{{stores}}" range-key="store_name" value="{{storeIndex}}" bindchange="storeChange" disabled="{{loading}}"><view class="date row">{{stores[storeIndex].store_name}}<view class="link">切换门店 ›</view></view></picker>
<picker mode="date" value="{{date}}" end="{{maxDate}}" bindchange="dateChange" disabled="{{loading}}"><view class="date row">{{date}}<view class="link">切换日期 ›</view></view></picker>
<view class="segmented"><view class="{{period==='today'?'selected':''}}" data-period="today" bindtap="periodChange">今日</view><view class="{{period==='week'?'selected':''}}" data-period="week" bindtap="periodChange">经营周</view><view class="{{period==='month'?'selected':''}}" data-period="month" bindtap="periodChange">经营月</view></view>
<view wx:if="{{loading}}" class="skeleton">读取门店日报…</view><view wx:elif="{{!ready}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view>
<block wx:else><view class="card"><view class="row"><view class="title">提交概况</view><view class="tag {{summary.rate>=90?'ok':summary.rate>=70?'warn':'danger'}}">{{summary.rate}}%</view></view><view class="muted">{{range.label}} · {{range.start}} 至 {{range.end}}</view><view class="stats"><view>应交<view>{{summary.due}}</view></view><view>已交<view>{{summary.submitted}}</view></view><view>未交<view>{{summary.missing}}</view></view></view></view>
<view class="section">员工日报</view><view class="muted">按员工档案的入离职日期统计，不代表实际出勤人数。</view><view wx:if="{{!employees.length}}" class="card empty">暂无员工。</view><view wx:for="{{employees}}" wx:key="employee_id" class="card row" data-id="{{item.employee_id}}" bindtap="person"><view>{{item.name}}<view class="muted">已交 {{item.submitted}} / {{item.due}}</view></view><text class="link">记录 ›</text></view>
<view class="section">已提交日报</view><view wx:for="{{reports}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="open"><view>{{item.employee_name}}<view class="muted">{{item.report_date}}</view></view><text class="link">查看 ›</text></view></block></view>