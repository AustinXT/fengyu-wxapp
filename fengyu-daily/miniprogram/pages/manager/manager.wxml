<view class="page"><view class="section">门店日报</view><picker wx:if="{{stores.length}}" range="{{stores}}" range-key="store_name" value="{{storeIndex}}" bindchange="storeChange" disabled="{{loading}}"><view class="date row"><view>{{stores[storeIndex].store_name}}</view><view class="link">切换门店 ›</view></view></picker><picker mode="date" value="{{date}}" end="{{maxDate}}" bindchange="dateChange" disabled="{{loading}}"><view class="date row"><view>{{date}}</view><view class="link">切换日期 ›</view></view></picker><view wx:if="{{loading}}" class="skeleton">读取门店日报…</view><view wx:elif="{{!ready}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view><block wx:else><view class="hero"><view class="heading">{{reports.length}} 份已提交</view><view class="subtitle">当前在职员工中 {{unsubmitted.length}} 人未提交</view></view><view class="section">已提交</view><view wx:if="{{!reports.length}}" class="card empty">当天还没有已提交的日报。</view><view wx:for="{{reports}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="open"><view>{{item.employee_name}}<view class="muted">{{item.employee_id}}</view></view><view class="link">查看 ›</view></view><view class="section">当前员工未提交</view><view class="muted">按当前在职员工名单展示，不代表当天应出勤人数。</view><view class="card" wx:if="{{unsubmitted.length}}"><view wx:for="{{unsubmitted}}" wx:key="employee_id" class="row"><view>{{item.name}}</view><view class="muted">{{item.employee_id}}</view></view></view></block></view>