<page-header title="{{title}}" back="{{true}}" /><view class="page"><view class="segmented"><view class="{{period==='today'?'selected':''}}" data-period="today" bindtap="periodChange">今日</view><view class="{{period==='week'?'selected':''}}" data-period="week" bindtap="periodChange">经营周</view><view class="{{period==='month'?'selected':''}}" data-period="month" bindtap="periodChange">经营月</view></view><view wx:if="{{loading}}" class="skeleton">正在读取范围日报…</view><view wx:elif="{{!overview}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view><block wx:else><view class="card"><view class="row"><view class="title">提交概况</view><view class="tag">{{overview.summary.rate}}%</view></view><view class="muted">{{overview.range.label}}</view><view class="stats"><view><text>应提交</text><view>{{overview.summary.due}}</view></view><view><text>已提交</text><view>{{overview.summary.submitted}}</view></view><view><text>未提交</text><view>{{overview.summary.missing}}</view></view></view></view><view class="card"><view class="title">门店日报</view><view wx:for="{{overview.stores}}" wx:key="store_id" class="list-row" data-id="{{item.store_id}}" bindtap="store"><view>{{item.store_name}}<view class="muted">已交 {{item.submitted}} / {{item.due}} · {{item.rate}}%</view></view><text class="link">›</text></view><view wx:if="{{!overview.stores.length}}" class="empty">该范围暂无授权门店。</view></view></block></view>
