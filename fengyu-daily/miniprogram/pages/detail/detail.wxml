<view class="page"><view wx:if="{{loading}}" class="skeleton">加载中…</view><view wx:elif="{{!report}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view><block wx:else><view class="hero"><view class="eyebrow">已提交 · {{report.report_date}}</view><view class="heading">{{report.employee_name}}的日报</view><view class="subtitle">{{report.store_name}}</view></view><view class="section">当天业务</view><view wx:if="{{!entries.length}}" class="card empty">当天无业务反馈条目。</view><view wx:for="{{entries}}" wx:key="businessId" class="card"><view class="tag">{{item.businessType === 'service' ? '服务' : '销售'}}</view><view class="title" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.businessId}} · {{item.status}}</view><view wx:if="{{item.businessType === 'service'}}" class="muted"><view wx:for="{{item.items}}" wx:for-item="project" wx:key="sourceOrderId">{{project.name}} · {{project.sessions}} 次 · 来源 {{project.sourceOrderId}}</view></view><view class="label">业务反馈</view><view class="body">{{item.feedback || '未填写'}}</view><view class="label">后续跟进</view><view class="body">{{item.followUp || '未填写'}}</view></view><view class="card"><view class="title">复盘与计划</view><view class="label">今日行动</view><view class="body">{{report.action || '未填写'}}</view><view class="divider"/><view class="label">今日成长</view><view class="body">{{report.growth || '未填写'}}</view><view class="divider"/><view class="label">明日计划</view><view class="body">{{report.plan || '未填写'}}</view></view></block></view>