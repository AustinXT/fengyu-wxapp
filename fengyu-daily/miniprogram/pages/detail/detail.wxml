<view class="page"><view wx:if="{{loading}}" class="skeleton">加载中…</view><view wx:elif="{{!report}}" class="card"><button class="secondary" bindtap="retry">重新加载</button></view><block wx:else>
<view class="card"><view class="row"><view class="title">{{report.report_date}} 日总结</view><view class="tag ok">已提交</view></view><view class="muted">{{report.employee_name}} · {{report.store_name || '尚未分配门店'}}</view><view class="muted">{{report.period_snapshot.name || '提交时未配置经营周期'}}</view><view class="muted">最近提交：{{submittedLabel}}</view><button wx:if="{{canEdit}}" class="primary" bindtap="edit">修改今日日报</button></view>
<metric-snapshot snapshot="{{report.metric_snapshot}}" frozen="{{true}}" /><view class="section">一 关联业务</view><view wx:if="{{!entries.length}}" class="card empty">当天无业务反馈条目。</view>
<view wx:for="{{entries}}" wx:key="businessId" class="card"><view class="row"><view class="tag">{{item.businessType === 'service' ? '服务单' : '销售订单'}}</view><view class="muted">{{item.auto===false?'手动补充':''}}</view></view><view class="title" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.businessId}} · {{item.businessDate || report.report_date}}</view><view wx:if="{{item.businessType==='sale'}}" class="notice">尚未进行服务，只记录本次销售沟通。</view><view wx:else class="muted"><view wx:for="{{item.items}}" wx:for-item="project" wx:key="sourceOrderId">{{project.name}} · {{project.sessions}} 次 · 来源 {{project.sourceOrderId}}</view></view><view class="label">业务反馈</view><view class="body">{{item.feedback || '未填写'}}</view><view class="label">后续跟进</view><view class="body">{{item.followUp || '未填写'}}</view></view>
<view class="section">二 整日补充</view><view class="card"><view class="title">今日行动</view><view class="body">{{report.action || '未填写'}}</view></view><view class="card"><view class="title">今日成长</view><view class="body">{{report.growth || '未填写'}}</view></view><view class="card"><view class="title">明日计划</view><view class="body">{{report.plan || '未填写'}}</view></view><view class="card"><view class="title">指导关系</view><view class="list-row"><text>指导员</text><text>{{report.metric_snapshot.guidance.mentor.name || '未选择'}}</text></view><view class="list-row"><text>同事</text><text>{{report.metric_snapshot.guidance.peer.name || '未选择'}}</text></view></view>
</block></view>
