<page-header title="我的" /><view class="page"><view wx:if="{{loading}}" class="skeleton">正在读取身份…</view><block wx:elif="{{user}}"><view class="card"><view class="row"><view><view class="title">{{user.name}}</view><view class="muted">{{workspaceLabel}} · {{user.storeName || '尚未分配门店'}}</view></view><view class="avatar">{{user.name[0]}}</view></view></view><view class="card"><view class="title">账号信息</view><view class="list-row"><text>员工编号</text><text>{{user.employeeId}}</text></view><view class="list-row"><text>所属门店</text><text>{{user.storeName || '尚未分配门店'}}</text></view><view class="list-row"><text>当前工作台</text><text>{{workspaceLabel}}</text></view><view class="list-row"><text>授权查看范围</text><text class="scope-value">{{scopeLabel}}</text></view></view><view class="card row" bindtap="history"><text>我的历史日报</text><text class="link">查看 ›</text></view><view wx:if="{{user.availableWorkspaces.length>1}}" class="card row" bindtap="change"><text>切换工作台</text><text class="link">{{workspaceLabel}} ›</text></view></block></view>