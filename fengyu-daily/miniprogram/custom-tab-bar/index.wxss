.tabs{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:100;background:#fff;border-top:1rpx solid #e9eaed;padding:16rpx 0 calc(12rpx + env(safe-area-inset-bottom));}.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#92969e;font-size:22rpx;}.active{color:#c0322a;font-weight:600}.icon{height:32rpx;width:32rpx;border:3rpx solid currentColor;border-radius:7rpx;position:relative;box-sizing:border-box}.home:before{content:'';position:absolute;width:18rpx;height:18rpx;border-top:3rpx solid currentColor;border-left:3rpx solid currentColor;transform:rotate(45deg);left:4rpx;top:-10rpx;background:white}.records:after{content:'';position:absolute;left:5rpx;right:5rpx;top:8rpx;height:3rpx;background:currentColor;box-shadow:0 8rpx currentColor}.person{border-radius:50%;width:19rpx;height:19rpx;margin-bottom:13rpx}.person:after{content:'';position:absolute;width:30rpx;height:14rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:18rpx 18rpx 0 0;top:21rpx;left:-9rpx}.grid:before{display:none}
