# envs/prod.env — PRODUCTION 环境变量
# Copy 到 envs/prod.env（已 gitignored），填入真实生产值。
#
# ⚠️ prod secret 必须与 dev 完全不同：
#   - CLIENT_SECRET（用 `openssl rand -hex 32` 生成）
#   - ADMIN_JWT_SECRET（同上）
#   - 拉卡拉 prod 商户密钥（向拉卡拉商户经理申请）

# === 标识 ===
ENV_PROFILE=prod

# === PG ===
# prod 业务库：118.178.196.26:5433/fengyu_wxapp（fengyu-prod 服务器，2026-07-17 迁移）
PG_CONNECTION_STRING=postgresql://fengyu:fengyu123@118.178.196.26:5433/fengyu_wxapp
ADMIN_DATABASE_URL=postgresql://fengyu:fengyu123@118.178.196.26:5433/fengyu_wxapp
POSTGRES_USER=fengyu
POSTGRES_PASSWORD=<prod postgres password>
POSTGRES_DB=fengyu_wxapp

# === CloudBase envId ===
CLIENT_ENV_ID=fengyu-client-prod-d1cga6909c0ba
STAFF_ENV_ID=fengyu-staff-prod-d4dtv6052992e9

# === admin 图片上传（须与 prod client 同环境桶，否则 prod client 取不到图）===
CLOUDBASE_ENV_ID=fengyu-client-prod-d1cga6909c0ba
CDN_BASE=https://6665-fengyu-client-prod-d1cga6909c0ba-1406056527.tcb.qcloud.la
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
# Admin 调用 staffApi 健康检查使用 staff 独立腾讯云账号凭据。
STAFF_TENCENTCLOUD_SECRETID=
STAFF_TENCENTCLOUD_SECRETKEY=

# === CloudBase HTTP service URL ===
# 首次部署前 URL 未知，用 PLACEHOLDER；开 HTTP 触发器拿到 URL 后再二次部署。
CLIENT_SERVICE_URL=https://fengyu-client-prod-d1cga6909c0ba-PLACEHOLDER.ap-shanghai.app.tcloudbase.com
LAKALA_NOTIFY_URL=${CLIENT_SERVICE_URL}/lakala/notify
CLIENT_API_HTTP_URL=${CLIENT_SERVICE_URL}/cloudfunctions/clientApi

# === 内部 RPC 桥（HMAC 共享密钥，必须 prod 独立 secret；与微信 appsecret 无关）===
CLIENT_SECRET=<prod 独立 secret，openssl rand -hex 32>

# === 客户端小程序真实 appsecret（wxacode 换 access_token；与 dev 同一份——同一个客户端小程序）===
CLIENT_APPSECRET=<客户端小程序 appsecret，32 位 hex>
WX_CLIENT_APPID=<客户端小程序 appid>
WX_CLIENT_SECRET=<与 CLIENT_APPSECRET 相同>

# === 小程序版本 + 测试通道 ===
WXACODE_ENV_VERSION=release
ALLOW_TEST_OPENID=false
ALLOW_DIRECT_PHONE=false

# === 拉卡拉（prod 真实商户）===
LAKALA_API_FAMILY=tkbs
LAKALA_CLIENT_MODE=real
LAKALA_API_BASE=https://api.wsmsd.cn/api
LAKALA_TEST_BASE_URL=https://test.wsmsd.cn/sit/api
LAKALA_APPID=<prod 真实 APPID>
LAKALA_SERIAL_NO=<prod 真实序列号>
LAKALA_CALLBACK_IP_WHITELIST=<prod 真实回调 IP 白名单>
LAKALA_ENV=release
LAKALA_PRIVATE_KEY_PEM="<prod 真实 multiline PEM，用引号包裹保留换行 \n>"
LAKALA_PLATFORM_CERT_PEM="<prod 真实 multiline cert>"
LAKALA_SM4_KEY=<prod 同一拉卡拉应用的 SM4 密钥>
LAKALA_ORG_CODE=
LAKALA_USER_NO=
LAKALA_ACTIVITY_ID=
LAKALA_MCC=13002
LAKALA_SETTLEMENT_TYPE=AUTOMATIC
LAKALA_SOURCE=H5
# 微信小程序 sub_appid（聚合主扫 trans_type=71 必送，跨 dev/prod 一致）
LAKALA_SUB_APPID=wx811eb4ded3dfba3f
# 支付宝吱口令 acc_busi_fields.source（ISV 公司名缩写，由拉卡拉商务对接确认；留空则禁用支付宝通道）
LAKALA_ALIPAY_SHARE_SOURCE=

# === 拉卡拉门店入网（共享上方支付凭据）===
LAKALA_ONBOARDING_API_BASE=https://s2.lakala.com
LAKALA_ECONTRACT_CALLBACK_URL=
LAKALA_ECONTRACT_TYPE=EC015
LAKALA_ONBOARDING_EMAIL=lakala-onboarding@fengyu.local
LAKALA_ONBOARDING_BUSI_CODE=WECHAT_PAY
LAKALA_ONBOARDING_MER_TYPE=TP_MERCHANT
LAKALA_ONBOARDING_DEFAULT_LATITUDE=28.682892
LAKALA_ONBOARDING_DEFAULT_LONGITUDE=115.858197
LAKALA_ONBOARDING_BUSINESS_CONTENT=美容美发服务
PRIVATE_UPLOAD_DIR=/var/lib/fengyu/private-uploads
SYSTEM_RUNTIME_DIR=/var/lib/fengyu/runtime-status
DATABASE_BACKUP_REQUEST_DIR=/var/lib/fengyu/backup-control
DATABASE_BACKUP_DIR=/var/lib/fengyu/database-backups
SCHEDULED_BACKUP_RETENTION_DAYS=7
MANUAL_BACKUP_RETENTION_DAYS=30
WECHAT_BOT_WEBHOOK_URL=
ALIYUN_OCR_MODE=real
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# === 第三方 ===
TMAP_KEY=<prod TMAP_KEY 可与 dev 相同或独立>
TMAP_SECRET=<prod TMAP_SECRET>
# MSSQL：WorkFine 只读，与 dev 共用一份只读账号是允许的
MSSQL_CONNECTION_STRING=Server=47.96.87.33,1433;Database=wkdb_20220804_86cd3292;User Id=admin;Password=Se1Qimoh;TrustServerCertificate=True

# === payNotify 显式开关 ===
PAYNOTIFY_ENABLED=true
# 微信「发货信息管理」自动上报（用户自提 logistics_type=4）；依赖 CLIENT_APPSECRET
WX_SHIPPING_ENABLED=true

# === 进销存发布开关 ===
# 四端共用一个逻辑开关。prod 关闭：WorkFine 期初库存尚未导入核验
#（inventory_cutover_states 为空），一旦开启提货会在 assertWorkfineInventoryInitialized
# 处抛 INVALID_STATE，直接打断线上提货业务。
# 期初完成并核验为「已初始化」后，两个键一起改 true 并重新构建 admin 镜像 + 重部署云函数。
INVENTORY_LINKAGE_ENABLED=false
NEXT_PUBLIC_INVENTORY_LINKAGE_ENABLED=false

# === admin 远程容器 ===
ADMIN_JWT_SECRET=<prod jwt secret，openssl rand -hex 32>
ADMIN_RSA_PRIVATE_KEY=<prod RSA private key base64 PEM>
NEXT_PUBLIC_RSA_PUBLIC_KEY=<与私钥配对的 public key base64 PEM>
SEC_CHECK_ENABLED=true
COOKIE_DOMAIN=.meiyayabeauty.com
ANALYST_INTERNAL_ORIGIN=http://analyst:3000
# analyst 生产公网地址；必须与 analyst 部署脚本使用的地址一致。
ANALYST_ADMIN_LOGIN_URL=<prod admin login URL>
ANALYST_ADMIN_ORIGIN=<prod admin origin>
ANALYST_PUBLIC_ORIGIN=https://analyst.meiyayabeauty.com/
ANALYST_VIEW_ACTION=data_center:dashboard
ANALYST_CHAT_ACTION=data_center:dashboard
ANALYST_EXPORT_ACTION=data_center:dashboard

# === analyst AI provider（可选；未配置时 AI 功能不可用）===
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
