# envs/prod.env.example
ENV_PROFILE=prod

PG_CONNECTION_STRING=postgresql://<user>:<password>@<host>:5433/<dbname>
ADMIN_DATABASE_URL=postgresql://<user>:<password>@<host>:5433/<dbname>

CLIENT_ENV_ID=<your-client-env-id>
STAFF_ENV_ID=<your-staff-env-id>
CLOUDBASE_ENV_ID=<your-client-env-id>
CDN_BASE=https://<cdn-host>
TENCENTCLOUD_SECRETID=<your-secret-id>
TENCENTCLOUD_SECRETKEY=<your-secret-key>

CLIENT_SERVICE_URL=https://<client-service-url>.tcloudbase.com
LAKALA_NOTIFY_URL=${CLIENT_SERVICE_URL}/lakala/notify
CLIENT_API_HTTP_URL=${CLIENT_SERVICE_URL}/cloudfunctions/clientApi

CLIENT_SECRET=<openssl rand -hex 32>
CLIENT_APPSECRET=<client-miniprogram-appsecret>

WXACODE_ENV_VERSION=release
ALLOW_TEST_OPENID=false

LAKALA_API_BASE=https://api.wsmsd.cn/api
LAKALA_APPID=<your-lakala-appid>
LAKALA_SERIAL_NO=<your-lakala-serial-no>
LAKALA_CALLBACK_IP_WHITELIST=<comma-separated-ips>
LAKALA_ENV=release
LAKALA_PRIVATE_KEY_PEM="<multiline PEM>"
LAKALA_PLATFORM_CERT_PEM="<multiline PEM>"
LAKALA_SUB_APPID=<client-miniprogram-appid>
LAKALA_ALIPAY_SHARE_SOURCE=

TMAP_KEY=<your-tmap-key>
TMAP_SECRET=<your-tmap-secret>
MSSQL_CONNECTION_STRING=Server=<host>,1433;Database=<db>;User Id=<user>;Password=<password>;TrustServerCertificate=True

PAYNOTIFY_ENABLED=true
WX_SHIPPING_ENABLED=true

ADMIN_JWT_SECRET=<openssl rand -hex 32>
