# envs/prod.env — PRODUCTION 环境变量
# Copy 到 envs/prod.env（已 gitignored），填入真实生产值。
#
# ⚠️ prod secret 必须与 dev 完全不同：
#   - CLIENT_SECRET（用 `openssl rand -hex 32` 生成）
#   - ADMIN_JWT_SECRET（同上）
#   - 拉卡拉 prod 商户密钥（向拉卡拉商户经理申请）

# === 标识 ===
ENV_PROFILE=prod

# === PG ===
# prod 业务库：47.113.202.7:5433/fengyu_wxapp
PG_CONNECTION_STRING=postgresql://fengyu:fengyu123@47.113.202.7:5433/fengyu_wxapp
ADMIN_DATABASE_URL=postgresql://fengyu:fengyu123@47.113.202.7:5433/fengyu_wxapp

# === CloudBase envId ===
CLIENT_ENV_ID=fengyu-client-prod-d1cga6909c0ba
STAFF_ENV_ID=fengyu-staff-prod-d4dtv6052992e9

# === admin 图片上传（须与 prod client 同环境桶，否则 prod client 取不到图）===
CLOUDBASE_ENV_ID=fengyu-client-prod-d1cga6909c0ba
CDN_BASE=https://6665-fengyu-client-prod-d1cga6909c0ba-1406056527.tcb.qcloud.la
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# === CloudBase HTTP service URL ===
# 首次部署前 URL 未知，用 PLACEHOLDER；开 HTTP 触发器拿到 URL 后再二次部署。
CLIENT_SERVICE_URL=https://fengyu-client-prod-d1cga6909c0ba-PLACEHOLDER.ap-shanghai.app.tcloudbase.com
LAKALA_NOTIFY_URL=${CLIENT_SERVICE_URL}/lakala/notify
CLIENT_API_HTTP_URL=${CLIENT_SERVICE_URL}/cloudfunctions/clientApi

# === 内部 RPC 桥（必须 prod 独立 secret）===
CLIENT_SECRET=<prod 独立 secret，openssl rand -hex 32>

# === 小程序版本 + 测试通道 ===
WXACODE_ENV_VERSION=release
ALLOW_TEST_OPENID=false

# === 拉卡拉（prod 真实商户）===
LAKALA_API_BASE=https://api.wsmsd.cn/api
LAKALA_APPID=<prod 真实 APPID>
LAKALA_SERIAL_NO=<prod 真实序列号>
LAKALA_DEFAULT_MERCHANT_NO=<prod 真实商户号>
LAKALA_DEFAULT_TERM_NO=<prod 真实终端号>
LAKALA_SM4_KEY=<prod 真实 SM4 密钥>
LAKALA_CALLBACK_IP_WHITELIST=<prod 真实回调 IP 白名单>
LAKALA_ENV=release
LAKALA_PRIVATE_KEY_PEM="<prod 真实 multiline PEM，用引号包裹保留换行 \n>"
LAKALA_PLATFORM_CERT_PEM="<prod 真实 multiline cert>"

# === 第三方 ===
TMAP_KEY=<prod TMAP_KEY 可与 dev 相同或独立>
TMAP_SECRET=<prod TMAP_SECRET>
# MSSQL：WorkFine 只读，与 dev 共用一份只读账号是允许的
MSSQL_CONNECTION_STRING=Server=47.96.87.33,1433;Database=wkdb_20220804_86cd3292;User Id=admin;Password=Se1Qimoh;TrustServerCertificate=True

# === payNotify 显式开关 ===
PAYNOTIFY_ENABLED=true

# === admin 远程容器 ===
ADMIN_JWT_SECRET=<prod jwt secret，openssl rand -hex 32>
