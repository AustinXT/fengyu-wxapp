# envs/dev.env — DEVELOPMENT 环境变量
# Copy 到 envs/dev.env（已 gitignored），填入实际值。

# === 标识 ===
ENV_PROFILE=dev

# === PG ===
# dev 环境业务库：101.34.242.103:5433/fengyu_wxapp（sqlserver101；admin 容器内经 172.18.0.1:5433 Docker 网桥回连，本地迁移走公网地址）
PG_CONNECTION_STRING=postgresql://fengyu:fengyu123@101.34.242.103:5433/fengyu_wxapp
ADMIN_DATABASE_URL=postgresql://fengyu:fengyu123@172.18.0.1:5433/fengyu_wxapp
POSTGRES_USER=fengyu
POSTGRES_PASSWORD=<dev postgres password>
POSTGRES_DB=fengyu_wxapp

# === CloudBase envId ===
CLIENT_ENV_ID=cloud1-3gpht4b01ff88838
STAFF_ENV_ID=cloud1-9g3ydpg512eecc99

# === admin 图片上传（须与 client 同环境桶，否则 client 取不到图）===
CLOUDBASE_ENV_ID=cloud1-3gpht4b01ff88838
CDN_BASE=https://636c-cloud1-3gpht4b01ff88838-1406056527.tcb.qcloud.la
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
# Admin 调用 staffApi 健康检查使用 staff 独立腾讯云账号凭据。
STAFF_TENCENTCLOUD_SECRETID=
STAFF_TENCENTCLOUD_SECRETKEY=

# === CloudBase HTTP service URL ===
CLIENT_SERVICE_URL=https://cloud1-3gpht4b01ff88838-1406056527.ap-shanghai.app.tcloudbase.com
LAKALA_NOTIFY_URL=${CLIENT_SERVICE_URL}/lakala/notify
CLIENT_API_HTTP_URL=${CLIENT_SERVICE_URL}/cloudfunctions/clientApi

# === 内部 RPC 桥（staffApi↔clientApi HMAC 共享密钥，两端须一致）===
CLIENT_SECRET=<from current fengyu-staff/.env CLIENT_SECRET>

# === 客户端小程序真实 appsecret（wxacode 换 access_token，微信公众平台→开发管理→开发设置）===
CLIENT_APPSECRET=<客户端小程序 appsecret，32 位 hex>
WX_CLIENT_APPID=<客户端小程序 appid>
WX_CLIENT_SECRET=<与 CLIENT_APPSECRET 相同>

# === 小程序版本 + 测试通道 ===
WXACODE_ENV_VERSION=develop
ALLOW_TEST_OPENID=true
ALLOW_DIRECT_PHONE=true

# === 拉卡拉（dev 用 sit 测试环境）===
LAKALA_API_FAMILY=tkbs
LAKALA_CLIENT_MODE=mock
LAKALA_API_BASE=https://test.wsmsd.cn/sit/api
LAKALA_TEST_BASE_URL=https://test.wsmsd.cn/sit/api
LAKALA_APPID=OP00000003
LAKALA_SERIAL_NO=00dfba8194c41b84cf
LAKALA_CALLBACK_IP_WHITELIST=58.246.131.244,61.169.68.178
LAKALA_ENV=test
LAKALA_PRIVATE_KEY_PEM="<multiline PEM — 用引号包裹，保留换行 \n>"
LAKALA_PLATFORM_CERT_PEM="<multiline PEM>"
LAKALA_SM4_KEY=
LAKALA_ORG_CODE=
LAKALA_USER_NO=
LAKALA_ACTIVITY_ID=
LAKALA_MCC=13002
LAKALA_SETTLEMENT_TYPE=AUTOMATIC
LAKALA_SOURCE=H5
# 微信小程序 sub_appid（聚合主扫 trans_type=71 必送，client appid 跨 dev/prod 一致）
LAKALA_SUB_APPID=wx811eb4ded3dfba3f
# 支付宝吱口令 acc_busi_fields.source（ISV 公司名缩写，由拉卡拉商务对接确认；留空则禁用支付宝通道）
LAKALA_ALIPAY_SHARE_SOURCE=

# === 拉卡拉门店入网（共享上方支付凭据；dev 固定 mock，避免创建真实商户）===
LAKALA_ONBOARDING_API_BASE=https://test.wsmsd.cn/sit
LAKALA_ECONTRACT_CALLBACK_URL=
LAKALA_ECONTRACT_TYPE=EC015
LAKALA_ONBOARDING_EMAIL=lakala-onboarding@fengyu.local
LAKALA_ONBOARDING_BUSI_CODE=WECHAT_PAY
LAKALA_ONBOARDING_MER_TYPE=TP_MERCHANT
LAKALA_ONBOARDING_DEFAULT_LATITUDE=28.682892
LAKALA_ONBOARDING_DEFAULT_LONGITUDE=115.858197
LAKALA_ONBOARDING_BUSINESS_CONTENT=美容美发服务
PRIVATE_UPLOAD_DIR=/var/lib/fengyu/private-uploads
SYSTEM_RUNTIME_DIR=/var/lib/fengyu/runtime-status
DATABASE_BACKUP_REQUEST_DIR=/var/lib/fengyu/backup-control
DATABASE_BACKUP_DIR=/var/lib/fengyu/database-backups
SCHEDULED_BACKUP_RETENTION_DAYS=7
MANUAL_BACKUP_RETENTION_DAYS=30
WECHAT_BOT_WEBHOOK_URL=
ALIYUN_OCR_MODE=real
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# === 第三方 ===
TMAP_KEY=<dev TMAP_KEY，腾讯位置服务控制台申请>
TMAP_SECRET=<dev TMAP_SECRET>
MSSQL_CONNECTION_STRING=Server=47.96.87.33,1433;Database=wkdb_20220804_86cd3292;User Id=SD;Password=Se4Qimoh;TrustServerCertificate=True

# === payNotify 显式开关 ===
PAYNOTIFY_ENABLED=true
# 微信「发货信息管理」自动上报；dev 默认关闭，避免开发测试单污染真实小程序发货管理后台
WX_SHIPPING_ENABLED=false

# === admin 远程容器（dev 用本地 docker postgres 或本地 .env.local，此变量主要给远程用）===
ADMIN_JWT_SECRET=<dev jwt secret，与 prod 不同>
ADMIN_RSA_PRIVATE_KEY=<dev RSA private key base64 PEM>
NEXT_PUBLIC_RSA_PUBLIC_KEY=<与私钥配对的 public key base64 PEM>
SEC_CHECK_ENABLED=false
COOKIE_DOMAIN=
ANALYST_INTERNAL_ORIGIN=http://analyst:3000
# analyst 公网地址；必须与 analyst 部署脚本使用的地址一致。
ANALYST_ADMIN_LOGIN_URL=http://101.34.242.103:3000/login
ANALYST_ADMIN_ORIGIN=http://101.34.242.103:3000
ANALYST_PUBLIC_ORIGIN=http://101.34.242.103:3001
ANALYST_VIEW_ACTION=data_center:dashboard
ANALYST_CHAT_ACTION=data_center:dashboard
ANALYST_EXPORT_ACTION=data_center:dashboard

# === analyst AI provider（可选；未配置时 AI 功能不可用）===
