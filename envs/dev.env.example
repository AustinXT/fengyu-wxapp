# envs/dev.env — DEVELOPMENT 环境变量
# Copy 到 envs/dev.env（已 gitignored），填入实际值。

# === 标识 ===
ENV_PROFILE=dev

# === PG ===
# dev 环境业务库：47.113.202.7:5434/fengyu
PG_CONNECTION_STRING=postgresql://fengyu:fengyu123@47.113.202.7:5434/fengyu
ADMIN_DATABASE_URL=postgresql://fengyu:fengyu123@47.113.202.7:5434/fengyu

# === CloudBase envId ===
CLIENT_ENV_ID=cloud1-3gpht4b01ff88838
STAFF_ENV_ID=cloud1-9g3ydpg512eecc99

# === admin 图片上传（须与 client 同环境桶，否则 client 取不到图）===
CLOUDBASE_ENV_ID=cloud1-3gpht4b01ff88838
CDN_BASE=https://636c-cloud1-3gpht4b01ff88838-1406056527.tcb.qcloud.la
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# === CloudBase HTTP service URL ===
CLIENT_SERVICE_URL=https://cloud1-3gpht4b01ff88838-1406056527.ap-shanghai.app.tcloudbase.com
LAKALA_NOTIFY_URL=${CLIENT_SERVICE_URL}/lakala/notify
CLIENT_API_HTTP_URL=${CLIENT_SERVICE_URL}/cloudfunctions/clientApi

# === 内部 RPC 桥（staffApi↔clientApi HMAC 共享密钥，两端须一致）===
CLIENT_SECRET=<from current fengyu-staff/.env CLIENT_SECRET>

# === 客户端小程序真实 appsecret（wxacode 换 access_token，微信公众平台→开发管理→开发设置）===
CLIENT_APPSECRET=<客户端小程序 appsecret，32 位 hex>

# === 小程序版本 + 测试通道 ===
WXACODE_ENV_VERSION=develop
ALLOW_TEST_OPENID=true

# === 拉卡拉（dev 用 sit 测试环境）===
LAKALA_API_BASE=https://test.wsmsd.cn/sit/api
LAKALA_APPID=OP00000003
LAKALA_SERIAL_NO=00dfba8194c41b84cf
LAKALA_DEFAULT_MERCHANT_NO=822290059430BFA
LAKALA_DEFAULT_TERM_NO=D9261078
LAKALA_SM4_KEY=<from current fengyu-client/cloudbaserc.json>
LAKALA_CALLBACK_IP_WHITELIST=58.246.131.244,61.169.68.178
LAKALA_ENV=release
LAKALA_PRIVATE_KEY_PEM="<multiline PEM — 用引号包裹，保留换行 \n>"
LAKALA_PLATFORM_CERT_PEM="<multiline PEM>"

# === 第三方 ===
TMAP_KEY=<dev TMAP_KEY，腾讯位置服务控制台申请>
TMAP_SECRET=<dev TMAP_SECRET>
MSSQL_CONNECTION_STRING=Server=47.96.87.33,1433;Database=wkdb_20220804_86cd3292;User Id=SD;Password=Se4Qimoh;TrustServerCertificate=True

# === payNotify 显式开关 ===
PAYNOTIFY_ENABLED=true

# === admin 远程容器（dev 用本地 docker postgres 或本地 .env.local，此变量主要给远程用）===
ADMIN_JWT_SECRET=<dev jwt secret，与 prod 不同>
