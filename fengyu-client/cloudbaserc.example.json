{
  "_comment": "TEMPLATE — rendered to cloudbaserc.json (gitignored) by scripts/render-cloudbaserc.mjs. Vars come from envs/<active>.env.",
  "envId": "${CLIENT_ENV_ID}",
  "version": "2.0",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "clientApi",
      "timeout": 60,
      "path": "/cloudfunctions/clientApi",
      "envVariables": {
        "PG_CONNECTION_STRING": "${PG_CONNECTION_STRING}",
        "MSSQL_CONNECTION_STRING": "${MSSQL_CONNECTION_STRING}",
        "TMAP_KEY": "${TMAP_KEY}",
        "TMAP_SECRET": "${TMAP_SECRET}",
        "CLIENT_SECRET": "${CLIENT_SECRET}",
        "ALLOW_TEST_OPENID": "${ALLOW_TEST_OPENID}",
        "ALLOW_DIRECT_PHONE": "${ALLOW_DIRECT_PHONE}",
        "TZ": "Asia/Shanghai",
        "LAKALA_API_BASE": "${LAKALA_API_BASE}",
        "LAKALA_APPID": "${LAKALA_APPID}",
        "LAKALA_SERIAL_NO": "${LAKALA_SERIAL_NO}",
        "LAKALA_CALLBACK_IP_WHITELIST": "${LAKALA_CALLBACK_IP_WHITELIST}",
        "LAKALA_ENV": "${LAKALA_ENV}",
        "LAKALA_NOTIFY_URL": "${LAKALA_NOTIFY_URL}",
        "LAKALA_PRIVATE_KEY_PEM": "${LAKALA_PRIVATE_KEY_PEM}",
        "LAKALA_PLATFORM_CERT_PEM": "${LAKALA_PLATFORM_CERT_PEM}",
        "LAKALA_SUB_APPID": "${LAKALA_SUB_APPID}",
        "LAKALA_ALIPAY_SHARE_SOURCE": "${LAKALA_ALIPAY_SHARE_SOURCE}",
        "CLIENT_APPSECRET": "${CLIENT_APPSECRET}",
        "SEC_CHECK_ENABLED": "${SEC_CHECK_ENABLED}",
        "INVENTORY_LINKAGE_ENABLED": "${INVENTORY_LINKAGE_ENABLED}",
        "PAYNOTIFY_FN_NAME": "payNotify"
      },
      "triggers": [
        {
          "name": "clientApiHttp",
          "type": "http",
          "config": "{\"enableAuth\":false}"
        }
      ],
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    },
    {
      "name": "payNotify",
      "timeout": 30,
      "path": "/cloudfunctions/payNotify",
      "envVariables": {
        "PG_CONNECTION_STRING": "${PG_CONNECTION_STRING}",
        "CLIENT_SECRET": "${CLIENT_SECRET}",
        "TZ": "Asia/Shanghai",
        "LAKALA_API_BASE": "${LAKALA_API_BASE}",
        "LAKALA_APPID": "${LAKALA_APPID}",
        "LAKALA_SERIAL_NO": "${LAKALA_SERIAL_NO}",
        "LAKALA_CALLBACK_IP_WHITELIST": "${LAKALA_CALLBACK_IP_WHITELIST}",
        "LAKALA_ENV": "${LAKALA_ENV}",
        "PAYNOTIFY_ENABLED": "${PAYNOTIFY_ENABLED}",
        "WX_SHIPPING_ENABLED": "${WX_SHIPPING_ENABLED}",
        "CLIENT_APPSECRET": "${CLIENT_APPSECRET}",
        "LAKALA_NOTIFY_URL": "${LAKALA_NOTIFY_URL}",
        "LAKALA_PRIVATE_KEY_PEM": "${LAKALA_PRIVATE_KEY_PEM}",
        "LAKALA_PLATFORM_CERT_PEM": "${LAKALA_PLATFORM_CERT_PEM}",
        "LAKALA_SUB_APPID": "${LAKALA_SUB_APPID}",
        "LAKALA_ALIPAY_SHARE_SOURCE": "${LAKALA_ALIPAY_SHARE_SOURCE}",
        "PAYNOTIFY_FN_NAME": "payNotify"
      },
      "triggers": [
        {
          "name": "wxShippingBackfill",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ],
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    },
    {
      "_comment": "影子函数：与 clientApi 同一份代码（dir 指向它），但连 dev 库。小程序端 develop/trial 版调这个，release 调 clientApi。",
      "name": "clientApiDev",
      "dir": "cloudfunctions/clientApi",
      "timeout": 60,
      "path": "/cloudfunctions/clientApiDev",
      "envVariables": {
        "PG_CONNECTION_STRING": "${DEV_PG_CONNECTION_STRING}",
        "MSSQL_CONNECTION_STRING": "${DEV_MSSQL_CONNECTION_STRING}",
        "TMAP_KEY": "${TMAP_KEY}",
        "TMAP_SECRET": "${TMAP_SECRET}",
        "CLIENT_SECRET": "${DEV_CLIENT_SECRET}",
        "ALLOW_TEST_OPENID": "${DEV_ALLOW_TEST_OPENID}",
        "ALLOW_DIRECT_PHONE": "${DEV_ALLOW_DIRECT_PHONE}",
        "TZ": "Asia/Shanghai",
        "LAKALA_API_BASE": "${DEV_LAKALA_API_BASE}",
        "LAKALA_APPID": "${DEV_LAKALA_APPID}",
        "LAKALA_SERIAL_NO": "${DEV_LAKALA_SERIAL_NO}",
        "LAKALA_CALLBACK_IP_WHITELIST": "${DEV_LAKALA_CALLBACK_IP_WHITELIST}",
        "LAKALA_ENV": "${DEV_LAKALA_ENV}",
        "LAKALA_NOTIFY_URL": "${CLIENT_SERVICE_URL}/lakala/notify-dev",
        "LAKALA_PRIVATE_KEY_PEM": "${DEV_LAKALA_PRIVATE_KEY_PEM}",
        "LAKALA_PLATFORM_CERT_PEM": "${DEV_LAKALA_PLATFORM_CERT_PEM}",
        "LAKALA_SUB_APPID": "${DEV_LAKALA_SUB_APPID}",
        "LAKALA_ALIPAY_SHARE_SOURCE": "${DEV_LAKALA_ALIPAY_SHARE_SOURCE}",
        "CLIENT_APPSECRET": "${CLIENT_APPSECRET}",
        "SEC_CHECK_ENABLED": "${DEV_SEC_CHECK_ENABLED}",
        "INVENTORY_LINKAGE_ENABLED": "${DEV_INVENTORY_LINKAGE_ENABLED}",
        "PAYNOTIFY_FN_NAME": "payNotifyDev"
      },
      "triggers": [
        {
          "name": "clientApiDevHttp",
          "type": "http",
          "config": "{\"enableAuth\":false}"
        }
      ],
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    },
    {
      "_comment": "影子函数：与 payNotify 同一份代码（dir 指向它），但连 dev 库。刻意不挂 wxShippingBackfill timer——正式 payNotify 每分钟跑对账会 UPDATE sale_orders，两份同时跑会互抢 lakala_out_order_no 的释放。",
      "name": "payNotifyDev",
      "dir": "cloudfunctions/payNotify",
      "timeout": 30,
      "path": "/cloudfunctions/payNotifyDev",
      "envVariables": {
        "PG_CONNECTION_STRING": "${DEV_PG_CONNECTION_STRING}",
        "CLIENT_SECRET": "${DEV_CLIENT_SECRET}",
        "TZ": "Asia/Shanghai",
        "LAKALA_API_BASE": "${DEV_LAKALA_API_BASE}",
        "LAKALA_APPID": "${DEV_LAKALA_APPID}",
        "LAKALA_SERIAL_NO": "${DEV_LAKALA_SERIAL_NO}",
        "LAKALA_CALLBACK_IP_WHITELIST": "${DEV_LAKALA_CALLBACK_IP_WHITELIST}",
        "LAKALA_ENV": "${DEV_LAKALA_ENV}",
        "PAYNOTIFY_ENABLED": "${DEV_PAYNOTIFY_ENABLED}",
        "WX_SHIPPING_ENABLED": "${DEV_WX_SHIPPING_ENABLED}",
        "CLIENT_APPSECRET": "${CLIENT_APPSECRET}",
        "LAKALA_NOTIFY_URL": "${CLIENT_SERVICE_URL}/lakala/notify-dev",
        "LAKALA_PRIVATE_KEY_PEM": "${DEV_LAKALA_PRIVATE_KEY_PEM}",
        "LAKALA_PLATFORM_CERT_PEM": "${DEV_LAKALA_PLATFORM_CERT_PEM}",
        "LAKALA_SUB_APPID": "${DEV_LAKALA_SUB_APPID}",
        "LAKALA_ALIPAY_SHARE_SOURCE": "${DEV_LAKALA_ALIPAY_SHARE_SOURCE}",
        "PAYNOTIFY_FN_NAME": "payNotifyDev"
      },
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    }
  ]
}
