{
  "_comment": "TEMPLATE — copy to cloudbaserc.json (gitignored), fill secrets from fengyu-client/.env, then deploy",
  "envId": "cloud1-3gpht4b01ff88838",
  "version": "2.0",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "clientApi",
      "timeout": 30,
      "path": "/cloudfunctions/clientApi",
      "envVariables": {
        "PG_CONNECTION_STRING": "<from .env PG_CONNECTION_STRING>",
        "MSSQL_CONNECTION_STRING": "<from .env MSSQL_CONNECTION_STRING>",
        "TMAP_KEY": "<from .env TMAP_KEY>",
        "TMAP_SECRET": "<from .env TMAP_SECRET>",
        "ALLOW_TEST_OPENID": "<from .env ALLOW_TEST_OPENID>"
      },
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    },
    {
      "name": "payNotify",
      "timeout": 30,
      "path": "/cloudfunctions/payNotify",
      "envVariables": {
        "PG_CONNECTION_STRING": "<from .env PG_CONNECTION_STRING>"
      },
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    }
  ]
}
