{
  "_comment": "TEMPLATE — rendered to cloudbaserc.json (gitignored) by scripts/render-cloudbaserc.mjs. Vars come from envs/<active>.env.",
  "envId": "${CLIENT_ENV_ID}",
  "version": "2.0",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "clientApi",
      "timeout": 60,
      "path": "/cloudfunctions/clientApi",
      "envVariables": {
        "PG_CONNECTION_STRING": "${PG_CONNECTION_STRING}",
        "MSSQL_CONNECTION_STRING": "${MSSQL_CONNECTION_STRING}",
        "TMAP_KEY": "${TMAP_KEY}",
        "TMAP_SECRET": "${TMAP_SECRET}",
        "CLIENT_SECRET": "${CLIENT_SECRET}",
        "ALLOW_TEST_OPENID": "${ALLOW_TEST_OPENID}",
        "TZ": "Asia/Shanghai",
        "LAKALA_API_BASE": "${LAKALA_API_BASE}",
        "LAKALA_APPID": "${LAKALA_APPID}",
        "LAKALA_SERIAL_NO": "${LAKALA_SERIAL_NO}",
        "LAKALA_CALLBACK_IP_WHITELIST": "${LAKALA_CALLBACK_IP_WHITELIST}",
        "LAKALA_ENV": "${LAKALA_ENV}",
        "LAKALA_NOTIFY_URL": "${LAKALA_NOTIFY_URL}",
        "LAKALA_PRIVATE_KEY_PEM": "${LAKALA_PRIVATE_KEY_PEM}",
        "LAKALA_PLATFORM_CERT_PEM": "${LAKALA_PLATFORM_CERT_PEM}",
        "LAKALA_SUB_APPID": "${LAKALA_SUB_APPID}",
        "LAKALA_ALIPAY_SHARE_SOURCE": "${LAKALA_ALIPAY_SHARE_SOURCE}",
        "CLIENT_APPSECRET": "${CLIENT_APPSECRET}",
        "SEC_CHECK_ENABLED": "${SEC_CHECK_ENABLED}"
      },
      "triggers": [
        {
          "name": "clientApiHttp",
          "type": "http",
          "config": "{\"enableAuth\":false}"
        }
      ],
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    },
    {
      "name": "payNotify",
      "timeout": 30,
      "path": "/cloudfunctions/payNotify",
      "envVariables": {
        "PG_CONNECTION_STRING": "${PG_CONNECTION_STRING}",
        "TZ": "Asia/Shanghai",
        "LAKALA_API_BASE": "${LAKALA_API_BASE}",
        "LAKALA_APPID": "${LAKALA_APPID}",
        "LAKALA_SERIAL_NO": "${LAKALA_SERIAL_NO}",
        "LAKALA_CALLBACK_IP_WHITELIST": "${LAKALA_CALLBACK_IP_WHITELIST}",
        "LAKALA_ENV": "${LAKALA_ENV}",
        "PAYNOTIFY_ENABLED": "${PAYNOTIFY_ENABLED}",
        "WX_SHIPPING_ENABLED": "${WX_SHIPPING_ENABLED}",
        "CLIENT_APPSECRET": "${CLIENT_APPSECRET}",
        "LAKALA_NOTIFY_URL": "${LAKALA_NOTIFY_URL}",
        "LAKALA_PRIVATE_KEY_PEM": "${LAKALA_PRIVATE_KEY_PEM}",
        "LAKALA_PLATFORM_CERT_PEM": "${LAKALA_PLATFORM_CERT_PEM}",
        "LAKALA_SUB_APPID": "${LAKALA_SUB_APPID}",
        "LAKALA_ALIPAY_SHARE_SOURCE": "${LAKALA_ALIPAY_SHARE_SOURCE}"
      },
      "triggers": [
        {
          "name": "wxShippingBackfill",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ],
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false
    }
  ]
}
