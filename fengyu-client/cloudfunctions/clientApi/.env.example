# clientApi 云函数环境变量配置

# PG 自托管数据库连接串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
PG_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/fengyu_wxapp

# WorkFine SQL Server 连接信息(只读)
MSSQL_SERVER=47.96.87.33
MSSQL_PORT=1433
MSSQL_USER=SD
MSSQL_PASSWORD=
MSSQL_DATABASE=wkdb_20220804_86cd3292

# ===== 拉卡拉聚合支付（收银台 SDK） =====
# 测试：https://test.wsmsd.cn/sit/api ｜ 生产：https://s2.lakala.com/api
LAKALA_API_BASE=https://test.wsmsd.cn/sit/api
LAKALA_APPID=OP00000003
LAKALA_SERIAL_NO=00dfba8194c41b84cf
# RSA-2048 私钥 PEM（含 BEGIN/END 头尾，整段塞进环境变量；CloudBase 控制台支持多行）
LAKALA_PRIVATE_KEY_PEM=
# 拉卡拉平台公钥证书 PEM（验签用，开通邮件附件下载）
LAKALA_PLATFORM_CERT_PEM=
# 测试号 / 生产正式号
LAKALA_DEFAULT_MERCHANT_NO=822290059430BFA
LAKALA_DEFAULT_TERM_NO=D9261078
# 异步通知 HTTPS URL（CloudBase HTTP 触发器地址，部署 payNotify 后填回）
LAKALA_NOTIFY_URL=
# 回调 IP 白名单（逗号分隔，"*" 跳过校验）
# 测试：58.246.131.244,61.169.68.178
# 生产：47.116.7.41,106.14.71.201,106.14.134.17,47.101.68.59,101.132.178.83,47.101.167.47,106.15.184.244,139.224.105.233,106.15.229.53,123.56.6.73
LAKALA_CALLBACK_IP_WHITELIST=*
# SM4 Key（仅 special_create_encry 加密变体用，本期可留空）
LAKALA_SM4_KEY=uIj6CPg1GZAY10dXFfsEAQ==
# 跳转拉卡拉收银台小程序时的 envVersion：release / trial
LAKALA_ENV=trial
