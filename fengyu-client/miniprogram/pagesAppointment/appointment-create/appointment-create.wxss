/* pages/appointment-create/appointment-create.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}

/* 无可预约项提示 */
.no-items-tip {
  padding: 40rpx 0;
}

/* 已选中的项目行 */
.item-selected {
  background: var(--color-primary-light) !important;
}

/* ===== 底部提交 ===== */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1px solid var(--color-border);
}

/* 美容师弹窗 — 复用 app.wxss 全局 .staff-* 样式 */
