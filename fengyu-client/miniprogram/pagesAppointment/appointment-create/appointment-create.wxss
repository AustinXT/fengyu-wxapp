/* pages/appointment-create/appointment-create.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}

/* 无可预约项提示 */
.no-items-tip {
  padding: 40rpx 0;
}

/* 已选中的项目行 */
.item-selected {
  background: var(--color-primary-light) !important;
}

/* 跨店卡：置灰 + 禁点（.wxml 仍保留 bind:click 做 Toast 提示） */
.item-disabled {
  opacity: 0.45;
}

.item-disabled .van-cell__title,
.item-disabled .van-cell__label {
  color: var(--color-text-hint) !important;
}

/* ===== 时段 tag 按钮 ===== */
.time-slots {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.time-slot-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.time-slot-tag--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.time-slot-tag--disabled {
  opacity: 0.4;
  background: var(--color-bg-section);
  color: var(--color-text-hint);
  border-color: var(--color-border);
  pointer-events: none;
}

/* ===== 底部提交 ===== */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1px solid var(--color-border);
}

/* 美容师弹窗 — 复用 app.wxss 全局 .staff-* 样式 */
