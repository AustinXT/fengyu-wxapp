

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}


.no-items-tip {
  padding: 40rpx 0;
}


.item-selected {
  background: var(--color-primary-light) !important;
}


.item-disabled {
  opacity: 0.45;
}

.item-disabled .van-cell__title,
.item-disabled .van-cell__label {
  color: var(--color-text-hint) !important;
}


.time-slot-row {
  padding: 20rpx 32rpx 24rpx;
  background: var(--color-bg-card);
}

.time-slot-row-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}


.time-slots {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.time-slot-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.time-slot-tag--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.time-slot-tag--disabled {
  opacity: 0.4;
  background: var(--color-bg-section);
  color: var(--color-text-hint);
  border-color: var(--color-border);
  pointer-events: none;
}


.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1px solid var(--color-border);
}




.cell-staff-avatar {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.cell-staff-avatar-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}
