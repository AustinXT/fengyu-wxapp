<!-- pages/appointment-create/appointment-create.wxml — 发起预约 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 关联疗程卡（可选） -->
  <van-cell-group title="关联疗程卡（可选）" inset>
    <view wx:if="{{appointableItems.length === 0}}" class="no-items-tip">
      <van-cell title="无可关联项目" label="您可以直接预约到店时间" icon="info-o" />
    </view>
    <view wx:else>
      <!-- 不关联选项 -->
      <van-cell
        title="不关联疗程卡"
        label="仅预约到店时间"
        clickable
        bind:click="onClearItem"
        class="{{!selectedSaleItemId ? 'item-selected' : ''}}"
      >
        <van-icon
          slot="right-icon"
          name="{{!selectedSaleItemId ? 'success' : 'circle'}}"
          color="{{!selectedSaleItemId ? '#C0322A' : '#DCDCDC'}}"
          size="40rpx"
        />
      </van-cell>
      <van-cell
        wx:for="{{appointableItems}}"
        wx:key="sale_item_id"
        title="{{item.product_name || '—'}}"
        label="已用 {{item.used_sessions}} / 已付 {{item.disabled ? '—' : item.paid_sessions}} / 共 {{item.session_count}} 次{{item.disabled_reason ? ' · ' + item.disabled_reason : ''}}"
        clickable
        bind:click="onSelectItem"
        data-item="{{item}}"
        class="{{selectedSaleItemId === item.sale_item_id ? 'item-selected' : ''}} {{item.disabled ? 'item-disabled' : ''}}"
      >
        <van-icon
          slot="right-icon"
          name="{{item.disabled ? 'close' : (selectedSaleItemId === item.sale_item_id ? 'success' : 'circle')}}"
          color="{{item.disabled ? '#CCCCCC' : (selectedSaleItemId === item.sale_item_id ? '#C0322A' : '#DCDCDC')}}"
          size="40rpx"
        />
      </van-cell>
    </view>
  </van-cell-group>

  <!-- 预约时间 -->
  <van-cell-group title="预约到店时间" inset>
    <van-cell
      title="选择日期"
      value="{{appointmentDate || '请选择'}}"
      is-link
      bindtap="onShowDatePicker"
    />
    <view class="time-slot-row">
      <view class="time-slot-row-title">到店时段</view>
      <view class="time-slots">
        <view
          wx:for="{{timeSlots}}"
          wx:key="value"
          class="time-slot-tag {{appointmentTimeSlot === item.value ? 'time-slot-tag--active' : ''}} {{item.disabled ? 'time-slot-tag--disabled' : ''}}"
          catchtap="onTimeSlotTap"
          data-value="{{item.value}}"
          data-text="{{item.text}}"
          data-disabled="{{item.disabled}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </van-cell-group>

  <!-- 选择美容师（可选） -->
  <van-cell-group title="指定美容师（可选）" inset>
    <van-cell
      title="{{selectedStaffName || '不指定'}}"
      label="{{defaultStaffName ? '主美容师：' + defaultStaffName : ''}}"
      is-link
      use-icon-slot
      bindtap="onShowStaffPopup"
    >
      <view slot="icon" class="cell-staff-avatar">
        <image wx:if="{{selectedStaffAvatarUrl}}" src="{{selectedStaffAvatarUrl}}" class="cell-staff-avatar-img" mode="aspectFill" />
        <van-icon wx:else name="manager-o" size="36rpx" color="#C0322A" />
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 备注 -->
  <van-cell-group title="备注" inset>
    <van-field
      model:value="{{notes}}"
      type="textarea"
      placeholder="如有特殊需求请填写（选填）"
      rows="3"
      autosize
      maxlength="200"
      show-word-limit
    />
  </van-cell-group>

  <!-- 底部提交 -->
  <view class="submit-wrap safe-area-bottom">
    <van-button
      type="primary"
      block
      round
      loading="{{submitting}}"
      disabled="{{!appointmentDate || !appointmentTimeSlot || submitting}}"
      bindtap="onSubmit"
    >提交预约申请</van-button>
  </view>

  <!-- 日期选择器 -->
  <van-calendar
    show="{{showCalendar}}"
    min-date="{{minDate}}"
    max-date="{{maxDate}}"
    bind:confirm="onDateConfirm"
    bind:close="onCloseCalendar"
    color="#C0322A"
    title="选择到店日期"
  />

  <!-- 手机号绑定 Overlay -->
  <van-overlay show="{{showPhoneBind}}" bind:click="onClosePhoneBind">
    <view class="phone-bind-overlay" catchtap="onClosePhoneBind">
      <view class="phone-bind-card">
        <text class="phone-bind-title">需要绑定手机号</text>
        <text class="phone-bind-desc">预约前请先绑定您的手机号</text>
        <button
          class="phone-bind-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
        >授权手机号</button>
      </view>
    </view>
  </van-overlay>

  <!-- 美容师选择 Popup -->
  <staff-popup
    show="{{showStaffPopup}}"
    staff-list="{{staffList}}"
    selected-id="{{selectedStaffWfId}}"
    bind:select="onStaffSelect"
    bind:close="onCloseStaffPopup"
  />

</view>
