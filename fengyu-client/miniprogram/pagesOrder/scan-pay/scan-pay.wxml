<!-- pages/scan-pay/scan-pay.wxml — 扫码收款（员工端开单后客户扫码） -->
<wxs module="fmt">
module.exports.price = function(n) { return (Math.round(n * 100) / 100).toFixed(2) }
module.exports.cents = function(n) { return Math.round(n * 100) }
</wxs>
<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<view class="container">

  <!-- 加载中 -->
  <view wx:if="{{isLoading}}" class="loading-wrap">
    <van-loading size="60rpx" color="#C0322A" />
    <text class="loading-text">正在加载订单信息...</text>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{errorMsg}}" class="error-wrap">
    <van-icon name="warning-o" size="120rpx" color="#FF4D4F" />
    <text class="error-title">无法获取订单</text>
    <text class="error-desc">{{errorMsg}}</text>
    <van-button type="default" size="normal" round bindtap="onBackHome">返回首页</van-button>
  </view>

  <!-- 非待支付状态提示 -->
  <view wx:elif="{{statusMsg}}" class="error-wrap">
    <van-icon name="info-o" size="120rpx" color="#C0322A" />
    <text class="error-title">订单提示</text>
    <text class="error-desc">{{statusMsg}}</text>
    <van-button type="default" size="normal" round bindtap="onBackHome">返回首页</van-button>
  </view>

  <!-- 订单展示 -->
  <view wx:elif="{{order}}" class="order-wrap">

    <!-- 门店 + 开单人 + 状态 -->
    <view class="order-header">
      <view class="order-header-left">
        <text class="order-store">{{order.storeName}}</text>
        <text wx:if="{{order.openerName}}" class="order-opener">开单人：{{order.openerName}}</text>
      </view>
      <van-tag type="primary">{{order.status}}</van-tag>
    </view>

    <!-- 商品明细 -->
    <view class="items-section">
      <view
        wx:for="{{items}}"
        wx:key="saleItemId"
        class="order-item"
      >
        <image
          wx:if="{{item.coverImage}}"
          class="item-cover"
          src="{{item.coverImage}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="item-cover item-cover--empty">
          <van-icon name="photo-o" size="32rpx" color="#CCC" />
        </view>
        <view class="item-info">
          <text class="item-name">{{item.productName}}</text>
        </view>
        <text class="item-price">¥{{fmt.price(item.unitPrice)}}</text>
      </view>
    </view>

    <!-- 合计 -->
    <view class="order-total">
      <text class="total-label">订单总额</text>
      <view class="total-amount">
        <text class="total-symbol">¥</text>
        <text class="total-value">{{fmt.price(order.totalAmount)}}</text>
      </view>
    </view>

    <!-- 抵扣区：储值卡（与优惠券并列；优惠券暂只展示，不可改）。回款场景隐藏：储值卡由店员先扣 -->
    <view wx:if="{{!isRepayment}}" class="deduction-section">
      <view class="deduction-section__title">抵扣</view>

      <view wx:if="{{couponDiscount > 0}}" class="deduction-row">
        <view class="deduction-row__left">
          <text class="deduction-row__name">优惠券</text>
          <text class="deduction-row__hint">店长已选用</text>
        </view>
        <text class="deduction-row__amount">-¥{{fmt.price(couponDiscount)}}</text>
      </view>

      <view class="deduction-row">
        <view class="deduction-row__left">
          <text class="deduction-row__name">储值卡</text>
          <text wx:if="{{cardBalance > 0}}" class="deduction-row__hint">余额 ¥{{fmt.price(cardBalance)}}</text>
          <text wx:else class="deduction-row__hint deduction-row__hint--disabled">暂无储值卡余额</text>
        </view>
        <view class="deduction-row__right">
          <van-switch
            checked="{{useCard}}"
            disabled="{{cardBalance <= 0}}"
            active-color="#C0322A"
            size="40rpx"
            bind:change="onUseCardChange"
          />
        </view>
      </view>
      <view wx:if="{{useCard && prepaidCardAmount > 0}}" class="deduction-row deduction-row--sub">
        <text class="deduction-row__sub-label">抵扣金额</text>
        <text class="deduction-row__amount">-¥{{fmt.price(prepaidCardAmount)}}</text>
      </view>
      <view wx:if="{{useCard && prepaidCardAmount > 0}}" class="deduction-tips">
        抵扣 ¥{{fmt.price(prepaidCardAmount)}}（不计入实付）
      </view>
    </view>

    <!-- 实付区 -->
    <view class="paid-section">
      <view class="paid-section__row">
        <text class="paid-section__label">实付</text>
        <view class="paid-section__amount">
          <text class="paid-section__symbol">¥</text>
          <text class="paid-section__value">{{fmt.price(paidAmount)}}</text>
        </view>
      </view>
      <!-- 首付提示：admin 设置了 first_payment_amount 且本次扫码为首次（received=0） -->
      <view wx:if="{{isFirstPartialScan}}" class="paid-section__hint">
        本次支付 ¥{{fmt.price(firstPaymentAmount)}}（首付），剩余款项可后续扫码支付
      </view>
      <!-- 回款提示：部分支付订单（已有首付到账，本次付剩余应付） -->
      <view wx:if="{{isRepayment}}" class="paid-section__hint">
        本单已部分支付，本次为回款，支付剩余应付款项
      </view>

      <!-- 支付方式：仅 paid > 0 时展示 -->
      <view wx:if="{{showPayMethodGroup}}" class="pay-method-wrap">
        <van-radio-group value="{{paymentMethod}}" bind:change="onPayMethodChange">
          <van-cell-group inset>
            <van-cell title="微信支付" clickable bindtap="onPayMethodTap" data-method="微信">
              <van-icon slot="icon" name="wechat-pay" size="40rpx" color="#07C160" style="margin-right:16rpx" />
              <van-radio slot="right-icon" name="微信" />
            </van-cell>
            <van-cell title="支付宝" clickable bindtap="onPayMethodTap" data-method="支付宝">
              <van-icon slot="icon" name="alipay" size="40rpx" color="#1677FF" style="margin-right:16rpx" />
              <van-radio slot="right-icon" name="支付宝" />
            </van-cell>
            <van-cell wx:if="{{!isRepayment}}" title="线下付款" label="到店后现场付款" clickable bindtap="onPayMethodTap" data-method="线下">
              <van-icon slot="icon" name="balance-o" size="40rpx" color="#C0322A" style="margin-right:16rpx" />
              <van-radio slot="right-icon" name="线下" />
            </van-cell>
          </van-cell-group>
        </van-radio-group>
      </view>
      <view wx:else class="paid-section__hint">全额抵扣，无需选择支付方式</view>
    </view>

    <!-- 底部确认 -->
    <van-submit-bar
      price="{{fmt.cents(paidAmount)}}"
      button-text="{{paidAmount === 0 ? '确认抵扣' : (paymentMethod === '微信' ? '微信支付' : '确认付款')}}"
      loading="{{submitting}}"
      bind:submit="onSubmit"
      safe-area-inset-bottom
    />

  </view>

</view>

<!-- 支付宝吱口令弹窗（聚合主扫 share_code 方案）-->
<van-popup
  show="{{showAlipayShare}}"
  round
  closeable
  close-on-click-overlay="{{false}}"
  bind:close="onAlipayShareClose"
>
  <view class="alipay-qr-popup">
    <view class="alipay-qr-popup__title">支付宝吱口令</view>
    <view class="alipay-qr-popup__amount">
      <text class="alipay-qr-popup__symbol">¥</text>
      <text class="alipay-qr-popup__price">{{alipayAmount}}</text>
    </view>
    <view class="alipay-share-token" selectable="true">{{alipayShareToken}}</view>
    <view class="alipay-qr-popup__tips">复制吱口令 → 打开支付宝 App → 自动识别后完成支付</view>
    <van-button type="primary" block round custom-class="alipay-qr-popup__btn" bindtap="onAlipayShareCopy">复制吱口令</van-button>
    <van-button type="default" block round custom-class="alipay-qr-popup__btn" bindtap="onAlipayShareDone">我已完成支付</van-button>
  </view>
</van-popup>
