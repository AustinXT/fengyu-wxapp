<!-- pages/order-detail/order-detail.wxml — 订单详情 -->
<van-toast id="van-toast" />

<view class="container" wx:if="{{!isLoading}}">

  <!-- 状态大图区 -->
  <view class="status-hero">
    <van-icon name="{{statusIcon}}" size="80rpx" color="{{statusIconColor}}" />
    <text class="status-label">{{order.status}}</text>
    <text class="status-hint" wx:if="{{order.status === '待确认收款'}}">请等待店长确认收款</text>
    <block wx:elif="{{order.status === '待支付'}}">
      <text class="status-hint-countdown" wx:if="{{countdown}}">请在 {{order.expire_time_fmt}} 前完成支付（剩余 {{countdown}}）</text>
      <text class="status-hint" wx:else>请完成支付</text>
    </block>
  </view>

  <!-- 订单基础信息 -->
  <van-cell-group title="订单信息" inset>
    <van-cell title="订单编号" value="{{order.order_no}}" />
    <van-cell title="下单时间" value="{{order.order_time_fmt}}" />
    <van-cell title="支付方式" value="{{order.payment_method === 'wechat' ? '微信支付' : '线下付款'}}" />
    <van-cell title="门店" value="{{order.store_name}}" />
    <van-cell
      title="指定美容师"
      value="{{order.preferred_staff_name || '未指定'}}"
      wx:if="{{order.preferred_employee_id}}"
    />
    <van-cell title="购买产品" label=" ">
      <view slot="right-icon" class="cell-products">
        <view wx:for="{{order.items}}" wx:key="item_flow_no" class="cell-product-row">
          <text>{{item.spu_name}} ×{{item.quantity}}</text>
        </view>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 服务明细 -->
  <view class="section-wrap">
    <view class="section-title">服务明细</view>
    <view class="items-card">
      <view
        wx:for="{{order.items}}"
        wx:key="item_flow_no"
        class="order-item"
      >
        <view class="order-item__main">
          <view class="order-item__info">
            <text class="oi-name">{{item.spu_name}}</text>
            <text class="oi-spec">{{item.sku_display_name}}</text>
            <text class="oi-qty">×{{item.quantity}}</text>
          </view>
          <view class="order-item__right">
            <text class="oi-price">¥{{item.receivable}}</text>
            <view class="oi-sessions" wx:if="{{item.remaining_sessions !== null}}">
              <text class="oi-sessions-text">剩余 {{item.remaining_sessions}}/{{item.session_count}} 次</text>
            </view>
            <van-tag color="#F0FAF0" text-color="#389E0D" wx:if="{{item.product_type === '院装产品'}}">已交付</van-tag>
          </view>
        </view>
        <view class="oi-expire" wx:if="{{item.expire_date}}">
          <van-icon name="clock-o" size="24rpx" color="#B09880" />
          <text class="oi-expire-text">有效期至 {{item.expire_date}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 金额汇总 -->
  <van-cell-group title="金额明细" inset>
    <van-cell title="商品总价" value="¥{{order.total_amount}}" />
    <van-cell title="优惠" value="- ¥0.00" />
    <van-cell title="实付" class="total-cell">
      <view slot="right-icon" class="total-price-wrap">
        <text class="total-symbol">¥</text>
        <text class="total-amount">{{order.total_amount}}</text>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 操作区 -->
  <view class="actions-wrap safe-area-bottom">
    <!-- 待支付：去支付 + 取消订单 -->
    <view class="actions-row" wx:if="{{order.status === '待支付'}}">
      <van-button
        type="default"
        block
        round
        size="large"
        bindtap="onCancel"
        class="cancel-btn"
      >取消订单</van-button>
      <van-button
        type="primary"
        block
        round
        size="large"
        bindtap="onPay"
        class="pay-btn"
      >去支付</van-button>
    </view>

    <!-- 已支付且有疗程卡：发起预约 -->
    <van-button
      wx:if="{{order.status === '已支付' && hasAppointableItems}}"
      type="primary"
      block
      round
      size="large"
      bindtap="onCreateAppointment"
    >发起预约</van-button>

    <!-- 终态：返回首页 -->
    <van-button
      wx:if="{{order.status === '已完成' || order.status === '已关闭' || order.status === '支付失败' || order.status === '待确认收款' || (order.status === '已支付' && !hasAppointableItems)}}"
      type="primary"
      block
      round
      plain
      size="large"
      custom-style="color:#C0322A;border-color:#C0322A;"
      bindtap="onBackToHome"
    >返回首页</van-button>
  </view>

</view>

<!-- 骨架屏 -->
<view wx:else class="skeleton-wrap">
  <van-skeleton title row="6" />
</view>
