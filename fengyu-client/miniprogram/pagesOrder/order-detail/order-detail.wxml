<!-- pages/order-detail/order-detail.wxml — 订单详情 -->
<wxs module="fmt">
module.exports.price = function(n) { return (Math.round(n * 100) / 100).toFixed(2) }
</wxs>
<van-toast id="van-toast" />

<view class="container" wx:if="{{!isLoading}}">

  <!-- 状态大图区 -->
  <view class="status-hero">
    <van-icon name="{{statusIcon}}" size="80rpx" color="{{statusIconColor}}" />
    <view class="status-label-row">
      <text class="status-label">{{order.status}}</text>
      <!-- 2026-04-26 sale-order-domain-refactor: 已退款标签由 refunded_amount > 0 推导 -->
      <view wx:if="{{order.has_refund}}" class="refund-tag">
        <van-tag color="#FFF1F0" text-color="#FF4D4F">已退款 ¥{{order.refunded_fmt}}</van-tag>
      </view>
    </view>
    <text class="status-hint" wx:if="{{order.status === '待支付' && order.payment_method === '线下'}}">请到店付款，等待店长确认收款</text>
    <block wx:elif="{{order.status === '待支付'}}">
      <text class="status-hint-countdown" wx:if="{{countdown}}">请在 {{order.expire_time_fmt}} 前完成支付（剩余 {{countdown}}）</text>
      <text class="status-hint" wx:else>请完成支付</text>
    </block>
  </view>

  <!-- 订单基础信息 -->
  <van-cell-group title="订单信息" inset>
    <van-cell title="订单编号" bindtap="onCopyOrderNo">
      <view slot="right-icon" class="copy-cell-value">
        <text>{{order.sale_order_id}}</text>
        <text class="copy-link">复制</text>
      </view>
    </van-cell>
    <van-cell title="下单时间" value="{{order.order_time_fmt}}" />
    <van-cell title="支付方式" value="{{order.payment_method}}" />
    <van-cell title="门店" value="{{order.store_name}}" />
    <van-cell
      title="指定美容师"
      value="{{order.preferred_staff_name || '未指定'}}"
      wx:if="{{order.preferred_employee_id}}"
    />
    <van-cell title="购买产品" label=" ">
      <view slot="right-icon" class="cell-products">
        <view wx:for="{{order.items}}" wx:key="sale_item_id" class="cell-product-row">
          <text>{{item.product_name}} ×{{item.quantity}}</text>
        </view>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 服务明细 -->
  <view class="section-wrap">
    <view class="section-title">服务明细</view>
    <view class="items-card">
      <view
        wx:for="{{order.items}}"
        wx:key="sale_item_id"
        class="order-item"
      >
        <view class="order-item__main">
          <image
            wx:if="{{item.cover_image}}"
            class="oi-cover"
            src="{{item.cover_image}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="oi-cover oi-cover--empty">
            <van-icon name="photo-o" size="36rpx" color="#CCC" />
          </view>
          <view class="order-item__info">
            <text class="oi-name">{{item.product_name}}</text>
            <text class="oi-spec">{{item.sku_spec_name}}</text>
            <text class="oi-qty">×{{item.quantity}}</text>
          </view>
          <view class="order-item__right">
            <text class="oi-price">¥{{fmt.price(item.sale_amount)}}</text>
            <view class="oi-sessions" wx:if="{{item.remaining_sessions !== null}}">
              <text class="oi-sessions-text">已用 {{item.used_sessions}} / 已付 {{item.paid_sessions}} / 共 {{item.session_count}} 次</text>
              <!-- 三段进度条：已用(浅灰) + 已付未用(主色) + 未付(斜纹) -->
              <view class="oi-progress">
                <view class="oi-progress__seg oi-progress__seg--used" style="width: {{item.used_pct}}%"></view>
                <view class="oi-progress__seg oi-progress__seg--paid-unused" style="width: {{item.paid_unused_pct}}%"></view>
                <view class="oi-progress__seg oi-progress__seg--unpaid" style="width: {{item.unpaid_pct}}%"></view>
              </view>
            </view>
            <van-tag color="#F0FAF0" text-color="#389E0D" wx:if="{{item.product_type === '家居产品'}}">已交付</van-tag>
          </view>
        </view>
        <view class="oi-expire" wx:if="{{item.expire_date}}">
          <van-icon name="clock-o" size="24rpx" color="#B09880" />
          <text class="oi-expire-text">有效期至 {{item.expire_date}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 金额汇总 -->
  <van-cell-group title="金额明细" inset>
    <van-cell
      title="商品总价"
      value="¥{{fmt.price(order.coupon_discount > 0 ? order.total_amount * 1 + order.coupon_discount * 1 : order.total_amount)}}"
    />
    <van-cell
      wx:if="{{order.coupon_id}}"
      title="优惠券"
      label="{{order.coupon_name || ''}}"
      value="-¥{{fmt.price(order.coupon_discount)}}"
      value-class="coupon-discount-value"
    />
    <van-cell wx:else title="优惠" value="- ¥0.00" />
    <van-cell title="实付" class="total-cell">
      <view slot="right-icon" class="total-price-wrap">
        <text class="total-symbol">¥</text>
        <text class="total-amount">{{fmt.price(order.total_amount)}}</text>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 收款记录（只读，payments 为空时不渲染） -->
  <view class="section-wrap" wx:if="{{payments.length > 0}}">
    <view class="section-title">收款记录</view>
    <view class="items-card">
      <view
        wx:for="{{payments}}"
        wx:key="time_fmt"
        wx:for-item="p"
        class="pay-row"
      >
        <view class="pay-row__left">
          <text class="pay-type">{{p.change_type}}</text>
          <text class="pay-meta">{{p.time_fmt}} · {{p.payment_method}}</text>
          <text wx:if="{{p.is_refund && p.refund_reason}}" class="pay-note">退款原因：{{p.refund_reason}}</text>
          <text wx:elif="{{p.note}}" class="pay-note">{{p.note}}</text>
        </view>
        <view class="pay-row__right">
          <text class="pay-amount {{p.is_refund ? 'pay-amount--refund' : ''}}">
            {{p.is_refund ? '退 -¥' : '¥'}}{{p.amount_abs_fmt}}
          </text>
          <text class="pay-status" wx:if="{{p.status !== '已支付'}}">{{p.status}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 欠款提示（部分支付时） -->
  <view
    class="outstanding-wrap"
    wx:if="{{continuePayEnabled && order.status === '部分支付' && outstandingAmount > 0}}"
  >
    <view class="outstanding-row">
      <text class="outstanding-label">待付金额</text>
      <text class="outstanding-value">¥{{order.outstanding_fmt}}</text>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="actions-wrap safe-area-bottom">

    <!-- 待支付：取消订单 + 去支付 -->
    <view class="actions-row" wx:if="{{order.status === '待支付'}}">
      <van-button
        type="default"
        block
        round
        size="normal"
        bindtap="onCancel"
        class="cancel-btn"
      >取消订单</van-button>
      <van-button
        type="primary"
        block
        round
        size="normal"
        bindtap="onPay"
        class="pay-btn"
      >去支付</van-button>
    </view>

    <!-- 部分支付：继续支付（灰度开关开启时显示） -->
    <view
      class="actions-row"
      wx:elif="{{continuePayEnabled && order.status === '部分支付' && outstandingAmount > 0}}"
    >
      <van-button
        type="primary"
        block
        round
        size="normal"
        bindtap="onContinuePayTap"
        class="pay-btn"
      >继续支付 ¥{{order.outstanding_fmt}}</van-button>
    </view>

    <!-- 已支付：发起预约（有可预约项）+ 查看疗程卡 -->
    <view wx:elif="{{order.status === '已支付'}}">
      <view wx:if="{{hasAppointableItems}}" class="actions-row">
        <van-button
          type="primary"
          block
          round
          size="normal"
          bindtap="onCreateAppointment"
          class="appt-btn"
        >发起预约</van-button>
        <van-button
          type="primary"
          block
          round
          plain
          size="normal"
          custom-style="color:#C0322A;border-color:#C0322A;"
          bindtap="onViewTreatmentCards"
          class="treatment-btn"
        >查看疗程卡</van-button>
      </view>
      <van-button
        wx:else
        type="primary"
        block
        round
        plain
        size="normal"
        custom-style="color:#C0322A;border-color:#C0322A;"
        bindtap="onViewTreatmentCards"
      >查看疗程卡</van-button>
    </view>

    <!-- 终态（已完成/已关闭/支付失败）：返回首页 -->
    <van-button
      wx:else
      type="primary"
      block
      round
      plain
      size="normal"
      custom-style="color:#C0322A;border-color:#C0322A;"
      bindtap="onBackToHome"
    >返回首页</van-button>

  </view>

</view>

<!-- 骨架屏 -->
<view wx:else class="skeleton-wrap">
  <van-skeleton title row="6" />
</view>

<!-- 继续支付弹层 -->
<van-popup
  show="{{repayModalVisible}}"
  position="bottom"
  round
  closeable
  bind:close="onRepayModalClose"
>
  <view class="repay-modal">
    <view class="repay-title">继续支付</view>
    <view class="repay-outstanding">
      <text class="repay-outstanding-label">待付金额</text>
      <text class="repay-outstanding-value">¥{{order.outstanding_fmt}}</text>
    </view>

    <view class="repay-field-label">支付金额</view>
    <van-field
      value="{{repayAmountInput}}"
      type="digit"
      placeholder="请输入支付金额"
      bind:change="onRepayAmountInput"
      border="{{false}}"
      custom-class="repay-amount-input"
    />

    <view class="repay-field-label">支付方式</view>
    <van-radio-group
      value="{{repayMethod}}"
      bind:change="onRepayMethodChange"
    >
      <van-cell-group>
        <van-cell title="微信支付" clickable data-name="微信" bind:click="onRepayMethodChange">
          <van-radio slot="right-icon" name="微信" checked-color="#C0322A" />
        </van-cell>
        <van-cell title="支付宝" clickable data-name="支付宝" bind:click="onRepayMethodChange">
          <van-radio slot="right-icon" name="支付宝" checked-color="#C0322A" />
        </van-cell>
        <van-cell
          title="储值卡"
          label="余额 ¥{{cardBalance}}"
          clickable
          data-name="储值卡"
          bind:click="onRepayMethodChange"
        >
          <van-radio slot="right-icon" name="储值卡" checked-color="#C0322A" disabled="{{cardBalance <= 0}}" />
        </van-cell>
      </van-cell-group>
    </van-radio-group>

    <view class="repay-actions">
      <van-button
        type="primary"
        block
        round
        loading="{{repaySubmitting}}"
        bindtap="onRepayConfirm"
      >确认支付</van-button>
    </view>
  </view>
</van-popup>
