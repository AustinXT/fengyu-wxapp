/* pages/order-detail/order-detail.wxss */

.coupon-discount-value {
  color: var(--color-primary) !important;
  font-weight: 600;
}

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}

.skeleton-wrap {
  padding: 32rpx;
}

/* ===== 状态大图区 ===== */
.status-hero {
  background: var(--color-bg-card);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.status-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.copy-cell-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.copy-link {
  color: var(--color-primary);
  font-size: 24rpx;
}

.status-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.status-hint-countdown {
  font-size: 26rpx;
  color: var(--color-error);
  font-weight: 600;
}

/* ===== 订单信息-购买产品 ===== */
.cell-products {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.cell-product-row {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ===== 服务明细区 ===== */
.section-wrap {
  margin: 0 24rpx 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 16rpx 8rpx 12rpx;
  letter-spacing: 1rpx;
}

.items-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}

.order-item {
  padding: 24rpx 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.order-item:last-child {
  border-bottom: none;
}

.order-item__main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.oi-cover {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.oi-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-section);
}

.order-item__info {
  flex: 1;
}

.oi-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.oi-spec {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.oi-qty {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.order-item__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.oi-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.oi-sessions-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.oi-expire {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
}

.oi-expire-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* ===== 金额合计 ===== */
.total-cell {
  border-top: 1px solid var(--color-border) !important;
}

.total-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.total-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.total-amount {
  font-size: 40rpx;
  font-weight: 700;
}

/* ===== 操作区 ===== */
.actions-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1px solid var(--color-border);
}

.actions-row {
  display: flex;
  gap: 24rpx;
}

.cancel-btn {
  flex: 1;
}

.pay-btn {
  flex: 2;
}
