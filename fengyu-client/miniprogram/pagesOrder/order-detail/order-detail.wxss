

.coupon-discount-value {
  color: var(--color-primary) !important;
  font-weight: 600;
}

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}

.skeleton-wrap {
  padding: 32rpx;
}


.status-hero {
  background: var(--color-bg-card);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.status-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.copy-cell-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.copy-link {
  color: var(--color-primary);
  font-size: 24rpx;
}

.status-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.status-hint-countdown {
  font-size: 26rpx;
  color: var(--color-error);
  font-weight: 600;
}


.status-hint--confirming {
  color: var(--color-primary);
  font-weight: 600;
  animation: fy-confirm-pulse 1.2s ease-in-out infinite;
}
@keyframes fy-confirm-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}


.cell-products {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.cell-product-row {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}


.section-wrap {
  margin: 0 24rpx 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 16rpx 8rpx 12rpx;
  letter-spacing: 1rpx;
}

.items-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}

.order-item {
  padding: 24rpx 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.order-item:last-child {
  border-bottom: none;
}

.order-item__main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.oi-cover {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.oi-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-section);
}

.order-item__info {
  flex: 1;
}

.oi-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.oi-spec {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.oi-qty {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.order-item__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.oi-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.oi-sessions-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}


.oi-progress {
  display: flex;
  height: 8rpx;
  width: 220rpx;
  margin-top: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: var(--color-border);
}
.oi-progress__seg {
  height: 100%;
}
.oi-progress__seg--used {
  background: #B0B0B0;
}
.oi-progress__seg--paid-unused {
  background: var(--color-primary);
}
.oi-progress__seg--unpaid {
  background: repeating-linear-gradient(
    45deg,
    #F0F0F0,
    #F0F0F0 4rpx,
    #E4E4E4 4rpx,
    #E4E4E4 8rpx
  );
}

.oi-expire {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
}

.oi-expire-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}


.total-cell {
  border-top: 1px solid var(--color-border) !important;
}

.total-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.total-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.total-amount {
  font-size: 40rpx;
  font-weight: 700;
}


.actions-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1px solid var(--color-border);
}

.actions-row {
  display: flex;
  gap: 24rpx;
}

.cancel-btn {
  flex: 1;
}

.pay-btn {
  flex: 2;
}

.appt-btn,
.treatment-btn {
  flex: 1;
}


.pay-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.pay-row:last-child {
  border-bottom: none;
}

.pay-row__left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.pay-type {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.pay-meta {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.pay-note {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.pay-row__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.pay-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.pay-amount--refund {
  color: var(--color-primary);
}

.pay-status {
  font-size: 22rpx;
  color: var(--color-text-hint);
}


.outstanding-wrap {
  margin: 0 24rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
}

.outstanding-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.outstanding-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.outstanding-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}


.repay-modal {
  padding: 40rpx 32rpx 48rpx;
}

.repay-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 24rpx;
}

.repay-outstanding {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 24rpx 32rpx;
  background: var(--color-primary-light);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.repay-outstanding-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.repay-outstanding-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.repay-field-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 16rpx 8rpx 8rpx;
}

.repay-amount-input {
  border: 1px solid var(--color-border);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.repay-actions {
  margin-top: 40rpx;
}
