
<wxs module="fmt">
module.exports.price = function(n) { return (Math.round(n * 100) / 100).toFixed(2) }
</wxs>
<van-toast id="van-toast" />

<view class="container">

  <van-tabs
    active="{{activeTab}}"
    bind:change="onTabChange"
    sticky
    title-inactive-color="#7A6553"
    swipeable
  >
    <van-tab title="全部"   name="all" />
    <van-tab title="待支付" name="待支付" />
    <van-tab title="已支付" name="已支付" />
    <van-tab title="已完成" name="已完成" />
  </van-tabs>

  
  <view wx:if="{{isLoading}}" class="skeleton-list">
    <van-skeleton title row="4" />
    <van-skeleton title row="4" style="margin-top:24rpx" />
  </view>

  
  <view wx:elif="{{loadError}}" class="empty-wrap">
    <van-empty image="error" description="加载失败，下拉刷新重试" />
  </view>

  
  <view wx:elif="{{list.length === 0}}" class="empty-wrap">
    <van-empty description="暂无订单" />
  </view>

  
  <view wx:else class="list-wrap">
    <view
      wx:for="{{list}}"
      wx:key="sale_order_id"
      class="order-card"
      bindtap="onOrderTap"
      data-sale-order-id="{{item.sale_order_id}}"
    >
      
      <view class="order-card__header">
        <view class="order-header-left">
          <view class="order-no-row">
            <text class="order-no">{{item.sale_order_id}}</text>
            
            <view wx:if="{{item.has_refund}}" class="order-refund-tag">
              <van-tag color="#FFF1F0" text-color="#FF4D4F" size="medium">已退款</van-tag>
            </view>
          </view>
          <text class="order-time">{{item.order_time_fmt}}</text>
        </view>
        <text class="order-status {{item.statusClass}}">{{item.status}}</text>
      </view>

      
      <view class="order-items">
        
        <view wx:if="{{item.isRecharge}}" class="recharge-row">
          <view class="recharge-icon">
            <van-icon name="gift-o" size="44rpx" color="#FFF" />
          </view>
          <view class="recharge-meta">
            <text class="recharge-title">充值卡充值</text>
            <text class="recharge-sub">¥{{fmt.price(item.total_amount)}} · {{item.store_name || '凤御美容'}}</text>
          </view>
        </view>

        
        <block wx:else>
          <view wx:for="{{item.items}}" wx:key="sale_item_id" wx:for-item="oi" class="order-item-row">
            <image
              wx:if="{{oi.cover_image}}"
              class="oi-cover"
              src="{{oi.cover_image}}"
              mode="aspectFill"
              lazy-load
            />
            <view wx:else class="oi-cover oi-cover--empty">
              <van-icon name="photo-o" size="32rpx" color="#CCC" />
            </view>
            <view class="oi-info">
              <view class="oi-top">
                <text class="oi-name">{{oi.product_name || '—'}}</text>
                <text class="oi-qty">×{{oi.quantity}}</text>
              </view>
              <view class="oi-bottom">
                <view wx:if="{{oi.remaining_sessions !== null}}" class="oi-sessions">
                  <text class="oi-sessions-text">已用 {{oi.used_sessions}} / 已付 {{oi.paid_sessions}} / 共 {{oi.session_count}} 次</text>
                </view>
                <view wx:else />
                <text class="oi-price">¥{{fmt.price(oi.sale_amount)}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      
      <view class="order-card__footer">
        <text class="order-count">{{item.isRecharge ? '充值卡' : ('共 ' + item.itemCount + ' 件')}}</text>
        <view class="order-amount-wrap">
          <text class="order-amount-label">合计</text>
          <text class="order-amount">¥{{fmt.price(item.total_amount)}}</text>
        </view>
      </view>

      
      <view wx:if="{{item.isPartialPay}}" class="order-outstanding-row">
        <text class="order-outstanding-label">待付</text>
        <text class="order-outstanding-value">¥{{item.outstanding_fmt}}</text>
      </view>

      
      <view class="order-card__actions" wx:if="{{item.status === '待支付'}}">
        <van-button size="small" plain round catch:tap="onCancelTap" data-sale-order-id="{{item.sale_order_id}}">取消订单</van-button>
        <van-button size="small" type="primary" round catch:tap="onPayTap" data-sale-order-id="{{item.sale_order_id}}">去支付</van-button>
      </view>
      <view class="order-card__actions" wx:elif="{{item.status === '部分支付'}}">
        <van-button size="small" type="primary" round catch:tap="onContinuePayTap" data-sale-order-id="{{item.sale_order_id}}">继续支付 ¥{{item.outstanding_fmt}}</van-button>
      </view>
      <view class="order-card__actions" wx:elif="{{item.status === '已支付' && item.hasAppointable}}">
        <van-button size="small" type="primary" round catch:tap="onAppointmentTap" data-sale-order-id="{{item.sale_order_id}}">发起预约</van-button>
      </view>
      <view class="order-card__actions" wx:elif="{{item.status === '已完成' || item.status === '已关闭'}}">
        <van-button size="small" plain round catch:tap="onOrderTap" data-sale-order-id="{{item.sale_order_id}}">查看详情</van-button>
      </view>

    </view>

    
    <view class="list-footer">
      <van-loading wx:if="{{loadingMore}}" size="24px" color="#C0322A">加载中...</van-loading>
      <text wx:elif="{{!hasMore}}" class="list-footer__end">没有更多订单了</text>
    </view>
  </view>

</view>
