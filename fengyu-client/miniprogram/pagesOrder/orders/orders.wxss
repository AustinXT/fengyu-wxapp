/* pages/orders/orders.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.skeleton-list {
  padding: 32rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

/* ===== 列表 ===== */
.list-wrap {
  padding: 24rpx 24rpx 40rpx;
}

/* ===== 订单卡片 ===== */
.order-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.order-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1px solid var(--color-border);
}

.order-header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-no-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

/* 状态颜色 — 复用 app.wxss .status-* 全局类 */

/* ===== 商品明细 ===== */
.order-items {
  padding: 16rpx 28rpx;
}

.order-item-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1px solid var(--color-border);
}

.order-item-row:last-child {
  border-bottom: none;
}

.oi-cover {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.oi-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-section);
}

.oi-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.oi-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.oi-name {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oi-qty {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.oi-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.oi-sessions-text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.oi-price {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ===== 底部区 ===== */
.order-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  border-top: 1px solid var(--color-border);
}

.order-time {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.order-amount-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.order-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.order-amount-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.order-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ===== 操作区 ===== */
.order-card__actions {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 24rpx 20rpx;
  gap: 16rpx;
  border-top: 1px solid var(--color-border);
}

/* 列表底部样式复用 app.wxss .list-footer */
