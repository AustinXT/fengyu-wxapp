<!-- pages/checkout/checkout.wxml — 下单确认 + 支付 -->
<wxs module="price">
module.exports.fmt = function(val) {
  return (Math.round(val * 100) / 100).toFixed(2)
}
module.exports.cents = function(val) {
  return Math.round(val * 100)
}
module.exports.date = function(s) {
  return s ? s.slice(0, 10) : ''
}
</wxs>
<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<view class="container">

  <!-- 商品明细 -->
  <van-cell-group title="商品明细" inset>
    <view class="checkout-items">
      <view wx:for="{{displayItems}}" wx:key="skuId" class="checkout-item">
        <image
          wx:if="{{item.coverImage}}"
          src="{{item.coverImage}}"
          class="checkout-item__cover"
          mode="aspectFill"
        />
        <view wx:else class="checkout-item__cover checkout-item__cover--empty" />
        <view class="checkout-item__info">
          <text class="checkout-item__name">{{item.spuName}}</text>
          <text class="checkout-item__spec" wx:if="{{item.skuDisplayName}}">{{item.skuDisplayName}}</text>
          <view class="checkout-item__meta">
            <text class="checkout-item__price">¥{{price.fmt(item.price)}}</text>
            <text class="checkout-item__qty">×{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
    <van-cell
      title="指定美容师"
      value="{{staffName || '不指定'}}"
      is-link
      bindtap="onSelectStaff"
    />
    <van-cell title="门店" value="{{storeName}}" />
  </van-cell-group>

  <!-- 支付方式 -->
  <van-cell-group title="支付方式" inset>
    <van-radio-group value="{{paymentMethod}}" bind:change="onPayMethodChange">
      <van-cell title="微信支付" clickable bindtap="onPayMethodTap" data-method="wechat">
        <van-icon slot="icon" name="wechat-pay" size="40rpx" color="#07C160" style="margin-right:16rpx" />
        <van-radio slot="right-icon" name="wechat" />
      </van-cell>
      <van-cell title="支付宝" label="使用支付宝扫码付款" clickable bindtap="onPayMethodTap" data-method="alipay">
        <image slot="icon" src="/images/alipay-icon.png" class="pay-icon" mode="aspectFit" />
        <van-radio slot="right-icon" name="alipay" />
      </van-cell>
      <van-cell title="线下付款" label="到店后现场付款" clickable bindtap="onPayMethodTap" data-method="offline">
        <van-icon slot="icon" name="balance-o" size="40rpx" color="#C0322A" style="margin-right:16rpx" />
        <van-radio slot="right-icon" name="offline" />
      </van-cell>
    </van-radio-group>
  </van-cell-group>

  <!-- 价格明细 -->
  <van-cell-group title="价格明细" inset>
    <van-cell title="{{fromCart ? '商品合计' : '服务单价'}}" value="¥{{price.fmt(unitPrice)}}" />
    <van-cell wx:if="{{!fromCart && quantity > 1}}" title="数量" value="x{{quantity}}" />
    <!-- 优惠券选择（扫码场景不展示） -->
    <van-cell
      wx:if="{{!existingOrderNo}}"
      title="优惠券"
      is-link
      bindtap="onSelectCoupon"
      value="{{selectedCoupon ? '-¥' + price.fmt(couponDiscount) : '去选择'}}"
      value-class="{{selectedCoupon ? 'coupon-selected-value' : 'coupon-unselected-value'}}"
    />
    <van-cell wx:else title="优惠" value="{{couponDiscount > 0 ? '-¥' + price.fmt(couponDiscount) : '- ¥0.00'}}" value-class="{{couponDiscount > 0 ? 'coupon-selected-value' : ''}}" />
    <van-cell title="实付" class="total-row">
      <view slot="right-icon" class="total-amount">
        <text class="total-symbol">¥</text>
        <text class="total-value">{{price.fmt((fromCart ? totalPrice : (unitPrice * quantity)) - couponDiscount)}}</text>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 消费协议 -->
  <van-cell-group title="消费协议" inset>
    <van-cell>
      <view slot="title" class="agreement-row">
        <van-checkbox
          value="{{agreed}}"
          shape="round"
          bind:change="onAgreementChange"
        >
          <text class="agreement-text">我已阅读并同意</text>
          <text class="agreement-link" bindtap="onViewAgreement">《服务消费协议》</text>
        </van-checkbox>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 底部提交 -->
  <van-submit-bar
    wx:if="{{!showPhoneBind}}"
    price="{{price.cents((fromCart ? totalPrice : unitPrice * quantity) - couponDiscount)}}"
    button-text="{{paymentMethod === 'wechat' ? '微信支付' : paymentMethod === 'alipay' ? '支付宝付款' : '提交订单'}}"
    loading="{{submitting}}"
    disabled="{{!agreed || submitting}}"
    tip="{{!agreed ? '请先同意消费协议' : false}}"
    bind:submit="onSubmitOrder"
    safe-area-inset-bottom
  />

  <!-- 需要绑定手机号时替换提交栏 -->
  <view wx:if="{{showPhoneBind}}" class="phone-bind-bar">
    <button
      class="phone-bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >绑定手机号并下单</button>
  </view>

</view>


<!-- 支付宝二维码弹窗 -->
<van-popup
  show="{{showAlipayQr}}"
  round
  closeable
  close-on-click-overlay="{{false}}"
  bind:close="onAlipayClose"
>
  <view class="alipay-qr-popup">
    <view class="alipay-qr-popup__title">请使用支付宝扫码付款</view>
    <image src="{{alipayQrUrl}}" mode="widthFix" class="alipay-qr-popup__image" />
    <view class="alipay-qr-popup__amount">
      <text class="alipay-qr-popup__symbol">¥</text>
      <text class="alipay-qr-popup__price">{{alipayAmount}}</text>
    </view>
    <view class="alipay-qr-popup__tips">长按保存图片，打开支付宝扫码支付</view>
    <van-button type="primary" block round custom-class="alipay-qr-popup__btn" bindtap="onAlipayDone">我已完成支付</van-button>
  </view>
</van-popup>

<!-- 优惠券选择 Popup -->
<van-popup
  show="{{showCouponPopup}}"
  position="bottom"
  round
  closeable
  bind:close="onCloseCouponPopup"
>
  <view class="coupon-popup">
    <view class="coupon-popup__title">选择优惠券</view>
    <view wx:if="{{couponsLoading}}" class="coupon-popup__loading">
      <van-loading size="48rpx" />
    </view>
    <view wx:elif="{{availableCoupons.length === 0}}" class="coupon-popup__empty">
      <text>暂无可用优惠券</text>
    </view>
    <scroll-view wx:else scroll-y class="coupon-popup__list">
      <view
        wx:for="{{availableCoupons}}"
        wx:key="couponId"
        class="coupon-popup__item {{selectedCoupon.couponId === item.couponId ? 'coupon-popup__item--active' : ''}}"
        bindtap="onCouponPick"
        data-coupon-id="{{item.couponId}}"
        data-name="{{item.name}}"
        data-discount="{{item.discount}}"
      >
        <view class="coupon-popup__item-left">
          <text class="coupon-popup__item-discount">¥{{price.fmt(item.discount)}}</text>
          <text class="coupon-popup__item-type">{{item.couponType}}</text>
        </view>
        <view class="coupon-popup__item-right">
          <text class="coupon-popup__item-name">{{item.name}}</text>
          <text class="coupon-popup__item-desc">{{item.description || ''}}</text>
          <text class="coupon-popup__item-expire">有效期至 {{price.date(item.expireAt)}}</text>
        </view>
        <van-icon wx:if="{{selectedCoupon.couponId === item.couponId}}" name="success" color="#C0322A" size="40rpx" />
      </view>
    </scroll-view>
    <view class="coupon-popup__footer">
      <van-button wx:if="{{selectedCoupon}}" plain size="small" bindtap="onClearCoupon">不使用优惠券</van-button>
    </view>
  </view>
</van-popup>

<!-- 美容师选择 Popup -->
<staff-popup
  show="{{showStaffPopup}}"
  staff-list="{{staffList}}"
  selected-id="{{staffWfId}}"
  bind:select="onStaffSelect"
  bind:close="onCloseStaffPopup"
/>
