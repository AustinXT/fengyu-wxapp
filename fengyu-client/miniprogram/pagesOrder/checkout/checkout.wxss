/* pages/checkout/checkout.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 160rpx;
}

/* 消费协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.agreement-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 价格合计行 */
.total-row {
  border-top: 1px solid var(--color-border);
}

.total-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.total-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.total-value {
  font-size: 40rpx;
  font-weight: 700;
}

/* ===== 手机号绑定底栏 ===== */
.phone-bind-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.phone-bind-btn {
  width: 100%;
  height: 88rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: 44rpx;
  line-height: 88rpx;
}

.phone-bind-btn::after {
  border: none;
}

/* ===== 支付宝二维码弹窗 ===== */
.pay-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.alipay-qr-popup {
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.alipay-qr-popup__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
}

.alipay-qr-popup__image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  margin-bottom: 24rpx;
}

.alipay-qr-popup__amount {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.alipay-qr-popup__symbol {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.alipay-qr-popup__price {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.alipay-qr-popup__tips {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 40rpx;
}

.alipay-qr-popup__btn {
  width: 100% !important;
}

/* ===== 美容师选择 Popup ===== */
.staff-popup {
  padding-bottom: env(safe-area-inset-bottom);
}

.staff-popup__title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 32rpx 0 20rpx;
}

.staff-list {
  display: flex;
  overflow-x: auto;
  padding: 16rpx 24rpx 40rpx;
  gap: 24rpx;
}

.staff-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  padding: 16rpx;
  border-radius: 16rpx;
  border: 2px solid transparent;
  min-width: 120rpx;
}

.staff-item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.staff-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #F0EBE4;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.staff-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.staff-title {
  font-size: 20rpx;
  color: var(--color-text-hint);
}
