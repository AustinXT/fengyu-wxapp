/* pages/checkout/checkout.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  /* 留足底部空间：submit-bar (~100rpx) + tip 行 (~70rpx) + 安全区，避免遮挡协议勾选 */
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

/* 底部提交按钮：拉宽 + 不换行，避免"支付宝付款 / 确认支付（已抵扣）"等多字按钮文字溢出 */
.checkout-submit-btn {
  min-width: 240rpx !important;
  padding: 0 28rpx !important;
  white-space: nowrap !important;
}

/* 消费协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.agreement-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 价格合计行 */
.total-row {
  border-top: 1px solid var(--color-border);
}

.total-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.total-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.total-value {
  font-size: 40rpx;
  font-weight: 700;
}

/* ===== 手机号绑定底栏 ===== */
.phone-bind-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.phone-bind-btn {
  width: 100%;
  height: 72rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  border-radius: 36rpx;
  line-height: 72rpx;
}

.phone-bind-btn::after {
  border: none;
}

/* ===== 支付宝二维码弹窗 ===== */
.pay-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.alipay-qr-popup {
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.alipay-qr-popup__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
}

.alipay-qr-popup__image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  background: var(--color-bg-section);
  margin-bottom: 24rpx;
}

.alipay-qr-popup__amount {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.alipay-qr-popup__symbol {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.alipay-qr-popup__price {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.alipay-qr-popup__tips {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 40rpx;
}

.alipay-qr-popup__btn {
  width: 100% !important;
}

/* ===== 优惠券选择 ===== */
.coupon-selected-value {
  color: var(--color-primary) !important;
  font-weight: 600;
}

.coupon-unselected-value {
  color: var(--color-text-hint) !important;
}

.coupon-popup {
  padding-bottom: env(safe-area-inset-bottom);
}

.coupon-popup__title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 32rpx 0 20rpx;
}

.coupon-popup__loading,
.coupon-popup__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  color: var(--color-text-hint);
  font-size: 28rpx;
}

.coupon-popup__list {
  max-height: 600rpx;
  padding: 0 24rpx;
}

.coupon-popup__item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-page);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.coupon-popup__item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.coupon-popup__item-left {
  width: 140rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.coupon-popup__item-discount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.coupon-popup__item-type {
  font-size: 20rpx;
  color: var(--color-primary);
}

.coupon-popup__item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 16rpx;
}

.coupon-popup__item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.coupon-popup__item-desc {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.coupon-popup__item-expire {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.coupon-popup__footer {
  display: flex;
  justify-content: center;
  padding: 20rpx 24rpx;
}

/* ===== 储值卡抵扣区 ===== */
.card-deduction-row {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--color-border);
}

.card-deduction-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-deduction-row__title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.card-deduction-row__balance {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.card-deduction-row__empty {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.card-deduction-row__detail {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.card-deduction-row__amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.card-deduction-row__hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 实付金额段 — 全额抵扣副文案 */
.pay-empty-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 美容师选择 Popup — 复用 app.wxss 全局 .staff-* 样式 */

/* ===== 商品明细列表 ===== */
.checkout-items {
  padding: 8rpx 0;
}

.checkout-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.checkout-item:last-child {
  border-bottom: none;
}

.checkout-item__cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.checkout-item__cover--empty {
  background: var(--color-bg-section);
}

.checkout-item__info {
  flex: 1;
  min-width: 0;
}

.checkout-item__name {
  font-size: 28rpx;
  color: var(--color-text-title);
  font-weight: 500;
  display: block;
  line-height: 1.4;
}

.checkout-item__spec {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 8rpx;
}

.checkout-item__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.checkout-item__price {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.checkout-item__qty {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* van-cell 左侧美容师头像（icon slot） */
.cell-staff-avatar {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.cell-staff-avatar-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}
