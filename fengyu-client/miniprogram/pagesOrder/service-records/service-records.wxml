
<van-toast id="van-toast" />

<view class="container">

  
  <view wx:if="{{isLoading && records.length === 0}}" class="skeleton-wrap">
    <van-skeleton title row="3" />
    <van-skeleton title row="3" style="margin-top:24rpx" />
    <van-skeleton title row="3" style="margin-top:24rpx" />
  </view>

  
  <van-empty
    wx:elif="{{loadError}}"
    image="error"
    description="加载失败，下拉刷新重试"
  />

  
  <van-empty
    wx:elif="{{!isLoading && records.length === 0}}"
    description="暂无服务记录"
  />

  
  <view wx:else class="record-list">
    <view
      wx:for="{{records}}"
      wx:key="service_order_id"
      class="record-card"
    >
      
      <view class="record-header">
        <van-tag
          plain
          color="{{item.statusColor}}"
          custom-class="record-status-tag"
        >{{item.status}}</van-tag>
        <text class="record-date">{{item.dateFmt}}</text>
      </view>

      
      <view class="record-title">{{item.itemSummary || '服务项目'}}</view>

      
      <view class="record-details">
        <view class="record-detail-item" wx:if="{{item.store_name}}">
          <van-icon name="location-o" size="24rpx" color="#999" />
          <text>{{item.store_name}}</text>
        </view>
        <view class="record-detail-item" wx:if="{{item.employee_name}}">
          <van-icon name="contact" size="24rpx" color="#999" />
          <text>{{item.employee_name}}</text>
        </view>
        <view class="record-detail-item" wx:if="{{item.durationFmt}}">
          <van-icon name="clock-o" size="24rpx" color="#999" />
          <text>{{item.durationFmt}}</text>
        </view>
      </view>

      
      <view wx:if="{{item.status === '待客户确认'}}" class="record-confirm">
        <view class="record-confirm-hint">美容师已完成服务，请确认</view>
        <van-button
          size="small"
          type="danger"
          loading="{{confirmingId === item.service_order_id}}"
          data-id="{{item.service_order_id}}"
          bindtap="onConfirmCompletion"
        >确认服务完成</van-button>
      </view>

      
      <view wx:elif="{{item.status === '已完成'}}" class="record-review">
        
        <view wx:if="{{item.reviewed}}" class="review-done">
          <view class="review-done-head">
            <van-rate value="{{item.review_rating}}" readonly size="28rpx" color="#C0322A" void-color="#E8E8E8" />
            <text class="review-done-label">已评价</text>
          </view>
          <view wx:if="{{item.review_comment}}" class="review-done-comment">{{item.review_comment}}</view>
        </view>
        
        <view wx:else class="review-action">
          <van-button
            size="small"
            plain
            type="danger"
            data-id="{{item.service_order_id}}"
            data-name="{{item.employee_name}}"
            bindtap="onTapReview"
          >评价美容师</van-button>
        </view>
      </view>
    </view>

    
    <view wx:if="{{records.length > 0}}" class="list-footer">
      <van-loading wx:if="{{loadingMore}}" size="24px" color="#C0322A">加载中...</van-loading>
      <text wx:elif="{{!hasMore}}" class="list-footer__end">没有更多了</text>
    </view>
  </view>

</view>


<van-popup
  show="{{ reviewVisible }}"
  position="bottom"
  round
  custom-style="padding: 32rpx;"
  bind:close="onReviewClose"
>
  <view class="review-popup">
    <view class="review-popup-title">评价美容师{{ reviewStaffName ? '：' + reviewStaffName : '' }}</view>

    <view class="review-popup-rate">
      <van-rate
        value="{{ reviewRating }}"
        size="48rpx"
        color="#C0322A"
        void-color="#E8E8E8"
        bind:change="onRatingChange"
      />
      <text class="review-popup-rate-hint">{{ reviewRating > 0 ? reviewRating + ' 星' : '请打分' }}</text>
    </view>

    <van-field
      value="{{ reviewComment }}"
      type="textarea"
      placeholder="说说本次服务体验（选填）"
      maxlength="500"
      autosize="{{ { minHeight: 120 } }}"
      border="{{ false }}"
      custom-class="review-popup-field"
      bind:change="onCommentChange"
    />

    <view class="review-popup-actions">
      <van-button block plain bind:tap="onReviewClose">取消</van-button>
      <van-button
        block
        type="danger"
        loading="{{ reviewSubmitting }}"
        disabled="{{ reviewRating < 1 }}"
        bind:tap="onSubmitReview"
      >提交评价</van-button>
    </view>
  </view>
</van-popup>
