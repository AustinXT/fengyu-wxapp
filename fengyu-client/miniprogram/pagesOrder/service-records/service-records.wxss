

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}


.skeleton-wrap {
  padding: 24rpx;
}


.record-list {
  padding: 24rpx;
}

.record-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}


.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 24rpx;
  color: var(--color-text-hint);
}


.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  line-height: 1.4;
}


.record-details {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.record-detail-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}


.record-review {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.record-confirm {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-confirm-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.review-action {
  display: flex;
  justify-content: flex-end;
}

.review-done-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-done-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.review-done-comment {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}


.review-popup {
  display: flex;
  flex-direction: column;
}

.review-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-title);
  text-align: center;
  margin-bottom: 32rpx;
}

.review-popup-rate {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.review-popup-rate-hint {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.review-popup-field {
  background: var(--color-bg-section);
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.review-popup-actions {
  display: flex;
  gap: 24rpx;
}

.review-popup-actions > view,
.review-popup-actions van-button {
  flex: 1;
}


.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--color-text-hint);
}
