/* pagesOrder/service-records/service-records.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 加载态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 记录列表 ===== */
.record-list {
  padding: 24rpx;
}

.record-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* ===== 头部 ===== */
.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ===== 项目名称 ===== */
.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* ===== 详情行 ===== */
.record-details {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.record-detail-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 底部状态 ===== */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--color-text-hint);
}
