<!-- pages/treatment-cards/treatment-cards.wxml — 我的疗程卡 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 加载 -->
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="4" />
    <van-skeleton title row="4" style="margin-top:24rpx" />
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{loadError}}" class="empty-wrap">
    <van-empty image="error" description="加载失败，下拉刷新重试" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{cards.length === 0}}" class="empty-wrap">
    <van-empty description="暂无可用疗程卡" />
  </view>

  <!-- 疗程卡列表 -->
  <view wx:else class="list-wrap">
    <view
      wx:for="{{cards}}"
      wx:key="saleItemId"
      class="tc-card {{item.active ? '' : 'tc-card--inactive'}}"
      bindtap="onCardTap"
      data-sale-order-id="{{item.saleOrderId}}"
    >
      <!-- 头部：项目名 + 类型标签（活跃卡用品牌渐变） -->
      <view class="tc-card__header {{item.active ? 'brand-gradient' : ''}}">
        <view class="tc-card__title-row">
          <text class="tc-card__name">{{item.productName}}</text>
          <van-tag
            wx:if="{{!item.active}}"
            color="#F5F5F5"
            text-color="#999"
          >已失效</van-tag>
          <van-tag
            wx:elif="{{item.productType === '疗程卡'}}"
            color="rgba(255,255,255,0.2)"
            text-color="#FFF"
          >疗程卡</van-tag>
        </view>
      </view>

      <!-- 进度区（三段：已用 / 已付未用 / 未付） -->
      <view class="tc-card__progress">
        <view class="progress-bar progress-bar--tri">
          <!-- 已用段（浅灰） -->
          <view class="progress-seg progress-seg--used" style="width: {{item.usedPct}}%"></view>
          <!-- 已付未用段（品牌主色，失效卡置灰） -->
          <view class="progress-seg {{item.active ? 'progress-seg--paid-unused' : 'progress-seg--paid-unused-inactive'}}" style="width: {{item.paidUnusedPct}}%"></view>
          <!-- 未付段（更浅灰，斜纹） -->
          <view class="progress-seg progress-seg--unpaid" style="width: {{item.unpaidPct}}%"></view>
        </view>
        <view class="progress-info">
          <text class="progress-used">已用 {{item.usedSessions}} / 已付 {{item.paidSessions}} / 共 {{item.sessionCount}} 次</text>
          <text class="progress-remain">剩余 <text class="progress-remain__num {{item.active ? '' : 'progress-remain__num--inactive'}}">{{item.paidUnusedSessions}}</text> 次</text>
        </view>
      </view>

      <!-- 底部：门店 + 有效期 + 预约按钮 -->
      <view class="tc-card__footer">
        <view class="tc-card__meta">
          <view class="tc-card__store">
            <van-icon name="shop-o" size="24rpx" color="#999" />
            <text class="tc-card__store-text">{{item.storeName}}</text>
          </view>
          <view class="tc-card__expire" wx:if="{{item.expireFmt}}">
            <van-icon name="clock-o" size="24rpx" color="#999" />
            <text class="tc-card__expire-text">{{item.expireFmt}} 到期</text>
          </view>
        </view>
        <view
          wx:if="{{item.active && item.paidUnusedSessions > 0}}"
          class="tc-card__book-btn"
          catchtap="onBookTap"
          data-sale-item-id="{{item.saleItemId}}"
        >预约</view>
        <view wx:else class="tc-card__status-text">已失效</view>
      </view>
    </view>
  </view>

</view>
