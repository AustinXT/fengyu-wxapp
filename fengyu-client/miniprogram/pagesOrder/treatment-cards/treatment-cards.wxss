/* pages/treatment-cards/treatment-cards.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.skeleton-wrap {
  padding: 32rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

/* ===== 列表 ===== */
.list-wrap {
  padding: 24rpx 24rpx 40rpx;
}

/* ===== 疗程卡卡片 ===== */
.tc-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.tc-card--inactive {
  opacity: 0.6;
}

/* 头部 */
.tc-card__header {
  margin-bottom: 24rpx;
}

/* 活跃卡渐变头部 — 扩展到卡片边缘 */
.tc-card__header.brand-gradient {
  margin: -28rpx -28rpx 24rpx -28rpx;
  padding: 28rpx;
  border-radius: 0;
}

.tc-card__header.brand-gradient .tc-card__name {
  color: #FFFFFF;
}

.tc-card__header.brand-gradient .tc-card__sku {
  color: rgba(255, 255, 255, 0.75);
}

.tc-card__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tc-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.tc-card__sku {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 进度条 */
.tc-card__progress {
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-bar__fill--inactive {
  background: var(--color-border);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-used {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.progress-remain {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.progress-remain__num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.progress-remain__num--inactive {
  color: var(--color-text-hint);
  font-weight: 400;
}

/* 底部 */
.tc-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1px solid var(--color-border);
}

.tc-card__meta {
  flex: 1;
}

.tc-card__store,
.tc-card__expire {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 4rpx;
}

.tc-card__store-text,
.tc-card__expire-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* 预约按钮 */
.tc-card__book-btn {
  flex-shrink: 0;
  padding: 10rpx 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: var(--color-primary);
  border-radius: 32rpx;
}

/* 已失效文字 */
.tc-card__status-text {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-hint);
}
