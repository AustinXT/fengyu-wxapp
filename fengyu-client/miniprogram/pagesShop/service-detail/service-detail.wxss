/* pages/service-detail/service-detail.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 160rpx;
}

.skeleton-wrap {
  padding: 32rpx;
}

.error-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-page);
}

/* ===== 封面 ===== */
.cover-wrap {
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 480rpx;
  background: linear-gradient(135deg, var(--color-primary-light) 0%, #FDDAD8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 信息卡 ===== */
.info-card {
  background: var(--color-bg-card);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.info-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.spu-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.spu-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-unit {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-left: 8rpx;
}

.price-hint {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

/* ===== 商品详情（图文） ===== */
.detail-section {
  background: var(--color-bg-card);
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.detail-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  margin-bottom: 20rpx;
}

.detail-img {
  width: 100%;
  display: block;
  margin-bottom: 12rpx;
}

/* ===== SKU Popup ===== */
.sku-popup {
  padding: 32rpx;
}

.sku-popup__header {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.sku-popup__cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.sku-popup__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-section);
}

.sku-popup__price-info {
  flex: 1;
}

.sku-popup__price-hint {
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.sku-popup__selected-name {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.sku-popup__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.sku-popup__list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.sku-item {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1px solid var(--color-border);
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 160rpx;
}

.sku-item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.sku-display-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sku-item--active .sku-display-name {
  color: var(--color-primary);
}

.sku-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.sku-sessions {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.sku-popup__quantity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1px solid var(--color-border);
  margin-bottom: 24rpx;
}

.sku-popup__quantity-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sku-popup__confirm {
  padding-top: 16rpx;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 100rpx;
  background: #fff;
  padding: 0 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-bar__price {
  flex: 1;
  min-width: 0;
  padding-left: 12rpx;
  display: flex;
  align-items: baseline;
}

.action-bar__price-symbol {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.action-bar__price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.action-bar__price-hint {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.action-bar__price-qty {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-left: 6rpx;
}

.action-bar__cart-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-bar__badge {
  position: absolute;
  top: 4rpx;
  right: 2rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--color-error);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.action-bar__btns {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-bar__btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.action-bar__btn--cart-add {
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  background: #fff;
}

.action-bar__btn--buy {
  color: #fff;
  background: var(--color-primary);
}

.action-bar__btn--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.action-bar__btn--full {
  width: 100%;
}

/* ===== 套餐多选 ===== */
.sku-popup__bundle {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.sku-popup__group {
  background: var(--color-bg-section);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.sku-popup__group-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid var(--color-border);
}

.sku-popup__group-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.sku-popup__group-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.sku-popup__group-skus {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bundle-sku-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg-card);
  border-radius: 12rpx;
  border: 1px solid var(--color-border);
}

.bundle-sku-row--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.bundle-sku-row--locked {
  opacity: 0.85;
}

.bundle-sku-row__check {
  flex-shrink: 0;
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bundle-sku-row__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bundle-sku-row__name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.bundle-sku-row--active .bundle-sku-row__name {
  color: var(--color-primary);
  font-weight: 600;
}

.bundle-sku-row__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bundle-sku-row__price {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.bundle-sku-row__sessions {
  font-size: 22rpx;
  color: var(--color-text-hint);
}
