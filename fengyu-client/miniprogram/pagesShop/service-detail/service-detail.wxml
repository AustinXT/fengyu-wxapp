<!-- pages/service-detail/service-detail.wxml — 商品详情 + SKU 选择 -->
<van-toast id="van-toast" />

<view class="container" wx:if="{{!isLoading}}">

  <!-- 封面图 -->
  <view class="cover-wrap">
    <image
      wx:if="{{spu.cover_image}}"
      class="cover-img"
      src="{{spu.cover_image}}"
      mode="aspectFill"
    />
    <view wx:else class="cover-placeholder">
      <van-icon name="photo-o" size="80rpx" color="#C0322A" />
    </view>
  </view>

  <!-- 商品基础信息 -->
  <view class="info-card">
    <view class="info-tags">
      <van-tag color="#722ED1" wx:if="{{spu.big_category === '促销方案'}}">促销方案</van-tag>
      <van-tag type="primary" wx:elif="{{spu.big_category === '生美'}}">生美</van-tag>
      <van-tag color="#006D75" wx:elif="{{spu.big_category === '非生美'}}">非生美</van-tag>
      <van-tag color="#D46B08" wx:elif="{{spu.big_category === '院装产品'}}">院装产品</van-tag>
    </view>
    <text class="spu-name">{{spu.name}}</text>
    <text class="spu-desc" wx:if="{{spu.description}}">{{spu.description}}</text>

    <!-- 选中 SKU 价格 -->
    <view class="price-row" wx:if="{{selectedSku}}">
      <view class="price-group">
        <text class="price-symbol">¥</text>
        <text class="price-integer">{{selectedSku.price}}</text>
      </view>
      <text class="price-unit" wx:if="{{selectedSku.session_count}}">/ {{selectedSku.session_count}} 次</text>
    </view>
    <view class="price-row" wx:else>
      <text class="price-hint">请选择规格</text>
    </view>
  </view>

  <!-- SKU 规格选择 -->
  <view class="sku-card">
    <text class="sku-title">选择规格</text>
    <view class="sku-list">
      <view
        wx:for="{{skuList}}"
        wx:key="sku_id"
        class="sku-item {{selectedSku.sku_id === item.sku_id ? 'sku-item--active' : ''}}"
        bindtap="onSkuTap"
        data-sku-id="{{item.sku_id}}"
      >
        <text class="sku-display-name">{{item.sku_display_name}}</text>
        <text class="sku-price">¥{{item.price}}</text>
        <text class="sku-sessions" wx:if="{{item.session_count}}">{{item.session_count}}次</text>
      </view>
    </view>
  </view>

  <!-- 购买数量 -->
  <view class="quantity-card" wx:if="{{selectedSku}}">
    <text class="quantity-label">购买数量</text>
    <van-stepper
      value="{{quantity}}"
      min="1"
      max="99"
      bind:change="onQuantityChange"
      input-width="44px"
      button-size="28px"
    />
  </view>

  <!-- 选择美容师（可选） -->
  <van-cell-group title="指定美容师（可选）" inset>
    <van-cell
      title="{{selectedStaffName || '不指定美容师'}}"
      is-link
      icon="manager-o"
      bindtap="onSelectStaff"
      value="{{selectedStaffName ? '' : '可不选'}}"
    />
  </van-cell-group>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <!-- 价格区 -->
    <view class="action-bar__price" wx:if="{{selectedSku}}">
      <text class="action-bar__price-symbol">¥</text>
      <text class="action-bar__price-value">{{selectedSku.price * quantity}}</text>
      <text class="action-bar__price-qty" wx:if="{{quantity > 1}}"> x{{quantity}}</text>
    </view>
    <view class="action-bar__price" wx:else>
      <text class="action-bar__price-hint">请选择规格</text>
    </view>

    <!-- 购物车图标：促销方案不显示 -->
    <view class="action-bar__cart-icon" bindtap="onCartTap" wx:if="{{spu.big_category !== '促销方案'}}">
      <van-icon name="shopping-cart-o" size="48rpx" />
      <view class="action-bar__badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>

    <!-- 按钮区 -->
    <view class="action-bar__btns">
      <view wx:if="{{spu.big_category !== '促销方案'}}" class="action-bar__btn action-bar__btn--cart-add {{!selectedSku ? 'action-bar__btn--disabled' : ''}}" bindtap="onAddToCart">加入购物车</view>
      <view class="action-bar__btn action-bar__btn--buy {{spu.big_category === '促销方案' ? 'action-bar__btn--full' : ''}} {{!selectedSku ? 'action-bar__btn--disabled' : ''}}" bindtap="onSubmit">立即下单</view>
    </view>
  </view>

  <!-- 美容师选择 Popup -->
  <van-popup
    show="{{showStaffPopup}}"
    position="bottom"
    round
    closeable
    bind:close="onCloseStaffPopup"
  >
    <view class="staff-popup">
      <view class="staff-popup__title">选择美容师</view>
      <view class="staff-list">
        <!-- 不指定 -->
        <view
          class="staff-item {{!selectedStaffWfId ? 'staff-item--active' : ''}}"
          bindtap="onStaffSelect"
          data-wf-id=""
          data-name=""
        >
          <view class="staff-avatar">
            <van-icon name="user-o" size="48rpx" color="#B09880" />
          </view>
          <text class="staff-name">不指定</text>
        </view>
        <!-- 美容师列表 -->
        <van-loading wx:if="{{staffListLoading && staffList.length === 0}}" size="24px" vertical style="padding: 40rpx 0;">加载中...</van-loading>
        <view
          wx:for="{{staffList}}"
          wx:key="staff_wf_id"
          class="staff-item {{selectedStaffWfId === item.staff_wf_id ? 'staff-item--active' : ''}}"
          bindtap="onStaffSelect"
          data-wf-id="{{item.staff_wf_id}}"
          data-name="{{item.name}}"
        >
          <view class="staff-avatar">
            <van-icon name="manager-o" size="48rpx" color="#C0322A" />
          </view>
          <text class="staff-name">{{item.name}}</text>
          <text class="staff-title">{{item.position}}</text>
        </view>
        <view wx:if="{{!staffListLoading && staffList.length === 0}}" class="staff-empty">
          <text>暂无可选美容师</text>
        </view>
      </view>
    </view>
  </van-popup>

</view>

<!-- 骨架屏 -->
<view wx:else class="skeleton-wrap">
  <van-skeleton title avatar row="5" />
</view>
