<!-- pages/service-detail/service-detail.wxml — 商品详情 + SKU 选择 -->
<wxs module="price">
module.exports.fmt = function(val) {
  return (Math.round(val * 100) / 100).toFixed(2)
}
</wxs>
<van-toast id="van-toast" />

<!-- 错误态 -->
<view wx:if="{{!isLoading && loadError}}" class="error-wrap">
  <van-empty image="error" description="加载失败，下拉刷新重试" />
</view>

<view class="container" wx:elif="{{!isLoading}}">

  <!-- 封面图 -->
  <view class="cover-wrap">
    <image
      wx:if="{{spu.cover_image}}"
      class="cover-img"
      src="{{spu.cover_image}}"
      mode="aspectFill"
    />
    <view wx:else class="cover-placeholder">
      <van-icon name="photo-o" size="80rpx" color="#C0322A" />
    </view>
  </view>

  <!-- 商品基础信息 -->
  <view class="info-card">
    <view class="info-tags" wx:if="{{spu.category_name}}">
      <van-tag type="primary">{{spu.category_name}}</van-tag>
      <van-tag wx:if="{{spu.is_bundle}}" type="danger" plain>组合套餐</van-tag>
    </view>
    <text class="spu-name">{{spu.name}}</text>

    <!-- 套餐：展示套餐价；非套餐：选中 SKU 价格 -->
    <view class="price-row" wx:if="{{spu.is_bundle}}">
      <view class="price-group">
        <text class="price-symbol">¥</text>
        <text class="price-integer">{{price.fmt(spu.price)}}</text>
      </view>
      <text class="price-unit">套餐价</text>
    </view>
    <view class="price-row" wx:elif="{{selectedSku}}">
      <view class="price-group">
        <text class="price-symbol">¥</text>
        <text class="price-integer">{{price.fmt(selectedSku.price)}}</text>
      </view>
      <text class="price-unit" wx:if="{{selectedSku.session_count}}">/ {{selectedSku.session_count}} 次</text>
    </view>
    <view class="price-row" wx:else>
      <text class="price-hint">请选择规格</text>
    </view>
  </view>

  <!-- SKU 规格选择入口 -->
  <van-cell-group inset>
    <van-cell
      wx:if="{{spu.is_bundle}}"
      title="套餐内容"
      value="{{bundleCanSubmit ? '已选 ' + bundleSelectedCount + ' 项' : '请选择'}}"
      is-link
      bindtap="onOpenSkuPopup"
    />
    <van-cell
      wx:else
      title="已选规格"
      value="{{selectedSku ? selectedSku.spec_name + (quantity > 1 ? ' x' + quantity : '') : '请选择'}}"
      is-link
      bindtap="onOpenSkuPopup"
    />
  </van-cell-group>

  <!-- 选择美容师（可选） -->
  <van-cell-group title="指定美容师（可选）" inset>
    <van-cell
      title="{{selectedStaffName || '不指定美容师'}}"
      is-link
      icon="manager-o"
      bindtap="onSelectStaff"
      value="{{selectedStaffName ? '' : '可不选'}}"
    />
  </van-cell-group>

  <!-- 商品详情（图文，竖向依次排列） -->
  <view
    class="detail-section"
    wx:if="{{spu.description || (spu.detail_images && spu.detail_images.length)}}"
  >
    <view class="detail-title">商品详情</view>
    <text class="detail-desc" wx:if="{{spu.description}}">{{spu.description}}</text>
    <image
      wx:for="{{spu.detail_images}}"
      wx:key="*this"
      class="detail-img"
      src="{{item}}"
      mode="widthFix"
      lazy-load
    />
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar safe-area-bottom">
    <!-- 套餐：展示已选合计；非套餐：单 SKU × 数量 -->
    <view class="action-bar__price" wx:if="{{spu.is_bundle}}">
      <text class="action-bar__price-symbol">¥</text>
      <text class="action-bar__price-value">{{price.fmt(bundleTotalPrice)}}</text>
      <text class="action-bar__price-qty" wx:if="{{bundleSelectedCount > 0}}"> 共{{bundleSelectedCount}}项</text>
    </view>
    <view class="action-bar__price" wx:elif="{{selectedSku}}">
      <text class="action-bar__price-symbol">¥</text>
      <text class="action-bar__price-value">{{price.fmt(selectedSku.price * quantity)}}</text>
      <text class="action-bar__price-qty" wx:if="{{quantity > 1}}"> x{{quantity}}</text>
    </view>
    <view class="action-bar__price" wx:else>
      <text class="action-bar__price-hint">请选择规格</text>
    </view>

    <!-- 购物车图标：套餐不显示 -->
    <view class="action-bar__cart-icon" bindtap="onCartTap" wx:if="{{!spu.is_bundle}}">
      <van-icon name="shopping-cart-o" size="48rpx" />
      <view class="action-bar__badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>

    <!-- 按钮区 -->
    <view class="action-bar__btns">
      <view wx:if="{{!spu.is_bundle}}" class="action-bar__btn action-bar__btn--cart-add {{!selectedSku ? 'action-bar__btn--disabled' : ''}}" bindtap="onAddToCart">加入购物车</view>
      <view wx:if="{{spu.is_bundle}}" class="action-bar__btn action-bar__btn--buy action-bar__btn--full {{!bundleCanSubmit ? 'action-bar__btn--disabled' : ''}}" bindtap="onSubmit">立即下单</view>
      <view wx:else class="action-bar__btn action-bar__btn--buy {{!selectedSku ? 'action-bar__btn--disabled' : ''}}" bindtap="onSubmit">立即下单</view>
    </view>
  </view>

  <!-- 美容师选择 Popup -->
  <staff-popup
    show="{{showStaffPopup}}"
    staff-list="{{staffList}}"
    selected-id="{{selectedStaffWfId}}"
    loading="{{staffListLoading}}"
    bind:select="onStaffSelect"
    bind:close="onCloseStaffPopup"
  />

  <!-- SKU 选择 Popup -->
  <van-popup
    show="{{showSkuPopup}}"
    position="bottom"
    round
    closeable
    bind:close="onCloseSkuPopup"
  >
    <view class="sku-popup">
      <!-- 顶部：封面 + 价格 -->
      <view class="sku-popup__header">
        <image
          wx:if="{{spu.cover_image}}"
          class="sku-popup__cover"
          src="{{spu.cover_image}}"
          mode="aspectFill"
        />
        <view wx:else class="sku-popup__cover sku-popup__cover--empty">
          <van-icon name="photo-o" size="48rpx" color="#CCC" />
        </view>
        <view class="sku-popup__price-info">
          <view wx:if="{{spu.is_bundle}}" class="price-group">
            <text class="price-symbol">¥</text>
            <text class="price-integer">{{price.fmt(spu.price)}}</text>
          </view>
          <view wx:elif="{{selectedSku}}" class="price-group">
            <text class="price-symbol">¥</text>
            <text class="price-integer">{{price.fmt(selectedSku.price)}}</text>
          </view>
          <text wx:else class="sku-popup__price-hint">请选择规格</text>
          <text class="sku-popup__selected-name" wx:if="{{spu.is_bundle}}">{{spu.name}}</text>
          <text class="sku-popup__selected-name" wx:elif="{{selectedSku}}">{{selectedSku.spec_name}}</text>
        </view>
      </view>

      <!-- 套餐分支：分组多选 -->
      <block wx:if="{{spu.is_bundle}}">
        <view class="sku-popup__bundle">
          <view class="sku-popup__group" wx:for="{{bundleViewGroups}}" wx:for-item="g" wx:key="id">
            <view class="sku-popup__group-header">
              <text class="sku-popup__group-name">「{{g.groupName}}」</text>
              <text class="sku-popup__group-hint">{{g.hint}}</text>
            </view>
            <view class="sku-popup__group-skus">
              <!-- 选 N 项组：数量步进器（同一 SKU 可选多件，组内合计 = pickCount） -->
              <block wx:if="{{g.mode === 'pick'}}">
                <view
                  wx:for="{{g.skus}}"
                  wx:for-item="sku"
                  wx:key="skuId"
                  class="bundle-sku-row {{sku.selected ? 'bundle-sku-row--active' : ''}}"
                >
                  <view class="bundle-sku-row__info">
                    <text class="bundle-sku-row__name">{{sku.specName}}</text>
                    <view class="bundle-sku-row__meta">
                      <text class="bundle-sku-row__price">套餐价 ¥{{price.fmt(sku.bundlePrice)}}</text>
                      <text wx:if="{{sku.sessionCount}}" class="bundle-sku-row__sessions">{{sku.sessionCount}}次</text>
                    </view>
                  </view>
                  <van-stepper
                    value="{{sku.qty}}"
                    min="0"
                    max="{{sku.maxQty}}"
                    integer
                    data-group-id="{{g.id}}"
                    data-sku-id="{{sku.skuId}}"
                    bind:change="onBundleSkuQtyChange"
                  />
                </view>
              </block>
              <!-- 全选组：复选框（默认全选、锁定） -->
              <block wx:else>
                <view
                  wx:for="{{g.skus}}"
                  wx:for-item="sku"
                  wx:key="skuId"
                  class="bundle-sku-row {{sku.selected ? 'bundle-sku-row--active' : ''}} bundle-sku-row--locked"
                >
                  <view class="bundle-sku-row__check">
                    <van-icon
                      name="{{sku.selected ? 'checked' : 'circle'}}"
                      size="40rpx"
                      color="{{sku.selected ? '#C0322A' : '#CCC'}}"
                    />
                  </view>
                  <view class="bundle-sku-row__info">
                    <text class="bundle-sku-row__name">{{sku.specName}}</text>
                    <view class="bundle-sku-row__meta">
                      <text class="bundle-sku-row__price">套餐价 ¥{{price.fmt(sku.bundlePrice)}}</text>
                      <text wx:if="{{sku.sessionCount}}" class="bundle-sku-row__sessions">{{sku.sessionCount}}次</text>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </block>

      <!-- 非套餐分支：普通 SKU 平铺 -->
      <block wx:else>
        <view class="sku-popup__title">选择规格</view>
        <view class="sku-popup__list">
          <view
            wx:for="{{skuList}}"
            wx:key="sku_id"
            class="sku-item {{selectedSku.sku_id === item.sku_id ? 'sku-item--active' : ''}}"
            bindtap="onSkuTap"
            data-sku-id="{{item.sku_id}}"
          >
            <text class="sku-display-name">{{item.spec_name}}</text>
            <text class="sku-price">¥{{price.fmt(item.price)}}</text>
            <text class="sku-sessions" wx:if="{{item.session_count}}">{{item.session_count}}次</text>
          </view>
        </view>

        <!-- 数量（套餐不显示） -->
        <view class="sku-popup__quantity">
          <text class="sku-popup__quantity-label">购买数量</text>
          <van-stepper
            value="{{quantity}}"
            min="1"
            max="99"
            bind:change="onQuantityChange"
            input-width="44px"
            button-size="28px"
          />
        </view>
      </block>

      <!-- 确认按钮：套餐→加入套餐+提交；非套餐→仅关闭弹层 -->
      <view class="sku-popup__confirm safe-area-bottom">
        <van-button
          wx:if="{{spu.is_bundle}}"
          type="primary"
          block
          disabled="{{!bundleCanSubmit}}"
          bindtap="onSubmit"
        >加入套餐</van-button>
        <van-button
          wx:else
          type="primary"
          block
          disabled="{{!selectedSku}}"
          bindtap="onCloseSkuPopup"
        >确定</van-button>
      </view>
    </view>
  </van-popup>

</view>

<!-- 骨架屏 -->
<view wx:else class="skeleton-wrap">
  <van-skeleton title avatar row="5" />
</view>
