
<van-toast id="van-toast" />

<view class="container">

  
  <view class="section-title" style="padding: 16rpx 24rpx;">
    <text style="font-size: 28rpx; font-weight: 600; color: #333;">全部分类</text>
  </view>

  
  <view class="catalog">

    
    <scroll-view class="sidebar-scroll" scroll-y>
      <van-sidebar active-key="{{activeCategoryIndex}}" bind:change="onCategoryChange">
        <van-sidebar-item
          wx:for="{{categories}}"
          wx:key="_index"
          title="{{item.category_name}}"
        />
      </van-sidebar>
    </scroll-view>

    
    <scroll-view class="product-scroll" scroll-y>

      
      <view wx:if="{{isLoading}}" class="skeleton-wrap">
        <van-skeleton title avatar row="3" />
        <van-skeleton title avatar row="3" style="margin-top:24rpx" />
      </view>

      
      <view wx:elif="{{spuList.length === 0 && categories.length === 0}}">
        <van-empty description="该分类暂无商品" />
      </view>
      <view wx:elif="{{spuList.length === 0 && categories.length > 0}}">
        <van-empty description="该分类暂无商品" />
      </view>

      
      <view wx:else class="spu-list">
        <view
          wx:for="{{spuList}}"
          wx:key="product_id"
          class="spu-card"
          bindtap="onSpuTap"
          data-product-id="{{item.product_id}}"
        >
          
          <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
            <van-icon name="photo-o" size="64rpx" color="#CCCCCC" />
          </view>
          <image
            wx:else
            class="spu-cover"
            src="{{item.cover_image}}"
            mode="aspectFill"
            lazy-load
          />

          
          <view class="spu-body">
            
            <view class="spu-tags" wx:if="{{item.category_name}}">
              <van-tag type="primary">{{item.category_name}}</van-tag>
            </view>

            
            <text class="spu-name">{{item.name}}</text>

            
            <view class="spu-footer">
              <view class="price-group">
                <text class="price-symbol">¥</text>
                <text class="price-integer">{{item.min_price}}</text>
                <text class="price-start">起</text>
                <text wx:if="{{item.strike_min_price}}" class="price-origin">¥{{item.strike_min_price}}</text>
              </view>
              <view class="spu-add-btn">
                <van-icon name="plus" size="36rpx" color="#FFFFFF" />
              </view>
            </view>
          </view>
        </view>
      </view>

    </scroll-view>
  </view>

  
  <view class="cart-bar" bindtap="onCartTap" wx:if="{{cartCount > 0}}">
    <view class="cart-icon-wrap">
      <van-icon name="shopping-cart-o" size="44rpx" color="#C0322A" />
      <view class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>
    <view class="cart-info">
      <text class="cart-tip">购物车</text>
    </view>
    <van-button type="warning" size="small" round>去结算</van-button>
  </view>

</view>
