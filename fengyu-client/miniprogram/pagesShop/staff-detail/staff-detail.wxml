
<van-toast id="van-toast" />

<view class="container">

  
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="4" />
  </view>

  
  <view wx:elif="{{!staff}}" class="empty-wrap">
    <van-empty description="美容师信息不存在" />
  </view>

  
  <view wx:else>

    
    <view class="staff-header">
      <view class="staff-avatar staff-avatar--large">
        <image wx:if="{{staff.avatarUrl}}" src="{{staff.avatarUrl}}" class="staff-avatar-img staff-avatar-img--large" mode="aspectFill" />
        <van-icon wx:else name="manager" size="64px" color="var(--color-primary)" />
      </view>
      <view class="staff-info">
        <view class="staff-name-row">
          <text class="staff-name">{{staff.name}}</text>
          <text class="staff-position" wx:if="{{staff.position}}">{{staff.position}}</text>
        </view>
        <van-tag
          wx:if="{{staff.onLeave}}"
          color="#C0322A"
          plain
          round
          size="medium"
        >休假中</van-tag>
        <van-tag
          wx:elif="{{staff.isBusy}}"
          color="#FAAD14"
          plain
          round
          size="medium"
        >忙碌</van-tag>
        <van-tag
          wx:else
          color="#52C41A"
          plain
          round
          size="medium"
        >空闲</van-tag>
      </view>
    </view>

    
    <view class="section" wx:if="{{staff.skills && staff.skills.length > 0}}">
      <view class="section-title">擅长项目</view>
      <view class="skills-wrap">
        <van-tag
          wx:for="{{staff.skills}}"
          wx:key="*this"
          plain
          round
          color="var(--color-primary)"
          size="medium"
          custom-class="skill-tag"
        >{{item}}</van-tag>
      </view>
    </view>

    
    <view class="section">
      <view class="section-title">服务数据</view>
      <view class="stats-card">
        <view class="stat-item">
          <text class="stat-value">{{staff.serviceCount || 0}}</text>
          <text class="stat-label">累计服务（次）</text>
        </view>
        <view class="stat-divider" />
        <view class="stat-item">
          <text class="stat-value">{{staff.todayAppointments || 0}}</text>
          <text class="stat-label">今日预约（位）</text>
        </view>
        <view class="stat-divider" />
        <view class="stat-item">
          <text class="stat-value">{{staff.reviewCount > 0 ? staff.avgRating : '—'}}</text>
          <text class="stat-label">{{staff.reviewCount > 0 ? '评分（' + staff.reviewCount + '条）' : '暂无评价'}}</text>
        </view>
      </view>
    </view>

    
    <view class="section" wx:if="{{staff.reviewCount > 0}}">
      <view class="section-title">顾客评价</view>
      <view class="rating-card">
        <text class="rating-score">{{staff.avgRating}}</text>
        <view class="rating-stars">
          <van-rate value="{{staff.avgRating}}" readonly allow-half size="32rpx" color="#C0322A" void-color="#E8E8E8" />
          <text class="rating-count">共 {{staff.reviewCount}} 条评价</text>
        </view>
      </view>
    </view>

  </view>

  
  <view class="bottom-space" />
</view>


<view wx:if="{{!isLoading && staff}}" class="bottom-bar safe-area-bottom">
  <van-button
    type="primary"
    block
    round
    color="#C0322A"
    bindtap="onBookAppointment"
  >预约此美容师</van-button>
</view>
