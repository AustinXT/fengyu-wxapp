/* app.wxss — 凤御客户端全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
               'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1A1A1A;
  background-color: #FAFAFA;

  /* ===== 业务 CSS 变量（白红主题） ===== */
  --color-primary:        #C0322A;  /* 中国红 - 品牌主色 */
  --color-primary-light:  #FFF0EE;  /* 红色浅底 */
  --color-primary-dark:   #9B1E14;  /* 深红 */
  --color-accent:         #C0322A;  /* 强调色 */
  --color-success:        #52C41A;
  --color-warning:        #FAAD14;
  --color-error:          #FF4D4F;
  --color-text-primary:   #1A1A1A;  /* 主文字 - 深黑 */
  --color-text-secondary: #666666;  /* 副文字 */
  --color-text-hint:      #999999;  /* 提示文字 */
  --color-border:         #E8E8E8;  /* 边框 */
  --color-bg-page:        #FAFAFA;  /* 页面背景 - 浅灰白 */
  --color-bg-card:        #FFFFFF;  /* 卡片背景 */

  /* 品牌白红专属 */
  --color-brand-black:    #FFFFFF;  /* 品牌背景白 */
  --color-brand-gold:     #C0322A;  /* 品牌红 */

  /* ===== Vant 主题覆盖（白红主题） ===== */
  --button-primary-background-color: #C0322A;
  --button-primary-border-color:     #C0322A;
  --button-primary-color:            #FFFFFF;
  --button-border-radius:            44rpx;
  --sidebar-active-color:            #C0322A;
  --sidebar-selected-color:          #C0322A;
  --sidebar-selected-font-weight:    600;
  --sidebar-width:                   180rpx;
  --sidebar-padding:                 12rpx 24rpx 12rpx 16rpx;
  --tab-active-color:                #C0322A;
  --tabs-bottom-bar-color:           #C0322A;
  --tag-primary-background-color:    #C0322A;
  --checkbox-checked-icon-color:     #C0322A;
  --radio-checked-icon-color:        #C0322A;
  --search-action-color:             #C0322A;
  --cell-right-icon-color:           #999999;
  --submit-bar-button-background:    #C0322A;
  --submit-bar-button-color:         #FFFFFF;
  --loading-color:                   #C0322A;
  --empty-image-size:                200rpx;
}

/* ===== 安全区 ===== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

/* ===== 分割线 ===== */
.divider {
  height: 1px;
  background-color: var(--color-border);
}

/* ===== 状态标签色 ===== */
.status-pending    { color: #D48806; }
.status-confirm    { color: #C0322A; }
.status-paid       { color: #389E0D; }
.status-completed  { color: #8C8C8C; }
.status-failed     { color: #CF1322; }
.status-closed     { color: #8C8C8C; }
.status-serving    { color: #096DD9; }

/* ===== 价格组合 ===== */
.price-group {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.price-symbol { font-size: 22rpx; font-weight: 600; }
.price-integer { font-size: 40rpx; font-weight: 700; }
.price-start   { font-size: 22rpx; color: var(--color-text-hint); margin-left: 4rpx; }

/* ===== 商品封面占位 ===== */
.cover-placeholder {
  background: linear-gradient(135deg, #FFF0EE 0%, #FDDAD8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 品牌红色渐变背景 ===== */
.brand-gradient {
  background: linear-gradient(135deg, #C0322A 0%, #9B1E14 100%);
}

/* ===== 金色文字 ===== */
.text-gold {
  color: var(--color-brand-gold);
}

/* ===== 黑金卡片 ===== */
.card-dark {
  background: #FFFFFF;
  border-top: 4rpx solid #C0322A;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  color: #1A1A1A;
}

.card-dark .card-title {
  color: #C0322A;
}
