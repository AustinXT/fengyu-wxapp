/* app.wxss — 凤御客户端全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
               'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1A1A1A;
  background-color: #FAFAFA;

  /* ===== 业务 CSS 变量（白红主题） ===== */
  --color-primary:        #C0322A;  /* 中国红 - 品牌主色 */
  --color-primary-light:  #FFF0EE;  /* 红色浅底 */
  --color-primary-dark:   #9B1E14;  /* 深红 */
  --color-bg-section:     #F5F5F5;  /* 区块背景 */
  --color-text-title:     #333333;  /* 标题文字 */
  --color-success:        #52C41A;
  --color-warning:        #FAAD14;
  --color-error:          #FF4D4F;
  --color-text-primary:   #1A1A1A;  /* 主文字 - 深黑 */
  --color-text-secondary: #666666;  /* 副文字 */
  --color-text-hint:      #999999;  /* 提示文字 */
  --color-border:         #E8E8E8;  /* 边框 */
  --color-bg-page:        #FAFAFA;  /* 页面背景 - 浅灰白 */
  --color-bg-card:        #FFFFFF;  /* 卡片背景 */

  /* 状态色 */
  --color-status-pending:  #D48806;
  --color-status-confirm:  #C9986A;
  --color-status-paid:     #389E0D;
  --color-status-done:     #8C8C8C;
  --color-status-failed:   #CF1322;
  --color-status-serving:  #096DD9;

  /* 阴影 */
  --shadow-card:      0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-elevated:  0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  --shadow-float:     0 8rpx 24rpx rgba(0, 0, 0, 0.12);

  /* ===== Vant 主题覆盖（白红主题） ===== */
  --button-primary-background-color: var(--color-primary);
  --button-primary-border-color:     var(--color-primary);
  --button-primary-color:            #FFFFFF;
  --button-border-radius:            12rpx;
  --sidebar-active-color:            var(--color-primary);
  --sidebar-selected-color:          var(--color-primary);
  --sidebar-selected-font-weight:    600;
  --sidebar-width:                   180rpx;
  --sidebar-padding:                 12rpx 24rpx 12rpx 16rpx;
  --tab-active-color:                var(--color-primary);
  --tabs-bottom-bar-color:           var(--color-primary);
  --tag-primary-background-color:    var(--color-primary);
  --checkbox-checked-icon-color:     var(--color-primary);
  --radio-checked-icon-color:        var(--color-primary);
  --search-action-color:             var(--color-primary);
  --cell-right-icon-color:           var(--color-text-hint);
  --submit-bar-button-background:    var(--color-primary);
  --submit-bar-button-color:         #FFFFFF;
  --loading-color:                   var(--color-primary);
  --empty-image-size:                200rpx;
}

/* ===== 按钮形状统一 ===== */
/* Vant plain button 边框统一为 1px 细边 */
.van-button--plain {
  border-width: 1px !important;
}

/* ===== 安全区 ===== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

/* ===== 分割线 ===== */
.divider {
  height: 1px;
  background-color: var(--color-border);
}

/* ===== 状态标签色 ===== */
.status-pending    { color: var(--color-status-pending); }
.status-confirm    { color: var(--color-status-confirm); }
.status-paid       { color: var(--color-status-paid); }
.status-completed  { color: var(--color-status-done); }
.status-failed     { color: var(--color-status-failed); }
.status-closed     { color: var(--color-status-done); }
.status-serving    { color: var(--color-status-serving); }

/* ===== 价格组合 ===== */
.price-group {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.price-symbol { font-size: 22rpx; font-weight: 600; }
.price-integer { font-size: 40rpx; font-weight: 700; }
.price-start   { font-size: 22rpx; color: var(--color-text-hint); margin-left: 4rpx; }

/* ===== 商品封面占位 ===== */
.cover-placeholder {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, #FDDAD8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 品牌红色渐变背景 ===== */
.brand-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
}

/* ===== 品牌红色文字 ===== */
.text-gold {
  color: var(--color-primary);
}

/* ===== 强调卡片 ===== */
.card-dark {
  background: var(--color-bg-card);
  border-top: 4rpx solid var(--color-primary);
  box-shadow: var(--shadow-elevated);
  color: var(--color-text-primary);
}

.card-dark .card-title {
  color: var(--color-primary);
}

/* ===== 美容师选择 Popup（全局复用） ===== */
.staff-popup {
  padding-bottom: env(safe-area-inset-bottom);
}

.staff-popup__title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 32rpx 0 20rpx;
}

.staff-list {
  display: flex;
  overflow-x: auto;
  padding: 16rpx 24rpx 40rpx;
  gap: 24rpx;
}

.staff-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  padding: 16rpx;
  border-radius: 16rpx;
  border: 2px solid transparent;
  min-width: 120rpx;
}

.staff-item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.staff-avatar {
  width: 96rpx;
  height: 96rpx;
  background: var(--color-primary-light);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 美容师头像（image 模式；与 .staff-avatar 容器尺寸对齐） */
.staff-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
}

.staff-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.staff-title,
.staff-role {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.staff-empty {
  width: 100%;
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

/* ===== 列表分页底部（全局复用） ===== */
.list-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0 48rpx;
}

.list-footer__end {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
