/* pages/orders/orders.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.skeleton-list {
  padding: 32rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

/* ===== 列表 ===== */
.list-wrap {
  padding: 24rpx 24rpx 40rpx;
}

/* ===== 订单卡片 ===== */
.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.order-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1px solid var(--color-border);
}

.order-no-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

/* 状态颜色 */
.status-class-pending  { color: #D48806; }
.status-class-confirm  { color: #A0785A; }
.status-class-paid     { color: #389E0D; }
.status-class-done     { color: #8C8C8C; }
.status-class-failed   { color: #CF1322; }
.status-class-closed   { color: #8C8C8C; }

/* ===== 商品明细 ===== */
.order-items {
  padding: 16rpx 28rpx;
}

.order-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1px solid #F5F0EB;
}

.order-item-row:last-child {
  border-bottom: none;
}

.oi-name {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex: 1;
}

.oi-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
}

.oi-qty {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.oi-sessions {}

.oi-sessions-text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 底部区 ===== */
.order-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  border-top: 1px solid var(--color-border);
}

.order-time {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.order-amount-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.order-amount-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.order-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ===== 操作区 ===== */
.order-card__actions {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 24rpx 20rpx;
  gap: 16rpx;
  border-top: 1px solid var(--color-border);
}
