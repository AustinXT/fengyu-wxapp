<!-- pages/scan-pay/scan-pay.wxml — 扫码收款（员工端开单后客户扫码） -->
<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<view class="container">

  <!-- 加载中 -->
  <view wx:if="{{isLoading}}" class="loading-wrap">
    <van-loading size="60rpx" color="#C9986A" />
    <text class="loading-text">正在加载订单信息...</text>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{errorMsg}}" class="error-wrap">
    <van-icon name="warning-o" size="120rpx" color="#FF4D4F" />
    <text class="error-title">无法获取订单</text>
    <text class="error-desc">{{errorMsg}}</text>
    <van-button type="default" size="normal" round bindtap="onBackHome">返回首页</van-button>
  </view>

  <!-- 非待支付状态提示 -->
  <view wx:elif="{{statusMsg}}" class="error-wrap">
    <van-icon name="info-o" size="120rpx" color="#C9986A" />
    <text class="error-title">订单提示</text>
    <text class="error-desc">{{statusMsg}}</text>
    <van-button type="default" size="normal" round bindtap="onBackHome">返回首页</van-button>
  </view>

  <!-- 订单展示 -->
  <view wx:elif="{{order}}" class="order-wrap">

    <!-- 门店 + 状态 -->
    <view class="order-header">
      <text class="order-store">{{order.storeName}}</text>
      <van-tag type="primary">{{order.status}}</van-tag>
    </view>

    <!-- 商品明细 -->
    <view class="items-section">
      <view
        wx:for="{{items}}"
        wx:key="itemFlowNo"
        class="order-item"
      >
        <view class="item-left">
          <text class="item-name">{{item.spuName}}</text>
          <text class="item-spec">{{item.skuDisplayName}}</text>
        </view>
        <text class="item-price">¥{{item.unitPrice}}</text>
      </view>
    </view>

    <!-- 合计 -->
    <view class="order-total">
      <text class="total-label">合计</text>
      <view class="total-amount">
        <text class="total-symbol">¥</text>
        <text class="total-value">{{order.totalAmount}}</text>
      </view>
    </view>

    <!-- 支付方式 -->
    <van-radio-group value="{{paymentMethod}}" bind:change="onPayMethodChange">
      <van-cell-group title="支付方式" inset>
        <van-cell title="微信支付" clickable bindtap="onPayMethodTap" data-method="wechat">
          <van-icon slot="icon" name="wechat-pay" size="40rpx" color="#07C160" style="margin-right:16rpx" />
          <van-radio slot="right-icon" name="wechat" checked-color="#C9986A" />
        </van-cell>
        <van-cell title="线下付款" label="到店后现场付款" clickable bindtap="onPayMethodTap" data-method="offline">
          <van-icon slot="icon" name="balance-o" size="40rpx" color="#C9986A" style="margin-right:16rpx" />
          <van-radio slot="right-icon" name="offline" checked-color="#C9986A" />
        </van-cell>
      </van-cell-group>
    </van-radio-group>

    <!-- 底部确认 -->
    <van-submit-bar
      price="{{order.totalAmount * 100}}"
      button-text="{{paymentMethod === 'wechat' ? '微信支付' : '确认付款'}}"
      loading="{{submitting}}"
      bind:submit="onSubmit"
      safe-area-inset-bottom
    />

  </view>

</view>
