<!-- pages/cart/cart.wxml — 购物车 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 空态 -->
  <view wx:if="{{items.length === 0}}" class="empty-wrap">
    <van-empty description="购物车空空如也">
      <van-button type="warning" round size="small" bindtap="onGoShop">去逛逛</van-button>
    </van-empty>
  </view>

  <!-- 购物车列表 -->
  <view wx:else class="cart-body">

    <!-- 全选栏 -->
    <view class="select-all-bar">
      <van-checkbox
        value="{{allSelected}}"
        shape="round"
        checked-color="#C0322A"
        bind:change="onToggleAll"
      >
        全选
      </van-checkbox>
      <text class="item-count">共 {{items.length}} 件</text>
    </view>

    <!-- 商品列表 -->
    <scroll-view class="cart-list" scroll-y>
      <van-swipe-cell
        wx:for="{{items}}"
        wx:key="skuId"
        right-width="{{ 65 }}"
      >
        <view class="cart-item">
          <van-checkbox
            value="{{item.selected}}"
            shape="round"
            checked-color="#C0322A"
            data-sku-id="{{item.skuId}}"
            bind:change="onItemSelectChange"
          />
          <!-- 商品图 -->
          <view class="item-cover cover-placeholder" wx:if="{{!item.coverImage}}">
            <van-icon name="photo-o" size="48rpx" color="#C0322A" />
          </view>
          <image
            wx:else
            class="item-cover"
            src="{{item.coverImage}}"
            mode="aspectFill"
          />
          <!-- 商品信息 -->
          <view class="item-info">
            <text class="item-name">{{item.spuName}}</text>
            <text class="item-sku">{{item.skuDisplayName}}</text>
            <view class="item-bottom">
              <text class="item-price">¥{{item.price}}</text>
              <van-stepper
                value="{{item.quantity}}"
                min="1"
                max="99"
                input-width="36px"
                button-size="24px"
                data-sku-id="{{item.skuId}}"
                bind:change="onQuantityChange"
              />
            </view>
          </view>
        </view>

        <!-- 左滑删除 -->
        <view slot="right" class="delete-btn" data-sku-id="{{item.skuId}}" bindtap="onDeleteItem">
          删除
        </view>
      </van-swipe-cell>
    </scroll-view>
  </view>

  <!-- 底部结算栏 -->
  <view wx:if="{{items.length > 0}}" class="checkout-bar">
    <view class="checkout-info">
      <text class="checkout-label">合计：</text>
      <text class="checkout-total">¥{{totalPrice}}</text>
    </view>
    <van-button
      type="warning"
      round
      disabled="{{selectedCount === 0}}"
      bindtap="onCheckout"
    >
      结算({{selectedCount}})
    </van-button>
  </view>

</view>
