<!-- pages/home/home.wxml — 首页 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 搜索栏 + 门店选择 + 扫码 -->
  <view class="header">
    <view class="header-left">
      <van-search
        class="header-search"
        value="{{searchValue}}"
        placeholder="搜索服务、项目、产品"
        shape="round"
        background="#F5F5F5"
        bind:change="onSearchChange"
      />
    </view>
    <view class="header-right">
      <view class="header-store" bindtap="onSelectStore">
        <text class="store-name">{{boundStoreName || '选择门店'}}</text>
        <van-icon name="arrow" size="28rpx" color="#666666" />
      </view>
      <view class="header-scan" bindtap="onScanPay">
        <van-icon name="scan" size="44rpx" color="#C0322A" />
      </view>
    </view>
  </view>

  <!-- 页面主体滚动区 -->
  <scroll-view class="page-body" scroll-y>

    <!-- ===== 1. 轮播图 ===== -->
    <view class="section-banner">
      <swiper
        class="banner-swiper"
        indicator-dots="{{false}}"
        autoplay="{{true}}"
        interval="{{4000}}"
        duration="{{500}}"
        circular="{{true}}"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-item" style="background: {{item.bgColor}};">
            <image wx:if="{{item.image}}" class="banner-image" src="{{item.image}}" mode="aspectFill" />
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- ===== 2. 功能模块宫格区（5个一排） ===== -->
    <view class="section-grid">
      <view class="grid-row grid-row-5">
        <view class="grid-item {{activeBigCategoryIndex === 0 ? 'grid-item-active' : ''}}" bindtap="onGridTap" data-type="promotion">
          <view class="grid-icon-wrap">
            <van-icon name="gift-o" size="44rpx" color="{{activeBigCategoryIndex === 0 ? '#C0322A' : '#666666'}}" />
          </view>
          <text class="grid-label {{activeBigCategoryIndex === 0 ? 'grid-label-active' : ''}}">促销方案</text>
        </view>
        <view class="grid-item {{activeBigCategoryIndex === 1 ? 'grid-item-active' : ''}}" bindtap="onGridTap" data-type="service">
          <view class="grid-icon-wrap">
            <van-icon name="flower-o" size="44rpx" color="{{activeBigCategoryIndex === 1 ? '#C0322A' : '#666666'}}" />
          </view>
          <text class="grid-label {{activeBigCategoryIndex === 1 ? 'grid-label-active' : ''}}">护理项目</text>
        </view>
        <view class="grid-item {{activeBigCategoryIndex === 2 ? 'grid-item-active' : ''}}" bindtap="onGridTap" data-type="product">
          <view class="grid-icon-wrap">
            <van-icon name="bag-o" size="44rpx" color="{{activeBigCategoryIndex === 2 ? '#C0322A' : '#666666'}}" />
          </view>
          <text class="grid-label {{activeBigCategoryIndex === 2 ? 'grid-label-active' : ''}}">家居产品</text>
        </view>
        <view class="grid-item" bindtap="onGridTap" data-type="coupon">
          <view class="grid-icon-wrap">
            <van-icon name="coupon-o" size="44rpx" color="#666666" />
          </view>
          <text class="grid-label">我的券</text>
        </view>
        <view class="grid-item" bindtap="onGridTap" data-type="treatment">
          <view class="grid-icon-wrap">
            <van-icon name="calendar-o" size="44rpx" color="#666666" />
          </view>
          <text class="grid-label">我的疗程</text>
        </view>
      </view>
    </view>

    <!-- ===== 3. 服务列表区域 ===== -->
    <view class="section-catalog">

      <!-- 分类 + 商品主区域 -->
      <view class="catalog">

        <!-- 左侧：Vant Sidebar -->
        <scroll-view class="sidebar-scroll" scroll-y>
          <van-sidebar active-key="{{activeCategoryIndex}}" bind:change="onCategoryChange">
            <van-sidebar-item
              wx:for="{{categories}}"
              wx:key="_index"
              title="{{item.category}}"
            />
          </van-sidebar>
        </scroll-view>

        <!-- 右侧：商品列表 -->
        <scroll-view class="product-scroll" scroll-y>

          <!-- 骨架屏 -->
          <view wx:if="{{isLoading}}" class="skeleton-wrap">
            <van-skeleton title avatar row="3" />
            <van-skeleton title avatar row="3" style="margin-top:24rpx" />
          </view>

          <!-- 空态 -->
          <view wx:elif="{{spuList.length === 0 && categories.length === 0}}">
            <van-empty description="暂无服务项目" />
          </view>
          <view wx:elif="{{spuList.length === 0 && categories.length > 0}}">
            <van-empty description="该分类暂无服务项目" />
          </view>

          <!-- SPU 卡片列表 -->
          <view wx:else class="spu-list">
            <view
              wx:for="{{spuList}}"
              wx:key="spu_id"
              class="spu-card"
              bindtap="onSpuTap"
              data-spu-id="{{item.spu_id}}"
            >
              <!-- 商品封面 -->
              <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
                <van-icon name="photo-o" size="64rpx" color="#CCCCCC" />
              </view>
              <image
                wx:else
                class="spu-cover"
                src="{{item.cover_image}}"
                mode="aspectFill"
                lazy-load
              />

              <!-- 商品信息 -->
              <view class="spu-body">
                <!-- 标签行 -->
                <view class="spu-tags" wx:if="{{item.is_recommend}}">
                  <van-tag color="#C0322A">推荐</van-tag>
                </view>

                <!-- 商品名 -->
                <text class="spu-name">{{item.name}}</text>

                <!-- 底部：价格 + 按钮 -->
                <view class="spu-footer">
                  <view class="price-group">
                    <text class="price-symbol">¥</text>
                    <text class="price-integer">{{item.min_price}}</text>
                    <text class="price-start">起</text>
                  </view>
                  <view class="spu-add-btn" catchtap="onAddToCart" data-spu-id="{{item.spu_id}}">
                    <van-icon name="plus" size="36rpx" color="#FFFFFF" />
                  </view>
                </view>
              </view>
            </view>
          </view>

        </scroll-view>
      </view>

    </view>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom"></view>

  </scroll-view>

  <!-- 右下角悬浮购物车按钮 -->
  <view class="cart-fab" bindtap="onCartTap" wx:if="{{cartCount > 0}}">
    <van-icon name="shopping-cart-o" size="48rpx" color="#FFFFFF" />
    <view class="cart-fab-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>

</view>
