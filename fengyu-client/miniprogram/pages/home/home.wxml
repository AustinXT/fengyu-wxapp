<!-- pages/home/home.wxml — 首页 -->
<wxs module="price">
module.exports.min = function(n) {
  var v = parseFloat(n) || 0;
  var r = Math.round(v * 100) / 100;
  return r % 1 === 0 ? '' + Math.round(r) : r.toFixed(2);
}
</wxs>
<van-toast id="van-toast" />

<view class="container">

  <!-- 自定义导航栏 -->
  <nav-bar />

  <!-- 搜索栏 + 门店选择 + 扫码 -->
  <view class="header">
    <view class="header-left">
      <view class="search-bar">
        <van-icon name="search" size="32rpx" color="#999" />
        <input
          class="search-input"
          placeholder="搜索服务、产品"
          placeholder-style="color:#BBBBBB;font-size:26rpx;"
          value="{{searchValue}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchSubmit"
          confirm-type="search"
        />
        <view class="search-btn" bindtap="onSearchSubmit">
          <text class="search-btn-text">搜索</text>
        </view>
      </view>
    </view>
    <view class="header-right">
      <view class="header-store" bindtap="onSelectStore">
        <text class="store-name">{{boundStoreName || '选择门店'}}</text>
        <van-icon name="arrow" size="28rpx" color="#666666" />
      </view>
      <view class="header-scan" bindtap="onScanPay">
        <van-icon name="scan" size="36rpx" color="#C0322A" />
      </view>
    </view>
  </view>

  <!-- 顶部区域：轮播图 + 功能宫格 -->
  <view class="top-section">

    <!-- ===== 1. 轮播图 ===== -->
    <view class="section-banner" wx:if="{{banners.length > 0}}">
      <swiper
        class="banner-swiper"
        indicator-dots="{{false}}"
        autoplay="{{true}}"
        interval="{{4000}}"
        duration="{{500}}"
        circular="{{true}}"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-item" style="background: {{item.bgColor}};">
            <image wx:if="{{item.image}}" class="banner-image" src="{{item.image}}" mode="aspectFill" />
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- ===== 2. 功能模块宫格区（5个一排） ===== -->
    <view class="section-grid">
      <view class="grid-row grid-row-5">
        <view class="grid-item" bindtap="onGridTap" data-type="coupon">
          <view class="grid-icon-wrap">
            <van-icon name="coupon" size="44rpx" color="#C0322A" />
          </view>
          <text class="grid-label">我的券</text>
        </view>
        <view class="grid-item" bindtap="onGridTap" data-type="treatment">
          <view class="grid-icon-wrap">
            <image class="grid-icon-img" src="/images/icons/grid-calendar.png" mode="aspectFit" />
          </view>
          <text class="grid-label">我的疗程</text>
        </view>
      </view>
    </view>

  </view>

  <!-- ===== 3. 商品目录区域（独立滚动） ===== -->
  <view class="section-catalog">

    <!-- 搜索结果模式 -->
    <view wx:if="{{isSearching}}" class="search-results-area">
      <view class="search-results-header">
        <text class="search-results-title">搜索结果</text>
        <view class="search-results-close" bindtap="onSearchClear">
          <van-icon name="cross" size="28rpx" color="#999" />
          <text class="search-results-close-text">返回</text>
        </view>
      </view>
      <scroll-view class="search-results-scroll" scroll-y>
        <van-loading wx:if="{{searchLoading}}" size="24px" vertical style="padding: 80rpx 0;">搜索中...</van-loading>
        <van-empty wx:elif="{{searchResults.length === 0}}" description="未找到相关商品" />
        <view wx:else class="spu-list">
          <view
            wx:for="{{searchResults}}"
            wx:key="product_id"
            class="spu-card"
            bindtap="onSpuTap"
            data-product-id="{{item.product_id}}"
          >
            <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
              <van-icon name="photo-o" size="48rpx" color="#CCCCCC" />
            </view>
            <image wx:else class="spu-cover" src="{{item.cover_image}}" mode="aspectFill" lazy-load />
            <view class="spu-body">
              <view class="spu-tags" wx:if="{{item.category_name}}">
                <van-tag type="primary">{{item.category_name}}</van-tag>
              </view>
              <text class="spu-name">{{item.name}}</text>
              <view class="spu-footer">
                <view class="price-group">
                  <text class="price-symbol">¥</text>
                  <text class="price-integer">{{price.min(item.min_price)}}</text>
                  <text class="price-start">起</text>
                </view>
                <view class="spu-buy-btn" catchtap="onBuyTap" data-product-id="{{item.product_id}}">
                  <text class="spu-buy-text">购买</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 正常浏览模式 -->
    <view wx:else class="catalog">

      <!-- 左侧：自定义分类侧边栏（一级分类作为标题，二级分类可点击） -->
      <scroll-view class="sidebar-scroll" scroll-y scroll-into-view="{{sidebarScrollIntoView}}">
        <view
          wx:for="{{sidebarItems}}"
          wx:key="id"
          id="{{item.id}}"
        >
          <!-- 分类项 -->
          <view
            class="sidebar-item {{activeCategoryKey === item.categoryKey ? 'sidebar-item--active' : ''}}"
            bindtap="onSidebarCategoryTap"
            data-key="{{item.categoryKey}}"
          >
            <text class="sidebar-item-text">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 右侧：商品列表（独立滚动，触底自动切换下一分类） -->
      <scroll-view class="product-scroll" scroll-y bindscrolltolower="onScrollToLower" lower-threshold="100">

        <!-- 骨架屏 -->
        <view wx:if="{{isLoading && spuList.length === 0}}" class="skeleton-wrap">
          <van-skeleton title avatar row="3" />
          <van-skeleton title avatar row="3" style="margin-top:24rpx" />
        </view>

        <!-- 错误态 -->
        <van-empty
          wx:elif="{{loadError}}"
          image="error"
          description="加载失败，下拉刷新重试"
        />

        <!-- 空态 -->
        <view wx:elif="{{spuList.length === 0}}">
          <van-empty description="该分类暂无商品" />
        </view>

        <!-- SPU 卡片列表 -->
        <view wx:else class="spu-list">
          <view
            wx:for="{{spuList}}"
            wx:key="product_id"
            class="spu-card"
            bindtap="onSpuTap"
            data-product-id="{{item.product_id}}"
          >
            <!-- 左侧封面 -->
            <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
              <van-icon name="photo-o" size="48rpx" color="#CCCCCC" />
            </view>
            <image
              wx:else
              class="spu-cover"
              src="{{item.cover_image}}"
              mode="aspectFill"
              lazy-load
            />

            <!-- 右侧信息 -->
            <view class="spu-body">
              <!-- 标签行 -->
              <view class="spu-tags" wx:if="{{item.category_name}}">
                <van-tag type="primary">{{item.category_name}}</van-tag>
              </view>

              <!-- 商品名 -->
              <text class="spu-name">{{item.name}}</text>

              <!-- 底部：价格 + 按钮 -->
              <view class="spu-footer">
                <view class="price-group">
                  <text class="price-symbol">¥</text>
                  <text class="price-integer">{{price.min(item.min_price)}}</text>
                  <text class="price-start">起</text>
                </view>
                <view class="spu-buy-btn" catchtap="onBuyTap" data-product-id="{{item.product_id}}">
                  <text class="spu-buy-text">购买</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 加载提示 -->
          <view wx:if="{{isLoading}}" class="load-more-hint">
            <van-loading size="20px" />
          </view>
        </view>

        <!-- 底部留白，确保单个商品也能触发滚动切换下一分类 -->
        <view class="scroll-bottom-spacer" wx:if="{{spuList.length > 0}}" />

      </scroll-view>
    </view>

  </view>

  <!-- 右下角悬浮购物车按钮 -->
  <view class="cart-fab" bindtap="onCartTap" wx:if="{{cartCount > 0}}">
    <van-icon name="shopping-cart-o" size="48rpx" color="#FFFFFF" />
    <view class="cart-fab-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>

</view>
