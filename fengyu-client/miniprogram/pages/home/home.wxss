/* pages/home/home.wxss — 首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 搜索栏 + 门店选择 + 扫码 ===== */
.header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.header-left {
  flex: 1;
  margin-right: 16rpx;
}

.header-search {
  background: #F5F5F5 !important;
}

.header-search .van-search__content {
  background: #F5F5F5 !important;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #FFF0EE;
  border: 1rpx solid rgba(192, 50, 42, 0.2);
  border-radius: 40rpx;
}

.header-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #FFF0EE;
  border: 1rpx solid rgba(192, 50, 42, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
}

.store-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #C0322A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100rpx;
}

/* ===== 页面主体滚动区 ===== */
.page-body {
  flex: 1;
  overflow-y: auto;
  min-height: 0;
}

/* ===== 1. 轮播图 ===== */
.section-banner {
  padding: 24rpx;
}

.banner-swiper {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* ===== 2. 功能模块宫格区（5个一排） ===== */
.section-grid {
  padding: 24rpx;
}

.grid-row-5 {
  display: flex;
  gap: 8rpx;
}

.grid-row-5 .grid-item {
  flex: 1;
  padding: 24rpx 8rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.grid-item-active {
  background: #FFF0EE;
}

.grid-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #FFF0EE;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.grid-icon {
  width: 44rpx;
  height: 44rpx;
}

.grid-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.grid-label-active {
  color: #C0322A;
  font-weight: 600;
}

/* ===== 3. 服务列表区域 ===== */
.section-catalog {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FFFFFF;
  /* 预留底部购物车空间 */
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ===== 分类+内容双栏 ===== */
.catalog {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类滚动区 */
.sidebar-scroll {
  width: var(--sidebar-width);
  flex-shrink: 0;
  background: #F5F5F5;
  overflow: hidden;
}

/* Vant Sidebar 覆盖 */
.sidebar-scroll .van-sidebar {
  width: 100%;
  background: transparent;
}

/* 右侧商品滚动区 */
.product-scroll {
  flex: 1;
  padding: 16rpx;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 16rpx;
}

/* ===== SPU 卡片列表 ===== */
.spu-list {
  padding-bottom: 32rpx;
}

.spu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.spu-cover {
  width: 100%;
  height: 220rpx;
  display: block;
}

.spu-body {
  padding: 18rpx 20rpx 16rpx;
}

.spu-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.spu-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.spu-add-btn {
  width: 56rpx;
  height: 56rpx;
  background: #C0322A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== 底部悬浮购物车栏 ===== */
.cart-bar {
  position: absolute;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  height: 100rpx;
  background: #C0322A;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(192, 50, 42, 0.35);
  z-index: 100;
}

.cart-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: #FF4D4F;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-info {
  flex: 1;
}

.cart-tip {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ===== 底部安全区 ===== */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
