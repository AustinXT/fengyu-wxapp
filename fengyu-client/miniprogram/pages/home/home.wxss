/* pages/home/home.wxss — 首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 搜索栏 + 门店选择 + 扫码 ===== */
.header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.header-left {
  flex: 1;
  margin-right: 16rpx;
}

/* 自定义搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  border: 1rpx solid #E8E8E8;
  padding: 0 20rpx;
  gap: 12rpx;
  overflow: hidden;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 64rpx;
  height: 64rpx;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  background: #C0322A;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.search-btn-text {
  font-size: 24rpx;
  color: #FFF;
  font-weight: 500;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #FFF0EE;
  border: 1rpx solid rgba(192, 50, 42, 0.2);
  border-radius: 40rpx;
}

.header-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: #FFF0EE;
  border: 1rpx solid rgba(192, 50, 42, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
}

.store-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #C0322A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}

/* ===== 页面主体滚动区 ===== */
.page-body {
  flex: 1;
  overflow-y: auto;
  min-height: 0;
}

/* ===== 1. 轮播图 ===== */
.section-banner {
  padding: 16rpx 16rpx 12rpx;
}

.banner-swiper {
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* ===== 2. 功能模块宫格区（5个一排） ===== */
.section-grid {
  padding: 0 16rpx 12rpx;
}

.grid-row-5 {
  display: flex;
  gap: 8rpx;
}

.grid-row-5 .grid-item {
  flex: 1;
  padding: 16rpx 8rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.grid-item-active {
  background: #FFF0EE;
}

.grid-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #FFF0EE;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.grid-icon {
  width: 44rpx;
  height: 44rpx;
}

.grid-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.grid-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.grid-label-active {
  color: #C0322A;
  font-weight: 600;
}

/* ===== 3. 服务列表区域 ===== */
.section-catalog {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FFFFFF;
  box-sizing: border-box;
}

/* ===== 分类+内容双栏 ===== */
.catalog {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类滚动区 */
.sidebar-scroll {
  width: var(--sidebar-width);
  flex-shrink: 0;
  background: #F5F5F5;
  overflow: hidden;
}

/* Vant Sidebar 覆盖 */
.sidebar-scroll .van-sidebar {
  width: 100%;
  background: transparent;
}

/* 右侧商品滚动区 */
.product-scroll {
  flex: 1;
  padding: 0 16rpx 16rpx;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 16rpx;
}

/* ===== SPU 卡片列表 ===== */
.spu-list {
  padding-bottom: 32rpx;
}

.spu-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.spu-cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: block;
}

.cover-placeholder {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
}

.spu-body {
  flex: 1;
  padding: 16rpx 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.spu-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.spu-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.spu-buy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  background: #C0322A;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.spu-buy-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ===== 右下角悬浮购物车按钮 ===== */
.cart-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  background: #C0322A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(192, 50, 42, 0.45);
  z-index: 100;
}

.cart-fab-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: #FF4D4F;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* ===== 底部安全区 ===== */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
