/* pages/home/home.wxss — 首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 顶部品牌区（黑金主题）===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #000000 0%, #1A1A1A 100%);
  flex-shrink: 0;
}

.header-brand {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 212rpx;
  height: 80rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(212, 167, 106, 0.15);
  border: 1px solid rgba(212, 167, 106, 0.3);
  border-radius: 40rpx;
  max-width: 220rpx;
}

.header-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: rgba(212, 167, 106, 0.15);
  border: 1px solid rgba(212, 167, 106, 0.3);
  border-radius: 50%;
}

.store-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #D4A76A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 页面主体滚动区 ===== */
.page-body {
  flex: 1;
  overflow-y: auto;
}

/* ===== 1. 广告轮播图 ===== */
.section-banner {
  position: relative;
  padding: 24rpx;
}

.banner-swiper {
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.banner-dots {
  position: absolute;
  bottom: 44rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.3s ease;
}

.banner-dot.active {
  width: 32rpx;
  background: #FFFFFF;
}

/* ===== 未选择门店 ===== */
.no-store-section {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

/* ===== 2. 疗程卡区块 ===== */
.section-treatment-cards {
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 登录提示 */
.tc-login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  gap: 16rpx;
}

.login-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin: 8rpx 0;
}

/* 无疗程卡 */
.tc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  gap: 8rpx;
}

.tc-empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tc-empty-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 16rpx;
}

/* 疗程卡横向滚动 */
.tc-scroll {
  width: 100%;
  white-space: nowrap;
}

.tc-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.tc-card {
  flex-shrink: 0;
  width: 320rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.tc-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.tc-card__sku {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-bottom: 16rpx;
}

.tc-card__progress {
  margin-bottom: 16rpx;
}

.tc-card__progress-text {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

.tc-card__book-btn {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: var(--color-primary);
  border-radius: 24rpx;
  text-align: center;
}

/* ===== 3. 两个大按钮 ===== */
.section-actions {
  display: flex;
  gap: 24rpx;
  padding: 0 24rpx 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 24rpx;
  border-radius: 16rpx;
  gap: 12rpx;
}

.action-btn__service {
  background: linear-gradient(135deg, #1A1A1A 0%, #2D2D2D 100%);
}

.action-btn__appointment {
  background: linear-gradient(135deg, #D4A76A 0%, #B8935A 100%);
}

.action-btn__text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.action-btn__subtext {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 4. 热门推荐 ===== */
.section-hot {
  padding: 24rpx;
}

.hot-loading {
  display: flex;
  gap: 16rpx;
  overflow: hidden;
}

.hot-skeleton {
  flex: 1;
  height: 240rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.hot-empty {
  padding: 40rpx 0;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-item {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
}

.hot-cover {
  width: 100%;
  height: 180rpx;
}

.hot-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  padding: 12rpx 16rpx 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-price {
  padding: 0 16rpx;
}

.price-symbol {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.price-integer {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ===== 底部安全区 ===== */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
