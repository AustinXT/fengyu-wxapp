/* pages/home/home.wxss — 首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 搜索栏 + 门店选择 + 扫码 ===== */
.header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-bg-card);
  flex-shrink: 0;
}

.header-left {
  flex: 1;
  margin-right: 16rpx;
}

/* 自定义搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  height: 64rpx;
  background: var(--color-bg-section);
  border-radius: 32rpx;
  border: 1rpx solid var(--color-border);
  padding: 0 20rpx;
  gap: 12rpx;
  overflow: hidden;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-title);
  line-height: 64rpx;
  height: 64rpx;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  background: var(--color-primary);
  border-radius: 24rpx;
  flex-shrink: 0;
}

.search-btn-text {
  font-size: 24rpx;
  color: var(--color-bg-card);
  font-weight: 500;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--color-primary-light);
  border: 1rpx solid rgba(192, 50, 42, 0.2);
  border-radius: 40rpx;
}

.header-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: var(--color-primary-light);
  border: 1rpx solid rgba(192, 50, 42, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
}

.store-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}

/* ===== 顶部区域（轮播图 + 宫格） ===== */
.top-section {
  flex-shrink: 0;
}

/* ===== 1. 轮播图 ===== */
.section-banner {
  padding: 16rpx 16rpx 12rpx;
}

.banner-swiper {
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* ===== 2. 功能模块宫格区（5个一排） ===== */
.section-grid {
  padding: 0 16rpx 12rpx;
}

.grid-row-5 {
  display: flex;
  gap: 8rpx;
}

.grid-row-5 .grid-item {
  flex: 1;
  padding: 16rpx 8rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.grid-item-active {
  background: var(--color-primary-light);
}

.grid-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: var(--color-primary-light);
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.grid-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.grid-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.grid-label-active {
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== 3. 商品目录区域（独立滚动） ===== */
.section-catalog {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
  background: var(--color-bg-card);
}

/* ===== 搜索结果区域 ===== */
.search-results-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.search-results-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.search-results-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.search-results-close {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.search-results-close-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.search-results-scroll {
  flex: 1;
  padding: 16rpx;
  background: var(--color-bg-page);
}

/* ===== 分类 + 商品双栏布局 ===== */
.catalog {
  display: flex;
  flex: 1;
  min-height: 0;
}

/* ===== 自定义侧边栏 ===== */
.sidebar-scroll {
  width: 200rpx;
  flex-shrink: 0;
  background: var(--color-bg-section);
}

.sidebar-title {
  padding: 20rpx 12rpx 8rpx;
}

.sidebar-title-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.sidebar-item {
  padding: 16rpx 12rpx 16rpx 28rpx;
}

.sidebar-item--active {
  background: var(--color-bg-card);
}

.sidebar-item-text {
  font-size: 24rpx;
  color: var(--color-text-title);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-item--active .sidebar-item-text {
  color: var(--color-primary);
  font-weight: 600;
}

/* ===== 右侧商品滚动区 ===== */
.product-scroll {
  flex: 1;
  padding: 0 16rpx 16rpx;
  background: var(--color-bg-page);
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 16rpx;
}

/* ===== SPU 卡片列表 ===== */
.spu-list {
  padding-bottom: 32rpx;
}

.spu-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: var(--color-bg-card);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.spu-cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: block;
}

.cover-placeholder {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-section);
}

.spu-body {
  flex: 1;
  padding: 16rpx 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}


.spu-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-group {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.price-integer {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.price-start {
  font-size: 20rpx;
  color: var(--color-primary);
  margin-left: 2rpx;
}

.spu-buy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  background: var(--color-primary);
  border-radius: 24rpx;
  flex-shrink: 0;
}

.spu-buy-text {
  font-size: 24rpx;
  color: var(--color-bg-card);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ===== 底部留白（保证可滚动触发下一分类） ===== */
.scroll-bottom-spacer {
  height: 60vh;
}

/* ===== 加载提示 ===== */
.load-more-hint {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

/* ===== 右下角悬浮购物车按钮 ===== */
.cart-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 60rpx);
  width: 104rpx;
  height: 104rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(192, 50, 42, 0.45);

  z-index: 100;
}

.cart-fab-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: var(--color-error);
  border-radius: 18rpx;
  font-size: 22rpx;
  color: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
