<!-- pages/shop/shop.wxml — 服务/产品浏览 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 顶部品牌/门店区（黑金主题） -->
  <view class="header">
    <view class="header-brand">
      <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    </view>
    <view class="header-store" bindtap="onSelectStore">
      <text class="store-name">{{boundStoreName || '选择门店'}}</text>
      <van-icon name="arrow" size="28rpx" color="#D4A76A" />
    </view>
  </view>

  <!-- 分类 + 商品主区域（始终显示） -->
  <view class="catalog">

    <!-- 左侧：Vant Sidebar -->
    <scroll-view class="sidebar-scroll" scroll-y>
      <van-sidebar active-key="{{activeCategoryIndex}}" bind:change="onCategoryChange">
        <van-sidebar-item
          wx:for="{{categories}}"
          wx:key="_index"
          title="{{item.category}}"
        />
      </van-sidebar>
    </scroll-view>

    <!-- 右侧：商品列表 -->
    <scroll-view class="product-scroll" scroll-y>

      <!-- 骨架屏 -->
      <view wx:if="{{isLoading}}" class="skeleton-wrap">
        <van-skeleton title avatar row="3" />
        <van-skeleton title avatar row="3" style="margin-top:24rpx" />
      </view>

      <!-- 空态 -->
      <view wx:elif="{{spuList.length === 0 && categories.length === 0}}">
        <van-empty description="暂无服务项目" />
      </view>
      <view wx:elif="{{spuList.length === 0 && categories.length > 0}}">
        <van-empty description="该分类暂无服务项目" />
      </view>

      <!-- SPU 卡片列表 -->
      <view wx:else class="spu-list">
        <view
          wx:for="{{spuList}}"
          wx:key="spu_id"
          class="spu-card"
        >
          <!-- 商品封面 -->
          <view class="spu-cover cover-placeholder" wx:if="{{!item.cover_image}}">
            <van-icon name="photo-o" size="64rpx" color="#D4A76A" />
          </view>
          <image
            wx:else
            class="spu-cover"
            src="{{item.cover_image}}"
            mode="aspectFill"
          />

          <!-- 商品信息 -->
          <view class="spu-body">
            <!-- 标签行 -->
            <view class="spu-tags">
              <van-tag type="primary" wx:if="{{item.big_category === '生美'}}">生美</van-tag>
              <van-tag color="#006D75" wx:elif="{{item.big_category === '非生美'}}">非生美</van-tag>
              <van-tag color="#D46B08" wx:elif="{{item.big_category === '院装产品'}}">产品</van-tag>
              <van-tag color="#D4A76A" wx:if="{{item.is_recommend}}">推荐</van-tag>
            </view>

            <!-- 商品名 -->
            <text class="spu-name">{{item.name}}</text>

            <!-- 底部：价格 + 按钮 -->
            <view class="spu-footer">
              <view class="price-group">
                <text class="price-symbol">¥</text>
                <text class="price-integer">{{item.min_price}}</text>
                <text class="price-start">起</text>
              </view>
              <view class="spu-add-btn" bindtap="onSpuTap" data-spu-id="{{item.spu_id}}">
                <van-icon name="plus" size="36rpx" color="#FFFFFF" />
              </view>
            </view>
          </view>
        </view>
      </view>

    </scroll-view>
  </view>

  <!-- 底部悬浮购物车栏 -->
  <view class="cart-bar" bindtap="onCartTap" wx:if="{{cartCount > 0}}">
    <view class="cart-icon-wrap">
      <van-icon name="shopping-cart-o" size="44rpx" color="#FFFFFF" />
      <view class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>
    <view class="cart-info">
      <text class="cart-tip">购物车</text>
    </view>
    <van-button type="warning" size="small" round>去结算</van-button>
  </view>

</view>
