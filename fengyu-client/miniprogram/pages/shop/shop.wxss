/* pages/shop/shop.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* ===== 顶部品牌区（黑金主题） ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #000000 0%, #1A1A1A 100%);
  flex-shrink: 0;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #D4A76A;  /* Logo 金色 */
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.brand-sub {
  font-size: 18rpx;
  color: #D4A76A;
  letter-spacing: 1rpx;
  opacity: 0.7;
  line-height: 1.2;
}

.header-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(212, 167, 106, 0.15);
  border: 1px solid rgba(212, 167, 106, 0.3);
  border-radius: 40rpx;
  max-width: 260rpx;
}

.store-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #D4A76A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 未选门店 ===== */
.no-store {
  padding: 80rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.no-store-btn {
  width: 280rpx;
}

/* ===== 分类+内容双栏 ===== */
.catalog {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类滚动区 */
.sidebar-scroll {
  width: var(--sidebar-width);
  flex-shrink: 0;
  background: #F5F5F5;
  overflow: hidden;
}

/* Vant Sidebar 覆盖 */
.sidebar-scroll .van-sidebar {
  width: 100%;
  background: transparent;
}

/* 右侧商品滚动区 */
.product-scroll {
  flex: 1;
  padding: 16rpx;
  overflow: hidden;
  background: var(--color-bg-page);
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 16rpx;
}

/* ===== SPU 卡片列表 ===== */
.spu-list {
  padding-bottom: 32rpx;
}

.spu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.spu-cover {
  width: 100%;
  height: 220rpx;
  display: block;
}

.spu-body {
  padding: 18rpx 20rpx 16rpx;
}

.spu-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.spu-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
