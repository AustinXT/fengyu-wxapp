<!-- pages/checkout/checkout.wxml — 下单确认 + 支付 -->
<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<view class="container">

  <!-- 订单信息 -->
  <van-cell-group title="服务信息" inset>
    <van-cell title="{{spuName}}" label="{{skuDisplayName}}" />
    <van-cell
      title="指定美容师"
      value="{{staffName || '不指定'}}"
    />
    <van-cell title="门店" value="{{storeName}}" />
  </van-cell-group>

  <!-- 消费协议 -->
  <van-cell-group title="消费协议" inset>
    <van-cell>
      <view slot="title" class="agreement-row">
        <van-checkbox
          value="{{agreed}}"
          shape="round"
          checked-color="#C9986A"
          bind:change="onAgreementChange"
        >
          <text class="agreement-text">我已阅读并同意</text>
          <text class="agreement-link" bindtap="onViewAgreement">《服务消费协议》</text>
        </van-checkbox>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 支付方式 -->
  <van-cell-group title="支付方式" inset>
    <van-radio-group value="{{paymentMethod}}" bind:change="onPayMethodChange">
      <van-cell title="微信支付" clickable bindtap="onPayMethodTap" data-method="wechat">
        <van-icon slot="icon" name="wechat-pay" size="40rpx" color="#07C160" style="margin-right:16rpx" />
        <van-radio slot="right-icon" name="wechat" checked-color="#C9986A" />
      </van-cell>
      <van-cell title="线下付款" label="到店后现场付款" clickable bindtap="onPayMethodTap" data-method="offline">
        <van-icon slot="icon" name="balance-o" size="40rpx" color="#C9986A" style="margin-right:16rpx" />
        <van-radio slot="right-icon" name="offline" checked-color="#C9986A" />
      </van-cell>
    </van-radio-group>
  </van-cell-group>

  <!-- 价格明细 -->
  <van-cell-group title="价格明细" inset>
    <van-cell title="服务单价" value="¥{{unitPrice}}" />
    <van-cell title="优惠" value="- ¥0.00" />
    <van-cell title="实付" class="total-row">
      <view slot="right-icon" class="total-amount">
        <text class="total-symbol">¥</text>
        <text class="total-value">{{unitPrice}}</text>
      </view>
    </van-cell>
  </van-cell-group>

  <!-- 底部提交 -->
  <van-submit-bar
    price="{{unitPrice * 100}}"
    button-text="{{paymentMethod === 'wechat' ? '微信支付' : '提交订单'}}"
    loading="{{submitting}}"
    disabled="{{!agreed || submitting}}"
    tip="{{!agreed ? '请先同意消费协议' : ''}}"
    bind:submit="onSubmitOrder"
    safe-area-inset-bottom
  />

</view>

<!-- 手机号绑定弹窗 -->
<van-popup
  show="{{showPhoneBind}}"
  position="bottom"
  round
  closeable
  bind:close="onClosePhoneBind"
  custom-style="padding: 48rpx 40rpx env(safe-area-inset-bottom);"
>
  <view class="phone-bind-popup">
    <van-icon name="phone-o" size="64rpx" color="#D4A76A" />
    <text class="phone-bind-title">需要绑定手机号</text>
    <text class="phone-bind-desc">下单前请先绑定手机号，用于订单通知和售后服务</text>
    <button
      class="phone-bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >微信一键绑定</button>
  </view>
</van-popup>
