/* pages/checkout/checkout.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 160rpx;
}

/* 消费协议行 */
.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.agreement-link {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 价格合计行 */
.total-row {
  border-top: 1px solid var(--color-border);
}

.total-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.total-symbol {
  font-size: 22rpx;
  font-weight: 600;
}

.total-value {
  font-size: 40rpx;
  font-weight: 700;
}

/* ===== 手机号绑定弹窗 ===== */
.phone-bind-popup {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.phone-bind-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-top: 24rpx;
}

.phone-bind-desc {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.5;
}

.phone-bind-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 48rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: 44rpx;
  line-height: 88rpx;
}

.phone-bind-btn::after {
  border: none;
}
