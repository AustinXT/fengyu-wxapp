/* pages/appointment/appointment.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.skeleton-list {
  padding: 32rpx;
}

.empty-wrap {
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.empty-btn {
  width: 280rpx;
}

/* ===== 列表 ===== */
.list-wrap {
  padding: 24rpx 24rpx 0;
}

/* ===== 预约卡片 ===== */
.appt-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.appt-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}

.appt-service {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.appt-card__actions {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 24rpx 20rpx;
  gap: 16rpx;
}

/* ===== 底部按钮 ===== */
.fab-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-top: 1px solid var(--color-border);
  backdrop-filter: blur(10rpx);
}
