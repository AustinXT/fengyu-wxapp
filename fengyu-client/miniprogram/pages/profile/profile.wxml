<!-- pages/profile/profile.wxml — 我的 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 头部卡片（品牌渐变） -->
  <view class="user-header brand-gradient" bindtap="onEditProfile">
    <view class="user-avatar-wrap">
      <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="user-avatar-img" mode="aspectFill" />
      <van-icon wx:else name="contact" size="88rpx" color="#FFFFFF" />
    </view>
    <view class="user-info">
      <text class="user-name">{{userName || '点击设置昵称'}}</text>
      <view class="user-phone-row" wx:if="{{maskedPhone || memberLevel}}">
        <text class="user-phone" wx:if="{{maskedPhone}}">{{maskedPhone}}</text>
        <text wx:if="{{memberLevel}}" class="member-level-tag">{{memberLevel}}</text>
      </view>
      <view class="user-store-row" wx:if="{{boundStoreName}}">
        <van-icon name="location-o" size="22rpx" color="rgba(255,255,255,0.8)" />
        <text class="user-store">{{boundStoreName}}</text>
      </view>
    </view>
    <van-icon name="arrow" size="32rpx" color="rgba(255,255,255,0.6)" />
  </view>

  <!-- 四宫格快捷入口 -->
  <view class="grid-section">
    <view class="grid-item" bindtap="onCoupons">
      <van-icon name="coupon-o" size="48rpx" color="#C0322A" />
      <text class="grid-label">优惠券</text>
    </view>
    <view class="grid-item" bindtap="onPoints">
      <van-icon name="gem-o" size="48rpx" color="#D4820A" />
      <text class="grid-label">积分</text>
    </view>
    <view class="grid-item" bindtap="onMessages">
      <view class="grid-icon-wrap">
        <van-icon name="envelop-o" size="48rpx" color="#096DD9" />
        <view wx:if="{{unreadCount > 0}}" class="grid-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <text class="grid-label">消息</text>
    </view>
    <view class="grid-item" bindtap="onPrepaidCards">
      <van-icon name="balance-o" size="48rpx" color="#52C41A" />
      <text class="grid-label">充值卡</text>
    </view>
  </view>

  <!-- 我的订单快捷入口 -->
  <view class="section-title">我的订单</view>
  <view class="order-shortcuts">
    <view class="order-shortcut-item" bindtap="onOrdersByStatus" data-status="待支付">
      <van-icon name="clock-o" size="44rpx" color="#FAAD14" />
      <text class="order-shortcut-label">待支付</text>
    </view>
    <view class="order-shortcut-item" bindtap="onOrdersByStatus" data-status="已支付">
      <van-icon name="passed" size="44rpx" color="#52C41A" />
      <text class="order-shortcut-label">已支付</text>
    </view>
    <view class="order-shortcut-item" bindtap="onOrdersByStatus" data-status="已完成">
      <van-icon name="success" size="44rpx" color="#8C8C8C" />
      <text class="order-shortcut-label">已完成</text>
    </view>
    <view class="order-shortcut-item" bindtap="onOrders">
      <van-icon name="orders-o" size="44rpx" color="#C0322A" />
      <text class="order-shortcut-label">全部</text>
    </view>
  </view>

  <!-- 我的服务 -->
  <view class="section-title">我的服务</view>
  <van-cell-group inset>
    <van-cell
      title="我的订单"
      icon="orders-o"
      is-link
      bindtap="onOrders"
    />
    <van-cell
      title="我的疗程卡"
      icon="card"
      is-link
      bindtap="onTreatmentCards"
    />
    <van-cell
      title="我的预约"
      icon="calendar-o"
      is-link
      bindtap="onAppointments"
    />
    <van-cell
      title="我的优惠券"
      icon="coupon-o"
      is-link
      bindtap="onCoupons"
    />
    <van-cell
      title="服务记录"
      icon="records"
      is-link
      bindtap="onServiceRecords"
    />
  </van-cell-group>

  <!-- 账户设置 -->
  <view class="section-title" style="margin-top:32rpx">账户设置</view>
  <van-cell-group inset>
    <!-- 手机号：未绑定 → 直接触发微信授权（首绑）；已绑定 → 跳转 profile-edit 走换绑流程 -->
    <button
      wx:if="{{!maskedPhone}}"
      class="phone-bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >
      <van-cell
        title="绑定手机号"
        icon="phone-o"
        is-link
        value="未绑定"
      />
    </button>
    <van-cell
      wx:else
      title="手机号"
      icon="phone-o"
      is-link
      value="{{maskedPhone}}"
      bindtap="onEditProfile"
    />
    <van-cell
      title="切换门店"
      icon="shop-o"
      is-link
      bindtap="onSwitchStore"
      value="{{boundStoreName || '未选择'}}"
    />
  </van-cell-group>

  <!-- 关于 -->
  <view class="section-title" style="margin-top:32rpx">关于</view>
  <van-cell-group inset>
    <van-cell
      title="关于凤御"
      icon="info-o"
      is-link
      bindtap="onAbout"
    />
    <van-cell
      title="客服热线"
      icon="phone-o"
      is-link
      value="400-000-0000"
      bindtap="onCallService"
    />
    <van-cell title="版本" icon="setting-o" value="v1.0.0" />
  </van-cell-group>

  <view class="bottom-space" />

</view>
