/* pages/profile/profile.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 头部卡片（品牌渐变） ===== */
.user-header {
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.user-phone {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.user-store-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.user-store {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ===== 四宫格 ===== */
.grid-section {
  display: flex;
  background: var(--color-bg-card);
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: var(--shadow-card);
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.grid-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 24rpx 32rpx 12rpx;
  letter-spacing: 1rpx;
}

/* ===== 底部留白 ===== */
.bottom-space {
  height: 60rpx;
}

/* ===== 手机号绑定按钮 ===== */
.phone-bind-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  text-align: left;
}

.phone-bind-btn::after {
  border: none;
}
