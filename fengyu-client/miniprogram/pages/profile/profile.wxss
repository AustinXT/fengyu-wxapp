/* pages/profile/profile.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 用户信息卡（白红主题） ===== */
.user-card {
  background: var(--color-bg-card);
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  border-bottom: 3rpx solid var(--color-primary);
  box-shadow: var(--shadow-card);
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  background: var(--color-primary-light);
  border: 2rpx solid rgba(192, 50, 42, 0.3);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-phone {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}

.user-store-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-store {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 24rpx 32rpx 12rpx;
  letter-spacing: 1rpx;
}

/* ===== 底部留白 ===== */
.bottom-space {
  height: 60rpx;
}

/* ===== 手机号绑定按钮 ===== */
.phone-bind-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  text-align: left;
}

.phone-bind-btn::after {
  border: none;
}
