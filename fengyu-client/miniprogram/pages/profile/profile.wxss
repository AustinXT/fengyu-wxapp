

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}


.user-header {
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.user-phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.member-level-tag {
  font-size: 20rpx;
  color: #FFFFFF;
  padding: 2rpx 14rpx;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.user-store-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.user-store {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}


.grid-section {
  display: flex;
  background: var(--color-bg-card);
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: var(--shadow-card);
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.grid-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}


.grid-icon-wrap {
  position: relative;
  display: inline-flex;
}

.grid-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: var(--color-primary);
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
}


.section-title {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 24rpx 32rpx 12rpx;
  letter-spacing: 1rpx;
}


.bottom-space {
  height: 60rpx;
}

