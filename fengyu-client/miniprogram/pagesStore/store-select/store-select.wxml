<!-- pages/store-select/store-select.wxml — 门店选择 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 当前城市提示 -->
  <view wx:if="{{currentCity}}" class="location-bar">
    <van-icon name="location-o" size="14" />
    <text>当前城市：{{currentCity}}</text>
  </view>

  <van-search
    value="{{keyword}}"
    placeholder="搜索门店名称或区域"
    bind:change="onSearch"
    background="#F8F4EF"
  />

  <!-- 加载 -->
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="3" />
    <van-skeleton title row="3" style="margin-top:24rpx" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{groupedStores.length === 0}}" class="empty-wrap">
    <van-empty description="未找到门店" />
  </view>

  <!-- 按市场分组的门店列表 -->
  <view wx:else>
    <view
      wx:for="{{groupedStores}}"
      wx:key="market"
      class="market-group"
    >
      <view class="market-title">{{item.market}}</view>
      <van-cell-group inset>
        <van-cell
          wx:for="{{item.stores}}"
          wx:for-item="store"
          wx:key="store_name"
          title="{{store.store_name}}"
          label="{{store.region}}"
          is-link
          bindtap="onStoreTap"
          data-store-name="{{store.store_name}}"
          right-icon="{{selectedStore === store.store_name ? 'success' : 'arrow'}}"
        />
      </van-cell-group>
    </view>
  </view>

  <view class="bottom-space safe-area-bottom" />
</view>
