<!-- pages/store-select/store-select.wxml — 门店选择 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 当前城市提示 -->
  <view wx:if="{{currentCity}}" class="location-bar">
    <van-icon name="location-o" size="14" />
    <text>当前城市：{{currentCity}}{{currentDistrict ? ' · ' + currentDistrict : ''}}（搜索支持全国）</text>
  </view>

  <van-search
    value="{{keyword}}"
    placeholder="搜索门店名称、市场或区域"
    bind:change="onSearch"
    background="#F8F4EF"
  />

  <!-- 加载 -->
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="3" />
    <van-skeleton title row="3" style="margin-top:24rpx" />
  </view>

  <!-- 提示：定位失败，请搜索 -->
  <view wx:elif="{{showHint === 'search'}}" class="empty-wrap">
    <van-empty image="search" description="无法定位，请搜索门店名称" />
  </view>

  <!-- 提示：搜索字符不足 -->
  <view wx:elif="{{showHint === 'minlen'}}" class="empty-wrap">
    <van-empty image="search" description="请至少输入2个字" />
  </view>

  <view wx:elif="{{showHint === 'no-city'}}" class="empty-wrap">
    <van-empty image="search" description="当前城市暂无门店，请搜索其他城市" />
  </view>

  <view wx:elif="{{showHint === 'no-result'}}" class="empty-wrap">
    <van-empty image="search" description="未找到匹配门店" />
  </view>

  <view wx:elif="{{showHint === 'load-error'}}" class="empty-wrap">
    <van-empty description="门店加载失败，请稍后重试" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{stores.length === 0}}" class="empty-wrap">
    <van-empty description="未找到门店" />
  </view>

  <!-- 按距离升序的门店卡片列表 -->
  <view wx:else class="store-list">
    <view
      wx:for="{{stores}}"
      wx:key="store_id"
      class="store-card"
      bindtap="onStoreTap"
      data-store-id="{{item.store_id}}"
      data-store-name="{{item.store_name}}"
    >
      <!-- 封面图 -->
      <image
        wx:if="{{item.cover_image}}"
        src="{{item.cover_image}}"
        mode="aspectFill"
        class="store-cover"
        lazy-load
      />
      <view wx:else class="store-cover store-cover-placeholder">
        <van-icon name="shop-o" size="40rpx" color="#C0322A" />
      </view>

      <!-- 信息 -->
      <view class="store-info">
        <view class="store-name-row">
          <text class="store-name">{{item.store_name}}</text>
          <van-tag wx:if="{{selectedStore === item.store_name}}" type="primary" round>当前</van-tag>
        </view>
        <view wx:if="{{item.market_name}}" class="store-market">{{item.market_name}}</view>
        <view wx:if="{{item.fullAddress}}" class="store-address">{{item.fullAddress}}</view>
      </view>

      <!-- 距离 -->
      <view wx:if="{{item.distanceText}}" class="store-distance">
        <van-icon name="location-o" size="24rpx" color="#999" />
        <text>{{item.distanceText}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-space safe-area-bottom" />
</view>
