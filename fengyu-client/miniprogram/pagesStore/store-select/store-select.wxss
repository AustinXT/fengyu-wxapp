/* pages/store-select/store-select.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.location-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
  background: #fff;
}

.location-bar text {
  margin-left: 8rpx;
}

.skeleton-wrap {
  padding: 24rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

.store-list {
  padding: 24rpx;
}

.store-card {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.store-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--color-bg-section);
}

.store-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-title);
  margin-right: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-address {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.store-market {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}

.store-distance {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.store-distance text {
  margin-left: 4rpx;
}

.bottom-space {
  height: 60rpx;
}
