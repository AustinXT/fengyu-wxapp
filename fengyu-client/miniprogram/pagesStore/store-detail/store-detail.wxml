<!-- pages/store-detail/store-detail.wxml — 门店详情 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 加载骨架 -->
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="4" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!store}}" class="empty-wrap">
    <van-empty description="门店信息不存在" />
  </view>

  <!-- 门店详情 -->
  <view wx:else>
    <!-- 门店封面图 -->
    <view wx:if="{{store.cover_image}}" class="cover-wrap">
      <image src="{{store.cover_image}}" mode="aspectFill" class="cover-image" />
    </view>
    <!-- 无封面时 Hero 区域 -->
    <view wx:else class="hero">
      <van-icon name="shop-o" size="56px" color="var(--color-brand)" />
      <view class="hero-info">
        <view class="hero-name">{{store.store_name}}</view>
        <van-tag wx:if="{{bindState === 'is-current' || bindState === 'is-current-reviewing'}}" type="primary" round>当前门店</van-tag>
      </view>
    </view>

    <!-- 门店名称区（有封面图时显示在封面下方） -->
    <view wx:if="{{store.cover_image}}" class="store-name-section">
      <view class="store-name-row">
        <text class="store-name-text">{{store.store_name}}</text>
        <van-tag wx:if="{{bindState === 'is-current' || bindState === 'is-current-reviewing'}}" type="primary" round>当前门店</van-tag>
      </view>
    </view>

    <!-- 门店信息 -->
    <van-cell-group inset title="门店信息">
      <van-cell title="所属市场" value="{{store.market_name || '—'}}" />
      <van-cell title="开业时间" value="{{store.open_date || '—'}}" />
      <van-cell title="可用床位" value="{{store.available_beds || '—'}}" />
      <van-cell title="在职员工" value="{{store.staff_count ? store.staff_count + '人' : '—'}}" />
      <van-cell title="服务顾客" value="{{store.customer_count ? store.customer_count + '人' : '—'}}" />
      <van-cell wx:if="{{store.business_hours}}" title="营业时间" value="{{store.business_hours}}" />
      <van-cell wx:if="{{store.phone}}" title="联系电话" value="{{store.phone}}" is-link bindtap="onCallPhone" />
      <van-cell wx:if="{{store.fullAddress}}" title="地址" label="{{store.fullAddress}}" is-link bindtap="onOpenMap" />
      <van-cell wx:if="{{store.parking_info}}" title="停车信息" value="{{store.parking_info}}" />
    </van-cell-group>

    <!-- 门店简介 -->
    <van-cell-group wx:if="{{store.description}}" inset title="门店简介">
      <view class="store-desc">{{store.description}}</view>
    </van-cell-group>

    <!-- 门店图片 -->
    <van-cell-group wx:if="{{store.images.length}}" inset title="门店图片">
      <view class="gallery">
        <image
          wx:for="{{store.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="gallery-image"
          data-index="{{index}}"
          bindtap="onPreviewImage"
        />
      </view>
    </van-cell-group>

    <!-- 审批中提示 -->
    <view wx:if="{{bindState === 'is-current-reviewing'}}" class="review-notice">
      <van-icon name="info-o" size="32rpx" color="#D48806" />
      <text class="review-notice-text">解绑申请审批中，请等待店长处理</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space" />
</view>

<!-- 底部固定操作栏 -->
<view wx:if="{{!isLoading && store}}" class="bottom-bar safe-area-bottom">

  <!-- 无绑定：直接绑定 -->
  <block wx:if="{{bindState === 'no-binding'}}">
    <view class="bind-hint">绑定门店后可享受预约、购买等服务</view>
    <van-button
      type="primary"
      block
      round
      color="#C0322A"
      bindtap="onBindStore"
    >绑定此门店</van-button>
  </block>

  <!-- 当前门店，无申请：申请解绑 -->
  <van-button
    wx:elif="{{bindState === 'is-current'}}"
    type="default"
    block
    round
    bindtap="onRequestUnbind"
  >申请解绑此门店</van-button>

  <!-- 当前门店，审批中 -->
  <block wx:elif="{{bindState === 'is-current-reviewing'}}">
    <van-button type="default" block round disabled>解绑申请审批中</van-button>
    <van-button
      type="danger"
      block
      round
      plain
      style="margin-top:16rpx"
      bindtap="onCancelUnbindRequest"
    >取消申请</van-button>
  </block>

  <!-- 已绑定其他门店：禁用 -->
  <van-button
    wx:elif="{{bindState === 'other-bound'}}"
    type="default"
    block
    round
    disabled
  >已绑定「{{boundStoreName}}」，请先解绑</van-button>

</view>

<!-- 解绑备注弹窗 -->
<van-dialog
  show="{{ showUnbindDialog }}"
  title="申请解绑门店"
  show-cancel-button
  confirm-button-text="提交申请"
  bind:confirm="onUnbindDialogConfirm"
  bind:cancel="onUnbindDialogCancel"
>
  <view class="dialog-body">
    <van-field
      value="{{ unbindNote }}"
      placeholder="备注（选填）"
      bind:input="onUnbindNoteInput"
      type="textarea"
      autosize
      border="{{ false }}"
    />
  </view>
</van-dialog>

<!-- 来源渠道弹窗 -->
<van-popup
  show="{{ showSourcePopup }}"
  position="bottom"
  round
  closeable
  bind:close="onSourcePopupClose"
>
  <view class="source-popup">
    <view class="source-popup-title">请选择来源渠道</view>
    <van-radio-group value="{{ sourceChannel }}" bind:change="onSourceChannelChange">
      <view class="source-radio-list">
        <block wx:for="{{sourceGroups}}" wx:key="label" wx:for-item="group">
          <view class="source-group-title">{{group.label}}</view>
          <view class="source-group-items">
            <view
              wx:for="{{group.channels}}"
              wx:key="*this"
              class="source-radio-cell"
            >
              <van-radio
                name="{{item}}"
                checked-color="#C0322A"
              >{{item}}</van-radio>
            </view>
          </view>
        </block>
      </view>
    </van-radio-group>
    <view class="source-promoter">
      <van-field
        value="{{ promoterName }}"
        label="推荐人"
        placeholder="推荐人姓名（选填）"
        bind:input="onPromoterNameInput"
        border="{{ false }}"
      />
    </view>
    <view class="source-popup-actions">
      <van-button
        type="primary"
        block
        round
        color="#C0322A"
        bindtap="onConfirmBind"
      >确认绑定</van-button>
    </view>
  </view>
</van-popup>
