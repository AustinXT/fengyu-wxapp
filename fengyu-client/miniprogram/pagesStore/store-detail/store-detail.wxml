<!-- pages/store-detail/store-detail.wxml — 门店详情 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 加载骨架 -->
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="4" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!store}}" class="empty-wrap">
    <van-empty description="门店信息不存在" />
  </view>

  <!-- 门店详情 -->
  <view wx:else>
    <!-- 门店封面图 -->
    <view wx:if="{{store.cover_image}}" class="cover-wrap">
      <image src="{{store.cover_image}}" mode="aspectFill" class="cover-image" />
    </view>
    <!-- 无封面时 Hero 区域 -->
    <view wx:else class="hero">
      <van-icon name="shop-o" size="56px" color="var(--color-brand)" />
      <view class="hero-info">
        <view class="hero-name">{{store.store_name}}</view>
        <van-tag wx:if="{{bindState === 'is-current'}}" type="primary" round>当前门店</van-tag>
      </view>
    </view>

    <!-- 门店名称区（有封面图时显示在封面下方） -->
    <view wx:if="{{store.cover_image}}" class="store-name-section">
      <view class="store-name-row">
        <text class="store-name-text">{{store.store_name}}</text>
        <van-tag wx:if="{{bindState === 'is-current'}}" type="primary" round>当前门店</van-tag>
      </view>
    </view>

    <!-- 门店公告（有内容时置顶显眼展示） -->
    <view wx:if="{{store.announcement}}" class="announcement">
      <view class="announcement-head">
        <van-icon name="volume-o" size="32rpx" color="#C0322A" />
        <text class="announcement-title">门店公告</text>
      </view>
      <text class="announcement-body">{{store.announcement}}</text>
    </view>

    <!-- 门店信息卡 -->
    <view class="info-card">
      <!-- 服务顾客 + 营业时间 + 距离 顶部行 -->
      <view wx:if="{{store.customer_count || store.business_hours || distanceText}}" class="info-meta-row">
        <view wx:if="{{store.customer_count}}" class="info-meta-item">
          <van-icon name="like" size="32rpx" color="#C0322A" />
          <text class="info-meta-text">已服务 {{store.customer_count}} 位顾客</text>
        </view>
        <view wx:if="{{store.business_hours}}" class="info-meta-item">
          <van-icon name="clock-o" size="32rpx" color="#999999" />
          <text class="info-meta-text">{{store.business_hours}}</text>
        </view>
        <view wx:if="{{distanceText}}" class="info-meta-item">
          <van-icon name="location-o" size="32rpx" color="#999999" />
          <text class="info-meta-text">距您 {{distanceText}}</text>
        </view>
      </view>

      <!-- 地址 -->
      <view wx:if="{{store.fullAddress}}" class="info-line" bindtap="onOpenMap">
        <van-icon name="location-o" size="36rpx" color="#C0322A" />
        <view class="info-line-content">
          <text class="info-line-label">地址</text>
          <text class="info-line-value">{{store.fullAddress}}</text>
        </view>
        <view class="info-action">
          <van-icon name="guide-o" size="40rpx" color="#FFFFFF" />
        </view>
      </view>

      <!-- 联系电话 -->
      <view wx:if="{{store.phone}}" class="info-line" bindtap="onCallPhone">
        <van-icon name="phone-o" size="36rpx" color="#C0322A" />
        <view class="info-line-content">
          <text class="info-line-label">联系电话</text>
          <text class="info-line-value">{{store.phone}}</text>
        </view>
        <view class="info-action">
          <van-icon name="phone" size="40rpx" color="#FFFFFF" />
        </view>
      </view>

      <!-- 停车信息 -->
      <view wx:if="{{store.parking_info}}" class="info-line info-line-static">
        <van-icon name="info-o" size="36rpx" color="#C0322A" />
        <view class="info-line-content">
          <text class="info-line-label">停车</text>
          <text class="info-line-value">{{store.parking_info}}</text>
        </view>
      </view>
    </view>

    <!-- 门店简介 -->
    <van-cell-group wx:if="{{store.description}}" inset title="门店简介">
      <view class="store-desc">{{store.description}}</view>
    </van-cell-group>

    <!-- 门店图片 -->
    <van-cell-group wx:if="{{store.images.length}}" inset title="门店图片">
      <view class="gallery">
        <image
          wx:for="{{store.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="gallery-image"
          data-index="{{index}}"
          bindtap="onPreviewImage"
        />
      </view>
    </van-cell-group>

    <!-- 转店审批中提示 -->
    <view wx:if="{{pendingRequest}}" class="review-notice">
      <van-icon name="info-o" size="32rpx" color="#D48806" />
      <text class="review-notice-text">转店申请审批中：{{pendingRequest.fromStoreName}} → {{pendingRequest.toStoreName}}，请等待店长处理</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space" />
</view>

<!-- 底部固定操作栏 -->
<view wx:if="{{!isLoading && store}}" class="bottom-bar safe-area-bottom">

  <!-- 有待审批转店申请：任意门店页都展示审核中 + 取消（同顾客仅 1 条 pending） -->
  <block wx:if="{{pendingRequest}}">
    <van-button type="default" block round disabled>转店申请审批中</van-button>
    <van-button
      type="danger"
      block
      round
      plain
      style="margin-top:16rpx"
      bindtap="onCancelTransferRequest"
    >取消申请</van-button>
  </block>

  <!-- 无绑定：直接绑定 -->
  <block wx:elif="{{bindState === 'no-binding'}}">
    <view class="bind-hint">绑定门店后可享受预约、购买等服务</view>
    <van-button
      type="primary"
      block
      round
      color="#C0322A"
      bindtap="onBindStore"
    >绑定此门店</van-button>
  </block>

  <!-- 当前门店：已绑定，无可操作 -->
  <van-button
    wx:elif="{{bindState === 'is-current'}}"
    type="default"
    block
    round
    disabled
  >当前绑定门店</van-button>

  <!-- 已绑定其他门店：申请转绑到本店 -->
  <block wx:elif="{{bindState === 'other-bound'}}">
    <view class="bind-hint">当前绑定「{{boundStoreName}}」，可申请转绑到本店</view>
    <van-button
      type="primary"
      block
      round
      color="#C0322A"
      bindtap="onRequestTransfer"
    >申请转绑到本店</van-button>
  </block>

</view>

<!-- 转店备注弹窗 -->
<van-dialog
  show="{{ showTransferDialog }}"
  title="申请转绑到本店"
  show-cancel-button
  confirm-button-text="提交申请"
  bind:confirm="onTransferDialogConfirm"
  bind:cancel="onTransferDialogCancel"
>
  <view class="dialog-body">
    <view class="transfer-tip">从「{{ boundStoreName }}」转绑到「{{ storeName }}」，提交后由原门店店长审核。</view>
    <van-field
      value="{{ transferNote }}"
      placeholder="备注（选填）"
      bind:input="onTransferNoteInput"
      type="textarea"
      autosize
      border="{{ false }}"
    />
  </view>
</van-dialog>

<!-- 来源渠道弹窗 -->
<van-popup
  show="{{ showSourcePopup }}"
  position="bottom"
  round
  closeable
  bind:close="onSourcePopupClose"
>
  <view class="source-popup">
    <view class="source-popup-title">请选择来源渠道</view>
    <van-radio-group value="{{ sourceChannel }}" bind:change="onSourceChannelChange">
      <view class="source-radio-list">
        <block wx:for="{{sourceGroups}}" wx:key="label" wx:for-item="group">
          <view class="source-group-title">{{group.label}}</view>
          <view class="source-group-items">
            <view
              wx:for="{{group.channels}}"
              wx:key="*this"
              class="source-radio-cell"
            >
              <van-radio
                name="{{item}}"
                checked-color="#C0322A"
              >{{item}}</van-radio>
            </view>
          </view>
        </block>
      </view>
    </van-radio-group>
    <view class="source-promoter">
      <van-field
        value="{{ promoterName }}"
        label="推荐人"
        placeholder="推荐人姓名（选填）"
        bind:input="onPromoterNameInput"
        border="{{ false }}"
      />
    </view>
    <view class="source-popup-actions">
      <van-button
        type="primary"
        block
        round
        color="#C0322A"
        bindtap="onConfirmBind"
      >确认绑定</van-button>
    </view>
  </view>
</van-popup>

<!-- 绑门店前未授权手机号 → 引导绑定手机号（授权后自动重提交绑门店） -->
<van-popup
  show="{{ showPhoneBind }}"
  round
  closeable
  bind:close="onPhoneBindClose"
>
  <view class="phone-bind-popup">
    <view class="phone-bind-popup__title">绑定手机号</view>
    <view class="phone-bind-popup__tips">绑定门店前请先授权手机号</view>
    <button
      class="phone-bind-popup__btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >授权并继续绑定</button>
  </view>
</van-popup>
