

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 200rpx;
}

.skeleton-wrap {
  padding: 24rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}


.cover-wrap {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}


.store-name-section {
  padding: 28rpx 32rpx 16rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.store-name-text {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}


.info-card {
  margin: 24rpx 32rpx 0;
  padding: 8rpx 28rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}


.info-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 32rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.info-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-meta-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}


.info-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 4rpx;
}

.info-line + .info-line {
  border-top: 1rpx solid var(--color-border);
}

.info-line-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.info-line-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.info-line-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.info-action {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}


.announcement {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--color-primary-light);
  border: 1rpx solid #F5C6C2;
  border-left: 8rpx solid var(--color-primary);
  border-radius: 12rpx;
}

.announcement-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.announcement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.announcement-body {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.store-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 24rpx 32rpx;
  line-height: 1.6;
}


.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.gallery-image {
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--color-bg-section);
}


.hero {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  gap: 24rpx;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}


.review-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: #FFFBE6;
  border-radius: 12rpx;
  border: 1rpx solid #FFE58F;
}

.review-notice-text {
  font-size: 26rpx;
  color: var(--color-status-pending);
  flex: 1;
}

.bottom-space {
  height: 60rpx;
}


.bind-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 16rpx;
}


.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}


.dialog-body {
  padding: 16rpx 0;
}

.transfer-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 0 32rpx 12rpx;
}


.source-popup {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.source-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.source-radio-list {
  padding: 0 8rpx;
}

.source-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  padding: 16rpx 0 8rpx;
}

.source-group-title:first-child {
  padding-top: 0;
}

.source-group-items {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
}

.source-radio-cell {
  width: 50%;
  box-sizing: border-box;
  padding-right: 16rpx;
}

.source-radio-cell .van-radio__label {
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

.source-promoter {
  margin-top: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}

.source-popup-actions {
  margin-top: 32rpx;
}

.phone-bind-popup {
  width: 560rpx;
  padding: 48rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.phone-bind-popup__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.phone-bind-popup__tips {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 40rpx;
}

.phone-bind-popup__btn {
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  height: 88rpx;
}

.phone-bind-popup__btn::after {
  border: none;
}

