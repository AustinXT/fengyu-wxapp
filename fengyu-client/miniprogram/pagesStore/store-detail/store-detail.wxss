/* pages/store-detail/store-detail.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 200rpx;
}

.skeleton-wrap {
  padding: 24rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

/* Hero 区域 */
.hero {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  gap: 24rpx;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 审批中提示 */
.review-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: #FFFBE6;
  border-radius: 12rpx;
  border: 1rpx solid #FFE58F;
}

.review-notice-text {
  font-size: 26rpx;
  color: var(--color-status-pending);
  flex: 1;
}

.bottom-space {
  height: 60rpx;
}

/* 绑定提示 */
.bind-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 16rpx;
}

/* 底部固定操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 解绑备注弹窗 */
.dialog-body {
  padding: 16rpx 0;
}

