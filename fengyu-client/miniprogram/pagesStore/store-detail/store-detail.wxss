/* pages/store-detail/store-detail.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 200rpx;
}

.skeleton-wrap {
  padding: 24rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

/* 封面图 */
.cover-wrap {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

/* 门店名称区 */
.store-name-section {
  padding: 28rpx 32rpx 16rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.store-name-text {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 门店公告 */
.announcement {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--color-primary-light);
  border: 1rpx solid #F5C6C2;
  border-left: 8rpx solid var(--color-primary);
  border-radius: 12rpx;
}

.announcement-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.announcement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.announcement-body {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.store-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 24rpx 32rpx;
  line-height: 1.6;
}

/* 门店图片 */
.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.gallery-image {
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--color-bg-section);
}

/* Hero 区域（无封面时） */
.hero {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  gap: 24rpx;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 审批中提示 */
.review-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: #FFFBE6;
  border-radius: 12rpx;
  border: 1rpx solid #FFE58F;
}

.review-notice-text {
  font-size: 26rpx;
  color: var(--color-status-pending);
  flex: 1;
}

.bottom-space {
  height: 60rpx;
}

/* 绑定提示 */
.bind-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 16rpx;
}

/* 底部固定操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 转店备注弹窗 */
.dialog-body {
  padding: 16rpx 0;
}

.transfer-tip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 0 32rpx 12rpx;
}

/* 来源渠道弹窗 */
.source-popup {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.source-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.source-radio-list {
  padding: 0 8rpx;
}

.source-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  padding: 16rpx 0 8rpx;
}

.source-group-title:first-child {
  padding-top: 0;
}

.source-group-items {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
}

.source-radio-cell {
  width: 50%;
  box-sizing: border-box;
  padding-right: 16rpx;
}

.source-radio-cell .van-radio__label {
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

.source-promoter {
  margin-top: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}

.source-popup-actions {
  margin-top: 32rpx;
}

