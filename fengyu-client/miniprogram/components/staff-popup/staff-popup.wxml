
<van-popup
  show="{{show}}"
  position="bottom"
  round
  closeable
  bind:close="onClose"
>
  <view class="staff-popup">
    <view class="staff-popup__title">选择美容师</view>
    <view class="staff-list">
      
      <view
        class="staff-item {{!selectedId ? 'staff-item--active' : ''}}"
        bindtap="onSelect"
        data-wf-id=""
        data-name=""
      >
        <view class="staff-avatar">
          <van-icon name="user-o" size="48rpx" color="#B09880" />
        </view>
        <text class="staff-name">不指定</text>
      </view>
      
      <van-loading wx:if="{{loading && staffList.length === 0}}" size="24px" vertical style="padding: 40rpx 0;">加载中...</van-loading>
      
      <view
        wx:for="{{staffList}}"
        wx:key="employee_id"
        class="staff-item {{selectedId === item.employee_id ? 'staff-item--active' : ''}} {{item.onLeave ? 'staff-item--leave' : ''}}"
        bindtap="onSelect"
        data-wf-id="{{item.employee_id}}"
        data-name="{{item.name}}"
        data-on-leave="{{item.onLeave}}"
      >
        <view class="staff-avatar">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="staff-avatar-img" mode="aspectFill" />
          <van-icon wx:else name="manager-o" size="48rpx" color="#C0322A" />
        </view>
        <text class="staff-name">{{item.name}}</text>
        <text class="staff-title">{{item.position}}</text>
        <view wx:if="{{item.onLeave}}" class="staff-leave-tag">请假</view>
        <view wx:elif="{{item.reviewCount > 0}}" class="staff-rating">
          <van-icon name="star" size="22rpx" color="#C0322A" />
          <text class="staff-rating-text">{{item.avgRating}}（{{item.reviewCount}}）</text>
        </view>
      </view>
      
      <view wx:if="{{!loading && staffList.length === 0}}" class="staff-empty">
        <text>暂无可选美容师</text>
      </view>
    </view>
  </view>
</van-popup>
