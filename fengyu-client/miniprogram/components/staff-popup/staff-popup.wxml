<!-- components/staff-popup — 美容师选择弹层（3 页面复用） -->
<van-popup
  show="{{show}}"
  position="bottom"
  round
  closeable
  bind:close="onClose"
>
  <view class="staff-popup">
    <view class="staff-popup__title">选择美容师</view>
    <view class="staff-list">
      <!-- 不指定 -->
      <view
        class="staff-item {{!selectedId ? 'staff-item--active' : ''}}"
        bindtap="onSelect"
        data-wf-id=""
        data-name=""
      >
        <view class="staff-avatar">
          <van-icon name="user-o" size="48rpx" color="#B09880" />
        </view>
        <text class="staff-name">不指定</text>
      </view>
      <!-- 加载中 -->
      <van-loading wx:if="{{loading && staffList.length === 0}}" size="24px" vertical style="padding: 40rpx 0;">加载中...</van-loading>
      <!-- 美容师列表 -->
      <view
        wx:for="{{staffList}}"
        wx:key="employee_id"
        class="staff-item {{selectedId === item.employee_id ? 'staff-item--active' : ''}}"
        bindtap="onSelect"
        data-wf-id="{{item.employee_id}}"
        data-name="{{item.name}}"
      >
        <view class="staff-avatar">
          <van-icon name="manager-o" size="48rpx" color="#C0322A" />
        </view>
        <text class="staff-name">{{item.name}}</text>
        <text class="staff-title">{{item.position}}</text>
      </view>
      <!-- 空态 -->
      <view wx:if="{{!loading && staffList.length === 0}}" class="staff-empty">
        <text>暂无可选美容师</text>
      </view>
    </view>
  </view>
</van-popup>
