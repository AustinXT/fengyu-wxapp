<!-- components/nav-bar/nav-bar.wxml -->

<!-- 固定定位的导航栏本体 -->
<view class="nav-bar" style="background: {{background}};">
  <!-- 状态栏占位（刘海/灵动岛适配） -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 标题栏内容区 -->
  <view class="nav-content" style="height: {{contentHeight}}px;">
    <!-- 返回按钮（非根页面自动显示） -->
    <view class="nav-back" wx:if="{{showBack}}" bindtap="onBack">
      <van-icon name="arrow-left" size="40rpx" color="#333333" />
    </view>

    <!-- 中心区域：Logo 或文字标题 -->
    <view class="nav-center">
      <image
        wx:if="{{showLogo && !title}}"
        class="nav-logo"
        src="/images/logo.png"
        mode="aspectFit"
      />
      <text wx:elif="{{title}}" class="nav-title">{{title}}</text>
    </view>
  </view>
</view>

<!-- 普通流占位符：撑开父容器的 flex 空间，防止内容被固定导航栏遮挡 -->
<view style="height: {{navBarHeight}}px; flex-shrink: 0;"></view>
