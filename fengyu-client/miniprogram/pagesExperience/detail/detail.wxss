/* pagesExperience/detail/detail.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 200rpx;
}

.skeleton-wrap {
  padding: 32rpx 24rpx;
}

/* ===== 顶部封面 ===== */

.hero-cover {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.hero-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #C0322A 0%, #9B1E14 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-tag-row {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  display: flex;
  gap: 12rpx;
}

.hero-tag {
  font-size: 22rpx !important;
}

/* ===== 信息块 ===== */

.info-block {
  background: var(--color-bg-card);
  margin: 0 0 24rpx 0;
  padding: 32rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.info-spec {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 12rpx;
}

.price-group {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.price-integer {
  font-size: 56rpx;
  color: var(--color-primary);
  font-weight: 700;
  line-height: 1;
}

.price-origin {
  font-size: 24rpx;
  color: var(--color-text-hint);
  text-decoration: line-through;
}

/* ===== 表格 cell 区 ===== */

.cell-section {
  margin-bottom: 24rpx;
}

/* ===== 详情说明 ===== */

.desc-block {
  background: var(--color-bg-card);
  padding: 28rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.desc-content {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
}

.desc-line {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ===== 底部 CTA ===== */

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
  z-index: 100;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.cta-btn {
  width: 100%;
  background: linear-gradient(135deg, #C0322A 0%, #9B1E14 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 22rpx 0;
  border: none;
}

.cta-btn::after {
  border: none;
}
