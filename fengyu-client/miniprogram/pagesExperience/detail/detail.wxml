<!-- pagesExperience/detail/detail.wxml — 体验卡详情 -->
<wxs module="price">
module.exports.fmt = function(n) {
  var v = parseFloat(n) || 0;
  var r = Math.round(v * 100) / 100;
  return r % 1 === 0 ? '' + Math.round(r) : r.toFixed(2);
}
</wxs>
<van-toast id="van-toast" />

<view class="container">

  <!-- 加载态 -->
  <view wx:if="{{isLoading}}" class="skeleton-wrap">
    <van-skeleton title row="3" />
  </view>

  <!-- 错误态 -->
  <van-empty
    wx:elif="{{loadError}}"
    image="error"
    description="加载失败，下拉刷新重试"
  />

  <view wx:else>

    <!-- 顶部封面 -->
    <view class="hero-cover">
      <view class="hero-cover-placeholder" wx:if="{{!sku.cover_image}}">
        <van-icon name="gift-o" size="120rpx" color="#FFFFFF" />
      </view>
      <image
        wx:else
        class="hero-cover-img"
        src="{{sku.cover_image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="hero-tag-row">
        <van-tag type="danger" round custom-class="hero-tag">体验卡</van-tag>
        <van-tag type="warning" round custom-class="hero-tag">新人专享</van-tag>
      </view>
    </view>

    <!-- 标题 + 价格 -->
    <view class="info-block">
      <view class="info-title">{{sku.product_name || sku.spec_name}}</view>
      <view wx:if="{{sku.product_name && sku.spec_name}}" class="info-spec">{{sku.spec_name}}</view>

      <view class="price-row">
        <view class="price-group">
          <text class="price-symbol">¥</text>
          <text class="price-integer">{{price.fmt(sku.displayPrice)}}</text>
        </view>
        <text wx:if="{{sku.strikePrice}}" class="price-origin">原价 ¥{{price.fmt(sku.strikePrice)}}</text>
      </view>
    </view>

    <!-- 规格信息 -->
    <view class="cell-section">
      <van-cell-group>
        <van-cell title="规格" value="{{sku.spec_name || '—'}}" />
        <van-cell wx:if="{{sku.session_count || sku.unit}}" title="数量" value="{{sku.session_count || 1}} {{sku.unit || '次'}}" />
        <van-cell title="使用门店" value="{{boundStoreName || '请绑定门店'}}" />
      </van-cell-group>
    </view>

    <!-- 详情说明 -->
    <view wx:if="{{sku.description}}" class="desc-block">
      <view class="desc-title">体验卡说明</view>
      <view class="desc-content">{{sku.description}}</view>
    </view>

    <!-- 默认说明（无描述时降级） -->
    <view wx:else class="desc-block">
      <view class="desc-title">购买须知</view>
      <view class="desc-line">· 体验卡仅限本人使用，不可转让</view>
      <view class="desc-line">· 购买后请到店核销，逾期作废</view>
      <view class="desc-line">· 体验卡每位顾客限购 1 张</view>
      <view class="desc-line">· 详细服务内容请到店咨询</view>
    </view>

  </view>

  <!-- 底部 sticky CTA -->
  <view wx:if="{{!isLoading && !loadError}}" class="cta-bar safe-bottom">
    <button class="cta-btn" bindtap="onBuyNow">
      立即购买 ¥{{price.fmt(sku.displayPrice)}}
    </button>
  </view>

</view>
