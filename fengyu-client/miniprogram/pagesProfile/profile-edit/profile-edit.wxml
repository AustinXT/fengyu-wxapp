<!-- pagesProfile/profile-edit/profile-edit.wxml -->
<van-toast id="van-toast" />
<van-dialog id="van-dialog" />

<view class="container">

  <!-- 头像区域 -->
  <view class="avatar-section" bindtap="onChooseAvatar">
    <view class="avatar-circle">
      <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-image" mode="aspectFill" />
      <van-icon wx:else name="contact" size="96rpx" color="#C0322A" />
    </view>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <!-- 基本信息 -->
  <van-cell-group inset custom-class="info-group">
    <!-- 昵称（可编辑） -->
    <view wx:if="{{!isEditing}}">
      <van-cell
        title="昵称"
        value="{{userName || '未设置'}}"
        is-link
        bindtap="onEditName"
      />
    </view>
    <view wx:else class="edit-name-row">
      <view class="edit-name-label">昵称</view>
      <input
        class="edit-name-input"
        value="{{editName}}"
        placeholder="请输入昵称"
        maxlength="{{20}}"
        focus="{{true}}"
        bindinput="onNameInput"
        bindconfirm="onSaveName"
      />
      <view class="edit-name-actions">
        <text class="edit-btn edit-btn--cancel" bindtap="onCancelEdit">取消</text>
        <text class="edit-btn edit-btn--save" bindtap="onSaveName">保存</text>
      </view>
    </view>

    <!-- 手机号 -->
    <!-- 首绑场景：直接触发 open-type=getPhoneNumber -->
    <button
      wx:if="{{!maskedPhone}}"
      class="phone-bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >
      <van-cell
        title="手机号"
        value="立即绑定"
        is-link
      />
    </button>

    <!-- 换绑场景：尚未确认 → 普通按钮弹 dialog 二次确认 -->
    <button
      wx:elif="{{!showRebindAuth}}"
      class="phone-bind-btn"
      bindtap="onRequestRebind"
    >
      <van-cell
        title="手机号"
        value="{{maskedPhone}}"
        label="更换手机号"
        is-link
      />
    </button>

    <!-- 换绑场景：确认后 → 真正的授权按钮（让用户再点一次） -->
    <button
      wx:else
      class="phone-bind-btn phone-bind-btn--rebind"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >
      <van-cell
        title="手机号"
        value="点此授权新手机号"
        label="当前：{{maskedPhone}}"
        is-link
      />
    </button>
  </van-cell-group>

  <!-- 只读信息 -->
  <view class="section-title">账户信息</view>
  <van-cell-group inset custom-class="info-group">
    <van-cell
      title="用户编号"
      value="{{userId}}"
    />
    <van-cell
      title="注册门店"
      value="{{boundStoreName || '未绑定'}}"
    />
  </van-cell-group>

</view>
