<!-- pagesProfile/profile-edit/profile-edit.wxml -->
<van-toast id="van-toast" />

<view class="container">

  <!-- 头像区域 -->
  <view class="avatar-section" wx:if="{{!isLoggedOut}}" bindtap="onChooseAvatar">
    <view class="avatar-circle">
      <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-image" mode="aspectFill" />
      <van-icon wx:else name="contact" size="96rpx" color="#C0322A" />
    </view>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <!-- 基本信息 -->
  <van-cell-group inset custom-class="info-group">
    <!-- 昵称（可编辑） -->
    <view wx:if="{{!isLoggedOut && !isEditing}}">
      <van-cell
        title="昵称"
        value="{{userName || '未设置'}}"
        is-link
        bindtap="onEditName"
      />
    </view>
    <view wx:elif="{{!isLoggedOut}}" class="edit-name-row">
      <view class="edit-name-label">昵称</view>
      <input
        class="edit-name-input"
        value="{{editName}}"
        placeholder="请输入昵称"
        maxlength="{{20}}"
        focus="{{true}}"
        bindinput="onNameInput"
        bindconfirm="onSaveName"
      />
      <view class="edit-name-actions">
        <text class="edit-btn edit-btn--cancel" bindtap="onCancelEdit">取消</text>
        <text class="edit-btn edit-btn--save" bindtap="onSaveName">保存</text>
      </view>
    </view>

    <!-- 手机号 -->
    <!-- 退出态优先通过 OPENID 恢复已有账户，不消耗手机号快速验证额度 -->
    <button
      wx:if="{{isLoggedOut}}"
      class="phone-bind-btn"
      bindtap="onRestoreLogin"
      disabled="{{restoringLogin}}"
      loading="{{restoringLogin}}"
    >
      <van-cell
        title="手机号"
        value="微信登录"
        is-link
      />
    </button>

    <!-- 首次绑定或服务端手机号缺失时，才触发付费手机号验证组件 -->
    <button
      wx:elif="{{!maskedPhone}}"
      class="phone-bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{phoneBinding}}"
      loading="{{phoneBinding}}"
    >
      <van-cell
        title="手机号"
        value="立即绑定"
        is-link
      />
    </button>

    <!-- 已绑定场景：只读展示（如需修改请联系门店） -->
    <van-cell
      wx:else
      title="手机号"
      value="{{maskedPhone}}"
      label="如需修改请联系门店"
    />
  </van-cell-group>

  <!-- 只读信息 -->
  <view class="section-title" wx:if="{{!isLoggedOut}}">账户信息</view>
  <van-cell-group inset custom-class="info-group" wx:if="{{!isLoggedOut}}">
    <van-cell
      title="用户编号"
      value="{{userId}}"
    />
    <van-cell
      title="切换门店"
      value="{{boundStoreName || '未选择'}}"
      is-link
      bindtap="onSwitchStore"
    />
  </van-cell-group>

</view>
