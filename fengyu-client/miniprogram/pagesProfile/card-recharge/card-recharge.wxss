/* pagesProfile/card-recharge/card-recharge.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 200rpx;  /* 给底部 CTA 留位 */
}

/* ===== 顶部 hero ===== */

.hero {
  background: linear-gradient(135deg, #C0322A 0%, #9B1E14 100%);
  padding: 56rpx 36rpx 48rpx;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-store {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  align-self: flex-start;
}

.hero-store-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
}

/* ===== 加载态 ===== */

.loading-block {
  padding: 80rpx 0;
  text-align: center;
}

/* ===== 主体 ===== */

.body {
  padding: 32rpx 24rpx 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 8rpx 12rpx 16rpx;
}

/* ===== 预设档卡片 ===== */

.tier-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tier-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
  position: relative;
}

.tier-card--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.tier-face {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.tier-card--active .tier-face {
  color: var(--color-primary);
}

.tier-discount {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 2rpx 12rpx;
  background: var(--color-primary-light);
  border-radius: 16rpx;
}

.tier-card--active .tier-discount {
  background: rgba(255, 255, 255, 0.6);
}

.tier-pay {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.tier-bonus {
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 自定义金额 ===== */

.custom-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.15s;
}

.custom-card--active {
  border-color: var(--color-primary);
}

.custom-input-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.custom-currency {
  font-size: 32rpx;
  color: var(--color-text-primary);
}

.custom-input {
  flex: 1;
  font-size: 36rpx;
  color: var(--color-text-primary);
}

.custom-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding-top: 14rpx;
  line-height: 1.5;
}

.custom-hint--placeholder {
  color: var(--color-text-hint);
}

.custom-hint--error {
  color: var(--color-status-failed, #C0322A);
}

.custom-hint-strong {
  color: var(--color-primary);
  font-weight: 600;
}

.custom-hint-bonus {
  color: var(--color-primary);
}

/* ===== 支付方式 ===== */

.pay-method-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.pay-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

/* ===== 支付宝二维码弹窗 ===== */

.alipay-qr-popup {
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.alipay-qr-popup__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
}

.alipay-qr-popup__image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  background: var(--color-bg-section);
  margin-bottom: 24rpx;
}

.alipay-qr-popup__amount {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.alipay-qr-popup__symbol {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.alipay-qr-popup__price {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.alipay-qr-popup__tips {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 40rpx;
}

.alipay-qr-popup__btn {
  width: 100% !important;
}

/* ===== 底部说明 ===== */

.footer-note {
  padding: 16rpx 12rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.footer-note-line {
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.6;
}

/* ===== 底部 CTA ===== */

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
  z-index: 100;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.cta-btn {
  width: 100%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 22rpx 0;
  border: none;
}

.cta-btn::after {
  border: none;
}

.cta-btn--disabled {
  background: #CCCCCC !important;
  color: #FFFFFF !important;
}

/* ===== 手机绑定弹窗 ===== */

.phone-bind-wrap {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.phone-bind-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.phone-bind-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
}

.phone-bind-btn {
  display: none;  /* van-dialog 的 confirm 按钮已触发，此处隐藏占位 */
}
