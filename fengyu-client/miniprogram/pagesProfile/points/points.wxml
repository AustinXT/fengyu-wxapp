<!-- pagesProfile/points/points.wxml — 积分页面 -->
<van-toast id="van-toast" />

<view class="container">

  <!-- VIP 卡片 -->
  <view class="vip-card brand-gradient">
    <view class="vip-level-row">
      <van-icon name="gem-o" size="36rpx" color="#FFFFFF" />
      <text class="vip-level-text">会员等级: {{levelName || '普通会员'}}</text>
    </view>
    <view class="vip-balance-row">
      <text class="vip-balance-label">积分余额</text>
      <text class="vip-balance-value">{{balance}}</text>
    </view>
    <view class="vip-next-level" wx:if="{{nextLevel}}">
      <text class="vip-next-text">距离{{nextLevel.name}}还需 {{nextLevel.minPoints - balance}} 积分</text>
    </view>
  </view>

  <!-- 积分记录 -->
  <view class="history-section">
    <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#C0322A" line-width="60rpx">
      <van-tab title="全部" />
      <van-tab title="收入" />
      <van-tab title="支出" />
    </van-tabs>

    <!-- 加载骨架 -->
    <view wx:if="{{isLoading && records.length === 0}}" class="skeleton-wrap">
      <van-skeleton title row="3" />
      <van-skeleton title row="3" />
    </view>

    <!-- 错误态 -->
    <van-empty
      wx:elif="{{loadError}}"
      image="error"
      description="加载失败，下拉刷新重试"
    />

    <!-- 空态 -->
    <van-empty wx:elif="{{!isLoading && records.length === 0}}" description="暂无积分记录" />

    <!-- 记录列表 -->
    <view wx:else class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-icon-wrap {{item.isEarn ? 'record-icon-earn' : 'record-icon-redeem'}}">
          <van-icon name="{{item.isEarn ? 'plus' : 'minus'}}" size="28rpx" color="#FFFFFF" />
        </view>
        <view class="record-info">
          <text class="record-desc">{{item.type || '积分变动'}}</text>
          <text class="record-date">{{item.displayDate}}</text>
        </view>
        <text class="record-amount {{item.isEarn ? 'amount-earn' : 'amount-redeem'}}">{{item.displayAmount}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{isLoading && records.length > 0}}" class="loading-more">
      <van-loading size="32rpx" color="#999">加载中...</van-loading>
    </view>
    <view wx:elif="{{!hasMore && records.length > 0}}" class="loading-more">
      <text class="loading-text">没有更多了</text>
    </view>
  </view>

</view>
