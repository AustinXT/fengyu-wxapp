/* pagesProfile/prepaid-cards/prepaid-cards.wxss */

.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.skeleton-wrap {
  padding: 24rpx 32rpx;
}

/* 总余额 */
.balance-header {
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.balance-value {
  font-size: 60rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 卡片列表 */
.card-list {
  padding: 24rpx 32rpx;
}

.card-item {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.card-active {
  border: 1rpx solid var(--color-primary);
}

.card-main {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 20rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-store {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.card-id {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.card-balance-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.card-balance-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.card-balance-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* 展开的消费明细 */
.tx-section {
  border-top: 1rpx solid var(--color-border);
  padding: 20rpx 24rpx;
}

.tx-loading,
.tx-empty {
  text-align: center;
  padding: 20rpx 0;
}

.tx-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.tx-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tx-desc {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.tx-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.tx-amount {
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.tx-positive {
  color: var(--color-success);
}

.tx-negative {
  color: var(--color-text-secondary);
}

/* 底部提示 */
.footer-note {
  text-align: center;
  padding: 24rpx 0 16rpx;
}

.footer-note-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.loading-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
