
<van-toast id="van-toast" />

<view class="container">

  
  <view wx:if="{{isLoading && records.length === 0}}" class="skeleton-wrap">
    <van-skeleton title row="2" />
    <van-skeleton title row="2" />
    <van-skeleton title row="2" />
  </view>

  
  <van-empty
    wx:elif="{{loadError}}"
    image="error"
    description="加载失败，下拉刷新重试"
  />

  
  <van-empty wx:elif="{{!isLoading && records.length === 0}}" description="暂无消息" />

  
  <view wx:else class="message-list">
    <view
      class="message-item {{!item.isRead ? 'message-unread' : ''}}"
      wx:for="{{records}}"
      wx:key="id"
      bindtap="onTapMessage"
      data-index="{{index}}"
    >
      <view class="message-icon-wrap" style="background:{{item.dotColor}}">
        <van-icon name="{{item.iconName}}" size="32rpx" color="#FFFFFF" />
      </view>
      <view class="message-content">
        <view class="message-title-row">
          <text class="message-title">{{item.title}}</text>
          <text class="message-time">{{item.displayTime}}</text>
        </view>
        <text class="message-body">{{item.body}}</text>
      </view>
      <view wx:if="{{!item.isRead}}" class="unread-dot" />
    </view>
  </view>

  
  <view wx:if="{{records.length > 0}}" class="list-footer">
    <van-loading wx:if="{{loadingMore}}" size="24px" color="#C0322A">加载中...</van-loading>
    <text wx:elif="{{!hasMore}}" class="list-footer__end">没有更多消息了</text>
  </view>

</view>
