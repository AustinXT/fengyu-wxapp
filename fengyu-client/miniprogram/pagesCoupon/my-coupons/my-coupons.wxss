/* pagesCoupon/my-coupons/my-coupons.wxss */

page {
  background: var(--color-bg-page);
}

.coupon-list {
  padding: 24rpx;
}

.coupon-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.coupon-card--disabled {
  opacity: 0.6;
}

.coupon-card__left {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C0322A 0%, #D4A76A 100%);
  color: #fff;
  padding: 32rpx 16rpx;
}

.coupon-card--disabled .coupon-card__left {
  background: linear-gradient(135deg, #999 0%, #bbb 100%);
}

.coupon-card__amount {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.coupon-card__type {
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.85;
}

.coupon-card__right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.coupon-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.coupon-card__scope {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.coupon-card__expire {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.coupon-card__desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.coupon-card__tag {
  align-self: flex-start;
  margin-top: 4rpx;
}

.coupon-card__stamp {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 24rpx;
  color: #C0322A;
  border: 2rpx solid #C0322A;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  transform: rotate(15deg);
  opacity: 0.6;
}

.coupon-card__stamp--expired {
  color: #999;
  border-color: #999;
}
