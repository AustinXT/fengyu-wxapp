<!-- pagesCoupon/my-coupons/my-coupons.wxml -->
<wxs module="fmt">
module.exports.join = function(arr, sep) { return arr ? arr.join(sep) : '' }
module.exports.slice = function(s, start, end) { return s ? s.slice(start, end) : '' }
</wxs>
<van-toast id="van-toast" />

<!-- 兑换码 -->
<view class="redeem-section">
  <view class="redeem-row">
    <input
      class="redeem-input"
      placeholder="输入兑换码"
      value="{{redeemCode}}"
      bindinput="onRedeemInput"
      confirm-type="done"
      bindconfirm="onRedeem"
    />
    <van-button
      type="primary"
      size="small"
      custom-class="redeem-btn"
      loading="{{redeeming}}"
      disabled="{{!redeemCode || redeeming}}"
      bindtap="onRedeem"
    >兑换</van-button>
  </view>
</view>

<van-tabs active="{{activeTab}}" bind:change="onTabChange" line-width="60rpx">
  <van-tab title="未使用" />
  <van-tab title="已使用" />
  <van-tab title="已过期" />
</van-tabs>

<!-- 加载态 -->
<view wx:if="{{isLoading}}" class="skeleton-wrap">
  <van-skeleton title row="3" />
  <van-skeleton title row="3" style="margin-top:24rpx" />
</view>

<!-- 错误态 -->
<van-empty
  wx:elif="{{loadError}}"
  image="error"
  description="加载失败，下拉刷新重试"
/>

<!-- 空态 -->
<van-empty
  wx:elif="{{coupons.length === 0}}"
  description="暂无优惠券"
/>

<!-- 数据态 -->
<view wx:else class="coupon-list">
  <view
    wx:for="{{coupons}}"
    wx:key="couponId"
    class="coupon-card {{item.status !== '未使用' ? 'coupon-card--disabled' : ''}}"
  >
    <view class="coupon-card__left">
      <text class="coupon-card__amount">{{item.discountLabel}}</text>
      <text class="coupon-card__type">{{item.couponType}}</text>
    </view>
    <view class="coupon-card__right">
      <text class="coupon-card__name">{{item.name}}</text>
      <text class="coupon-card__scope" wx:if="{{item.applicableStoreNames}}">
        限：{{fmt.join(item.applicableStoreNames, '、')}}
      </text>
      <text class="coupon-card__scope" wx:else>全部门店可用</text>
      <text class="coupon-card__expire">
        <block wx:if="{{item.status === '已使用'}}">已于 {{item.usedAt ? fmt.slice(item.usedAt, 0, 10) : '-'}} 使用</block>
        <block wx:else>有效期至 {{item.expireAtFmt}}</block>
      </text>
      <text class="coupon-card__desc" wx:if="{{item.description}}">{{item.description}}</text>
      <text class="coupon-card__hint" wx:if="{{item.minSpendHint}}">{{item.minSpendHint}}</text>
      <van-tag wx:if="{{item.minSpendNum > 0}}" plain color="#C9986A" custom-class="coupon-card__tag">
        满{{item.minSpendNum}}可用
      </van-tag>
    </view>
    <view class="coupon-card__stamp" wx:if="{{item.status === '已使用'}}">已使用</view>
    <view class="coupon-card__stamp coupon-card__stamp--expired" wx:elif="{{item.status === '已过期'}}">已过期</view>
  </view>
</view>
